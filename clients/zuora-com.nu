  --min-quantity: float # Specifies the minimum number of units for this charge. Use this field and the `MaxQuantity` field to create a range of units allowed in a product rate plan charge. **Character limit**: 16 **Values**: a positive decimal value (format: double)
  --name: string # The name of the product rate plan charge. **Character limit**: 100 **Values**: a string of 100 characters or fewer
  --number-of-period: int # Specifies the number of periods to use when calculating charges in an overage smoothing charge model. **Character limit**: **Values**: a positive whole number (format: int64)
