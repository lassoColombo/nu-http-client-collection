  --account-id: string # The ID of the customer account that the payment is created for.
  amount: float # The total amount of the payment. (format: double)
  --auth-transaction-id: string # The authorization transaction ID from the payment gateway. Use this field for electronic payments, such as credit cards. When capturing the authorized funds after authorization enablement, `authTransactionId` must be used together with `gatewayOrderId`.
