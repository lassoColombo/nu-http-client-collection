    path: "/v1/billing-preview-runs"
    header: [{name: Zuora-Track-Id, var: zuora_track_id}, {name: Zuora-Entity-Ids, var: zuora_entity_ids}]
    body: {content_type: "application/json; charset=utf-8", kind: json, fields: [{name: assumeRenewal, var: assume_renewal}, {name: batch, var: batch}, {name: chargeTypeToExclude, var: charge_type_to_exclude}, {name: includingEvergreenSubscription, var: including_evergreen_subscription}, {name: targetDate, var: target_date}]}
    accept: ["application/json", "application/json; charset=utf-8"]
    ok: [200]
    auth: bearer
  } {
    zuora_track_id: $zuora_track_id, zuora_entity_ids: $zuora_entity_ids, assume_renewal: $assume_renewal, batch: $batch, charge_type_to_exclude: $charge_type_to_exclude, including_evergreen_subscription: $including_evergreen_subscription, target_date: $target_date
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

