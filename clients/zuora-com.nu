  --bcd-setting-option: string # Billing cycle day setting option. **Character limit**: 9 **Values**: `AutoSet`, `ManualSet`
  --bill-cycle-day: int # Billing cycle day (BCD) on which bill runs generate invoices for the account. **Character limit**: 2 **Values**: any activated system-defined bill cycle day (`1` - `31`) (format: int32)
  --bill-to-id: string # ID of the person to bill for the account. **Character limit**: 32 **Values**: a valid contact ID for the account
