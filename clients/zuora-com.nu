  --last-name: string # The customer's last name. This field is used only for the direct debit payment method. **Character limit**: 70 **Values**: a string of 70 characters or fewer
  --last-transaction-date-time: string # The date of the most recent transaction. **Character limit**: 29 **Values**: a valid date and time value (format: date-time)
