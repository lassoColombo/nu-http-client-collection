mo-item" "post-r-sfor-debit-memo-item-manual-distribution" "post-r-sfor-debit-memo-item-distribute-by-date-range" "get-r-sby-invoice-item-adjustment" "post-r-sfor-invoice-item-adjustment-manual-distribution" "post-r-sfor-invoice-item-adjustment-distribute-by-date-range" "get-r-sby-invoice-item" "post-r-sfor-invoice-item-manual-distribution" "post-r-sfor-invoice-item-distribute-by-date-range" "get-r-sby-product-charge-and-billing-account" "get-r-sfor-subsc-charge" "post-r-sfor-subsc-charge" "delete-rs" "get-rs" "put-rs-basic-info" "put-revenue-across-ap" "put-revenue-specific-date" "put-revenue-by-recognition-startand-end-dates" "put-rev-pro-accounting-codes" "post-rsa-signatures" "post-decrypt-rsa-signatures" "get-sequence-sets" "post-sequence-sets" "delete-sequence-set" "get-sequence-set" "put-sequence-set" "get-revenue-automation-start-date" "post-subscription" "get-subscriptions-by-account" "post-preview-subscription" "get-subscriptions-by-key" "put-subscription" "put-cancel-subscription" "put-renew-subscription" "put-resume-subscription" "put-suspend-subscription" "get-subscriptions-by-key-and-version" "get-ramp-metrics-by-subscription-key" "get-ramps-by-subscription-key" "put-update-subscription-custom-fields" "put-update-subscription-custom-fields-of-a-specified-version" "delete-taxation-item" "get-taxation-item" "put-taxation-item" "get-transaction-invoice" "get-transaction-payment" "post-usage" "get-usage" "put-accept-user-access" "get-entities-user-accessible" "put-deny-user-access" "put-send-user-access-requests" "get-workflows" "post-workflow-import" "get-workflows-usages" "get-workflows-tasks" "put-workflows-tasks-update" "get-workflows-task" "post-workflows-task-rerun" "delete-workflow" "get-workflow" "patch-update-workflow" "get-workflow-export" "post-run-workflow" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

