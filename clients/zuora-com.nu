  --uom: string # Specifies the units to measure usage. You can update this field for an OLI only when the OLI is in the `Executing` state (when the `itemState` field is set as `Executing`).
  --accounting-code: string # The accountingCode for the Order Line Item (OLI). You can update this field for an OLI only when the OLI is in the `Executing` state (when the `itemState` field is set as `Executing`).
