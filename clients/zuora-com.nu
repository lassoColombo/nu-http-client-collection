N, var: iban}, {name: IPAddress, var: ip_address}, {name: IdentityNumber, var: identity_number}, {name: IsCompany, var: is_company}, {name: LastName, var: last_name}, {name: LastTransactionDateTime, var: last_transaction_date_time}, {name: MandateCreationDate, var: mandate_creation_date}, {name: MandateID, var: mandate_id}, {name: MandateReceived, var: mandate_received}, {name: MandateUpdateDate, var: mandate_update_date}, {name: MaxConsecutivePaymentFailures, var: max_consecutive_payment_failures}, {name: NumConsecutiveFailures, var: num_consecutive_failures}, {name: PaymentRetryWindow, var: payment_retry_window}, {name: PaypalBaid, var: paypal_baid}, {name: PaypalEmail, var: paypal_email}, {name: PaypalPreapprovalKey, var: paypal_preapproval_key}, {name: PaypalType, var: paypal_type}, {name: Phone, var: phone}, {name: PostalCode, var: postal_code}, {name: SecondTokenId, var: second_token_id}, {name: SkipValidation, var: skip_validation}, {name: State, var: state}, {name: StreetName, var: street_name}, {name: StreetNumber, var: street_number}, {name: TokenId, var: token_id}, {name: Type, var: type}, {name: UseDefaultRetryRule, var: use_default_retry_rule, required: true}, {name: currencyCode, var: currency_code}]}
