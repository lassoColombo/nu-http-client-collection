  --transferred-to-accounting: string@transferred-to-accounting-completer-2 # Whether the refund was transferred to an external accounting system. Use this field for integration with accounting systems, such as NetSuite.
  --type: string@type-completer-3 # The type of the payment, whether the payment is external or electronic.
