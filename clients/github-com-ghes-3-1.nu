  --tool-guid: string # The GUID of a code scanning tool. Only results by this tool will be listed. Note that some code scanning tools may not include a GUID in their analysis data. You can specify the tool by using either `tool_guid` or `tool_name`, but not both. (nullable)
  --page: int # Page number of the results to fetch. (default: 1)
