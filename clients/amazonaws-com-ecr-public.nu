# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    batch-check-layer-availability: "record<layers: table<layerDigest: string, layerAvailability: string, layerSize: int, mediaType: string>, failures: table<layerDigest: string, failureCode: string, failureReason: string>>"
    batch-delete-image: "record<imageIds: table<imageDigest: string, imageTag: string>, failures: table<imageId: record, failureCode: string, failureReason: string>>"
    complete-layer-upload: "record<registryId: string, repositoryName: string, uploadId: string, layerDigest: string>"
    create-repository: "record<repository: record<repositoryArn: string, registryId: string, repositoryName: string, repositoryUri: string, createdAt: string>, catalogData: record<description: string, architectures: list<string>, operatingSystems: list<string>, logoUrl: string, aboutText: string, usageText: string, marketplaceCertified: bool>>"
    delete-repository: "record<repository: record<repositoryArn: string, registryId: string, repositoryName: string, repositoryUri: string, createdAt: string>>"
    delete-repository-policy: "record<registryId: string, repositoryName: string, policyText: string>"
    describe-image-tags: "record<imageTagDetails: table<imageTag: string, createdAt: string, imageDetail: record>, nextToken: string>"
    describe-images: "record<imageDetails: table<registryId: string, repositoryName: string, imageDigest: string, imageTags: list, imageSizeInBytes: int, imagePushedAt: string, imageManifestMediaType: string, artifactMediaType: string>, nextToken: string>"
    describe-registries: "record<registries: table<registryId: string, registryArn: string, registryUri: string, verified: bool, aliases: list>, nextToken: string>"
    describe-repositories: "record<repositories: table<repositoryArn: string, registryId: string, repositoryName: string, repositoryUri: string, createdAt: string>, nextToken: string>"
    get-authorization-token: "record<authorizationData: record<authorizationToken: string, expiresAt: string>>"
    get-registry-catalog-data: "record<registryCatalogData: record<displayName: string>>"
    get-repository-catalog-data: "record<catalogData: record<description: string, architectures: list<string>, operatingSystems: list<string>, logoUrl: string, aboutText: string, usageText: string, marketplaceCertified: bool>>"
    get-repository-policy: "record<registryId: string, repositoryName: string, policyText: string>"
    initiate-layer-upload: "record<uploadId: string, partSize: int>"
    list-tags-for-resource: "record<tags: table<Key: string, Value: string>>"
    put-image: "record<image: record<registryId: string, repositoryName: string, imageId: record<imageDigest: string, imageTag: string>, imageManifest: string, imageManifestMediaType: string>>"
    put-registry-catalog-data: "record<registryCatalogData: record<displayName: string>>"
    put-repository-catalog-data: "record<catalogData: record<description: string, architectures: list<string>, operatingSystems: list<string>, logoUrl: string, aboutText: string, usageText: string, marketplaceCertified: bool>>"
    set-repository-policy: "record<registryId: string, repositoryName: string, policyText: string>"
    tag-resource: "record"
    untag-resource: "record"
    upload-layer-part: "record<registryId: string, repositoryName: string, uploadId: string, lastByteReceived: int>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["batch-check-layer-availability" "batch-delete-image" "complete-layer-upload" "create-repository" "delete-repository" "delete-repository-policy" "describe-image-tags" "describe-images" "describe-registries" "describe-repositories" "get-authorization-token" "get-registry-catalog-data" "get-repository-catalog-data" "get-repository-policy" "initiate-layer-upload" "list-tags-for-resource" "put-image" "put-registry-catalog-data" "put-repository-catalog-data" "set-repository-policy" "tag-resource" "untag-resource" "upload-layer-part" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Checks the availability of one or more image layers that are within a repository in a public registry. When an image is pushed to a repository, each image layer is checked to verify if it has been uploaded before. If it has been uploaded, then the image layer is skipped. This operation is used by the Amazon ECR proxy and is not generally used by customers for pulling and pushing images. In most cases, you should use the docker CLI to pull, tag, and push images.
#
# POST /
# Returns: record<layers: table<layerDigest: string, layerAvailability: string, layerSize: int, mediaType: string>, failures: table<layerDigest: string, failureCode: string, failureReason: string>>
# operationId: BatchCheckLayerAvailability
