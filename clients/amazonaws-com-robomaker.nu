    describe-simulation-job: "record<arn: string, name: string, status: string, lastStartedAt: string, lastUpdatedAt: string, failureBehavior: string, failureCode: string, failureReason: string, clientRequestToken: string, outputLocation: record<s3Bucket: string, s3Prefix: string>, loggingConfig: record<recordAllRosTopics: bool>, maxJobDurationInSeconds: int, simulationTimeMillis: int, iamRole: string, robotApplications: table<application: string, applicationVersion: string, launchConfig: record, uploadConfigurations: list, useDefaultUploadConfigurations: bool, tools: list, useDefaultTools: bool>, simulationApplications: table<application: string, applicationVersion: string, launchConfig: record, uploadConfigurations: list, worldConfigs: list, useDefaultUploadConfigurations: bool, tools: list, useDefaultTools: bool>, dataSources: table<name: string, s3Bucket: string, s3Keys: list, type: string, destination: string>, tags: record, vpcConfig: record<subnets: list<string>, securityGroups: list<string>, vpcId: string, assignPublicIp: bool>, networkInterface: record<networkInterfaceId: string, privateIpAddress: string, publicIpAddress: string>, compute: record<simulationUnitLimit: int, computeType: string, gpuUnitLimit: int>>"
