    create-simulation-application: "record<arn: string, name: string, version: string, sources: table<s3Bucket: string, s3Key: string, etag: string, architecture: string>, simulationSoftwareSuite: record<name: string, version: string>, robotSoftwareSuite: record<name: string, version: string>, renderingEngine: record<name: string, version: string>, lastUpdatedAt: string, revisionId: string, tags: record, environment: record<uri: string>>"
    create-simulation-application-version: "record<arn: string, name: string, version: string, sources: table<s3Bucket: string, s3Key: string, etag: string, architecture: string>, simulationSoftwareSuite: record<name: string, version: string>, robotSoftwareSuite: record<name: string, version: string>, renderingEngine: record<name: string, version: string>, lastUpdatedAt: string, revisionId: string, environment: record<uri: string>>"
    create-simulation-job: "record<arn: string, status: string, lastStartedAt: string, lastUpdatedAt: string, failureBehavior: string, failureCode: string, clientRequestToken: string, outputLocation: record<s3Bucket: string, s3Prefix: string>, loggingConfig: record<recordAllRosTopics: bool>, maxJobDurationInSeconds: int, simulationTimeMillis: int, iamRole: string, robotApplications: table<application: string, applicationVersion: string, launchConfig: record, uploadConfigurations: list, useDefaultUploadConfigurations: bool, tools: list, useDefaultTools: bool>, simulationApplications: table<application: string, applicationVersion: string, launchConfig: record, uploadConfigurations: list, worldConfigs: list, useDefaultUploadConfigurations: bool, tools: list, useDefaultTools: bool>, dataSources: table<name: string, s3Bucket: string, s3Keys: list, type: string, destination: string>, tags: record, vpcConfig: record<subnets: list<string>, securityGroups: list<string>, vpcId: string, assignPublicIp: bool>, compute: record<simulationUnitLimit: int, computeType: string, gpuUnitLimit: int>>"
