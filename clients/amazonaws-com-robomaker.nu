    list-world-templates: "record<templateSummaries: table<arn: string, createdAt: string, lastUpdatedAt: string, name: string, version: string>, nextToken: string>"
    list-worlds: "record<worldSummaries: table<arn: string, createdAt: string, generationJob: string, template: string>, nextToken: string>"
    register-robot: "record<fleet: string, robot: string>"
    restart-simulation-job: "record"
    start-simulation-job-batch: "record<arn: string, status: string, createdAt: string, clientRequestToken: string, batchPolicy: record<timeoutInSeconds: int, maxConcurrency: int>, failureCode: string, failureReason: string, failedRequests: table<request: record, failureReason: string, failureCode: string, failedAt: string>, pendingRequests: table<outputLocation: record, loggingConfig: record, maxJobDurationInSeconds: int, iamRole: string, failureBehavior: string, useDefaultApplications: bool, robotApplications: list, simulationApplications: list, dataSources: list, vpcConfig: record, compute: record, tags: record>, createdRequests: table<arn: string, lastUpdatedAt: string, name: string, status: string, simulationApplicationNames: list, robotApplicationNames: list, dataSourceNames: list, computeType: string>, tags: record>"
    sync-deployment-job: "record<arn: string, fleet: string, status: string, deploymentConfig: record<concurrentDeploymentPercentage: int, failureThresholdPercentage: int, robotDeploymentTimeoutInSeconds: int, downloadConditionFile: record<bucket: string, key: string, etag: string>>, deploymentApplicationConfigs: table<application: string, applicationVersion: string, launchConfig: record>, failureReason: string, failureCode: string, createdAt: string>"
    untag-resource: "record"
    update-robot-application: "record<arn: string, name: string, version: string, sources: table<s3Bucket: string, s3Key: string, etag: string, architecture: string>, robotSoftwareSuite: record<name: string, version: string>, lastUpdatedAt: string, revisionId: string, environment: record<uri: string>>"
    update-simulation-application: "record<arn: string, name: string, version: string, sources: table<s3Bucket: string, s3Key: string, etag: string, architecture: string>, simulationSoftwareSuite: record<name: string, version: string>, robotSoftwareSuite: record<name: string, version: string>, renderingEngine: record<name: string, version: string>, lastUpdatedAt: string, revisionId: string, environment: record<uri: string>>"
    update-world-template: "record<arn: string, name: string, createdAt: string, lastUpdatedAt: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["batch-delete-worlds" "batch-describe-simulation-job" "cancel-deployment-job" "cancel-simulation-job" "cancel-simulation-job-batch" "cancel-world-export-job" "cancel-world-generation-job" "create-deployment-job" "create-fleet" "create-robot" "create-robot-application" "create-robot-application-version" "create-simulation-application" "create-simulation-application-version" "create-simulation-job" "create-world-export-job" "create-world-generation-job" "create-world-template" "delete-fleet" "delete-robot" "delete-robot-application" "delete-simulation-application" "delete-world-template" "deregister-robot" "describe-deployment-job" "describe-fleet" "describe-robot" "describe-robot-application" "describe-simulation-application" "describe-simulation-job" "describe-simulation-job-batch" "describe-world" "describe-world-export-job" "describe-world-generation-job" "describe-world-template" "get-world-template-body" "list-deployment-jobs" "list-fleets" "list-robot-applications" "list-robots" "list-simulation-applications" "list-simulation-job-batches" "list-simulation-jobs" "list-tags-for-resource" "tag-resource" "list-world-export-jobs" "list-world-generation-jobs" "list-world-templates" "list-worlds" "register-robot" "restart-simulation-job" "start-simulation-job-batch" "sync-deployment-job" "untag-resource" "update-robot-application" "update-simulation-application" "update-world-template" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Deletes one or more worlds in a batch operation.
#
# POST /batchDeleteWorlds
# Returns: record<unprocessedWorlds: list<string>>
# operationId: BatchDeleteWorlds
export def "batch-delete-worlds" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  worlds: list<string> # A list of Amazon Resource Names (arns) that correspond to worlds to delete.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/batchDeleteWorlds"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: worlds, var: worlds}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, worlds: $worlds
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

