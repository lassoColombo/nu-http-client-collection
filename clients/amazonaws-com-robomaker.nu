    list-fleets: "record<fleetDetails: table<name: string, arn: string, createdAt: string, lastDeploymentStatus: string, lastDeploymentJob: string, lastDeploymentTime: string>, nextToken: string>"
    list-robot-applications: "record<robotApplicationSummaries: table<name: string, arn: string, version: string, lastUpdatedAt: string, robotSoftwareSuite: record>, nextToken: string>"
    list-robots: "record<robots: table<arn: string, name: string, fleetArn: string, status: string, greenGrassGroupId: string, createdAt: string, architecture: string, lastDeploymentJob: string, lastDeploymentTime: string>, nextToken: string>"
    list-simulation-applications: "record<simulationApplicationSummaries: table<name: string, arn: string, version: string, lastUpdatedAt: string, robotSoftwareSuite: record, simulationSoftwareSuite: record>, nextToken: string>"
    list-simulation-job-batches: "record<simulationJobBatchSummaries: table<arn: string, lastUpdatedAt: string, createdAt: string, status: string, failedRequestCount: int, pendingRequestCount: int, createdRequestCount: int>, nextToken: string>"
    list-simulation-jobs: "record<simulationJobSummaries: table<arn: string, lastUpdatedAt: string, name: string, status: string, simulationApplicationNames: list, robotApplicationNames: list, dataSourceNames: list, computeType: string>, nextToken: string>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    list-world-export-jobs: "record<worldExportJobSummaries: table<arn: string, status: string, createdAt: string, worlds: list, outputLocation: record>, nextToken: string>"
