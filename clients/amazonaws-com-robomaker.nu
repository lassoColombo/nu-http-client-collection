    describe-world: "record<arn: string, generationJob: string, template: string, createdAt: string, tags: record, worldDescriptionBody: string>"
    describe-world-export-job: "record<arn: string, status: string, createdAt: string, failureCode: string, failureReason: string, clientRequestToken: string, worlds: list<string>, outputLocation: record<s3Bucket: string, s3Prefix: string>, iamRole: string, tags: record>"
