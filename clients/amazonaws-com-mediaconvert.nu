# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-certificate: "record"
    cancel-job: "record"
    get-job: "record<Job: record<AccelerationSettings: record<Mode: string>, AccelerationStatus: string, Arn: string, BillingTagsSource: string, ClientRequestToken: string, CreatedAt: string, CurrentPhase: string, ErrorCode: int, ErrorMessage: string, HopDestinations: list<record>, Id: string, JobPercentComplete: int, JobTemplate: string, Messages: record<Info: list, Warning: list>, OutputGroupDetails: list<record>, Priority: int, Queue: string, QueueTransitions: list<record>, RetryCount: int, Role: string, Settings: record<AdAvailOffset: int, AvailBlanking: record, Esam: record, ExtendedDataServices: record, Inputs: list, KantarWatermark: record, MotionImageInserter: record, NielsenConfiguration: record, NielsenNonLinearWatermark: record, OutputGroups: list, TimecodeConfig: record, TimedMetadataInsertion: record>, SimulateReservedQueue: string, Status: string, StatusUpdateInterval: string, Timing: record<FinishTime: string, StartTime: string, SubmitTime: string>, UserMetadata: record, Warnings: list<record>>>"
    create-job: "record<Job: record<AccelerationSettings: record<Mode: string>, AccelerationStatus: string, Arn: string, BillingTagsSource: string, ClientRequestToken: string, CreatedAt: string, CurrentPhase: string, ErrorCode: int, ErrorMessage: string, HopDestinations: list<record>, Id: string, JobPercentComplete: int, JobTemplate: string, Messages: record<Info: list, Warning: list>, OutputGroupDetails: list<record>, Priority: int, Queue: string, QueueTransitions: list<record>, RetryCount: int, Role: string, Settings: record<AdAvailOffset: int, AvailBlanking: record, Esam: record, ExtendedDataServices: record, Inputs: list, KantarWatermark: record, MotionImageInserter: record, NielsenConfiguration: record, NielsenNonLinearWatermark: record, OutputGroups: list, TimecodeConfig: record, TimedMetadataInsertion: record>, SimulateReservedQueue: string, Status: string, StatusUpdateInterval: string, Timing: record<FinishTime: string, StartTime: string, SubmitTime: string>, UserMetadata: record, Warnings: list<record>>>"
    list-jobs: "record<Jobs: table<AccelerationSettings: record, AccelerationStatus: string, Arn: string, BillingTagsSource: string, ClientRequestToken: string, CreatedAt: string, CurrentPhase: string, ErrorCode: int, ErrorMessage: string, HopDestinations: list, Id: string, JobPercentComplete: int, JobTemplate: string, Messages: record, OutputGroupDetails: list, Priority: int, Queue: string, QueueTransitions: list, RetryCount: int, Role: string, Settings: record, SimulateReservedQueue: string, Status: string, StatusUpdateInterval: string, Timing: record, UserMetadata: record, Warnings: list>, NextToken: string>"
    create-job-template: "record<JobTemplate: record<AccelerationSettings: record<Mode: string>, Arn: string, Category: string, CreatedAt: string, Description: string, HopDestinations: list<record>, LastUpdated: string, Name: string, Priority: int, Queue: string, Settings: record<AdAvailOffset: int, AvailBlanking: record, Esam: record, ExtendedDataServices: record, Inputs: list, KantarWatermark: record, MotionImageInserter: record, NielsenConfiguration: record, NielsenNonLinearWatermark: record, OutputGroups: list, TimecodeConfig: record, TimedMetadataInsertion: record>, StatusUpdateInterval: string, Type: string>>"
    list-job-templates: "record<JobTemplates: table<AccelerationSettings: record, Arn: string, Category: string, CreatedAt: string, Description: string, HopDestinations: list, LastUpdated: string, Name: string, Priority: int, Queue: string, Settings: record, StatusUpdateInterval: string, Type: string>, NextToken: string>"
    create-preset: "record<Preset: record<Arn: string, Category: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, Settings: record<AudioDescriptions: list, CaptionDescriptions: list, ContainerSettings: record, VideoDescription: record>, Type: string>>"
    list-presets: "record<NextToken: string, Presets: table<Arn: string, Category: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, Settings: record, Type: string>>"
    create-queue: "record<Queue: record<Arn: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, PricingPlan: string, ProgressingJobsCount: int, ReservationPlan: record<Commitment: string, ExpiresAt: string, PurchasedAt: string, RenewalType: string, ReservedSlots: int, Status: string>, Status: string, SubmittedJobsCount: int, Type: string>>"
    list-queues: "record<NextToken: string, Queues: table<Arn: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, PricingPlan: string, ProgressingJobsCount: int, ReservationPlan: record, Status: string, SubmittedJobsCount: int, Type: string>>"
    delete-job-template: "record"
    get-job-template: "record<JobTemplate: record<AccelerationSettings: record<Mode: string>, Arn: string, Category: string, CreatedAt: string, Description: string, HopDestinations: list<record>, LastUpdated: string, Name: string, Priority: int, Queue: string, Settings: record<AdAvailOffset: int, AvailBlanking: record, Esam: record, ExtendedDataServices: record, Inputs: list, KantarWatermark: record, MotionImageInserter: record, NielsenConfiguration: record, NielsenNonLinearWatermark: record, OutputGroups: list, TimecodeConfig: record, TimedMetadataInsertion: record>, StatusUpdateInterval: string, Type: string>>"
    update-job-template: "record<JobTemplate: record<AccelerationSettings: record<Mode: string>, Arn: string, Category: string, CreatedAt: string, Description: string, HopDestinations: list<record>, LastUpdated: string, Name: string, Priority: int, Queue: string, Settings: record<AdAvailOffset: int, AvailBlanking: record, Esam: record, ExtendedDataServices: record, Inputs: list, KantarWatermark: record, MotionImageInserter: record, NielsenConfiguration: record, NielsenNonLinearWatermark: record, OutputGroups: list, TimecodeConfig: record, TimedMetadataInsertion: record>, StatusUpdateInterval: string, Type: string>>"
    delete-policy: "record"
    get-policy: "record<Policy: record<HttpInputs: string, HttpsInputs: string, S3Inputs: string>>"
    put-policy: "record<Policy: record<HttpInputs: string, HttpsInputs: string, S3Inputs: string>>"
    delete-preset: "record"
    get-preset: "record<Preset: record<Arn: string, Category: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, Settings: record<AudioDescriptions: list, CaptionDescriptions: list, ContainerSettings: record, VideoDescription: record>, Type: string>>"
    update-preset: "record<Preset: record<Arn: string, Category: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, Settings: record<AudioDescriptions: list, CaptionDescriptions: list, ContainerSettings: record, VideoDescription: record>, Type: string>>"
    delete-queue: "record"
    get-queue: "record<Queue: record<Arn: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, PricingPlan: string, ProgressingJobsCount: int, ReservationPlan: record<Commitment: string, ExpiresAt: string, PurchasedAt: string, RenewalType: string, ReservedSlots: int, Status: string>, Status: string, SubmittedJobsCount: int, Type: string>>"
    update-queue: "record<Queue: record<Arn: string, CreatedAt: string, Description: string, LastUpdated: string, Name: string, PricingPlan: string, ProgressingJobsCount: int, ReservationPlan: record<Commitment: string, ExpiresAt: string, PurchasedAt: string, RenewalType: string, ReservedSlots: int, Status: string>, Status: string, SubmittedJobsCount: int, Type: string>>"
    describe-endpoints: "record<Endpoints: table<Url: string>, NextToken: string>"
    disassociate-certificate: "record"
    list-tags-for-resource: "record<ResourceTags: record<Arn: string, Tags: record>>"
    untag-resource: "record"
    tag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-certificate" "cancel-job" "get-job" "create-job" "list-jobs" "create-job-template" "list-job-templates" "create-preset" "list-presets" "create-queue" "list-queues" "delete-job-template" "get-job-template" "update-job-template" "delete-policy" "get-policy" "put-policy" "delete-preset" "get-preset" "update-preset" "delete-queue" "get-queue" "update-queue" "describe-endpoints" "disassociate-certificate" "list-tags-for-resource" "untag-resource" "tag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Associates an AWS Certificate Manager (ACM) Amazon Resource Name (ARN) with AWS Elemental MediaConvert.
#
# POST /2017-08-29/certificates
# Returns: record
# operationId: AssociateCertificate
export def "associate-certificate" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  arn: string # The ARN of the ACM certificate that you want to associate with your MediaConvert resource.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/2017-08-29/certificates"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: arn, var: arn}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, arn: $arn
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

