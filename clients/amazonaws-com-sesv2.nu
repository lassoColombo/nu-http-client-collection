    get-email-identity: "record<IdentityType: string, FeedbackForwardingStatus: bool, VerifiedForSendingStatus: bool, DkimAttributes: record<SigningEnabled: bool, Status: string, Tokens: list<string>, SigningAttributesOrigin: string, NextSigningKeyLength: string, CurrentSigningKeyLength: string, LastKeyGenerationTimestamp: string>, MailFromAttributes: record<MailFromDomain: string, MailFromDomainStatus: string, BehaviorOnMxFailure: string>, Policies: record, Tags: table<Key: string, Value: string>, ConfigurationSetName: string, VerificationStatus: string>"
