    get-domain-statistics-report: "record<OverallVolume: record<VolumeStatistics: record<InboxRawCount: int, SpamRawCount: int, ProjectedInbox: int, ProjectedSpam: int>, ReadRatePercent: float, DomainIspPlacements: list<record>>, DailyVolumes: table<StartDate: string, VolumeStatistics: record, DomainIspPlacements: list>>"
