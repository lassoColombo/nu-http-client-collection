    send-bulk-email: "record<BulkEmailEntryResults: table<Status: string, Error: string, MessageId: string>>"
    send-custom-verification-email: "record<MessageId: string>"
    send-email: "record<MessageId: string>"
    tag-resource: "record"
    test-render-email-template: "record<RenderedTemplate: string>"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["batch-get-metric-data" "create-configuration-set" "list-configuration-sets" "create-configuration-set-event-destination" "get-configuration-set-event-destinations" "create-contact" "list-contacts" "create-contact-list" "list-contact-lists" "create-custom-verification-email-template" "list-custom-verification-email-templates" "create-dedicated-ip-pool" "list-dedicated-ip-pools" "create-deliverability-test-report" "create-email-identity" "list-email-identities" "create-email-identity-policy" "delete-email-identity-policy" "update-email-identity-policy" "create-email-template" "list-email-templates" "create-import-job" "list-import-jobs" "delete-configuration-set" "get-configuration-set" "delete-configuration-set-event-destination" "update-configuration-set-event-destination" "delete-contact" "get-contact" "update-contact" "delete-contact-list" "get-contact-list" "update-contact-list" "delete-custom-verification-email-template" "get-custom-verification-email-template" "update-custom-verification-email-template" "delete-dedicated-ip-pool" "get-dedicated-ip-pool" "delete-email-identity" "get-email-identity" "delete-email-template" "get-email-template" "update-email-template" "delete-suppressed-destination" "get-suppressed-destination" "get-account" "get-blacklist-reports" "get-dedicated-ip" "get-dedicated-ips" "get-deliverability-dashboard-options" "put-deliverability-dashboard-option" "get-deliverability-test-report" "get-domain-deliverability-campaign" "get-domain-statistics-report" "get-email-identity-policies" "get-import-job" "list-deliverability-test-reports" "list-domain-deliverability-campaigns" "list-recommendations" "list-suppressed-destinations" "put-suppressed-destination" "list-tags-for-resource" "put-account-dedicated-ip-warmup-attributes" "put-account-details" "put-account-sending-attributes" "put-account-suppression-attributes" "put-account-vdm-attributes" "put-configuration-set-delivery-options" "put-configuration-set-reputation-options" "put-configuration-set-sending-options" "put-configuration-set-suppression-options" "put-configuration-set-tracking-options" "put-configuration-set-vdm-options" "put-dedicated-ip-in-pool" "put-dedicated-ip-warmup-attributes" "put-email-identity-configuration-set-attributes" "put-email-identity-dkim-attributes" "put-email-identity-dkim-signing-attributes" "put-email-identity-feedback-attributes" "put-email-identity-mail-from-attributes" "send-bulk-email" "send-custom-verification-email" "send-email" "tag-resource" "test-render-email-template" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Retrieves batches of metric data collected based on your sending activity. You can execute this operation no more than 16 times per second, and with at most 160 queries from the batches per second (cumulative).
#
# POST /v2/email/metrics/batch
# Returns: record<Results: table<Id: string, Timestamps: list, Values: list>, Errors: table<Id: string, Code: string, Message: string>>
# operationId: BatchGetMetricData
export def "batch-get-metric-data" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  queries: list # A list of queries for metrics to be retrieved. — item shape: {Id: string, Namespace: "VDM", Metric: "SEND"|"COMPLAINT"|"PERMANENT_BOUNCE"|"TRANSIENT_BOUNCE"|"OPEN"|"CLICK"|"DELIVERY"|"DELIVERY_OPEN"|"DELIVERY_CLICK"|"DELIVERY_COMPLAINT", Dimensions?: record, StartDate: string, EndDate: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/v2/email/metrics/batch"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: Queries, var: queries}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, queries: $queries
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Create a configuration set. Configuration sets are groups of rules that you can apply to the emails that you send. You apply a configuration set to an email by specifying the name of the configuration set when you call the Amazon SES API v2. When you apply a configuration set to an email, all of the rules in that configuration set are applied to the email.
#
# POST /v2/email/configuration-sets
# Returns: record
# operationId: CreateConfigurationSet
export def "create-configuration-set" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  configuration_set_name: string # The name of a configuration set. Configuration sets are groups of rules that you can apply to the emails you send. You apply a configuration set to an email by including a reference to the configuration set in the headers of the email. When you apply a configuration set to an email, all of the rules in that configuration set are applied to the email.
  --tracking-options: record # An object that defines the tracking options for a configuration set. When you use the Amazon SES API v2 to send an email, it contains an invisible image that's used to track when recipients open your email. If your email contains links, those links are changed slightly in order to track when recipients click them. These images and links include references to a domain operated by Amazon Web Services. You can optionally configure the Amazon SES to use a domain that you operate for these images and links. — shape: {CustomRedirectDomain?: string}
  --delivery-options: record # Used to associate a configuration set with a dedicated IP pool. — shape: {TlsPolicy?: "REQUIRE"|"OPTIONAL", SendingPoolName?: string}
  --reputation-options: record # Enable or disable collection of reputation metrics for emails that you send using this configuration set in the current Amazon Web Services Region. — shape: {ReputationMetricsEnabled?: bool, LastFreshStart?: string}
  --sending-options: record # Used to enable or disable email sending for messages that use this configuration set in the current Amazon Web Services Region. — shape: {SendingEnabled?: bool}
  --tags: list # An array of objects that define the tags (keys and values) to associate with the configuration set. — item shape: {Key: string, Value: string}
  --suppression-options: record # An object that contains information about the suppression list preferences for your account. — shape: {SuppressedReasons?: list<string>}
  --vdm-options: record # An object that defines the VDM settings that apply to emails that you send using the configuration set. — shape: {DashboardOptions?: record, GuardianOptions?: record}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/v2/email/configuration-sets"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: ConfigurationSetName, var: configuration_set_name}, {name: TrackingOptions, var: tracking_options}, {name: DeliveryOptions, var: delivery_options}, {name: ReputationOptions, var: reputation_options}, {name: SendingOptions, var: sending_options}, {name: Tags, var: tags}, {name: SuppressionOptions, var: suppression_options}, {name: VdmOptions, var: vdm_options}]}
    accept: ["application/json"]
    ok: [200]
