    get-account: "record<DedicatedIpAutoWarmupEnabled: bool, EnforcementStatus: string, ProductionAccessEnabled: bool, SendQuota: record<Max24HourSend: float, MaxSendRate: float, SentLast24Hours: float>, SendingEnabled: bool, SuppressionAttributes: record<SuppressedReasons: list<string>>, Details: record<MailType: string, WebsiteURL: string, ContactLanguage: string, UseCaseDescription: string, AdditionalContactEmailAddresses: list<string>, ReviewDetails: record<Status: string, CaseId: string>>, VdmAttributes: record<VdmEnabled: string, DashboardAttributes: record<EngagementMetrics: string>, GuardianAttributes: record<OptimizedSharedDelivery: string>>>"
