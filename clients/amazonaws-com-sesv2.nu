    delete-contact: "record"
    get-contact: "record<ContactListName: string, EmailAddress: string, TopicPreferences: table<TopicName: string, SubscriptionStatus: string>, TopicDefaultPreferences: table<TopicName: string, SubscriptionStatus: string>, UnsubscribeAll: bool, AttributesData: string, CreatedTimestamp: string, LastUpdatedTimestamp: string>"
    update-contact: "record"
    delete-contact-list: "record"
    get-contact-list: "record<ContactListName: string, Topics: table<TopicName: string, DisplayName: string, Description: string, DefaultSubscriptionStatus: string>, Description: string, CreatedTimestamp: string, LastUpdatedTimestamp: string, Tags: table<Key: string, Value: string>>"
    update-contact-list: "record"
    delete-custom-verification-email-template: "record"
    get-custom-verification-email-template: "record<TemplateName: string, FromEmailAddress: string, TemplateSubject: string, TemplateContent: string, SuccessRedirectionURL: string, FailureRedirectionURL: string>"
    update-custom-verification-email-template: "record"
    delete-dedicated-ip-pool: "record"
    get-dedicated-ip-pool: "record<DedicatedIpPool: record<PoolName: string, ScalingMode: string>>"
