# Confirms an order from a quote_id and submits it to the Voodoo factory.
#
# POST /order/confirm
# Returns: record<address: record<city: string, country: string, email: string, name: string, state: string, street1: string, street2: string, zip: string>, delivery_date: string, notes: string, order_id: string, order_items: table<material_id: int, model_id: int, options: record, quantity: int, units: string>, purchased: bool, quote: record<errors: list<string>, grand_total: float, items: float, options: record<orientation: float>, shipping: float, tax: float, total: float>, shipping_service: string>
export def "post-order-confirm" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --quote-id: string # quote_id generated by the /order/create endpoint.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/order/confirm"
    body: {content_type: "application/json", kind: json, fields: [{name: quote_id, var: quote_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: api_key
  } {
    quote_id: $quote_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Quotes an order and returns a quote_id that is used to confirm the order.
#
# POST /order/create
# Returns: record<address: record<city: string, country: string, email: string, name: string, state: string, street1: string, street2: string, zip: string>, delivery_date: string, notes: string, order_items: table<material_id: int, model_id: int, options: record, quantity: int, units: string>, quote: record<errors: list<string>, grand_total: float, items: float, options: record<orientation: float>, shipping: float, tax: float, total: float>, quote_id: string, shipping_service: string>
export def "post-order-create" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --models: list # item shape: {material_id?: int, model_id?: int, options?: record, quantity?: int, units?: string}
  --notes: string # Any notes about this order. This field is always returned when reading the order back.
  --shipping-address: record # shape: {city?: string, country?: string, email?: string, name?: string, state?: string, street1?: string, street2?: string, zip?: string}
  --shipping-service: string # Service identifier string pulled from a specific rate returned by /order/shipping.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/order/create"
    body: {content_type: "application/json", kind: json, fields: [{name: models, var: models}, {name: notes, var: notes}, {name: shipping_address, var: shipping_address}, {name: shipping_service, var: shipping_service}]}
    accept: ["application/json"]
    ok: [200]
    auth: api_key
  } {
    models: $models, notes: $notes, shipping_address: $shipping_address, shipping_service: $shipping_service
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

