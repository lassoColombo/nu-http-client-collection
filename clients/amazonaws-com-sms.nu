    get-app-replication-configuration: "record<serverGroupReplicationConfigurations: table<serverGroupId: string, serverReplicationConfigurations: list>>"
    get-app-validation-configuration: "record<appValidationConfigurations: table<validationId: string, name: string, appValidationStrategy: string, ssmValidationParameters: record>, serverGroupValidationConfigurations: table<serverGroupId: string, serverValidationConfigurations: list>>"
    get-app-validation-output: "record<validationOutputList: table<validationId: string, name: string, status: string, statusMessage: string, latestValidationTime: string, appValidationOutput: record, serverValidationOutput: record>>"
    get-connectors: "record<connectorList: table<connectorId: string, version: string, status: string, capabilityList: list, vmManagerName: string, vmManagerType: string, vmManagerId: string, ipAddress: string, macAddress: string, associatedOn: string>, nextToken: string>"
    get-replication-jobs: "record<replicationJobList: table<replicationJobId: string, serverId: string, serverType: string, vmServer: record, seedReplicationTime: string, frequency: int, runOnce: bool, nextReplicationRunStartTime: string, licenseType: string, roleName: string, latestAmiId: string, state: string, statusMessage: string, description: string, numberOfRecentAmisToKeep: int, encrypted: bool, kmsKeyId: string, replicationRunList: list>, nextToken: string>"
    get-replication-runs: "record<replicationJob: record<replicationJobId: string, serverId: string, serverType: string, vmServer: record<vmServerAddress: record, vmName: string, vmManagerName: string, vmManagerType: string, vmPath: string>, seedReplicationTime: string, frequency: int, runOnce: bool, nextReplicationRunStartTime: string, licenseType: string, roleName: string, latestAmiId: string, state: string, statusMessage: string, description: string, numberOfRecentAmisToKeep: int, encrypted: bool, kmsKeyId: string, replicationRunList: list<record>>, replicationRunList: table<replicationRunId: string, state: string, type: string, stageDetails: record, statusMessage: string, amiId: string, scheduledStartTime: string, completedTime: string, description: string, encrypted: bool, kmsKeyId: string>, nextToken: string>"
    get-servers: "record<lastModifiedOn: string, serverCatalogStatus: string, serverList: table<serverId: string, serverType: string, vmServer: record, replicationJobId: string, replicationJobTerminated: bool>, nextToken: string>"
    import-app-catalog: "record"
    import-server-catalog: "record"
    launch-app: "record"
    list-apps: "record<apps: table<appId: string, importedAppId: string, name: string, description: string, status: string, statusMessage: string, replicationConfigurationStatus: string, replicationStatus: string, replicationStatusMessage: string, latestReplicationTime: string, launchConfigurationStatus: string, launchStatus: string, launchStatusMessage: string, launchDetails: record, creationTime: string, lastModified: string, roleName: string, totalServerGroups: int, totalServers: int>, nextToken: string>"
    notify-app-validation-output: "record"
    put-app-launch-configuration: "record"
    put-app-replication-configuration: "record"
    put-app-validation-configuration: "record"
    start-app-replication: "record"
    start-on-demand-app-replication: "record"
    start-on-demand-replication-run: "record<replicationRunId: string>"
    stop-app-replication: "record"
    terminate-app: "record"
    update-app: "record<appSummary: record<appId: string, importedAppId: string, name: string, description: string, status: string, statusMessage: string, replicationConfigurationStatus: string, replicationStatus: string, replicationStatusMessage: string, latestReplicationTime: string, launchConfigurationStatus: string, launchStatus: string, launchStatusMessage: string, launchDetails: record<latestLaunchTime: string, stackName: string, stackId: string>, creationTime: string, lastModified: string, roleName: string, totalServerGroups: int, totalServers: int>, serverGroups: table<serverGroupId: string, name: string, serverList: list>, tags: table<key: string, value: string>>"
    update-replication-job: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-app" "create-replication-job" "delete-app" "delete-app-launch-configuration" "delete-app-replication-configuration" "delete-app-validation-configuration" "delete-replication-job" "delete-server-catalog" "disassociate-connector" "generate-change-set" "generate-template" "get-app" "get-app-launch-configuration" "get-app-replication-configuration" "get-app-validation-configuration" "get-app-validation-output" "get-connectors" "get-replication-jobs" "get-replication-runs" "get-servers" "import-app-catalog" "import-server-catalog" "launch-app" "list-apps" "notify-app-validation-output" "put-app-launch-configuration" "put-app-replication-configuration" "put-app-validation-configuration" "start-app-replication" "start-on-demand-app-replication" "start-on-demand-replication-run" "stop-app-replication" "terminate-app" "update-app" "update-replication-job" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

