# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-savings-plan: "record<savingsPlanId: string>"
    delete-queued-savings-plan: "record"
    describe-savings-plan-rates: "record<savingsPlanId: string, searchResults: table<rate: string, currency: string, unit: string, productType: string, serviceCode: string, usageType: string, operation: string, properties: any>, nextToken: string>"
    describe-savings-plans: "record<savingsPlans: table<offeringId: string, savingsPlanId: string, savingsPlanArn: string, description: string, start: string, end: string, state: string, region: string, ec2InstanceFamily: string, savingsPlanType: string, paymentOption: string, productTypes: list, currency: string, commitment: string, upfrontPaymentAmount: string, recurringPaymentAmount: string, termDurationInSeconds: int, tags: record>, nextToken: string>"
    describe-savings-plans-offering-rates: "record<searchResults: table<savingsPlanOffering: record, rate: string, unit: string, productType: string, serviceCode: string, usageType: string, operation: string, properties: any>, nextToken: string>"
    describe-savings-plans-offerings: "record<searchResults: table<offeringId: string, productTypes: list, planType: string, description: string, paymentOption: string, durationSeconds: int, currency: string, serviceCode: string, usageType: string, operation: string, properties: any>, nextToken: string>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-savings-plan" "delete-queued-savings-plan" "describe-savings-plan-rates" "describe-savings-plans" "describe-savings-plans-offering-rates" "describe-savings-plans-offerings" "list-tags-for-resource" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Creates a Savings Plan.
#
# POST /CreateSavingsPlan
# Returns: record<savingsPlanId: string>
# operationId: CreateSavingsPlan
export def "create-savings-plan" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  savings_plan_offering_id: string # The ID of the offering.
  commitment: string # The hourly commitment, in USD. This is a value between 0.001 and 1 million. You cannot specify more than five digits after the decimal point.
  --upfront-payment-amount: string # The up-front payment amount. This is a whole number between 50 and 99 percent of the total value of the Savings Plan. This parameter is supported only if the payment option is Partial Upfront.
  --purchase-time: string # The time at which to purchase the Savings Plan, in UTC format (YYYY-MM-DDTHH:MM:SSZ). (format: date-time)
  --client-token: string # Unique, case-sensitive identifier that you provide to ensure the idempotency of the request.
  --tags: record # One or more tags.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/CreateSavingsPlan"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: savingsPlanOfferingId, var: savings_plan_offering_id}, {name: commitment, var: commitment}, {name: upfrontPaymentAmount, var: upfront_payment_amount}, {name: purchaseTime, var: purchase_time}, {name: clientToken, var: client_token}, {name: tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, savings_plan_offering_id: $savings_plan_offering_id, commitment: $commitment, upfront_payment_amount: $upfront_payment_amount, purchase_time: $purchase_time, client_token: $client_token, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
