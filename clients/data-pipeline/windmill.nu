# get one Datatable table schema
#
# GET /w/{workspace}/workspaces/get_datatable_table_schema
# operationId: getDataTableTableSchema
export def "w-workspaces-get-datatable-table-schema get" [
  workspace: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --datatable-name: string
  --schema-name: string
  --table-name: string
]: nothing -> record<datatable_name: string, schema_name: string, table_name: string, columns: record> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "datatable_name" $datatable_name "scalar") (serialize-qp "schema_name" $schema_name "scalar") (serialize-qp "table_name" $table_name "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/w/($workspace)/workspaces/get_datatable_table_schema" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

