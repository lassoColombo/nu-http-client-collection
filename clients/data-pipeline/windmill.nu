# create mqtt trigger
#
# POST /w/{workspace}/mqtt_triggers/create
# operationId: createMqttTrigger
# --subscribe_topics item shape: {qos: "qos0"|"qos1"|"qos2", topic: string}
# --v3_config shape: {clean_session?: bool}
# --v5_config shape: {clean_start?: bool, topic_alias_maximum?: float, session_expiry_interval?: float}
export def "w-mqtt-triggers-create createMqttTrigger" [
  workspace: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  mqtt_resource_path: string # Path to the MQTT resource containing broker connection configuration
  subscribe_topics: list # Array of MQTT topics to subscribe to, each with topic name and QoS level — item shape: {qos: "qos0"|"qos1"|"qos2", topic: string}
  --client-id: string # MQTT client ID for this connection (nullable)
  --v3-config: record # shape: {clean_session?: bool}
