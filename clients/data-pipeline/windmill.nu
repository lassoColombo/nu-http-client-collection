# get resource interpolated (variables and resources are fully unrolled)
#
# GET /w/{workspace}/resources/get_value_interpolated/{path}
# operationId: getResourceValueInterpolated
export def "w-resources-get-value-interpolated get" [
  workspace: string
  path: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --job-id: string # job id (format: uuid)
  --allow-cache: string@bool-completer # allow getting a cached value for improved performance
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "job_id" $job_id "scalar") (serialize-qp "allow_cache" $allow_cache "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/w/($workspace)/resources/get_value_interpolated/($path)" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

