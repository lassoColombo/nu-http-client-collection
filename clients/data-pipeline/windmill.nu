# run flow preview
#
# POST /w/{workspace}/jobs/run/preview_flow
# operationId: runFlowPreview
# --restarted_from shape: {flow_job_id?: string, step_id?: string, branch_or_iteration_n?: int, flow_version?: int, branch_chosen?: record, nested?: record}
export def "w-jobs-run-preview-flow runFlowPreview" [
  workspace: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --include-header: string # List of headers's keys (separated with ',') whove value are added to the args Header's key lowercased and '-'' replaced to '_' such that 'Content-Type' becomes the 'content_type' arg key
  --invisible-to-owner: string@bool-completer # make the run invisible to the the script owner (default false)
  --job-id: string # The job id to assign to the created job. if missing, job is chosen randomly using the ULID scheme. If a job id already exists in the queue or as a completed job, the request to create one will fail (Bad Request) (format: uuid)
  --memory-id: string # memory ID for chat-enabled flows (format: uuid)
  value: any
  --path: string
  args: record # The arguments to pass to the script or flow
  --tag: string
  --restarted-from: record # shape: {flow_job_id?: string, step_id?: string, branch_or_iteration_n?: int, flow_version?: int, branch_chosen?: record, nested?: record}
  --temp-script-refs: record # Map of relative-import script path -> temp storage hash, propagated to each flow step so inline-script relative imports resolve from not-yet-deployed local content instead of the deployed script (nullable)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "include_header" $include_header "scalar") (serialize-qp "invisible_to_owner" $invisible_to_owner "scalar") (serialize-qp "job_id" $job_id "scalar") (serialize-qp "memory_id" $memory_id "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/w/($workspace)/jobs/run/preview_flow" $qp)
  let body = {value: $value, path: $path, args: $args, tag: $tag, restarted_from: $restarted_from, temp_script_refs: $temp_script_refs} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "text/plain"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

