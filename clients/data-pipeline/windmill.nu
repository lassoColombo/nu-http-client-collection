  --flow-version: int # specific flow version to use for restart (optional, uses current version if not specified)
  --nested-path: list # path of additional steps to descend into AFTER `step_id`. Each entry represents one level of nesting inside the spawned child of the previous level's container (BranchOne / sequential ForLoop iteration / Subflow). When non-empty, the actual restart point is the LAST entry's step_id. — item shape: {step_id: string, branch_or_iteration_n?: int}
