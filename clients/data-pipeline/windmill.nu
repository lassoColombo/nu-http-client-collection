# list resources
#
# GET /w/{workspace}/resources/list
# operationId: listResource
export def "w-resources-list listResource" [
  workspace: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --page: int # which page to return (start at 1, default 1)
  --per-page: int # number of items to return for a given page (default 30, max 100)
  --resource-type: string # resource_types to list from, separated by ',',
  --resource-type-exclude: string # resource_types to not list from, separated by ',',
  --path-start: string # filter resources by path prefix
  --path: string # exact path match filter
  --description: string # pattern match filter for description field (case-insensitive)
  --value: string # JSONB subset match filter using base64 encoded JSON
  --broad-filter: string # broad search across multiple fields (case-insensitive substring match)
  --label: string # Filter by label
]: nothing -> table<workspace_id: string, path: string, description: string, resource_type: string, value: any, is_oauth: bool, extra_perms: record, is_expired: bool, refresh_error: string, is_linked: bool, is_refreshed: bool, account: float, created_by: string, edited_at: string, labels: list<string>, inherited_labels: list<string>, ws_specific: bool> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "page" $page "scalar") (serialize-qp "per_page" $per_page "scalar") (serialize-qp "resource_type" $resource_type "scalar") (serialize-qp "resource_type_exclude" $resource_type_exclude "scalar") (serialize-qp "path_start" $path_start "scalar") (serialize-qp "path" $path "scalar") (serialize-qp "description" $description "scalar") (serialize-qp "value" $value "scalar") (serialize-qp "broad_filter" $broad_filter "scalar") (serialize-qp "label" $label "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/w/($workspace)/resources/list" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

