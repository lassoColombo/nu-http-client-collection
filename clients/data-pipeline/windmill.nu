# run script by hash
#
# POST /w/{workspace}/jobs/run/h/{hash}
# operationId: runScriptByHash
export def "w-jobs-run-h runScriptByHash" [
  workspace: string
  hash: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --scheduled-for: string # when to schedule this job (leave empty for immediate run) (format: date-time)
  --scheduled-in-secs: int # schedule the script to execute in the number of seconds starting now
  --skip-preprocessor: string@bool-completer # skip the preprocessor
  --parent-job: string # The parent job that is at the origin and responsible for the execution of this script if any (format: uuid)
  --tag: string # Override the tag to use
  --cache-ttl: string # Override the cache time to live (in seconds). Can not be used to disable caching, only override with a new cache ttl
  --job-id: string # The job id to assign to the created job. if missing, job is chosen randomly using the ULID scheme. If a job id already exists in the queue or as a completed job, the request to create one will fail (Bad Request) (format: uuid)
  --include-header: string # List of headers's keys (separated with ',') whove value are added to the args Header's key lowercased and '-'' replaced to '_' such that 'Content-Type' becomes the 'content_type' arg key
  --invisible-to-owner: string@bool-completer # make the run invisible to the the script owner (default false)
  --body: record
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "scheduled_for" $scheduled_for "scalar") (serialize-qp "scheduled_in_secs" $scheduled_in_secs "scalar") (serialize-qp "skip_preprocessor" $skip_preprocessor "scalar") (serialize-qp "parent_job" $parent_job "scalar") (serialize-qp "tag" $tag "scalar") (serialize-qp "cache_ttl" $cache_ttl "scalar") (serialize-qp "job_id" $job_id "scalar") (serialize-qp "include_header" $include_header "scalar") (serialize-qp "invisible_to_owner" $invisible_to_owner "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/w/($workspace)/jobs/run/h/($hash)" $qp)
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "text/plain"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

# run script preview
#
# POST /w/{workspace}/jobs/run/preview
# operationId: runScriptPreview
export def "w-jobs-run-preview runScriptPreview" [
  workspace: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --include-header: string # List of headers's keys (separated with ',') whove value are added to the args Header's key lowercased and '-'' replaced to '_' such that 'Content-Type' becomes the 'content_type' arg key
  --invisible-to-owner: string@bool-completer # make the run invisible to the the script owner (default false)
  --job-id: string # The job id to assign to the created job. if missing, job is chosen randomly using the ULID scheme. If a job id already exists in the queue or as a completed job, the request to create one will fail (Bad Request) (format: uuid)
  --content: string # The code to run
  --path: string # The path to the script
  --script-hash: string # The hash of the script
  args: record # The arguments to pass to the script or flow
  --language: string@language-completer
  --tag: string
  --kind: string@kind-completer-2
  --dedicated-worker: string@bool-completer
  --lock: string
  --flow-path: string
  --modules: record # Additional script modules keyed by relative file path (nullable)
  --temp-script-refs: record # Map of relative-import script path -> temp storage hash so the preview job resolves those imports from not-yet-deployed local content instead of the deployed script (nullable)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "include_header" $include_header "scalar") (serialize-qp "invisible_to_owner" $invisible_to_owner "scalar") (serialize-qp "job_id" $job_id "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/w/($workspace)/jobs/run/preview" $qp)
  let body = {content: $content, path: $path, script_hash: $script_hash, args: $args, language: $language, tag: $tag, kind: $kind, dedicated_worker: $dedicated_worker, lock: $lock, flow_path: $flow_path, modules: $modules, temp_script_refs: $temp_script_refs} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "text/plain"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

