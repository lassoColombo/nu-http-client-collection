#
# GET /srch/index/search/service_logs
# operationId: searchLogsIndex
export def "srch-index-search-service-logs searchLogsIndex" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --search-query: string
  --mode: string
  --worker-group: string
  --hostname: string
  --min-ts: string # format: date-time
  --max-ts: string # format: date-time
]: nothing -> record<query_parse_errors: list<string>, hits: table<dancer: string>> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "search_query" $search_query "scalar") (serialize-qp "mode" $mode "scalar") (serialize-qp "worker_group" $worker_group "scalar") (serialize-qp "hostname" $hostname "scalar") (serialize-qp "min_ts" $min_ts "scalar") (serialize-qp "max_ts" $max_ts "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/srch/index/search/service_logs" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

