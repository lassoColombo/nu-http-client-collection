# discover MCP server OAuth metadata
#
# POST /mcp/oauth/discover
# operationId: discoverMcpOAuth
export def "mcp-oauth-discover discoverMcpOAuth" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  mcp_server_url: string # URL of the MCP server to discover OAuth metadata from
]: any -> record<scopes_supported: list<string>, authorization_endpoint: string, token_endpoint: string, registration_endpoint: string, supports_dynamic_registration: bool> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base "/mcp/oauth/discover")
  let body = {mcp_server_url: $mcp_server_url} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

# start MCP OAuth popup flow
#
# GET /mcp/oauth/start
# operationId: startMcpOAuthPopup
export def "mcp-oauth-start startMcpOAuthPopup" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --mcp-server-url: string # URL of the MCP server to connect to
  --scopes: string # Comma-separated list of OAuth scopes to request
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "mcp_server_url" $mcp_server_url "scalar") (serialize-qp "scopes" $scopes "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/mcp/oauth/start" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

# MCP OAuth callback
#
# GET /mcp/oauth/callback
# operationId: mcpOAuthCallback
export def "mcp-oauth-callback mcpOAuthCallback" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --code: string # OAuth authorization code
  --state: string # CSRF state token
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "code" $code "scalar") (serialize-qp "state" $state "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/mcp/oauth/callback" $qp)
  let accept_val = "text/html"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}
