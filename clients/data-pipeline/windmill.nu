#
# GET /w/{workspace}/npm_proxy/metadata/{package}
# operationId: getNpmPackageMetadata
export def "w-npm-proxy-metadata get" [
  workspace: string
  package: string
  --base-url(-b): string@base-url-completer # API base URL
