  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  destination_configuration: record # A complex type that describes a location where recorded videos will be stored. Each member represents a type of destination configuration. For recording, you define one and only one type of destination configuration. — shape: {s3?: record}
  --name: string # Recording-configuration name. The value does not need to be unique.
  --recording-reconnect-window-seconds: int # If a broadcast disconnects and then reconnects within the specified interval, the multiple streams will be considered a single broadcast and merged together. Default: 0.
  --tags: record # Array of 1-50 maps, each of the form string:string (key:value). See Tagging Amazon Web Services Resources (https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html) for more information, including restrictions that apply to tags and "Tag naming limits and requirements"; Amazon IVS has no service-specific constraints beyond what is documented there.
  --thumbnail-configuration: record # An object representing a configuration of thumbnails for recorded video. — shape: {recordingMode?: "DISABLED"|"INTERVAL", targetIntervalSeconds?: int}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/CreateRecordingConfiguration"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: destinationConfiguration, var: destination_configuration}, {name: name, var: name}, {name: recordingReconnectWindowSeconds, var: recording_reconnect_window_seconds}, {name: tags, var: tags}, {name: thumbnailConfiguration, var: thumbnail_configuration}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, destination_configuration: $destination_configuration, name: $name, recording_reconnect_window_seconds: $recording_reconnect_window_seconds, tags: $tags, thumbnail_configuration: $thumbnail_configuration
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
