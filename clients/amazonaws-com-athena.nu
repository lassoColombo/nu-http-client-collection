# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    batch-get-named-query: "record<NamedQueries: table<Name: string, Description: string, Database: string, QueryString: string, NamedQueryId: string, WorkGroup: string>, UnprocessedNamedQueryIds: table<NamedQueryId: string, ErrorCode: string, ErrorMessage: string>>"
    batch-get-prepared-statement: "record<PreparedStatements: table<StatementName: string, QueryStatement: string, WorkGroupName: string, Description: string, LastModifiedTime: string>, UnprocessedPreparedStatementNames: table<StatementName: string, ErrorCode: string, ErrorMessage: string>>"
    batch-get-query-execution: "record<QueryExecutions: table<QueryExecutionId: string, Query: string, StatementType: string, ResultConfiguration: record, ResultReuseConfiguration: record, QueryExecutionContext: record, Status: record, Statistics: record, WorkGroup: string, EngineVersion: record, ExecutionParameters: list, SubstatementType: string>, UnprocessedQueryExecutionIds: table<QueryExecutionId: string, ErrorCode: string, ErrorMessage: string>>"
    create-data-catalog: "record"
    create-named-query: "record<NamedQueryId: string>"
    create-notebook: "record<NotebookId: string>"
    create-prepared-statement: "record"
    create-presigned-notebook-url: "record<NotebookUrl: string, AuthToken: string, AuthTokenExpirationTime: int>"
    create-work-group: "record"
    delete-data-catalog: "record"
    delete-named-query: "record"
    delete-notebook: "record"
    delete-prepared-statement: "record"
    delete-work-group: "record"
    export-notebook: "record<NotebookMetadata: record<NotebookId: string, Name: string, WorkGroup: string, CreationTime: string, Type: string, LastModifiedTime: string>, Payload: string>"
    get-calculation-execution: "record<CalculationExecutionId: string, SessionId: string, Description: string, WorkingDirectory: string, Status: record<SubmissionDateTime: string, CompletionDateTime: string, State: string, StateChangeReason: string>, Statistics: record<DpuExecutionInMillis: int, Progress: string>, Result: record<StdOutS3Uri: string, StdErrorS3Uri: string, ResultS3Uri: string, ResultType: string>>"
    get-calculation-execution-code: "record<CodeBlock: string>"
    get-calculation-execution-status: "record<Status: record<SubmissionDateTime: string, CompletionDateTime: string, State: string, StateChangeReason: string>, Statistics: record<DpuExecutionInMillis: int, Progress: string>>"
    get-data-catalog: "record<DataCatalog: record<Name: string, Description: string, Type: string, Parameters: record>>"
    get-database: "record<Database: record<Name: string, Description: string, Parameters: record>>"
    get-named-query: "record<NamedQuery: record<Name: string, Description: string, Database: string, QueryString: string, NamedQueryId: string, WorkGroup: string>>"
    get-notebook-metadata: "record<NotebookMetadata: record<NotebookId: string, Name: string, WorkGroup: string, CreationTime: string, Type: string, LastModifiedTime: string>>"
    get-prepared-statement: "record<PreparedStatement: record<StatementName: string, QueryStatement: string, WorkGroupName: string, Description: string, LastModifiedTime: string>>"
    get-query-execution: "record<QueryExecution: record<QueryExecutionId: string, Query: string, StatementType: string, ResultConfiguration: record<OutputLocation: string, EncryptionConfiguration: record, ExpectedBucketOwner: string, AclConfiguration: record>, ResultReuseConfiguration: record<ResultReuseByAgeConfiguration: record>, QueryExecutionContext: record<Database: string, Catalog: string>, Status: record<State: string, StateChangeReason: string, SubmissionDateTime: string, CompletionDateTime: string, AthenaError: record>, Statistics: record<EngineExecutionTimeInMillis: int, DataScannedInBytes: int, DataManifestLocation: string, TotalExecutionTimeInMillis: int, QueryQueueTimeInMillis: int, QueryPlanningTimeInMillis: int, ServiceProcessingTimeInMillis: int, ResultReuseInformation: record>, WorkGroup: string, EngineVersion: record<SelectedEngineVersion: string, EffectiveEngineVersion: string>, ExecutionParameters: list<string>, SubstatementType: string>>"
    get-query-results: "record<UpdateCount: int, ResultSet: record<Rows: list<record>, ResultSetMetadata: record<ColumnInfo: list>>, NextToken: string>"
    get-query-runtime-statistics: "record<QueryRuntimeStatistics: record<Timeline: record<QueryQueueTimeInMillis: int, QueryPlanningTimeInMillis: int, EngineExecutionTimeInMillis: int, ServiceProcessingTimeInMillis: int, TotalExecutionTimeInMillis: int>, Rows: record<InputRows: int, InputBytes: int, OutputBytes: int, OutputRows: int>, OutputStage: record<StageId: int, State: string, OutputBytes: int, OutputRows: int, InputBytes: int, InputRows: int, ExecutionTime: int, QueryStagePlan: record, SubStages: list>>>"
    get-session: "record<SessionId: string, Description: string, WorkGroup: string, EngineVersion: string, EngineConfiguration: record<CoordinatorDpuSize: int, MaxConcurrentDpus: int, DefaultExecutorDpuSize: int, AdditionalConfigs: record>, NotebookVersion: string, SessionConfiguration: record<ExecutionRole: string, WorkingDirectory: string, IdleTimeoutSeconds: int, EncryptionConfiguration: record<EncryptionOption: string, KmsKey: string>>, Status: record<StartDateTime: string, LastModifiedDateTime: string, EndDateTime: string, IdleSinceDateTime: string, State: string, StateChangeReason: string>, Statistics: record<DpuExecutionInMillis: int>>"
    get-session-status: "record<SessionId: string, Status: record<StartDateTime: string, LastModifiedDateTime: string, EndDateTime: string, IdleSinceDateTime: string, State: string, StateChangeReason: string>>"
    get-table-metadata: "record<TableMetadata: record<Name: string, CreateTime: string, LastAccessTime: string, TableType: string, Columns: list<record>, PartitionKeys: list<record>, Parameters: record>>"
    get-work-group: "record<WorkGroup: record<Name: string, State: string, Configuration: record<ResultConfiguration: record, EnforceWorkGroupConfiguration: bool, PublishCloudWatchMetricsEnabled: bool, BytesScannedCutoffPerQuery: int, RequesterPaysEnabled: bool, EngineVersion: record, AdditionalConfiguration: string, ExecutionRole: string, CustomerContentEncryptionConfiguration: record, EnableMinimumEncryptionConfiguration: bool>, Description: string, CreationTime: string>>"
    import-notebook: "record<NotebookId: string>"
    list-application-dpu-sizes: "record<ApplicationDPUSizes: table<ApplicationRuntimeId: string, SupportedDPUSizes: list>, NextToken: string>"
    list-calculation-executions: "record<NextToken: string, Calculations: table<CalculationExecutionId: string, Description: string, Status: record>>"
    list-data-catalogs: "record<DataCatalogsSummary: table<CatalogName: string, Type: string>, NextToken: string>"
    list-databases: "record<DatabaseList: table<Name: string, Description: string, Parameters: record>, NextToken: string>"
    list-engine-versions: "record<EngineVersions: table<SelectedEngineVersion: string, EffectiveEngineVersion: string>, NextToken: string>"
    list-executors: "record<SessionId: string, NextToken: string, ExecutorsSummary: table<ExecutorId: string, ExecutorType: string, StartDateTime: int, TerminationDateTime: int, ExecutorState: string, ExecutorSize: int>>"
    list-named-queries: "record<NamedQueryIds: list<string>, NextToken: string>"
    list-notebook-metadata: "record<NextToken: string, NotebookMetadataList: table<NotebookId: string, Name: string, WorkGroup: string, CreationTime: string, Type: string, LastModifiedTime: string>>"
    list-notebook-sessions: "record<NotebookSessionsList: table<SessionId: string, CreationTime: string>, NextToken: string>"
    list-prepared-statements: "record<PreparedStatements: table<StatementName: string, LastModifiedTime: string>, NextToken: string>"
    list-query-executions: "record<QueryExecutionIds: list<string>, NextToken: string>"
    list-sessions: "record<NextToken: string, Sessions: table<SessionId: string, Description: string, EngineVersion: record, NotebookVersion: string, Status: record>>"
    list-table-metadata: "record<TableMetadataList: table<Name: string, CreateTime: string, LastAccessTime: string, TableType: string, Columns: list, PartitionKeys: list, Parameters: record>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>, NextToken: string>"
    list-work-groups: "record<WorkGroups: table<Name: string, State: string, Description: string, CreationTime: string, EngineVersion: record>, NextToken: string>"
    start-calculation-execution: "record<CalculationExecutionId: string, State: string>"
    start-query-execution: "record<QueryExecutionId: string>"
    start-session: "record<SessionId: string, State: string>"
    stop-calculation-execution: "record<State: string>"
    stop-query-execution: "record"
    tag-resource: "record"
    terminate-session: "record<State: string>"
    untag-resource: "record"
    update-data-catalog: "record"
    update-named-query: "record"
    update-notebook: "record"
    update-notebook-metadata: "record"
    update-prepared-statement: "record"
    update-work-group: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["batch-get-named-query" "batch-get-prepared-statement" "batch-get-query-execution" "create-data-catalog" "create-named-query" "create-notebook" "create-prepared-statement" "create-presigned-notebook-url" "create-work-group" "delete-data-catalog" "delete-named-query" "delete-notebook" "delete-prepared-statement" "delete-work-group" "export-notebook" "get-calculation-execution" "get-calculation-execution-code" "get-calculation-execution-status" "get-data-catalog" "get-database" "get-named-query" "get-notebook-metadata" "get-prepared-statement" "get-query-execution" "get-query-results" "get-query-runtime-statistics" "get-session" "get-session-status" "get-table-metadata" "get-work-group" "import-notebook" "list-application-dpu-sizes" "list-calculation-executions" "list-data-catalogs" "list-databases" "list-engine-versions" "list-executors" "list-named-queries" "list-notebook-metadata" "list-notebook-sessions" "list-prepared-statements" "list-query-executions" "list-sessions" "list-table-metadata" "list-tags-for-resource" "list-work-groups" "start-calculation-execution" "start-query-execution" "start-session" "stop-calculation-execution" "stop-query-execution" "tag-resource" "terminate-session" "untag-resource" "update-data-catalog" "update-named-query" "update-notebook" "update-notebook-metadata" "update-prepared-statement" "update-work-group" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Returns the details of a single named query or a list of up to 50 queries, which you provide as an array of query ID strings. Requires you to have access to the workgroup in which the queries were saved. Use ListNamedQueriesInput to get the list of named query IDs in the specified workgroup. If information could not be retrieved for a submitted query ID, information about the query ID submitted is listed under UnprocessedNamedQueryId. Named queries differ from executed queries. Use BatchGetQueryExecutionInput to get details about each unique query execution, and ListQueryExecutionsInput to get a list of query execution IDs.
#
# POST /
# Returns: record<NamedQueries: table<Name: string, Description: string, Database: string, QueryString: string, NamedQueryId: string, WorkGroup: string>, UnprocessedNamedQueryIds: table<NamedQueryId: string, ErrorCode: string, ErrorMessage: string>>
# operationId: BatchGetNamedQuery
export def "batch-get-named-query" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  named_query_ids: list<string> # An array of query IDs.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "AmazonAthena.BatchGetNamedQuery"}]
    body: {content_type: "application/json", kind: json, fields: [{name: NamedQueryIds, var: named_query_ids}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, named_query_ids: $named_query_ids
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Returns the details of a single prepared statement or a list of up to 256 prepared statements for the array of prepared statement names that you provide. Requires you to have access to the workgroup to which the prepared statements belong. If a prepared statement cannot be retrieved for the name specified, the statement is listed in UnprocessedPreparedStatementNames.
#
# POST /
# Returns: record<PreparedStatements: table<StatementName: string, QueryStatement: string, WorkGroupName: string, Description: string, LastModifiedTime: string>, UnprocessedPreparedStatementNames: table<StatementName: string, ErrorCode: string, ErrorMessage: string>>
# operationId: BatchGetPreparedStatement
export def "batch-get-prepared-statement" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-1 # required
  prepared_statement_names: list<string> # A list of prepared statement names to return.
  work_group: string # The name of the workgroup to which the prepared statements belong.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
