# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-delegate-to-resource: "record"
    associate-member-to-group: "record"
    assume-impersonation-role: "record<Token: string, ExpiresIn: int>"
    cancel-mailbox-export-job: "record"
    create-alias: "record"
    create-availability-configuration: "record"
    create-group: "record<GroupId: string>"
    create-impersonation-role: "record<ImpersonationRoleId: string>"
    create-mobile-device-access-rule: "record<MobileDeviceAccessRuleId: string>"
    create-organization: "record<OrganizationId: string>"
    create-resource: "record<ResourceId: string>"
    create-user: "record<UserId: string>"
    delete-access-control-rule: "record"
    delete-alias: "record"
    delete-availability-configuration: "record"
    delete-email-monitoring-configuration: "record"
    delete-group: "record"
    delete-impersonation-role: "record"
    delete-mailbox-permissions: "record"
    delete-mobile-device-access-override: "record"
    delete-mobile-device-access-rule: "record"
    delete-organization: "record<OrganizationId: string, State: string>"
    delete-resource: "record"
    delete-retention-policy: "record"
    delete-user: "record"
    deregister-from-work-mail: "record"
    deregister-mail-domain: "record"
    describe-email-monitoring-configuration: "record<RoleArn: string, LogGroupArn: string>"
    describe-group: "record<GroupId: string, Name: string, Email: string, State: string, EnabledDate: string, DisabledDate: string>"
    describe-inbound-dmarc-settings: "record<Enforced: bool>"
    describe-mailbox-export-job: "record<EntityId: string, Description: string, RoleArn: string, KmsKeyArn: string, S3BucketName: string, S3Prefix: string, S3Path: string, EstimatedProgress: int, State: string, ErrorInfo: string, StartTime: string, EndTime: string>"
    describe-organization: "record<OrganizationId: string, Alias: string, State: string, DirectoryId: string, DirectoryType: string, DefaultMailDomain: string, CompletedDate: string, ErrorMessage: string, ARN: string>"
    describe-resource: "record<ResourceId: string, Email: string, Name: string, Type: string, BookingOptions: record<AutoAcceptRequests: bool, AutoDeclineRecurringRequests: bool, AutoDeclineConflictingRequests: bool>, State: string, EnabledDate: string, DisabledDate: string>"
    describe-user: "record<UserId: string, Name: string, Email: string, DisplayName: string, State: string, UserRole: string, EnabledDate: string, DisabledDate: string>"
    disassociate-delegate-from-resource: "record"
    disassociate-member-from-group: "record"
    get-access-control-effect: "record<Effect: string, MatchedRules: list<string>>"
    get-default-retention-policy: "record<Id: string, Name: string, Description: string, FolderConfigurations: table<Name: string, Action: string, Period: int>>"
    get-impersonation-role: "record<ImpersonationRoleId: string, Name: string, Type: string, Description: string, Rules: table<ImpersonationRuleId: string, Name: string, Description: string, Effect: string, TargetUsers: list, NotTargetUsers: list>, DateCreated: string, DateModified: string>"
    get-impersonation-role-effect: "record<Type: string, Effect: string, MatchedRules: table<ImpersonationRuleId: string, Name: string>>"
    get-mail-domain: "record<Records: table<Type: string, Hostname: string, Value: string>, IsTestDomain: bool, IsDefault: bool, OwnershipVerificationStatus: string, DkimVerificationStatus: string>"
    get-mailbox-details: "record<MailboxQuota: int, MailboxSize: float>"
    get-mobile-device-access-effect: "record<Effect: string, MatchedRules: table<MobileDeviceAccessRuleId: string, Name: string>>"
    get-mobile-device-access-override: "record<UserId: string, DeviceId: string, Effect: string, Description: string, DateCreated: string, DateModified: string>"
    list-access-control-rules: "record<Rules: table<Name: string, Effect: string, Description: string, IpRanges: list, NotIpRanges: list, Actions: list, NotActions: list, UserIds: list, NotUserIds: list, DateCreated: string, DateModified: string, ImpersonationRoleIds: list, NotImpersonationRoleIds: list>>"
    list-aliases: "record<Aliases: list<string>, NextToken: string>"
    list-availability-configurations: "record<AvailabilityConfigurations: table<DomainName: string, ProviderType: string, EwsProvider: record, LambdaProvider: record, DateCreated: string, DateModified: string>, NextToken: string>"
    list-group-members: "record<Members: table<Id: string, Name: string, Type: string, State: string, EnabledDate: string, DisabledDate: string>, NextToken: string>"
    list-groups: "record<Groups: table<Id: string, Email: string, Name: string, State: string, EnabledDate: string, DisabledDate: string>, NextToken: string>"
    list-impersonation-roles: "record<Roles: table<ImpersonationRoleId: string, Name: string, Type: string, DateCreated: string, DateModified: string>, NextToken: string>"
    list-mail-domains: "record<MailDomains: table<DomainName: string, DefaultDomain: bool>, NextToken: string>"
    list-mailbox-export-jobs: "record<Jobs: table<JobId: string, EntityId: string, Description: string, S3BucketName: string, S3Path: string, EstimatedProgress: int, State: string, StartTime: string, EndTime: string>, NextToken: string>"
    list-mailbox-permissions: "record<Permissions: table<GranteeId: string, GranteeType: string, PermissionValues: list>, NextToken: string>"
    list-mobile-device-access-overrides: "record<Overrides: table<UserId: string, DeviceId: string, Effect: string, Description: string, DateCreated: string, DateModified: string>, NextToken: string>"
    list-mobile-device-access-rules: "record<Rules: table<MobileDeviceAccessRuleId: string, Name: string, Description: string, Effect: string, DeviceTypes: list, NotDeviceTypes: list, DeviceModels: list, NotDeviceModels: list, DeviceOperatingSystems: list, NotDeviceOperatingSystems: list, DeviceUserAgents: list, NotDeviceUserAgents: list, DateCreated: string, DateModified: string>>"
    list-organizations: "record<OrganizationSummaries: table<OrganizationId: string, Alias: string, DefaultMailDomain: string, ErrorMessage: string, State: string>, NextToken: string>"
    list-resource-delegates: "record<Delegates: table<Id: string, Type: string>, NextToken: string>"
    list-resources: "record<Resources: table<Id: string, Email: string, Name: string, Type: string, State: string, EnabledDate: string, DisabledDate: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    list-users: "record<Users: table<Id: string, Email: string, Name: string, DisplayName: string, State: string, UserRole: string, EnabledDate: string, DisabledDate: string>, NextToken: string>"
    put-access-control-rule: "record"
    put-email-monitoring-configuration: "record"
    put-inbound-dmarc-settings: "record"
    put-mailbox-permissions: "record"
    put-mobile-device-access-override: "record"
    put-retention-policy: "record"
    register-mail-domain: "record"
    register-to-work-mail: "record"
    reset-password: "record"
    start-mailbox-export-job: "record<JobId: string>"
    tag-resource: "record"
    test-availability-configuration: "record<TestPassed: bool, FailureReason: string>"
    untag-resource: "record"
    update-availability-configuration: "record"
    update-default-mail-domain: "record"
    update-impersonation-role: "record"
    update-mailbox-quota: "record"
    update-mobile-device-access-rule: "record"
    update-primary-email-address: "record"
    update-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-delegate-to-resource" "associate-member-to-group" "assume-impersonation-role" "cancel-mailbox-export-job" "create-alias" "create-availability-configuration" "create-group" "create-impersonation-role" "create-mobile-device-access-rule" "create-organization" "create-resource" "create-user" "delete-access-control-rule" "delete-alias" "delete-availability-configuration" "delete-email-monitoring-configuration" "delete-group" "delete-impersonation-role" "delete-mailbox-permissions" "delete-mobile-device-access-override" "delete-mobile-device-access-rule" "delete-organization" "delete-resource" "delete-retention-policy" "delete-user" "deregister-from-work-mail" "deregister-mail-domain" "describe-email-monitoring-configuration" "describe-group" "describe-inbound-dmarc-settings" "describe-mailbox-export-job" "describe-organization" "describe-resource" "describe-user" "disassociate-delegate-from-resource" "disassociate-member-from-group" "get-access-control-effect" "get-default-retention-policy" "get-impersonation-role" "get-impersonation-role-effect" "get-mail-domain" "get-mailbox-details" "get-mobile-device-access-effect" "get-mobile-device-access-override" "list-access-control-rules" "list-aliases" "list-availability-configurations" "list-group-members" "list-groups" "list-impersonation-roles" "list-mail-domains" "list-mailbox-export-jobs" "list-mailbox-permissions" "list-mobile-device-access-overrides" "list-mobile-device-access-rules" "list-organizations" "list-resource-delegates" "list-resources" "list-tags-for-resource" "list-users" "put-access-control-rule" "put-email-monitoring-configuration" "put-inbound-dmarc-settings" "put-mailbox-permissions" "put-mobile-device-access-override" "put-retention-policy" "register-mail-domain" "register-to-work-mail" "reset-password" "start-mailbox-export-job" "tag-resource" "test-availability-configuration" "untag-resource" "update-availability-configuration" "update-default-mail-domain" "update-impersonation-role" "update-mailbox-quota" "update-mobile-device-access-rule" "update-primary-email-address" "update-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Adds a member (user or group) to the resource's set of delegates.
#
# POST /
# Returns: record
# operationId: AssociateDelegateToResource
export def "associate-delegate-to-resource" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  organization_id: string # The organization under which the resource exists.
  resource_id: string # The resource for which members (users or groups) are associated.
  entity_id: string # The member (user or group) to associate to the resource.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "WorkMailService.AssociateDelegateToResource"}]
    body: {content_type: "application/json", kind: json, fields: [{name: OrganizationId, var: organization_id}, {name: ResourceId, var: resource_id}, {name: EntityId, var: entity_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, organization_id: $organization_id, resource_id: $resource_id, entity_id: $entity_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Adds a member (user or group) to the group's set.
#
# POST /
# Returns: record
# operationId: AssociateMemberToGroup
export def "associate-member-to-group" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
