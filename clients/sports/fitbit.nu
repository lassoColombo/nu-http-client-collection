# Log Activity
#
# POST /1/user/-/activities.json
# operationId: addActivitiesLog
export def "1-user-activitiesjson addActivitiesLog" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --activityId: int # The ID of the activity, directory activity or intensity level activity.
  --activityName: string # Custom activity name. Either activityId or activityName must be provided.
  --manualCalories: int # Calories burned that are manaully specified. Required with activityName must be provided.
  --startTime: string # Activity start time. Hours and minutes in the format HH:mm:ss.
  --durationMillis: int # Duration in milliseconds.
  --date: string # Log entry date in the format yyyy-MM-dd. (format: date)
  --distance: int # Distance is required for logging directory activity in the format X.XX and in the selected distanceUnit.
  --distanceUnit: int # Distance measurement unit. Steps units are available only for Walking (activityId=90013) and Running (activityId=90009) directory activities and their intensity levels.
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "activityId" $activityId "scalar") (serialize-qp "activityName" $activityName "scalar") (serialize-qp "manualCalories" $manualCalories "scalar") (serialize-qp "startTime" $startTime "scalar") (serialize-qp "durationMillis" $durationMillis "scalar") (serialize-qp "date" $date "scalar") (serialize-qp "distance" $distance "scalar") (serialize-qp "distanceUnit" $distanceUnit "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/1/user/-/activities.json" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

