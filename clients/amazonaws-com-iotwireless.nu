    accept: ["application/json"]
    ok: [204]
    auth: bearer
  } {
    id: $id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, name: $name, description: $description, lo_ra_wan: $lo_ra_wan, firmware_update_image: $firmware_update_image, firmware_update_role: $firmware_update_role, redundancy_percent: $redundancy_percent, fragment_size_bytes: $fragment_size_bytes, fragment_interval_ms: $fragment_interval_ms
