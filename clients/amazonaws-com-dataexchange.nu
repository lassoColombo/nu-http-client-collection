    start-job: "record"
    create-data-set: "record<Arn: string, AssetType: string, CreatedAt: string, Description: string, Id: string, Name: string, Origin: string, OriginDetails: record<ProductId: string>, SourceId: string, Tags: record, UpdatedAt: string>"
    list-data-sets: "record<DataSets: table<Arn: string, AssetType: string, CreatedAt: string, Description: string, Id: string, Name: string, Origin: string, OriginDetails: record, SourceId: string, UpdatedAt: string>, NextToken: string>"
    create-event-action: "record<Action: record<ExportRevisionToS3: record<Encryption: record, RevisionDestination: record>>, Arn: string, CreatedAt: string, Event: record<RevisionPublished: record<DataSetId: string>>, Id: string, UpdatedAt: string>"
    list-event-actions: "record<EventActions: table<Action: record, Arn: string, CreatedAt: string, Event: record, Id: string, UpdatedAt: string>, NextToken: string>"
    create-job: "record<Arn: string, CreatedAt: string, Details: record<ExportAssetToSignedUrl: record<AssetId: string, DataSetId: string, RevisionId: string, SignedUrl: string, SignedUrlExpiresAt: string>, ExportAssetsToS3: record<AssetDestinations: list, DataSetId: string, Encryption: record, RevisionId: string>, ExportRevisionsToS3: record<DataSetId: string, Encryption: record, RevisionDestinations: list, EventActionArn: string>, ImportAssetFromSignedUrl: record<AssetName: string, DataSetId: string, Md5Hash: string, RevisionId: string, SignedUrl: string, SignedUrlExpiresAt: string>, ImportAssetsFromS3: record<AssetSources: list, DataSetId: string, RevisionId: string>, ImportAssetsFromRedshiftDataShares: record<AssetSources: list, DataSetId: string, RevisionId: string>, ImportAssetFromApiGatewayApi: record<ApiDescription: string, ApiId: string, ApiKey: string, ApiName: string, ApiSpecificationMd5Hash: string, ApiSpecificationUploadUrl: string, ApiSpecificationUploadUrlExpiresAt: string, DataSetId: string, ProtocolType: string, RevisionId: string, Stage: string>, CreateS3DataAccessFromS3Bucket: record<AssetSource: record, DataSetId: string, RevisionId: string>, ImportAssetsFromLakeFormationTagPolicy: record<CatalogId: string, Database: record, Table: record, RoleArn: string, DataSetId: string, RevisionId: string>>, Errors: table<Code: string, Details: record, LimitName: string, LimitValue: float, Message: string, ResourceId: string, ResourceType: string>, Id: string, State: string, Type: string, UpdatedAt: string>"
