    create-revision: "record<Arn: string, Comment: string, CreatedAt: string, DataSetId: string, Finalized: bool, Id: string, SourceId: string, Tags: record, UpdatedAt: string, RevocationComment: string, Revoked: bool, RevokedAt: string>"
    list-data-set-revisions: "record<NextToken: string, Revisions: table<Arn: string, Comment: string, CreatedAt: string, DataSetId: string, Finalized: bool, Id: string, SourceId: string, UpdatedAt: string, RevocationComment: string, Revoked: bool, RevokedAt: string>>"
    get-asset: "record<Arn: string, AssetDetails: record<S3SnapshotAsset: record<Size: float>, RedshiftDataShareAsset: record<Arn: string>, ApiGatewayApiAsset: record<ApiDescription: string, ApiEndpoint: string, ApiId: string, ApiKey: string, ApiName: string, ApiSpecificationDownloadUrl: string, ApiSpecificationDownloadUrlExpiresAt: string, ProtocolType: string, Stage: string>, S3DataAccessAsset: record<Bucket: string, KeyPrefixes: list, Keys: list, S3AccessPointAlias: string, S3AccessPointArn: string, KmsKeysToGrant: list>, LakeFormationDataPermissionAsset: record<LakeFormationDataPermissionDetails: record, LakeFormationDataPermissionType: string, Permissions: list, RoleArn: string>>, AssetType: string, CreatedAt: string, DataSetId: string, Id: string, Name: string, RevisionId: string, SourceId: string, UpdatedAt: string>"
    update-asset: "record<Arn: string, AssetDetails: record<S3SnapshotAsset: record<Size: float>, RedshiftDataShareAsset: record<Arn: string>, ApiGatewayApiAsset: record<ApiDescription: string, ApiEndpoint: string, ApiId: string, ApiKey: string, ApiName: string, ApiSpecificationDownloadUrl: string, ApiSpecificationDownloadUrlExpiresAt: string, ProtocolType: string, Stage: string>, S3DataAccessAsset: record<Bucket: string, KeyPrefixes: list, Keys: list, S3AccessPointAlias: string, S3AccessPointArn: string, KmsKeysToGrant: list>, LakeFormationDataPermissionAsset: record<LakeFormationDataPermissionDetails: record, LakeFormationDataPermissionType: string, Permissions: list, RoleArn: string>>, AssetType: string, CreatedAt: string, DataSetId: string, Id: string, Name: string, RevisionId: string, SourceId: string, UpdatedAt: string>"
    get-data-set: "record<Arn: string, AssetType: string, CreatedAt: string, Description: string, Id: string, Name: string, Origin: string, OriginDetails: record<ProductId: string>, SourceId: string, Tags: record, UpdatedAt: string>"
    update-data-set: "record<Arn: string, AssetType: string, CreatedAt: string, Description: string, Id: string, Name: string, Origin: string, OriginDetails: record<ProductId: string>, SourceId: string, UpdatedAt: string>"
    get-event-action: "record<Action: record<ExportRevisionToS3: record<Encryption: record, RevisionDestination: record>>, Arn: string, CreatedAt: string, Event: record<RevisionPublished: record<DataSetId: string>>, Id: string, UpdatedAt: string>"
    update-event-action: "record<Action: record<ExportRevisionToS3: record<Encryption: record, RevisionDestination: record>>, Arn: string, CreatedAt: string, Event: record<RevisionPublished: record<DataSetId: string>>, Id: string, UpdatedAt: string>"
    get-revision: "record<Arn: string, Comment: string, CreatedAt: string, DataSetId: string, Finalized: bool, Id: string, SourceId: string, Tags: record, UpdatedAt: string, RevocationComment: string, Revoked: bool, RevokedAt: string>"
    update-revision: "record<Arn: string, Comment: string, CreatedAt: string, DataSetId: string, Finalized: bool, Id: string, SourceId: string, UpdatedAt: string, RevocationComment: string, Revoked: bool, RevokedAt: string>"
    list-revision-assets: "record<Assets: table<Arn: string, AssetDetails: record, AssetType: string, CreatedAt: string, DataSetId: string, Id: string, Name: string, RevisionId: string, SourceId: string, UpdatedAt: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    revoke-revision: "record<Arn: string, Comment: string, CreatedAt: string, DataSetId: string, Finalized: bool, Id: string, SourceId: string, UpdatedAt: string, RevocationComment: string, Revoked: bool, RevokedAt: string>"
    send-api-asset: "record<Body: string, ResponseHeaders: record>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["cancel-job" "get-job" "start-job" "create-data-set" "list-data-sets" "create-event-action" "list-event-actions" "create-job" "list-jobs" "create-revision" "list-data-set-revisions" "delete-asset" "get-asset" "update-asset" "delete-data-set" "get-data-set" "update-data-set" "delete-event-action" "get-event-action" "update-event-action" "delete-revision" "get-revision" "update-revision" "list-revision-assets" "list-tags-for-resource" "tag-resource" "revoke-revision" "send-api-asset" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# This operation cancels a job. Jobs can be cancelled only when they are in the WAITING state.
#
# DELETE /v1/jobs/{JobId}
# operationId: CancelJob
export def "cancel-job" [
  job_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> any {
  http-request {
    method: delete
    path: "/v1/jobs/{JobId}"
    path_params: [{name: JobId, var: job_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    accept: ["application/json"]
    ok: [204]
    auth: bearer
  } {
    job_id: $job_id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

