# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-accessor: "record<AccessorId: string, BillingToken: string>"
    list-accessors: "record<Accessors: table<Id: string, Type: string, Status: string, CreationDate: string, Arn: string>, NextToken: string>"
    create-member: "record<MemberId: string>"
    list-members: "record<Members: table<Id: string, Name: string, Description: string, Status: string, CreationDate: string, IsOwned: bool, Arn: string>, NextToken: string>"
    create-network: "record<NetworkId: string, MemberId: string>"
    list-networks: "record<Networks: table<Id: string, Name: string, Description: string, Framework: string, FrameworkVersion: string, Status: string, CreationDate: string, Arn: string>, NextToken: string>"
    create-node: "record<NodeId: string>"
    list-nodes: "record<Nodes: table<Id: string, Status: string, CreationDate: string, AvailabilityZone: string, InstanceType: string, Arn: string>, NextToken: string>"
    create-proposal: "record<ProposalId: string>"
    list-proposals: "record<Proposals: table<ProposalId: string, Description: string, ProposedByMemberId: string, ProposedByMemberName: string, Status: string, CreationDate: string, ExpirationDate: string, Arn: string>, NextToken: string>"
    delete-accessor: "record"
    get-accessor: "record<Accessor: record<Id: string, Type: string, BillingToken: string, Status: string, CreationDate: string, Arn: string, Tags: record>>"
    delete-member: "record"
    get-member: "record<Member: record<NetworkId: string, Id: string, Name: string, Description: string, FrameworkAttributes: record<Fabric: record>, LogPublishingConfiguration: record<Fabric: record>, Status: string, CreationDate: string, Tags: record, Arn: string, KmsKeyArn: string>>"
    update-member: "record"
    delete-node: "record"
    get-node: "record<Node: record<NetworkId: string, MemberId: string, Id: string, InstanceType: string, AvailabilityZone: string, FrameworkAttributes: record<Fabric: record, Ethereum: record>, LogPublishingConfiguration: record<Fabric: record>, StateDB: string, Status: string, CreationDate: string, Tags: record, Arn: string, KmsKeyArn: string>>"
    update-node: "record"
    get-network: "record<Network: record<Id: string, Name: string, Description: string, Framework: string, FrameworkVersion: string, FrameworkAttributes: record<Fabric: record, Ethereum: record>, VpcEndpointServiceName: string, VotingPolicy: record<ApprovalThresholdPolicy: record>, Status: string, CreationDate: string, Tags: record, Arn: string>>"
    get-proposal: "record<Proposal: record<ProposalId: string, NetworkId: string, Description: string, Actions: record<Invitations: list, Removals: list>, ProposedByMemberId: string, ProposedByMemberName: string, Status: string, CreationDate: string, ExpirationDate: string, YesVoteCount: int, NoVoteCount: int, OutstandingVoteCount: int, Tags: record, Arn: string>>"
    list-invitations: "record<Invitations: table<InvitationId: string, CreationDate: string, ExpirationDate: string, Status: string, NetworkSummary: record, Arn: string>, NextToken: string>"
    list-proposal-votes: "record<ProposalVotes: table<Vote: string, MemberName: string, MemberId: string>, NextToken: string>"
    vote-on-proposal: "record"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    reject-invitation: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-accessor" "list-accessors" "create-member" "list-members" "create-network" "list-networks" "create-node" "list-nodes" "create-proposal" "list-proposals" "delete-accessor" "get-accessor" "delete-member" "get-member" "update-member" "delete-node" "get-node" "update-node" "get-network" "get-proposal" "list-invitations" "list-proposal-votes" "vote-on-proposal" "list-tags-for-resource" "tag-resource" "reject-invitation" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Creates a new accessor for use with Managed Blockchain Ethereum nodes. An accessor contains information required for token based access to your Ethereum nodes.
#
# POST /accessors
# Returns: record<AccessorId: string, BillingToken: string>
# operationId: CreateAccessor
export def "create-accessor" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  client_request_token: string # This is a unique, case-sensitive identifier that you provide to ensure the idempotency of the operation. An idempotent operation completes no more than once. This identifier is required only if you make a service request directly using an HTTP client. It is generated automatically if you use an Amazon Web Services SDK or the Amazon Web Services CLI.
  accessor_type: string@accessor-type-completer # The type of accessor. Currently, accessor type is restricted to BILLING_TOKEN.
  --tags: record # Tags to assign to the Accessor. Each tag consists of a key and an optional value. You can specify multiple key-value pairs in a single request with an overall maximum of 50 tags allowed per resource. For more information about tags, see Tagging Resources (https://docs.aws.amazon.com/managed-blockchain/latest/ethereum-dev/tagging-resources.html) in the Amazon Managed Blockchain Ethereum Developer Guide, or Tagging Resources (https://docs.aws.amazon.com/managed-blockchain/latest/hyperledger-fabric-dev/tagging-resources.html) in the Amazon Managed Blockchain Hyperledger Fabric Developer Guide.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/accessors"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: ClientRequestToken, var: client_request_token}, {name: AccessorType, var: accessor_type}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, client_request_token: $client_request_token, accessor_type: $accessor_type, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Returns a list of the accessors and their properties. Accessor objects are containers that have the information required for token based access to your Ethereum nodes.
#
# GET /accessors
# Returns: record<Accessors: table<Id: string, Type: string, Status: string, CreationDate: string, Arn: string>, NextToken: string>
# operationId: ListAccessors
export def "list-accessors" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --max-results: int # The maximum number of accessors to list.
  --next-token: string # The pagination token that indicates the next set of results to retrieve.
  --qp-max-results: string # Pagination limit (spec name: MaxResults)
  --qp-next-token: string # Pagination token (spec name: NextToken)
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/accessors"
    query: [{name: maxResults, var: max_results}, {name: nextToken, var: next_token}, {name: MaxResults, var: qp_max_results}, {name: NextToken, var: qp_next_token}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    max_results: $max_results, next_token: $next_token, qp_max_results: $qp_max_results, qp_next_token: $qp_next_token, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

