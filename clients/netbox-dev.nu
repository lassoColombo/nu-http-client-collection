# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    circuits-circuit-terminations-list: "record<count: int, next: string, previous: string, results: table<_occupied: bool, cable: record, cable_end: string, circuit: record, created: string, custom_fields: record, description: string, display: string, id: int, last_updated: string, link_peers: list, link_peers_type: string, mark_connected: bool, port_speed: int, pp_info: string, provider_network: record, site: record, tags: list, term_side: string, upstream_speed: int, url: string, xconnect_id: string>>"
    circuits-circuit-terminations-bulk-partial-update: "record<_occupied: bool, cable: record<display: string, id: int, label: string, url: string>, cable_end: string, circuit: record<cid: string, display: string, id: int, url: string>, created: string, custom_fields: record, description: string, display: string, id: int, last_updated: string, link_peers: list<string>, link_peers_type: string, mark_connected: bool, port_speed: int, pp_info: string, provider_network: record<display: string, id: int, name: string, url: string>, site: record<display: string, id: int, name: string, slug: string, url: string>, tags: table<color: string, display: string, id: int, name: string, slug: string, url: string>, term_side: string, upstream_speed: int, url: string, xconnect_id: string>"
