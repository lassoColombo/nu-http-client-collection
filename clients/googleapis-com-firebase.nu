# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    firebase-available-projects-list: "record<nextPageToken: string, projectInfo: table<displayName: string, locationId: string, project: string>>"
    firebase-projects-list: "record<nextPageToken: string, results: table<annotations: record, displayName: string, etag: string, name: string, projectId: string, projectNumber: string, resources: record, state: string>>"
    firebase-projects-android-apps-sha-delete: "record"
    firebase-projects-web-apps-get-config: "record<apiKey: string, appId: string, authDomain: string, databaseURL: string, locationId: string, measurementId: string, messagingSenderId: string, projectId: string, storageBucket: string>"
    firebase-projects-web-apps-patch: "record<apiKeyId: string, appId: string, appUrls: list<string>, displayName: string, etag: string, expireTime: string, name: string, projectId: string, state: string, webId: string>"
    firebase-projects-web-apps-remove: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-web-apps-undelete: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-android-apps-list: "record<apps: table<apiKeyId: string, appId: string, displayName: string, etag: string, expireTime: string, name: string, packageName: string, projectId: string, sha1Hashes: list, sha256Hashes: list, state: string>, nextPageToken: string>"
    firebase-projects-android-apps-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-available-locations-list: "record<locations: table<features: list, locationId: string, type: string>, nextPageToken: string>"
    firebase-projects-default-location-finalize: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-ios-apps-list: "record<apps: table<apiKeyId: string, appId: string, appStoreId: string, bundleId: string, displayName: string, etag: string, expireTime: string, name: string, projectId: string, state: string, teamId: string>, nextPageToken: string>"
    firebase-projects-ios-apps-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-android-apps-sha-list: "record<certificates: table<certType: string, name: string, shaHash: string>>"
    firebase-projects-android-apps-sha-create: "record<certType: string, name: string, shaHash: string>"
    firebase-projects-web-apps-list: "record<apps: table<apiKeyId: string, appId: string, appUrls: list, displayName: string, etag: string, expireTime: string, name: string, projectId: string, state: string, webId: string>, nextPageToken: string>"
    firebase-projects-web-apps-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-add-google-analytics: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebase-projects-remove-analytics: "record"
    firebase-projects-search-apps: "record<apps: table<apiKeyId: string, appId: string, displayName: string, expireTime: string, name: string, namespace: string, platform: string, state: string>, nextPageToken: string>"
    firebase-projects-add-firebase: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["firebase-available-projects-list" "firebase-projects-list" "firebase-projects-android-apps-sha-delete" "firebase-projects-web-apps-get-config" "firebase-projects-web-apps-patch" "firebase-projects-web-apps-remove" "firebase-projects-web-apps-undelete" "firebase-projects-android-apps-list" "firebase-projects-android-apps-create" "firebase-projects-available-locations-list" "firebase-projects-default-location-finalize" "firebase-projects-ios-apps-list" "firebase-projects-ios-apps-create" "firebase-projects-android-apps-sha-list" "firebase-projects-android-apps-sha-create" "firebase-projects-web-apps-list" "firebase-projects-web-apps-create" "firebase-projects-add-google-analytics" "firebase-projects-remove-analytics" "firebase-projects-search-apps" "firebase-projects-add-firebase" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

