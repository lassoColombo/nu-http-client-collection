# Represents a sorted list of changesets, newest first.
#
# GET /rest-service/repositories-v1/changes/{repository}/{path}
# operationId: changes
export def "changes" [
  repository: string
  path: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --oldest-csid: string # only return change sets after this change set. If omitted there is no restriction.
  --include-oldest: oneof<nothing, bool> # include the change set with id "from" in the change sets returned.
  --newest-csid: string # only return change sets before this change set. If omitted there is no restriction.
  --include-newest: oneof<nothing, bool> # include the change set with id "to" in the change sets returned.
  --max: int # return only the newest change sets, to a maximum of maxChangesets. (format: int32)
]: nothing -> any {
  http-request {
    method: get
    path: "/rest-service/repositories-v1/changes/{repository}/{path}"
    path_params: [{name: repository, var: repository}, {name: path, var: path}]
    query: [{name: oldestCsid, var: oldest_csid}, {name: includeOldest, var: include_oldest}, {name: newestCsid, var: newest_csid}, {name: includeNewest, var: include_newest}, {name: max, var: max}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    repository: $repository, path: $path, oldest_csid: $oldest_csid, include_oldest: $include_oldest, newest_csid: $newest_csid, include_newest: $include_newest, max: $max
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

