    describe-account-assignment-deletion-status: "record<AccountAssignmentDeletionStatus: record<Status: string, RequestId: string, FailureReason: string, TargetId: string, TargetType: string, PermissionSetArn: string, PrincipalType: string, PrincipalId: string, CreatedDate: string>>"
    describe-instance-access-control-attribute-configuration: "record<Status: string, StatusReason: string, InstanceAccessControlAttributeConfiguration: record<AccessControlAttributes: list<record>>>"
    describe-permission-set: "record<PermissionSet: record<Name: string, PermissionSetArn: string, Description: string, CreatedDate: string, SessionDuration: string, RelayState: string>>"
    describe-permission-set-provisioning-status: "record<PermissionSetProvisioningStatus: record<Status: string, RequestId: string, AccountId: string, PermissionSetArn: string, FailureReason: string, CreatedDate: string>>"
    detach-customer-managed-policy-reference-from-permission-set: "record"
    detach-managed-policy-from-permission-set: "record"
    get-inline-policy-for-permission-set: "record<InlinePolicy: string>"
    get-permissions-boundary-for-permission-set: "record<PermissionsBoundary: record<CustomerManagedPolicyReference: record<Name: string, Path: string>, ManagedPolicyArn: string>>"
    list-account-assignment-creation-status: "record<AccountAssignmentsCreationStatus: table<Status: string, RequestId: string, CreatedDate: string>, NextToken: string>"
    list-account-assignment-deletion-status: "record<AccountAssignmentsDeletionStatus: table<Status: string, RequestId: string, CreatedDate: string>, NextToken: string>"
    list-account-assignments: "record<AccountAssignments: table<AccountId: string, PermissionSetArn: string, PrincipalType: string, PrincipalId: string>, NextToken: string>"
