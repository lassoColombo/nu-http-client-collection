# Active subscriptions for the given topic
#
# GET /.well-known/mercure/subscriptions/{topic}
# Docs: https://mercure.rocks/spec#subscription-api — Subscription API
export def "well-known-mercure-subscriptions get-by-topic" [
  topic: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
]: nothing -> record<_context: string, id: string, lastEventID: string, subscriptions: table<_context: string, active: bool, id: string, lastEventID: string, payload: record, subscriber: string, topic: string, type: string>, type: string> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($topic | is-empty) { error make --unspanned { msg: "path parameter 'topic' must be non-empty" } }
  let full_url = (build-url $base ({topic: (encode-path-segment $topic)} | format pattern "/.well-known/mercure/subscriptions/{topic}") $auth.query)
  let accept_val = "application/ld+json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let req = {
    method: "get"
    url: $full_url
    query: {}
    headers: $auth.headers
    body: null
    content_type: null
    timeout: ($max_time | default 30min)
    auth: {scheme: $auth.scheme, location: $auth.location}
  }
  if $dry_run { return ({dry_run: true} | merge $req) }
  send-get $req $insecure $raw $allow_errors $full [200]
}

# Active subscription for the given topic and subscriber
#
# GET /.well-known/mercure/subscriptions/{topic}/{subscriber}
# Docs: https://mercure.rocks/spec#active-subscriptions — Subscription API
export def "well-known-mercure-subscriptions get-by-topic-subscriber" [
  topic: string
  subscriber: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
]: nothing -> record<_context: string, id: string, lastEventID: string, subscriptions: table<_context: string, active: bool, id: string, lastEventID: string, payload: record, subscriber: string, topic: string, type: string>, type: string> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($topic | is-empty) { error make --unspanned { msg: "path parameter 'topic' must be non-empty" } }
  if ($subscriber | is-empty) { error make --unspanned { msg: "path parameter 'subscriber' must be non-empty" } }
  let full_url = (build-url $base ({topic: (encode-path-segment $topic), subscriber: (encode-path-segment $subscriber)} | format pattern "/.well-known/mercure/subscriptions/{topic}/{subscriber}") $auth.query)
  let accept_val = "application/ld+json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let req = {
    method: "get"
    url: $full_url
    query: {}
    headers: $auth.headers
    body: null
    content_type: null
    timeout: ($max_time | default 30min)
    auth: {scheme: $auth.scheme, location: $auth.location}
  }
  if $dry_run { return ({dry_run: true} | merge $req) }
  send-get $req $insecure $raw $allow_errors $full [200]
}
