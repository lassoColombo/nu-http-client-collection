# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-connection-alias: "record<ConnectionIdentifier: string>"
    associate-ip-groups: "record"
    authorize-ip-rules: "record"
    copy-workspace-image: "record<ImageId: string>"
    create-connect-client-add-in: "record<AddInId: string>"
    create-connection-alias: "record<AliasId: string>"
    create-ip-group: "record<GroupId: string>"
    create-standby-workspaces: "record<FailedStandbyRequests: table<StandbyWorkspaceRequest: record, ErrorCode: string, ErrorMessage: string>, PendingStandbyRequests: table<UserName: string, DirectoryId: string, State: string, WorkspaceId: string>>"
    create-tags: "record"
    create-updated-workspace-image: "record<ImageId: string>"
    create-workspace-bundle: "record<WorkspaceBundle: record<BundleId: string, Name: string, Owner: string, Description: string, ImageId: string, RootStorage: record<Capacity: string>, UserStorage: record<Capacity: string>, ComputeType: record<Name: string>, LastUpdatedTime: string, CreationTime: string, State: string, BundleType: string>>"
    create-workspace-image: "record<ImageId: string, Name: string, Description: string, OperatingSystem: record<Type: string>, State: string, RequiredTenancy: string, Created: string, OwnerAccountId: string>"
    create-workspaces: "record<FailedRequests: table<WorkspaceRequest: record, ErrorCode: string, ErrorMessage: string>, PendingRequests: table<WorkspaceId: string, DirectoryId: string, UserName: string, IpAddress: string, State: string, BundleId: string, SubnetId: string, ErrorMessage: string, ErrorCode: string, ComputerName: string, VolumeEncryptionKey: string, UserVolumeEncryptionEnabled: bool, RootVolumeEncryptionEnabled: bool, WorkspaceProperties: record, ModificationStates: list, RelatedWorkspaces: list>>"
    delete-client-branding: "record"
    delete-connect-client-add-in: "record"
    delete-connection-alias: "record"
    delete-ip-group: "record"
    delete-tags: "record"
    delete-workspace-bundle: "record"
    delete-workspace-image: "record"
    deregister-workspace-directory: "record"
    describe-account: "record<DedicatedTenancySupport: string, DedicatedTenancyManagementCidrRange: string>"
    describe-account-modifications: "record<AccountModifications: table<ModificationState: string, DedicatedTenancySupport: string, DedicatedTenancyManagementCidrRange: string, StartTime: string, ErrorCode: string, ErrorMessage: string>, NextToken: string>"
    describe-client-branding: "record<DeviceTypeWindows: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeOsx: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeAndroid: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeIos: record<LogoUrl: string, Logo2xUrl: string, Logo3xUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeLinux: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeWeb: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>>"
    describe-client-properties: "record<ClientPropertiesList: table<ResourceId: string, ClientProperties: record>>"
    describe-connect-client-add-ins: "record<AddIns: table<AddInId: string, ResourceId: string, Name: string, URL: string>, NextToken: string>"
    describe-connection-alias-permissions: "record<AliasId: string, ConnectionAliasPermissions: table<SharedAccountId: string, AllowAssociation: bool>, NextToken: string>"
    describe-connection-aliases: "record<ConnectionAliases: table<ConnectionString: string, AliasId: string, State: string, OwnerAccountId: string, Associations: list>, NextToken: string>"
    describe-ip-groups: "record<Result: table<groupId: string, groupName: string, groupDesc: string, userRules: list>, NextToken: string>"
    describe-tags: "record<TagList: table<Key: string, Value: string>>"
    describe-workspace-bundles: "record<Bundles: table<BundleId: string, Name: string, Owner: string, Description: string, ImageId: string, RootStorage: record, UserStorage: record, ComputeType: record, LastUpdatedTime: string, CreationTime: string, State: string, BundleType: string>, NextToken: string>"
    describe-workspace-directories: "record<Directories: table<DirectoryId: string, Alias: string, DirectoryName: string, RegistrationCode: string, SubnetIds: list, DnsIpAddresses: list, CustomerUserName: string, IamRoleId: string, DirectoryType: string, WorkspaceSecurityGroupId: string, State: string, WorkspaceCreationProperties: record, ipGroupIds: list, WorkspaceAccessProperties: record, Tenancy: string, SelfservicePermissions: record, SamlProperties: record, CertificateBasedAuthProperties: record>, NextToken: string>"
    describe-workspace-image-permissions: "record<ImageId: string, ImagePermissions: table<SharedAccountId: string>, NextToken: string>"
    describe-workspace-images: "record<Images: table<ImageId: string, Name: string, Description: string, OperatingSystem: record, State: string, RequiredTenancy: string, ErrorCode: string, ErrorMessage: string, Created: string, OwnerAccountId: string, Updates: record>, NextToken: string>"
    describe-workspace-snapshots: "record<RebuildSnapshots: table<SnapshotTime: string>, RestoreSnapshots: table<SnapshotTime: string>>"
    describe-workspaces: "record<Workspaces: table<WorkspaceId: string, DirectoryId: string, UserName: string, IpAddress: string, State: string, BundleId: string, SubnetId: string, ErrorMessage: string, ErrorCode: string, ComputerName: string, VolumeEncryptionKey: string, UserVolumeEncryptionEnabled: bool, RootVolumeEncryptionEnabled: bool, WorkspaceProperties: record, ModificationStates: list, RelatedWorkspaces: list>, NextToken: string>"
    describe-workspaces-connection-status: "record<WorkspacesConnectionStatus: table<WorkspaceId: string, ConnectionState: string, ConnectionStateCheckTimestamp: string, LastKnownUserConnectionTimestamp: string>, NextToken: string>"
    disassociate-connection-alias: "record"
    disassociate-ip-groups: "record"
    import-client-branding: "record<DeviceTypeWindows: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeOsx: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeAndroid: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeIos: record<LogoUrl: string, Logo2xUrl: string, Logo3xUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeLinux: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>, DeviceTypeWeb: record<LogoUrl: string, SupportEmail: string, SupportLink: string, ForgotPasswordLink: string, LoginMessage: record>>"
    import-workspace-image: "record<ImageId: string>"
    list-available-management-cidr-ranges: "record<ManagementCidrRanges: list<string>, NextToken: string>"
    migrate-workspace: "record<SourceWorkspaceId: string, TargetWorkspaceId: string>"
    modify-account: "record"
    modify-certificate-based-auth-properties: "record"
    modify-client-properties: "record"
    modify-saml-properties: "record"
    modify-selfservice-permissions: "record"
    modify-workspace-access-properties: "record"
    modify-workspace-creation-properties: "record"
    modify-workspace-properties: "record"
    modify-workspace-state: "record"
    reboot-workspaces: "record<FailedRequests: table<WorkspaceId: string, ErrorCode: string, ErrorMessage: string>>"
    rebuild-workspaces: "record<FailedRequests: table<WorkspaceId: string, ErrorCode: string, ErrorMessage: string>>"
    register-workspace-directory: "record"
    restore-workspace: "record"
    revoke-ip-rules: "record"
    start-workspaces: "record<FailedRequests: table<WorkspaceId: string, ErrorCode: string, ErrorMessage: string>>"
    stop-workspaces: "record<FailedRequests: table<WorkspaceId: string, ErrorCode: string, ErrorMessage: string>>"
    terminate-workspaces: "record<FailedRequests: table<WorkspaceId: string, ErrorCode: string, ErrorMessage: string>>"
    update-connect-client-add-in: "record"
    update-connection-alias-permission: "record"
    update-rules-of-ip-group: "record"
    update-workspace-bundle: "record"
    update-workspace-image-permission: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-connection-alias" "associate-ip-groups" "authorize-ip-rules" "copy-workspace-image" "create-connect-client-add-in" "create-connection-alias" "create-ip-group" "create-standby-workspaces" "create-tags" "create-updated-workspace-image" "create-workspace-bundle" "create-workspace-image" "create-workspaces" "delete-client-branding" "delete-connect-client-add-in" "delete-connection-alias" "delete-ip-group" "delete-tags" "delete-workspace-bundle" "delete-workspace-image" "deregister-workspace-directory" "describe-account" "describe-account-modifications" "describe-client-branding" "describe-client-properties" "describe-connect-client-add-ins" "describe-connection-alias-permissions" "describe-connection-aliases" "describe-ip-groups" "describe-tags" "describe-workspace-bundles" "describe-workspace-directories" "describe-workspace-image-permissions" "describe-workspace-images" "describe-workspace-snapshots" "describe-workspaces" "describe-workspaces-connection-status" "disassociate-connection-alias" "disassociate-ip-groups" "import-client-branding" "import-workspace-image" "list-available-management-cidr-ranges" "migrate-workspace" "modify-account" "modify-certificate-based-auth-properties" "modify-client-properties" "modify-saml-properties" "modify-selfservice-permissions" "modify-workspace-access-properties" "modify-workspace-creation-properties" "modify-workspace-properties" "modify-workspace-state" "reboot-workspaces" "rebuild-workspaces" "register-workspace-directory" "restore-workspace" "revoke-ip-rules" "start-workspaces" "stop-workspaces" "terminate-workspaces" "update-connect-client-add-in" "update-connection-alias-permission" "update-rules-of-ip-group" "update-workspace-bundle" "update-workspace-image-permission" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Associates the specified connection alias with the specified directory to enable cross-Region redirection. For more information, see Cross-Region Redirection for Amazon WorkSpaces (https://docs.aws.amazon.com/workspaces/latest/adminguide/cross-region-redirection.html). Before performing this operation, call DescribeConnectionAliases (https://docs.aws.amazon.com/workspaces/latest/api/API_DescribeConnectionAliases.html) to make sure that the current state of the connection alias is CREATED.
#
# POST /
# Returns: record<ConnectionIdentifier: string>
# operationId: AssociateConnectionAlias
export def "associate-connection-alias" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  alias_id: string # The identifier of the connection alias.
  resource_id: string # The identifier of the directory to associate the connection alias with.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "WorkspacesService.AssociateConnectionAlias"}]
    body: {content_type: "application/json", kind: json, fields: [{name: AliasId, var: alias_id}, {name: ResourceId, var: resource_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, alias_id: $alias_id, resource_id: $resource_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Associates the specified IP access control group with the specified directory.
#
# POST /
# Returns: record
# operationId: AssociateIpGroups
export def "associate-ip-groups" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-1 # required
  directory_id: string # The identifier of the directory.
  group_ids: list<string> # The identifiers of one or more IP access control groups.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
