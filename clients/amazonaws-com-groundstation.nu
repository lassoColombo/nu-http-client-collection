# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cancel-contact: "record<contactId: string>"
    describe-contact: "record<contactId: string, contactStatus: string, dataflowList: table<destination: record, errorMessage: string, source: record>, endTime: string, errorMessage: string, groundStation: string, maximumElevation: record<unit: string, value: float>, missionProfileArn: string, postPassEndTime: string, prePassStartTime: string, region: string, satelliteArn: string, startTime: string, tags: record>"
    create-config: "record<configArn: string, configId: string, configType: string>"
    list-configs: "record<configList: table<configArn: string, configId: string, configType: string, name: string>, nextToken: string>"
    create-dataflow-endpoint-group: "record<dataflowEndpointGroupId: string>"
    list-dataflow-endpoint-groups: "record<dataflowEndpointGroupList: table<dataflowEndpointGroupArn: string, dataflowEndpointGroupId: string>, nextToken: string>"
    create-ephemeris: "record<ephemerisId: string>"
    create-mission-profile: "record<missionProfileId: string>"
    list-mission-profiles: "record<missionProfileList: table<missionProfileArn: string, missionProfileId: string, name: string, region: string>, nextToken: string>"
    delete-config: "record<configArn: string, configId: string, configType: string>"
    get-config: "record<configArn: string, configData: record<antennaDownlinkConfig: record<spectrumConfig: record>, antennaDownlinkDemodDecodeConfig: record<decodeConfig: record, demodulationConfig: record, spectrumConfig: record>, antennaUplinkConfig: record<spectrumConfig: record, targetEirp: record, transmitDisabled: bool>, dataflowEndpointConfig: record<dataflowEndpointName: string, dataflowEndpointRegion: string>, s3RecordingConfig: record<bucketArn: string, prefix: string, roleArn: string>, trackingConfig: record<autotrack: string>, uplinkEchoConfig: record<antennaUplinkConfigArn: string, enabled: bool>>, configId: string, configType: string, name: string, tags: record>"
    update-config: "record<configArn: string, configId: string, configType: string>"
    delete-dataflow-endpoint-group: "record<dataflowEndpointGroupId: string>"
    get-dataflow-endpoint-group: "record<contactPostPassDurationSeconds: int, contactPrePassDurationSeconds: int, dataflowEndpointGroupArn: string, dataflowEndpointGroupId: string, endpointsDetails: table<awsGroundStationAgentEndpoint: record, endpoint: record, healthReasons: list, healthStatus: string, securityDetails: record>, tags: record>"
    delete-ephemeris: "record<ephemerisId: string>"
    describe-ephemeris: "record<creationTime: string, enabled: bool, ephemerisId: string, invalidReason: string, name: string, priority: int, satelliteId: string, status: string, suppliedData: record<oem: record<ephemerisData: string, sourceS3Object: record>, tle: record<ephemerisData: string, sourceS3Object: record>>, tags: record>"
    update-ephemeris: "record<ephemerisId: string>"
    delete-mission-profile: "record<missionProfileId: string>"
    get-mission-profile: "record<contactPostPassDurationSeconds: int, contactPrePassDurationSeconds: int, dataflowEdges: list<list<string>>, minimumViableContactDurationSeconds: int, missionProfileArn: string, missionProfileId: string, name: string, region: string, streamsKmsKey: record<kmsAliasArn: string, kmsKeyArn: string>, streamsKmsRole: string, tags: record, trackingConfigArn: string>"
    update-mission-profile: "record<missionProfileId: string>"
    get-agent-configuration: "record<agentId: string, taskingDocument: string>"
    get-minute-usage: "record<estimatedMinutesRemaining: int, isReservedMinutesCustomer: bool, totalReservedMinuteAllocation: int, totalScheduledMinutes: int, upcomingMinutesScheduled: int>"
    get-satellite: "record<currentEphemeris: record<ephemerisId: string, epoch: string, name: string, source: string>, groundStations: list<string>, noradSatelliteID: int, satelliteArn: string, satelliteId: string>"
    list-contacts: "record<contactList: table<contactId: string, contactStatus: string, endTime: string, errorMessage: string, groundStation: string, maximumElevation: record, missionProfileArn: string, postPassEndTime: string, prePassStartTime: string, region: string, satelliteArn: string, startTime: string, tags: record>, nextToken: string>"
    list-ephemerides: "record<ephemerides: table<creationTime: string, enabled: bool, ephemerisId: string, name: string, priority: int, sourceS3Object: record, status: string>, nextToken: string>"
    list-ground-stations: "record<groundStationList: table<groundStationId: string, groundStationName: string, region: string>, nextToken: string>"
    list-satellites: "record<nextToken: string, satellites: table<currentEphemeris: record, groundStations: list, noradSatelliteID: int, satelliteArn: string, satelliteId: string>>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    register-agent: "record<agentId: string>"
    reserve-contact: "record<contactId: string>"
    untag-resource: "record"
    update-agent-status: "record<agentId: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["cancel-contact" "describe-contact" "create-config" "list-configs" "create-dataflow-endpoint-group" "list-dataflow-endpoint-groups" "create-ephemeris" "create-mission-profile" "list-mission-profiles" "delete-config" "get-config" "update-config" "delete-dataflow-endpoint-group" "get-dataflow-endpoint-group" "delete-ephemeris" "describe-ephemeris" "update-ephemeris" "delete-mission-profile" "get-mission-profile" "update-mission-profile" "get-agent-configuration" "get-minute-usage" "get-satellite" "list-contacts" "list-ephemerides" "list-ground-stations" "list-satellites" "list-tags-for-resource" "tag-resource" "register-agent" "reserve-contact" "untag-resource" "update-agent-status" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Cancels a contact with a specified contact ID.
#
# DELETE /contact/{contactId}
# Returns: record<contactId: string>
# operationId: CancelContact
export def "cancel-contact" [
  contact_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: delete
    path: "/contact/{contactId}"
    path_params: [{name: contactId, var: contact_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    contact_id: $contact_id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

