# For use by AWS Ground Station Agent and shouldn't be called directly. Update the status of the agent.
#
# PUT /agent/{agentId}
# Returns: record<agentId: string>
# operationId: UpdateAgentStatus
export def "update-agent-status" [
  agent_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  aggregate_status: record # Aggregate status of Agent components. — shape: {signatureMap?: record, status?: "SUCCESS"|"FAILED"|"ACTIVE"|"INACTIVE"}
  component_statuses: list # List of component statuses for agent. — item shape: {bytesReceived?: int, bytesSent?: int, capabilityArn: string, componentType: string, dataflowId: string, packetsDropped?: int, status: "SUCCESS"|"FAILED"|"ACTIVE"|"INACTIVE"}
  task_id: string # GUID of agent task.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/agent/{agentId}"
    path_params: [{name: agentId, var: agent_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: aggregateStatus, var: aggregate_status}, {name: componentStatuses, var: component_statuses}, {name: taskId, var: task_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    agent_id: $agent_id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, aggregate_status: $aggregate_status, component_statuses: $component_statuses, task_id: $task_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}
