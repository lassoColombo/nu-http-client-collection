# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["operations-list" "namespaces-check-name-availability" "namespaces-list" "regions-list-by-sku" "namespaces-list-by-resource-group" "namespaces-delete" "namespaces-get" "namespaces-update" "namespaces-create-or-update" "namespaces-list-authorization-rules" "namespaces-delete-authorization-rule" "namespaces-get-authorization-rule" "namespaces-create-or-update-authorization-rule" "namespaces-list-keys" "namespaces-regenerate-keys" "disaster-recovery-configs-list" "disaster-recovery-configs-check-name-availability" "disaster-recovery-configs-delete" "disaster-recovery-configs-get" "disaster-recovery-configs-create-or-update" "disaster-recovery-configs-list-authorization-rules" "disaster-recovery-configs-get-authorization-rule" "disaster-recovery-configs-list-keys" "disaster-recovery-configs-break-pairing" "disaster-recovery-configs-fail-over" "event-hubs-list-by-namespace" "event-hubs-delete" "event-hubs-get" "event-hubs-create-or-update" "event-hubs-list-authorization-rules" "event-hubs-delete-authorization-rule" "event-hubs-get-authorization-rule" "event-hubs-create-or-update-authorization-rule" "event-hubs-list-keys" "event-hubs-regenerate-keys" "consumer-groups-list-by-event-hub" "consumer-groups-delete" "consumer-groups-get" "consumer-groups-create-or-update" "namespaces-get-messaging-plan" "namespaces-list-network-rule-sets" "namespaces-get-network-rule-set" "namespaces-create-or-update-network-rule-set" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let return_type = ($sig | where parameter_type == "output" | get -o syntax_shape | first | default "any")
    {
      name: ($cmd.name | str replace $"($mod_name) " "")
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: $return_type
      params: $params
    }
  }
}

# Lists all of the available Event Hub REST API operations.
#
# GET /providers/Microsoft.EventHub/operations
# operationId: Operations_List
export def "operations-list" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --api-version: string # Client API Version. (required)
]: nothing -> oneof<record<nextLink: string, value: table<display: record, name: string>>, string, nothing> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($api_version == null) { error make --unspanned { msg: "required query parameter 'api-version' missing: pass --api-version" } }
  let qp = [(serialize-qp "api-version" $api_version "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/providers/Microsoft.EventHub/operations" $qp $auth.query)
  let accept_val = "application/json"
  let auth = ($auth | update headers (merge-headers $auth.headers {Accept: $accept_val}))
  let req = {
    method: "get"
    url: $full_url
    query: ({"api-version": $api_version} | compact)
    headers: $auth.headers
    body: null
    content_type: null
    timeout: ($max_time | default 30min)
    auth: {scheme: $auth.scheme, location: $auth.location}
  }
  if $dry_run { return ({dry_run: true} | merge $req) }
  send-get $req $insecure $raw $allow_errors $full [200]
}

