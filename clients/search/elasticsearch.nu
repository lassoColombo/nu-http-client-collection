  let qp = [(serialize-qp "allow_no_indices" $allow_no_indices "scalar") (serialize-qp "all_shards" $all_shards "scalar") (serialize-qp "analyzer" $analyzer "scalar") (serialize-qp "analyze_wildcard" $analyze_wildcard "scalar") (serialize-qp "default_operator" $default_operator "scalar") (serialize-qp "df" $df "scalar") (serialize-qp "expand_wildcards" $expand_wildcards "scalar") (serialize-qp "explain" $explain "scalar") (serialize-qp "ignore_unavailable" $ignore_unavailable "scalar") (serialize-qp "lenient" $lenient "scalar") (serialize-qp "rewrite" $rewrite "scalar") (serialize-qp "q" $q "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/_validate/query" $qp)
  let body = {query: $body_query} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
