  --indices: list # A list of indices permissions entries. — item shape: {field_security?: any, names: any, privileges: list, query?: any, allow_restricted_indices?: bool}
  --remote-indices: list # A list of remote indices permissions entries.  NOTE: Remote indices are effective for remote clusters configured with the API key based model. They have no effect for remote clusters configured with the certificate based model. — item shape: {clusters: any, field_security?: any, names: any, privileges: list, query?: any, allow_restricted_indices?: bool}
  --remote-cluster: list # A list of remote cluster permissions entries. — item shape: {clusters: any, privileges: list}
