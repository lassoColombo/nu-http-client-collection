# Perform chat completion inference on the service
#
# POST /_inference/chat_completion/{inference_id}/_stream
# operationId: inference-chat-completion-unified
# --messages item shape: {content?: any, role: string, tool_call_id?: any, tool_calls?: list, reasoning?: string, reasoning_details?: list}
# --tools item shape: {type: string, function: any}
export def "inference-chat-completion-stream inference-chat-completion-unified" [
  inference_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
