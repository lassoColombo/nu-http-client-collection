  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "master_timeout" $master_timeout "scalar") (serialize-qp "wait_for_completion" $wait_for_completion "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/_snapshot/($repository)/($snapshot)" $qp)
  let body = {expand_wildcards: $expand_wildcards, feature_states: $feature_states, ignore_unavailable: $ignore_unavailable, include_global_state: $include_global_state, indices: $indices, metadata: $metadata, partial: $partial} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json" $body
}

