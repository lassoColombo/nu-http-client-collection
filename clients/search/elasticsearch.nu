  --groups: list # A list of job groups. A job can belong to no groups or many.
  --detectors: list # An array of detector update objects. — item shape: {detector_index: float, description?: string, custom_rules?: list}
  --per-partition-categorization: any # Settings related to how categorization interacts with partition fields.
