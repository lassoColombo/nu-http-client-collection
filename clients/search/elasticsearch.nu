  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "if_primary_term" $if_primary_term "scalar") (serialize-qp "if_seq_no" $if_seq_no "scalar") (serialize-qp "include_source_on_error" $include_source_on_error "scalar") (serialize-qp "op_type" $op_type "scalar") (serialize-qp "pipeline" $pipeline "scalar") (serialize-qp "refresh" $refresh "scalar") (serialize-qp "routing" $routing "scalar") (serialize-qp "timeout" $timeout "scalar") (serialize-qp "version" $version "scalar") (serialize-qp "version_type" $version_type "scalar") (serialize-qp "wait_for_active_shards" $wait_for_active_shards "scalar") (serialize-qp "require_alias" $require_alias "scalar") (serialize-qp "require_data_stream" $require_data_stream "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/($index)/_doc" $qp)
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json" $body
