  let body = {username: $body_username, email: $email, full_name: $full_name, metadata: $metadata, password: $password, password_hash: $password_hash, roles: $roles, enabled: $enabled} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
