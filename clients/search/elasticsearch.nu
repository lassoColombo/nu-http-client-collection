  let full_url = (build-url $base "/_query" $qp)
  let body = {columnar: $columnar, filter: $filter, time_zone: $time_zone, locale: $locale, params: $params, profile: $profile, query: $body_query, tables: $tables, include_ccs_metadata: $include_ccs_metadata, include_execution_metadata: $include_execution_metadata} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
