  let full_url = (build-url $base $"/_ml/anomaly_detectors/($job_id)/results/buckets/($timestamp)" $qp)
  let body = {anomaly_score: $anomaly_score, desc: $desc, end: $end, exclude_interim: $exclude_interim, expand: $expand, page: $page, sort: $body_sort, start: $start} | compact
