  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "create" $create "scalar") (serialize-qp "cause" $cause "scalar") (serialize-qp "master_timeout" $master_timeout "scalar") (serialize-qp "include_defaults" $include_defaults "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/_index_template/_simulate" $qp)
