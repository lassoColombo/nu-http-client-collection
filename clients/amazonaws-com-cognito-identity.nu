    body: {content_type: "application/json", kind: json, fields: [{name: IdentityPoolName, var: identity_pool_name}, {name: AllowUnauthenticatedIdentities, var: allow_unauthenticated_identities, required: true}, {name: AllowClassicFlow, var: allow_classic_flow}, {name: SupportedLoginProviders, var: supported_login_providers}, {name: DeveloperProviderName, var: developer_provider_name}, {name: OpenIdConnectProviderARNs, var: open_id_connect_provider_ar_ns}, {name: CognitoIdentityProviders, var: cognito_identity_providers}, {name: SamlProviderARNs, var: saml_provider_ar_ns}, {name: IdentityPoolTags, var: identity_pool_tags}]}
    accept: ["application/json"]
