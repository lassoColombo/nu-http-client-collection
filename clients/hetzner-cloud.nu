def sort-completer-2 [] { ["created" "created:asc" "created:desc" "id" "id:asc" "id:desc"] }
def type-completer-1 [] { ["ipv4" "ipv6"] }
def type-completer-2 [] { ["app" "backup" "snapshot" "system"] }
