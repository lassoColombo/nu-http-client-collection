# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-third-party-firewall: "record<ThirdPartyFirewallStatus: string>"
    batch-associate-resource: "record<ResourceSetIdentifier: string, FailedItems: table<URI: string, Reason: string>>"
    batch-disassociate-resource: "record<ResourceSetIdentifier: string, FailedItems: table<URI: string, Reason: string>>"
    disassociate-third-party-firewall: "record<ThirdPartyFirewallStatus: string>"
    get-admin-account: "record<AdminAccount: string, RoleStatus: string>"
    get-admin-scope: "record<AdminScope: record<AccountScope: record<Accounts: list, AllAccountsEnabled: bool, ExcludeSpecifiedAccounts: bool>, OrganizationalUnitScope: record<OrganizationalUnits: list, AllOrganizationalUnitsEnabled: bool, ExcludeSpecifiedOrganizationalUnits: bool>, RegionScope: record<Regions: list, AllRegionsEnabled: bool>, PolicyTypeScope: record<PolicyTypes: list, AllPolicyTypesEnabled: bool>>, Status: string>"
    get-apps-list: "record<AppsList: record<ListId: string, ListName: string, ListUpdateToken: string, CreateTime: string, LastUpdateTime: string, AppsList: list<record>, PreviousAppsList: record>, AppsListArn: string>"
    get-compliance-detail: "record<PolicyComplianceDetail: record<PolicyOwner: string, PolicyId: string, MemberAccount: string, Violators: list<record>, EvaluationLimitExceeded: bool, ExpiredAt: string, IssueInfoMap: record>>"
    get-notification-channel: "record<SnsTopicArn: string, SnsRoleName: string>"
    get-policy: "record<Policy: record<PolicyId: string, PolicyName: string, PolicyUpdateToken: string, SecurityServicePolicyData: record<Type: string, ManagedServiceData: string, PolicyOption: record>, ResourceType: string, ResourceTypeList: list<string>, ResourceTags: list<record>, ExcludeResourceTags: bool, RemediationEnabled: bool, DeleteUnusedFMManagedResources: bool, IncludeMap: record, ExcludeMap: record, ResourceSetIds: list<string>, PolicyDescription: string, PolicyStatus: string>, PolicyArn: string>"
    get-protection-status: "record<AdminAccountId: string, ServiceType: string, Data: string, NextToken: string>"
    get-protocols-list: "record<ProtocolsList: record<ListId: string, ListName: string, ListUpdateToken: string, CreateTime: string, LastUpdateTime: string, ProtocolsList: list<string>, PreviousProtocolsList: record>, ProtocolsListArn: string>"
    get-resource-set: "record<ResourceSet: record<Id: string, Name: string, Description: string, UpdateToken: string, ResourceTypeList: list<string>, LastUpdateTime: string, ResourceSetStatus: string>, ResourceSetArn: string>"
    get-third-party-firewall-association-status: "record<ThirdPartyFirewallStatus: string, MarketplaceOnboardingStatus: string>"
    get-violation-details: "record<ViolationDetail: record<PolicyId: string, MemberAccount: string, ResourceId: string, ResourceType: string, ResourceViolations: list<record>, ResourceTags: list<record>, ResourceDescription: string>>"
    list-admin-accounts-for-organization: "record<AdminAccounts: table<AdminAccount: string, DefaultAdmin: bool, Status: string>, NextToken: string>"
    list-admins-managing-account: "record<AdminAccounts: list<string>, NextToken: string>"
    list-apps-lists: "record<AppsLists: table<ListArn: string, ListId: string, ListName: string, AppsList: list>, NextToken: string>"
    list-compliance-status: "record<PolicyComplianceStatusList: table<PolicyOwner: string, PolicyId: string, PolicyName: string, MemberAccount: string, EvaluationResults: list, LastUpdated: string, IssueInfoMap: record>, NextToken: string>"
    list-discovered-resources: "record<Items: table<URI: string, AccountId: string, Type: string, Name: string>, NextToken: string>"
    list-member-accounts: "record<MemberAccounts: list<string>, NextToken: string>"
    list-policies: "record<PolicyList: table<PolicyArn: string, PolicyId: string, PolicyName: string, ResourceType: string, SecurityServiceType: string, RemediationEnabled: bool, DeleteUnusedFMManagedResources: bool, PolicyStatus: string>, NextToken: string>"
    list-protocols-lists: "record<ProtocolsLists: table<ListArn: string, ListId: string, ListName: string, ProtocolsList: list>, NextToken: string>"
    list-resource-set-resources: "record<Items: table<URI: string, AccountId: string>, NextToken: string>"
    list-resource-sets: "record<ResourceSets: table<Id: string, Name: string, Description: string, LastUpdateTime: string, ResourceSetStatus: string>, NextToken: string>"
    list-tags-for-resource: "record<TagList: table<Key: string, Value: string>>"
    list-third-party-firewall-firewall-policies: "record<ThirdPartyFirewallFirewallPolicies: table<FirewallPolicyId: string, FirewallPolicyName: string>, NextToken: string>"
    put-apps-list: "record<AppsList: record<ListId: string, ListName: string, ListUpdateToken: string, CreateTime: string, LastUpdateTime: string, AppsList: list<record>, PreviousAppsList: record>, AppsListArn: string>"
    put-policy: "record<Policy: record<PolicyId: string, PolicyName: string, PolicyUpdateToken: string, SecurityServicePolicyData: record<Type: string, ManagedServiceData: string, PolicyOption: record>, ResourceType: string, ResourceTypeList: list<string>, ResourceTags: list<record>, ExcludeResourceTags: bool, RemediationEnabled: bool, DeleteUnusedFMManagedResources: bool, IncludeMap: record, ExcludeMap: record, ResourceSetIds: list<string>, PolicyDescription: string, PolicyStatus: string>, PolicyArn: string>"
    put-protocols-list: "record<ProtocolsList: record<ListId: string, ListName: string, ListUpdateToken: string, CreateTime: string, LastUpdateTime: string, ProtocolsList: list<string>, PreviousProtocolsList: record>, ProtocolsListArn: string>"
    put-resource-set: "record<ResourceSet: record<Id: string, Name: string, Description: string, UpdateToken: string, ResourceTypeList: list<string>, LastUpdateTime: string, ResourceSetStatus: string>, ResourceSetArn: string>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-admin-account" "associate-third-party-firewall" "batch-associate-resource" "batch-disassociate-resource" "delete-apps-list" "delete-notification-channel" "delete-policy" "delete-protocols-list" "delete-resource-set" "disassociate-admin-account" "disassociate-third-party-firewall" "get-admin-account" "get-admin-scope" "get-apps-list" "get-compliance-detail" "get-notification-channel" "get-policy" "get-protection-status" "get-protocols-list" "get-resource-set" "get-third-party-firewall-association-status" "get-violation-details" "list-admin-accounts-for-organization" "list-admins-managing-account" "list-apps-lists" "list-compliance-status" "list-discovered-resources" "list-member-accounts" "list-policies" "list-protocols-lists" "list-resource-set-resources" "list-resource-sets" "list-tags-for-resource" "list-third-party-firewall-firewall-policies" "put-admin-account" "put-apps-list" "put-notification-channel" "put-policy" "put-protocols-list" "put-resource-set" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Sets a Firewall Manager default administrator account. The Firewall Manager default administrator account can manage third-party firewalls and has full administrative scope that allows administration of all policy types, accounts, organizational units, and Regions. This account must be a member account of the organization in Organizations whose resources you want to protect. For information about working with Firewall Manager administrator accounts, see Managing Firewall Manager administrators (https://docs.aws.amazon.com/organizations/latest/userguide/fms-administrators.html) in the Firewall Manager Developer Guide.
