# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-group: "record<GroupId: string, IdentityStoreId: string>"
    create-group-membership: "record<MembershipId: string, IdentityStoreId: string>"
    create-user: "record<UserId: string, IdentityStoreId: string>"
    delete-group: "record"
    delete-group-membership: "record"
    delete-user: "record"
    describe-group: "record<GroupId: string, DisplayName: string, ExternalIds: table<Issuer: string, Id: string>, Description: string, IdentityStoreId: string>"
    describe-group-membership: "record<IdentityStoreId: string, MembershipId: string, GroupId: string, MemberId: record<UserId: string>>"
    describe-user: "record<UserName: string, UserId: string, ExternalIds: table<Issuer: string, Id: string>, Name: record<Formatted: string, FamilyName: string, GivenName: string, MiddleName: string, HonorificPrefix: string, HonorificSuffix: string>, DisplayName: string, NickName: string, ProfileUrl: string, Emails: table<Value: string, Type: string, Primary: bool>, Addresses: table<StreetAddress: string, Locality: string, Region: string, PostalCode: string, Country: string, Formatted: string, Type: string, Primary: bool>, PhoneNumbers: table<Value: string, Type: string, Primary: bool>, UserType: string, Title: string, PreferredLanguage: string, Locale: string, Timezone: string, IdentityStoreId: string>"
    get-group-id: "record<GroupId: string, IdentityStoreId: string>"
    get-group-membership-id: "record<MembershipId: string, IdentityStoreId: string>"
    get-user-id: "record<UserId: string, IdentityStoreId: string>"
    is-member-in-groups: "record<Results: table<GroupId: string, MemberId: record, MembershipExists: bool>>"
    list-group-memberships: "record<GroupMemberships: table<IdentityStoreId: string, MembershipId: string, GroupId: string, MemberId: record>, NextToken: string>"
    list-group-memberships-for-member: "record<GroupMemberships: table<IdentityStoreId: string, MembershipId: string, GroupId: string, MemberId: record>, NextToken: string>"
    list-groups: "record<Groups: table<GroupId: string, DisplayName: string, ExternalIds: list, Description: string, IdentityStoreId: string>, NextToken: string>"
    list-users: "record<Users: table<UserName: string, UserId: string, ExternalIds: list, Name: record, DisplayName: string, NickName: string, ProfileUrl: string, Emails: list, Addresses: list, PhoneNumbers: list, UserType: string, Title: string, PreferredLanguage: string, Locale: string, Timezone: string, IdentityStoreId: string>, NextToken: string>"
    update-group: "record"
    update-user: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-group" "create-group-membership" "create-user" "delete-group" "delete-group-membership" "delete-user" "describe-group" "describe-group-membership" "describe-user" "get-group-id" "get-group-membership-id" "get-user-id" "is-member-in-groups" "list-group-memberships" "list-group-memberships-for-member" "list-groups" "list-users" "update-group" "update-user" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

