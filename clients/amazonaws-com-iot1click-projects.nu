# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-device-with-placement: "record"
    disassociate-device-from-placement: "record"
    create-placement: "record"
    list-placements: "record<placements: table<projectName: string, placementName: string, createdDate: string, updatedDate: string>, nextToken: string>"
    create-project: "record"
    list-projects: "record<projects: table<arn: string, projectName: string, createdDate: string, updatedDate: string, tags: record>, nextToken: string>"
    delete-placement: "record"
    describe-placement: "record<placement: record<projectName: string, placementName: string, attributes: record, createdDate: string, updatedDate: string>>"
    update-placement: "record"
    delete-project: "record"
    describe-project: "record<project: record<arn: string, projectName: string, description: string, createdDate: string, updatedDate: string, placementTemplate: record<defaultAttributes: record, deviceTemplates: record>, tags: record>>"
    update-project: "record"
    get-devices-in-placement: "record<devices: record>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-device-with-placement" "disassociate-device-from-placement" "create-placement" "list-placements" "create-project" "list-projects" "delete-placement" "describe-placement" "update-placement" "delete-project" "describe-project" "update-project" "get-devices-in-placement" "list-tags-for-resource" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

