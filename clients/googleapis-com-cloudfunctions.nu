# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cloudfunctions-projects-locations-functions-delete: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudfunctions-projects-locations-operations-get: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudfunctions-projects-locations-functions-patch: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudfunctions-projects-locations-list: "record<locations: table<displayName: string, labels: record, locationId: string, metadata: record, name: string>, nextPageToken: string>"
    cloudfunctions-projects-locations-operations-list: "record<nextPageToken: string, operations: table<done: bool, error: record, metadata: record, name: string, response: record>>"
    cloudfunctions-projects-locations-functions-generate-download-url: "record<downloadUrl: string>"
    cloudfunctions-projects-locations-functions-list: "record<functions: table<buildConfig: record, description: string, environment: string, eventTrigger: record, kmsKeyName: string, labels: record, name: string, serviceConfig: record, state: string, stateMessages: list, updateTime: string>, nextPageToken: string, unreachable: list<string>>"
    cloudfunctions-projects-locations-functions-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudfunctions-projects-locations-functions-generate-upload-url: "record<storageSource: record<bucket: string, generation: string, object: string>, uploadUrl: string>"
    cloudfunctions-projects-locations-runtimes-list: "record<runtimes: table<displayName: string, environment: string, name: string, stage: string, warnings: list>>"
    cloudfunctions-projects-locations-functions-get-iam-policy: "record<auditConfigs: table<auditLogConfigs: list, service: string>, bindings: table<condition: record, members: list, role: string>, etag: string, version: int>"
    cloudfunctions-projects-locations-functions-set-iam-policy: "record<auditConfigs: table<auditLogConfigs: list, service: string>, bindings: table<condition: record, members: list, role: string>, etag: string, version: int>"
    cloudfunctions-projects-locations-functions-test-iam-permissions: "record<permissions: list<string>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["cloudfunctions-projects-locations-functions-delete" "cloudfunctions-projects-locations-operations-get" "cloudfunctions-projects-locations-functions-patch" "cloudfunctions-projects-locations-list" "cloudfunctions-projects-locations-operations-list" "cloudfunctions-projects-locations-functions-generate-download-url" "cloudfunctions-projects-locations-functions-list" "cloudfunctions-projects-locations-functions-create" "cloudfunctions-projects-locations-functions-generate-upload-url" "cloudfunctions-projects-locations-runtimes-list" "cloudfunctions-projects-locations-functions-get-iam-policy" "cloudfunctions-projects-locations-functions-set-iam-policy" "cloudfunctions-projects-locations-functions-test-iam-permissions" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

