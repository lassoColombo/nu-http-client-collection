  name: string # The name of the repository. (e.g. Team Environment)
  --description: string # A short description of the repository.
  --homepage: string # A URL with more information about the repository.
  --private: oneof<nothing, bool> # Whether the repository is private. (default: false)
  --has-issues: oneof<nothing, bool> # Whether issues are enabled. (default: true, e.g. true)
  --has-projects: oneof<nothing, bool> # Whether projects are enabled. (default: true, e.g. true)
  --has-wiki: oneof<nothing, bool> # Whether the wiki is enabled. (default: true, e.g. true)
  --has-discussions: oneof<nothing, bool> # Whether discussions are enabled. (default: false, e.g. true)
  --team-id: int # The id of the team that will be granted access to this repository. This is only valid when creating a repository in an organization.
  --auto-init: oneof<nothing, bool> # Whether the repository is initialized with a minimal README. (default: false)
  --gitignore-template: string # The desired language or platform to apply to the .gitignore. (e.g. Haskell)
  --license-template: string # The license keyword of the open source license for this repository. (e.g. mit)
  --allow-squash-merge: oneof<nothing, bool> # Whether to allow squash merges for pull requests. (default: true, e.g. true)
  --allow-merge-commit: oneof<nothing, bool> # Whether to allow merge commits for pull requests. (default: true, e.g. true)
  --allow-rebase-merge: oneof<nothing, bool> # Whether to allow rebase merges for pull requests. (default: true, e.g. true)
  --allow-auto-merge: oneof<nothing, bool> # Whether to allow Auto-merge to be used on pull requests. (default: false, e.g. false)
