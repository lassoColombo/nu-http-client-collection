# Update an issue
#
# PATCH /repos/{owner}/{repo}/issues/{issue_number}
# Docs: https://docs.github.com/rest/issues/issues#update-an-issue — API method documentation
# operationId: issues/update
# --issue_field_values item shape: {field_id: int, value: any}
export def "repos-issues issues/update" [
  owner: string
  repo: string
  issue_number: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --title: any # The title of the issue. (nullable)
  --body-body: string # The contents of the issue. (nullable)
  --assignee: string # Username to assign to this issue. **This field is closing down.** (nullable)
  --state: string@state-completer-1 # The open or closed state of the issue.
  --state-reason: string@state-reason-completer # The reason for the state change. Ignored unless `state` is changed. (nullable, e.g. not_planned)
  --milestone: any # nullable
  --labels: list # Labels to associate with this issue. Pass one or more labels to _replace_ the set of labels on this issue. Send an empty array (`[]`) to clear all labels from the issue. Only users with push access can set labels for issues. Without push access to the repository, label changes are silently dropped.
  --assignees: list # Usernames to assign to this issue. Pass one or more user logins to _replace_ the set of assignees on this issue. Send an empty array (`[]`) to clear all assignees from the issue. Only users with push access can set assignees for new issues. Without push access to the repository, assignee changes are silently dropped.
  --issue-field-values: list # An array of issue field values to set on this issue. Each field value must include the field ID and the value to set. Only users with push access can set field values for issues — item shape: {field_id: int, value: any}
  --type: string # The name of the issue type to associate with this issue or use `null` to remove the current issue type. Only users with push access can set the type for issues. Without push access to the repository, type changes are silently dropped. (nullable, e.g. Epic)
