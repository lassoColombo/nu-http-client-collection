    proximitybeacon-get-eidparams: "record<maxRotationPeriodExponent: int, minRotationPeriodExponent: int, serviceEcdhPublicKey: string>"
    proximitybeacon-namespaces-list: "record<namespaces: table<namespaceName: string, servingVisibility: string>>"
    proximitybeacon-beacons-attachments-delete: "record"
    proximitybeacon-beacons-delete: "record"
    proximitybeacon-beacons-get: "record<advertisedId: record<id: string, type: string>, beaconName: string, description: string, ephemeralIdRegistration: record<beaconEcdhPublicKey: string, beaconIdentityKey: string, initialClockValue: string, initialEid: string, rotationPeriodExponent: int, serviceEcdhPublicKey: string>, expectedStability: string, indoorLevel: record<name: string>, latLng: record<latitude: float, longitude: float>, placeId: string, properties: record, provisioningKey: string, status: string>"
    proximitybeacon-beacons-update: "record<advertisedId: record<id: string, type: string>, beaconName: string, description: string, ephemeralIdRegistration: record<beaconEcdhPublicKey: string, beaconIdentityKey: string, initialClockValue: string, initialEid: string, rotationPeriodExponent: int, serviceEcdhPublicKey: string>, expectedStability: string, indoorLevel: record<name: string>, latLng: record<latitude: float, longitude: float>, placeId: string, properties: record, provisioningKey: string, status: string>"
    proximitybeacon-beacons-attachments-list: "record<attachments: table<attachmentName: string, creationTimeMs: string, data: string, maxDistanceMeters: float, namespacedType: string>>"
    proximitybeacon-beacons-attachments-create: "record<attachmentName: string, creationTimeMs: string, data: string, maxDistanceMeters: float, namespacedType: string>"
    proximitybeacon-beacons-attachments-batch-delete: "record<numDeleted: int>"
    proximitybeacon-beacons-diagnostics-list: "record<diagnostics: table<alerts: list, beaconName: string, estimatedLowBatteryDate: record>, nextPageToken: string>"
    proximitybeacon-beacons-activate: "record"
    proximitybeacon-beacons-deactivate: "record"
    proximitybeacon-beacons-decommission: "record"
    proximitybeacon-namespaces-update: "record<namespaceName: string, servingVisibility: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["proximitybeacon-beaconinfo-getforobserved" "proximitybeacon-beacons-list" "proximitybeacon-beacons-register" "proximitybeacon-get-eidparams" "proximitybeacon-namespaces-list" "proximitybeacon-beacons-attachments-delete" "proximitybeacon-beacons-delete" "proximitybeacon-beacons-get" "proximitybeacon-beacons-update" "proximitybeacon-beacons-attachments-list" "proximitybeacon-beacons-attachments-create" "proximitybeacon-beacons-attachments-batch-delete" "proximitybeacon-beacons-diagnostics-list" "proximitybeacon-beacons-activate" "proximitybeacon-beacons-deactivate" "proximitybeacon-beacons-decommission" "proximitybeacon-namespaces-update" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

