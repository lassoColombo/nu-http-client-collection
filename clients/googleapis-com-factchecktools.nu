  let input = $in
  let auth = (merge-auth [(build-auth ($token_oauth2 | default ($env | get -o FACT_CHECK_TOOLS_API_OAUTH2_TOKEN | default "")) "bearer") (build-auth ($token_oauth2c | default ($env | get -o FACT_CHECK_TOOLS_API_OAUTH2C_TOKEN | default "")) "bearer")])
