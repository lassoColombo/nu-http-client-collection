  let full_url = (build-url $base ({secret_name: (encode-path-segment $secret_name)} | format pattern "/user/codespaces/secrets/{secret_name}"))
  let req_body = {"encrypted_value": $encrypted_value, "key_id": $key_id, "selected_repository_ids": $selected_repository_ids} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
