  type: string@type-completer # The type of schema.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/v1/registries/name/{registryName}/schemas/name/{schemaName}"
    path_params: [{name: registryName, var: registry_name}, {name: schemaName, var: schema_name}]
