# Completers for enum parameters
def type-completer [] { ["JSONSchemaDraft4" "OpenApi3"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-discoverer: "record<Description: string, DiscovererArn: string, DiscovererId: string, SourceArn: string, State: string, CrossAccount: bool, Tags: record>"
    list-discoverers: "record<Discoverers: table<DiscovererArn: string, DiscovererId: string, SourceArn: string, State: string, CrossAccount: bool, Tags: record>, NextToken: string>"
    create-registry: "record<Description: string, RegistryArn: string, RegistryName: string, Tags: record>"
    describe-registry: "record<Description: string, RegistryArn: string, RegistryName: string, Tags: record>"
    update-registry: "record<Description: string, RegistryArn: string, RegistryName: string, Tags: record>"
    create-schema: "record<Description: string, LastModified: string, SchemaArn: string, SchemaName: string, SchemaVersion: string, Tags: record, Type: string, VersionCreatedDate: string>"
    describe-schema: "record<Content: string, Description: string, LastModified: string, SchemaArn: string, SchemaName: string, SchemaVersion: string, Tags: record, Type: string, VersionCreatedDate: string>"
    update-schema: "record<Description: string, LastModified: string, SchemaArn: string, SchemaName: string, SchemaVersion: string, Tags: record, Type: string, VersionCreatedDate: string>"
    describe-discoverer: "record<Description: string, DiscovererArn: string, DiscovererId: string, SourceArn: string, State: string, CrossAccount: bool, Tags: record>"
    update-discoverer: "record<Description: string, DiscovererArn: string, DiscovererId: string, SourceArn: string, State: string, CrossAccount: bool, Tags: record>"
    get-resource-policy: "record<Policy: string, RevisionId: string>"
    put-resource-policy: "record<Policy: string, RevisionId: string>"
    describe-code-binding: "record<CreationDate: string, LastModified: string, SchemaVersion: string, Status: string>"
    put-code-binding: "record<CreationDate: string, LastModified: string, SchemaVersion: string, Status: string>"
    export-schema: "record<Content: string, SchemaArn: string, SchemaName: string, SchemaVersion: string, Type: string>"
    get-code-binding-source: "record<Body: string>"
    get-discovered-schema: "record<Content: string>"
    list-registries: "record<NextToken: string, Registries: table<RegistryArn: string, RegistryName: string, Tags: record>>"
    list-schema-versions: "record<NextToken: string, SchemaVersions: table<SchemaArn: string, SchemaName: string, SchemaVersion: string, Type: string>>"
    list-schemas: "record<NextToken: string, Schemas: table<LastModified: string, SchemaArn: string, SchemaName: string, Tags: record, VersionCount: int>>"
    list-tags-for-resource: "record<Tags: record>"
    search-schemas: "record<NextToken: string, Schemas: table<RegistryName: string, SchemaArn: string, SchemaName: string, SchemaVersions: list>>"
    start-discoverer: "record<DiscovererId: string, State: string>"
    stop-discoverer: "record<DiscovererId: string, State: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-discoverer" "list-discoverers" "create-registry" "delete-registry" "describe-registry" "update-registry" "create-schema" "delete-schema" "describe-schema" "update-schema" "delete-discoverer" "describe-discoverer" "update-discoverer" "delete-resource-policy" "get-resource-policy" "put-resource-policy" "delete-schema-version" "describe-code-binding" "put-code-binding" "export-schema" "get-code-binding-source" "get-discovered-schema" "list-registries" "list-schema-versions" "list-schemas" "list-tags-for-resource" "tag-resource" "search-schemas" "start-discoverer" "stop-discoverer" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

