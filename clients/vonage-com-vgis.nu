  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" null {query: ({"fromDate": $from_date, "toDate": $to_date, "direction": $direction, "states": $states, "offset": $offset, "size": $size, "order": $order, "sort": $qp_sort} | compact), body: null}
}

