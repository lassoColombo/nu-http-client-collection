# Returns the time series of values for a requested list of frame metrics from a time period.
#
# POST /profilingGroups/{profilingGroupName}/frames/-/metrics
# Returns: record<endTime: string, endTimes: table<value: string>, frameMetricData: table<frameMetric: record, values: list>, resolution: string, startTime: string, unprocessedEndTimes: record>
# operationId: BatchGetFrameMetricData
export def "batch-get-frame-metric-data" [
  profiling_group_name: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --end-time: string # The end time of the time period for the returned time series values. This is specified using the ISO 8601 format. For example, 2020-06-01T13:15:02.001Z represents 1 millisecond past June 1, 2020 1:15:02 PM UTC. (format: date-time)
  --period: string # The duration of the frame metrics used to return the time series values. Specify using the ISO 8601 format. The maximum period duration is one day (PT24H or P1D).
  --start-time: string # The start time of the time period for the frame metrics used to return the time series values. This is specified using the ISO 8601 format. For example, 2020-06-01T13:15:02.001Z represents 1 millisecond past June 1, 2020 1:15:02 PM UTC. (format: date-time)
  --target-resolution: string@target-resolution-completer # The requested resolution of time steps for the returned time series of values. If the requested target resolution is not available due to data not being retained we provide a best effort result by falling back to the most granular available resolution after the target resolution. There are 3 valid values. P1D — 1 day PT1H — 1 hour PT5M — 5 minutes
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --frame-metrics: list # The details of the metrics that are used to request a time series of values. The metric includes the name of the frame, the aggregation type to calculate the metric value for the frame, and the thread states to use to get the count for the metric value of the frame. — item shape: {frameName: string, threadStates: list<string>, type: "AggregatedRelativeTotalTime"}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/profilingGroups/{profilingGroupName}/frames/-/metrics"
    path_params: [{name: profilingGroupName, var: profiling_group_name}]
    query: [{name: endTime, var: end_time}, {name: period, var: period}, {name: startTime, var: start_time}, {name: targetResolution, var: target_resolution}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: frameMetrics, var: frame_metrics}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    profiling_group_name: $profiling_group_name, end_time: $end_time, period: $period, start_time: $start_time, target_resolution: $target_resolution, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, frame_metrics: $frame_metrics
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Used by profiler agents to report their current state and to receive remote configuration updates. For example, ConfigureAgent can be used to tell an agent whether to profile or not and for how long to return profiling data.
#
# POST /profilingGroups/{profilingGroupName}/configureAgent
# Returns: record<configuration: record<agentParameters: record, periodInSeconds: int, shouldProfile: bool>>
# operationId: ConfigureAgent
export def "configure-agent" [
  profiling_group_name: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
