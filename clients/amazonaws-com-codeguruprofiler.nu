# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    add-notification-channels: "record<notificationConfiguration: record<channels: list<record>>>"
    get-notification-configuration: "record<notificationConfiguration: record<channels: list<record>>>"
    batch-get-frame-metric-data: "record<endTime: string, endTimes: table<value: string>, frameMetricData: table<frameMetric: record, values: list>, resolution: string, startTime: string, unprocessedEndTimes: record>"
    configure-agent: "record<configuration: record<agentParameters: record, periodInSeconds: int, shouldProfile: bool>>"
    create-profiling-group: "record<profilingGroup: record<agentOrchestrationConfig: record<profilingEnabled: bool>, arn: string, computePlatform: string, createdAt: string, name: string, profilingStatus: record<latestAgentOrchestratedAt: string, latestAgentProfileReportedAt: string, latestAggregatedProfile: record>, tags: record, updatedAt: string>>"
    delete-profiling-group: "record"
    describe-profiling-group: "record<profilingGroup: record<agentOrchestrationConfig: record<profilingEnabled: bool>, arn: string, computePlatform: string, createdAt: string, name: string, profilingStatus: record<latestAgentOrchestratedAt: string, latestAgentProfileReportedAt: string, latestAggregatedProfile: record>, tags: record, updatedAt: string>>"
    update-profiling-group: "record<profilingGroup: record<agentOrchestrationConfig: record<profilingEnabled: bool>, arn: string, computePlatform: string, createdAt: string, name: string, profilingStatus: record<latestAgentOrchestratedAt: string, latestAgentProfileReportedAt: string, latestAggregatedProfile: record>, tags: record, updatedAt: string>>"
    get-findings-report-account-summary: "record<nextToken: string, reportSummaries: table<id: string, profileEndTime: string, profileStartTime: string, profilingGroupName: string, totalNumberOfFindings: int>>"
    get-policy: "record<policy: string, revisionId: string>"
    get-profile: "record<profile: string>"
    get-recommendations: "record<anomalies: table<instances: list, metric: record, reason: string>, profileEndTime: string, profileStartTime: string, profilingGroupName: string, recommendations: table<allMatchesCount: int, allMatchesSum: float, endTime: string, pattern: record, startTime: string, topMatches: list>>"
    list-findings-reports: "record<findingsReportSummaries: table<id: string, profileEndTime: string, profileStartTime: string, profilingGroupName: string, totalNumberOfFindings: int>, nextToken: string>"
    list-profile-times: "record<nextToken: string, profileTimes: table<start: string>>"
    list-profiling-groups: "record<nextToken: string, profilingGroupNames: list<string>, profilingGroups: table<agentOrchestrationConfig: record, arn: string, computePlatform: string, createdAt: string, name: string, profilingStatus: record, tags: record, updatedAt: string>>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    post-agent-profile: "record"
    put-permission: "record<policy: string, revisionId: string>"
    remove-notification-channel: "record<notificationConfiguration: record<channels: list<record>>>"
    remove-permission: "record<policy: string, revisionId: string>"
    submit-feedback: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["add-notification-channels" "get-notification-configuration" "batch-get-frame-metric-data" "configure-agent" "create-profiling-group" "delete-profiling-group" "describe-profiling-group" "update-profiling-group" "get-findings-report-account-summary" "get-policy" "get-profile" "get-recommendations" "list-findings-reports" "list-profile-times" "list-profiling-groups" "list-tags-for-resource" "tag-resource" "post-agent-profile" "put-permission" "remove-notification-channel" "remove-permission" "submit-feedback" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Add up to 2 anomaly notifications channels for a profiling group.
#
# POST /profilingGroups/{profilingGroupName}/notificationConfiguration
# Returns: record<notificationConfiguration: record<channels: list<record>>>
# operationId: AddNotificationChannels
export def "add-notification-channels" [
  profiling_group_name: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  channels: list # One or 2 channels to report to when anomalies are detected. — item shape: {eventPublishers: list<string>, id?: string, uri: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/profilingGroups/{profilingGroupName}/notificationConfiguration"
    path_params: [{name: profilingGroupName, var: profiling_group_name}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: channels, var: channels}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    profiling_group_name: $profiling_group_name, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, channels: $channels
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

