# Creates a profiling group.
#
# POST /profilingGroups
# Returns: record<profilingGroup: record<agentOrchestrationConfig: record<profilingEnabled: bool>, arn: string, computePlatform: string, createdAt: string, name: string, profilingStatus: record<latestAgentOrchestratedAt: string, latestAgentProfileReportedAt: string, latestAggregatedProfile: record>, tags: record, updatedAt: string>>
# operationId: CreateProfilingGroup
export def "create-profiling-group" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --client-token: string # Amazon CodeGuru Profiler uses this universally unique identifier (UUID) to prevent the accidental creation of duplicate profiling groups if there are failures and retries. (required)
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
