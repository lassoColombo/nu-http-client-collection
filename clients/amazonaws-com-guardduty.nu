  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --enable: oneof<nothing, bool> # A Boolean value that specifies whether the detector is to be enabled.
  --client-token: string # The idempotency token for the create request.
  --finding-publishing-frequency: string@finding-publishing-frequency-completer # A value that specifies how frequently updated findings are exported.
  --data-sources: record # Contains information about which data sources are enabled. — shape: {S3Logs?: record, Kubernetes?: record, MalwareProtection?: record}
  --tags: record # The tags to be added to a new detector resource.
  --features: list # A list of features that will be configured for the detector. — item shape: {Name?: "S3_DATA_EVENTS"|"EKS_AUDIT_LOGS"|"EBS_MALWARE_PROTECTION"|"RDS_LOGIN_EVENTS"|"EKS_RUNTIME_MONITORING"|"LAMBDA_NETWORK_LOGS", Status?: "ENABLED"|"DISABLED", AdditionalConfiguration?: list}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/detector"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: enable, var: enable, required: true}, {name: clientToken, var: client_token}, {name: findingPublishingFrequency, var: finding_publishing_frequency}, {name: dataSources, var: data_sources}, {name: tags, var: tags}, {name: features, var: features}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, enable: $enable, client_token: $client_token, finding_publishing_frequency: $finding_publishing_frequency, data_sources: $data_sources, tags: $tags, features: $features
