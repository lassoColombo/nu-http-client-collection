# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    accept-administrator-invitation: "record"
    get-administrator-account: "record<Administrator: record<AccountId: string, InvitationId: string, RelationshipStatus: string, InvitedAt: string>>"
    accept-invitation: "record"
    get-master-account: "record<Master: record<AccountId: string, InvitationId: string, RelationshipStatus: string, InvitedAt: string>>"
    archive-findings: "record"
    create-detector: "record<DetectorId: string, UnprocessedDataSources: record<MalwareProtection: record<ScanEc2InstanceWithFindings: record, ServiceRole: string>>>"
    list-detectors: "record<DetectorIds: list<string>, NextToken: string>"
    create-filter: "record<Name: string>"
    list-filters: "record<FilterNames: list<string>, NextToken: string>"
    create-ip-set: "record<IpSetId: string>"
    list-ip-sets: "record<IpSetIds: list<string>, NextToken: string>"
    create-members: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    list-members: "record<Members: table<AccountId: string, DetectorId: string, MasterId: string, Email: string, RelationshipStatus: string, InvitedAt: string, UpdatedAt: string, AdministratorId: string>, NextToken: string>"
    create-publishing-destination: "record<DestinationId: string>"
    list-publishing-destinations: "record<Destinations: table<DestinationId: string, DestinationType: string, Status: string>, NextToken: string>"
    create-sample-findings: "record"
    create-threat-intel-set: "record<ThreatIntelSetId: string>"
    list-threat-intel-sets: "record<ThreatIntelSetIds: list<string>, NextToken: string>"
    decline-invitations: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    delete-detector: "record"
    get-detector: "record<CreatedAt: string, FindingPublishingFrequency: string, ServiceRole: string, Status: string, UpdatedAt: string, DataSources: record<CloudTrail: record<Status: string>, DNSLogs: record<Status: string>, FlowLogs: record<Status: string>, S3Logs: record<Status: string>, Kubernetes: record<AuditLogs: record>, MalwareProtection: record<ScanEc2InstanceWithFindings: record, ServiceRole: string>>, Tags: record, Features: table<Name: string, Status: string, UpdatedAt: string, AdditionalConfiguration: list>>"
    update-detector: "record"
    delete-filter: "record"
    get-filter: "record<Name: string, Description: string, Action: string, Rank: int, FindingCriteria: record<Criterion: record>, Tags: record>"
    update-filter: "record<Name: string>"
    delete-ip-set: "record"
    get-ip-set: "record<Name: string, Format: string, Location: string, Status: string, Tags: record>"
    update-ip-set: "record"
    delete-invitations: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    delete-members: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    delete-publishing-destination: "record"
    describe-publishing-destination: "record<DestinationId: string, DestinationType: string, Status: string, PublishingFailureStartTimestamp: int, DestinationProperties: record<DestinationArn: string, KmsKeyArn: string>>"
    update-publishing-destination: "record"
    delete-threat-intel-set: "record"
    get-threat-intel-set: "record<Name: string, Format: string, Location: string, Status: string, Tags: record>"
    update-threat-intel-set: "record"
    describe-malware-scans: "record<Scans: table<DetectorId: string, AdminDetectorId: string, ScanId: string, ScanStatus: string, FailureReason: string, ScanStartTime: string, ScanEndTime: string, TriggerDetails: record, ResourceDetails: record, ScanResultDetails: record, AccountId: string, TotalBytes: int, FileCount: int, AttachedVolumes: list>, NextToken: string>"
    describe-organization-configuration: "record<AutoEnable: bool, MemberAccountLimitReached: bool, DataSources: record<S3Logs: record<AutoEnable: bool>, Kubernetes: record<AuditLogs: record>, MalwareProtection: record<ScanEc2InstanceWithFindings: record>>, Features: table<Name: string, AutoEnable: string, AdditionalConfiguration: list>, NextToken: string, AutoEnableOrganizationMembers: string>"
    update-organization-configuration: "record"
    disable-organization-admin-account: "record"
    disassociate-from-administrator-account: "record"
    disassociate-from-master-account: "record"
    disassociate-members: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    enable-organization-admin-account: "record"
    get-coverage-statistics: "record<CoverageStatistics: record<CountByResourceType: record, CountByCoverageStatus: record>>"
    get-findings: "record<Findings: table<AccountId: string, Arn: string, Confidence: float, CreatedAt: string, Description: string, Id: string, Partition: string, Region: string, Resource: record, SchemaVersion: string, Service: record, Severity: float, Title: string, Type: string, UpdatedAt: string>>"
    get-findings-statistics: "record<FindingStatistics: record<CountBySeverity: record>>"
    get-invitations-count: "record<InvitationsCount: int>"
    get-malware-scan-settings: "record<ScanResourceCriteria: record<Include: record, Exclude: record>, EbsSnapshotPreservation: string>"
    update-malware-scan-settings: "record"
    get-member-detectors: "record<MemberDataSourceConfigurations: table<AccountId: string, DataSources: record, Features: list>, UnprocessedAccounts: table<AccountId: string, Result: string>>"
    get-members: "record<Members: table<AccountId: string, DetectorId: string, MasterId: string, Email: string, RelationshipStatus: string, InvitedAt: string, UpdatedAt: string, AdministratorId: string>, UnprocessedAccounts: table<AccountId: string, Result: string>>"
    get-remaining-free-trial-days: "record<Accounts: table<AccountId: string, DataSources: record, Features: list>, UnprocessedAccounts: table<AccountId: string, Result: string>>"
    get-usage-statistics: "record<UsageStatistics: record<SumByAccount: list<record>, SumByDataSource: list<record>, SumByResource: list<record>, TopResources: list<record>, SumByFeature: list<record>>, NextToken: string>"
    invite-members: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    list-coverage: "record<Resources: table<ResourceId: string, DetectorId: string, AccountId: string, ResourceDetails: record, CoverageStatus: string, Issue: string, UpdatedAt: string>, NextToken: string>"
    list-findings: "record<FindingIds: list<string>, NextToken: string>"
    list-invitations: "record<Invitations: table<AccountId: string, InvitationId: string, RelationshipStatus: string, InvitedAt: string>, NextToken: string>"
    list-organization-admin-accounts: "record<AdminAccounts: table<AdminAccountId: string, AdminStatus: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    start-monitoring-members: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    stop-monitoring-members: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
    unarchive-findings: "record"
    untag-resource: "record"
    update-findings-feedback: "record"
    update-member-detectors: "record<UnprocessedAccounts: table<AccountId: string, Result: string>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["accept-administrator-invitation" "get-administrator-account" "accept-invitation" "get-master-account" "archive-findings" "create-detector" "list-detectors" "create-filter" "list-filters" "create-ip-set" "list-ip-sets" "create-members" "list-members" "create-publishing-destination" "list-publishing-destinations" "create-sample-findings" "create-threat-intel-set" "list-threat-intel-sets" "decline-invitations" "delete-detector" "get-detector" "update-detector" "delete-filter" "get-filter" "update-filter" "delete-ip-set" "get-ip-set" "update-ip-set" "delete-invitations" "delete-members" "delete-publishing-destination" "describe-publishing-destination" "update-publishing-destination" "delete-threat-intel-set" "get-threat-intel-set" "update-threat-intel-set" "describe-malware-scans" "describe-organization-configuration" "update-organization-configuration" "disable-organization-admin-account" "disassociate-from-administrator-account" "disassociate-from-master-account" "disassociate-members" "enable-organization-admin-account" "get-coverage-statistics" "get-findings" "get-findings-statistics" "get-invitations-count" "get-malware-scan-settings" "update-malware-scan-settings" "get-member-detectors" "get-members" "get-remaining-free-trial-days" "get-usage-statistics" "invite-members" "list-coverage" "list-findings" "list-invitations" "list-organization-admin-accounts" "list-tags-for-resource" "tag-resource" "start-monitoring-members" "stop-monitoring-members" "unarchive-findings" "untag-resource" "update-findings-feedback" "update-member-detectors" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Accepts the invitation to be a member account and get monitored by a GuardDuty administrator account that sent the invitation.
#
# POST /detector/{detectorId}/administrator
# Returns: record
# operationId: AcceptAdministratorInvitation
export def "accept-administrator-invitation" [
  detector_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  administrator_id: string # The account ID of the GuardDuty administrator account whose invitation you're accepting.
  invitation_id: string # The value that is used to validate the administrator account to the member account.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/detector/{detectorId}/administrator"
    path_params: [{name: detectorId, var: detector_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: administratorId, var: administrator_id}, {name: invitationId, var: invitation_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    detector_id: $detector_id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, administrator_id: $administrator_id, invitation_id: $invitation_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

