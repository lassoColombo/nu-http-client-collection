    body: {content_type: "application/json", kind: json, fields: [{name: columns, var: columns}, {name: dataBoostEnabled, var: data_boost_enabled}, {name: index, var: index}, {name: keySet, var: key_set}, {name: limit, var: limit}, {name: partitionToken, var: partition_token}, {name: requestOptions, var: request_options}, {name: resumeToken, var: resume_token}, {name: table, var: table}, {name: transaction, var: transaction}]}
    accept: ["application/json"]
