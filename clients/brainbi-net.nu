  --email: string # required (e.g. fiver3r23@fiverr.de)
  --store-name: string # required (e.g. Fiverr Store)
  --store-url: string # required (e.g. https;//www.fiverr.de)
  --password: string # required (e.g. 12345678)
  --fromuser: string # required (always 1) (e.g. 1)
  --api-url: string # required (e.g. https://woocommerce-351439-1090797.cloudwaysapps.com/)
  --consumer-key: string # required (e.g. ck_59b23d313ae372feaf211652c318fbe4501abda2)
  --consumer-secret: string # required (e.g. cs_acc202d648bfa6b69efe553bb25086230ba116a7)
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "first_name" $first_name "scalar") (serialize-qp "last_name" $last_name "scalar") (serialize-qp "company_name" $company_name "scalar") (serialize-qp "shop_url" $shop_url "scalar") (serialize-qp "email" $email "scalar") (serialize-qp "store_name" $store_name "scalar") (serialize-qp "store_url" $store_url "scalar") (serialize-qp "password" $password "scalar") (serialize-qp "fromuser" $fromuser "scalar") (serialize-qp "api_url" $api_url "scalar") (serialize-qp "consumer_key" $consumer_key "scalar") (serialize-qp "consumer_secret" $consumer_secret "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/register_woocommerce" $qp $auth.query)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let req = {
    method: "post"
    url: $full_url
    query: ({"first_name": $first_name, "last_name": $last_name, "company_name": $company_name, "shop_url": $shop_url, "email": $email, "store_name": $store_name, "store_url": $store_url, "password": $password, "fromuser": $fromuser, "api_url": $api_url, "consumer_key": $consumer_key, "consumer_secret": $consumer_secret} | compact)
    headers: $auth.headers
    body: null
    content_type: "application/json"
    timeout: ($max_time | default 30min)
    auth: {scheme: $auth.scheme, location: $auth.location}
  }
  if $dry_run { return ({dry_run: true} | merge $req) }
  send-post $req null $insecure $raw $allow_errors $full [200]
}

