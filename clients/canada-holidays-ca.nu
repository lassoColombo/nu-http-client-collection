  let qp = [(serialize-qp "year" $year "scalar") (serialize-qp "optional" $optional "scalar")] | flatten | str join "&"
  let full_url = (build-url $base ({holiday_id: (encode-path-segment $holiday_id)} | format pattern "/api/v1/holidays/{holiday_id}") $qp $auth.query)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let req = {
    method: "get"
    url: $full_url
    query: ({"year": $year, "optional": $optional} | compact)
    headers: $auth.headers
    body: null
    content_type: null
    timeout: ($max_time | default 30min)
    auth: {scheme: $auth.scheme, location: $auth.location}
  }
  if $dry_run { return ({dry_run: true} | merge $req) }
  send-get $req $insecure $raw $allow_errors $full [200]
}

