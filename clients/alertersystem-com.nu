    method: post
    path: "/api/ping"
    body: {content_type: "application/json", kind: json, fields: [{name: expectNextPingAt, var: expect_next_ping_at}, {name: expectNextPingAtEpoch, var: expect_next_ping_at_epoch}, {name: monitor, var: monitor}, {name: pingCustomCode, var: ping_custom_code}, {name: pingCustomPayload, var: ping_custom_payload}]}
