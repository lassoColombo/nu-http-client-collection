# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-user-to-permission-group: "record<statusCode: int>"
    disassociate-user-from-permission-group: "record<statusCode: int>"
    create-changeset: "record<datasetId: string, changesetId: string>"
    list-changesets: "record<changesets: table<changesetId: string, changesetArn: string, datasetId: string, changeType: string, sourceParams: record, formatParams: record, createTime: int, status: string, errorInfo: record, activeUntilTimestamp: int, activeFromTimestamp: int, updatesChangesetId: string, updatedByChangesetId: string>, nextToken: string>"
    create-data-view: "record<datasetId: string, dataViewId: string>"
    list-data-views: "record<nextToken: string, dataViews: table<dataViewId: string, dataViewArn: string, datasetId: string, asOfTimestamp: int, partitionColumns: list, sortColumns: list, status: string, errorInfo: record, destinationTypeProperties: record, autoUpdate: bool, createTime: int, lastModifiedTime: int>>"
    create-dataset: "record<datasetId: string>"
    list-datasets: "record<datasets: table<datasetId: string, datasetArn: string, datasetTitle: string, kind: string, datasetDescription: string, ownerInfo: record, createTime: int, lastModifiedTime: int, schemaDefinition: record, alias: string>, nextToken: string>"
    create-permission-group: "record<permissionGroupId: string>"
    create-user: "record<userId: string>"
    delete-dataset: "record<datasetId: string>"
    get-dataset: "record<datasetId: string, datasetArn: string, datasetTitle: string, kind: string, datasetDescription: string, createTime: int, lastModifiedTime: int, schemaDefinition: record<tabularSchemaConfig: record<columns: list, primaryKeyColumns: list>>, alias: string, status: string>"
    update-dataset: "record<datasetId: string>"
    delete-permission-group: "record<permissionGroupId: string>"
    get-permission-group: "record<permissionGroup: record<permissionGroupId: string, name: string, description: string, applicationPermissions: list<string>, createTime: int, lastModifiedTime: int, membershipStatus: string>>"
    update-permission-group: "record<permissionGroupId: string>"
    disable-user: "record<userId: string>"
    enable-user: "record<userId: string>"
    get-changeset: "record<changesetId: string, changesetArn: string, datasetId: string, changeType: string, sourceParams: record, formatParams: record, createTime: int, status: string, errorInfo: record<errorMessage: string, errorCategory: string>, activeUntilTimestamp: int, activeFromTimestamp: int, updatesChangesetId: string, updatedByChangesetId: string>"
    update-changeset: "record<changesetId: string, datasetId: string>"
    get-data-view: "record<autoUpdate: bool, partitionColumns: list<string>, datasetId: string, asOfTimestamp: int, errorInfo: record<errorMessage: string, errorCategory: string>, lastModifiedTime: int, createTime: int, sortColumns: list<string>, dataViewId: string, dataViewArn: string, destinationTypeParams: record<destinationType: string, s3DestinationExportFileFormat: string, s3DestinationExportFileFormatOptions: record>, status: string>"
    get-external-data-view-access-details: "record<credentials: record<accessKeyId: string, secretAccessKey: string, sessionToken: string, expiration: int>, s3Location: record<bucket: string, key: string>>"
    get-programmatic-access-credentials: "record<credentials: record<accessKeyId: string, secretAccessKey: string, sessionToken: string>, durationInMinutes: int>"
    get-user: "record<userId: string, status: string, firstName: string, lastName: string, emailAddress: string, type: string, apiAccess: string, apiAccessPrincipalArn: string, createTime: int, lastEnabledTime: int, lastDisabledTime: int, lastModifiedTime: int, lastLoginTime: int>"
    update-user: "record<userId: string>"
    get-working-location: "record<s3Uri: string, s3Path: string, s3Bucket: string>"
    list-permission-groups: "record<permissionGroups: table<permissionGroupId: string, name: string, description: string, applicationPermissions: list, createTime: int, lastModifiedTime: int, membershipStatus: string>, nextToken: string>"
    list-permission-groups-by-user: "record<permissionGroups: table<permissionGroupId: string, name: string, membershipStatus: string>, nextToken: string>"
    list-users: "record<users: table<userId: string, status: string, firstName: string, lastName: string, emailAddress: string, type: string, apiAccess: string, apiAccessPrincipalArn: string, createTime: int, lastEnabledTime: int, lastDisabledTime: int, lastModifiedTime: int, lastLoginTime: int>, nextToken: string>"
    list-users-by-permission-group: "record<users: table<userId: string, status: string, firstName: string, lastName: string, emailAddress: string, type: string, apiAccess: string, apiAccessPrincipalArn: string, membershipStatus: string>, nextToken: string>"
    reset-user-password: "record<userId: string, temporaryPassword: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-user-to-permission-group" "disassociate-user-from-permission-group" "create-changeset" "list-changesets" "create-data-view" "list-data-views" "create-dataset" "list-datasets" "create-permission-group" "create-user" "delete-dataset" "get-dataset" "update-dataset" "delete-permission-group" "get-permission-group" "update-permission-group" "disable-user" "enable-user" "get-changeset" "update-changeset" "get-data-view" "get-external-data-view-access-details" "get-programmatic-access-credentials" "get-user" "update-user" "get-working-location" "list-permission-groups" "list-permission-groups-by-user" "list-users" "list-users-by-permission-group" "reset-user-password" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

