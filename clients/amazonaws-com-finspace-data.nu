  --as-of-timestamp: int # Milliseconds since UTC epoch
  destination_type_params: record # Structure for the Dataview destination type parameters. — shape: {destinationType?: string, s3DestinationExportFileFormat?: "PARQUET"|"DELIMITED_TEXT", s3DestinationExportFileFormatOptions?: record}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/datasets/{datasetId}/dataviewsv2"
    path_params: [{name: datasetId, var: dataset_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
