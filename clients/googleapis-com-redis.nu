    redis-projects-locations-instances-upgrade: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    redis-projects-locations-instances-list: "record<instances: table<alternativeLocationId: string, authEnabled: bool, authorizedNetwork: string, availableMaintenanceVersions: list, connectMode: string, createTime: string, currentLocationId: string, customerManagedKey: string, displayName: string, host: string, labels: record, locationId: string, maintenancePolicy: record, maintenanceSchedule: record, maintenanceVersion: string, memorySizeGb: int, name: string, nodes: list, persistenceConfig: record, persistenceIamIdentity: string, port: int, readEndpoint: string, readEndpointPort: int, readReplicasMode: string, redisConfigs: record, redisVersion: string, replicaCount: int, reservedIpRange: string, secondaryIpRange: string, serverCaCerts: list, state: string, statusMessage: string, suspensionReasons: list, tier: string, transitEncryptionMode: string>, nextPageToken: string, unreachable: list<string>>"
    redis-projects-locations-instances-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
