list<string>, installations_count: int, client_secret: string, webhook_secret: string, pem: string>, author_association: string, reactions: record<url: string, total_count: int, _1: int, _1: int, laugh: int, confused: int, heart: int, hooray: int, eyes: int, rocket: int>, sub_issues_summary: record<total: int, completed: int, percent_completed: int>> {
