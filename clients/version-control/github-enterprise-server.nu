  --event: string@event-completer # The review action you want to perform. The review actions include: `APPROVE`, `REQUEST_CHANGES`, or `COMMENT`. By leaving this blank, you set the review action state to `PENDING`, which means you will need to [submit the pull request review](https://docs.github.com/enterprise-server@3.11/rest/pulls/reviews#submit-a-review-for-a-pull-request) when you are ready.
  --comments: list # Use the following table to specify the location, destination, and contents of the draft review comment. — item shape: {path: string, position?: int, body: string, line?: int, side?: string, start_line?: int, start_side?: string}
