# Update a project
#
# PUT /api/v4/projects/{id}
# operationId: putApiV4ProjectsId
# --container_expiration_policy_attributes shape: {cadence?: string, keep_n?: int, older_than?: string, name_regex?: string, name_regex_keep?: string, enabled?: bool}
export def "projects put" [
  id: string
