  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

# Get currently authenticated user's issues statistics
#
# GET /api/v4/issues_statistics
# operationId: getApiV4IssuesStatistics
export def "issues-statistics get" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --labels: list # Comma-separated list of label names
  --milestone: string # Milestone title
  --milestone-id: string@milestone-id-completer # Return issues assigned to milestones with the specified timebox value ("Any", "None", "Upcoming" or "Started")
  --iids: list # The IID array of issues
  --search: string # Search issues for text present in the title, description, or any combination of these
  --in-param: string # `title`, `description`, or a string joining them with comma
  --author-id: int # Return issues which are authored by the user with the given ID (format: int32)
  --author-username: string # Return issues which are authored by the user with the given username
  --assignee-id: int # Return issues which are assigned to the user with the given ID (format: int32)
  --assignee-username: list # Return issues which are assigned to the user with the given username
  --created-after: string # Return issues created after the specified time (format: date-time)
  --created-before: string # Return issues created before the specified time (format: date-time)
  --updated-after: string # Return issues updated after the specified time (format: date-time)
  --updated-before: string # Return issues updated before the specified time (format: date-time)
  --notlabels: list # Comma-separated list of label names
  --notmilestone: string # Milestone title
  --notmilestone-id: string@notmilestone-id-completer # Return issues assigned to milestones without the specified timebox value ("Any", "None", "Upcoming" or "Started")
  --notiids: list # The IID array of issues
  --notauthor-id: int # Return issues which are not authored by the user with the given ID (format: int32)
  --notauthor-username: string # Return issues which are not authored by the user with the given username
  --notassignee-id: int # Return issues which are not assigned to the user with the given ID (format: int32)
  --notassignee-username: list # Return issues which are not assigned to the user with the given username
  --notweight: int # Return issues without the specified weight (format: int32)
  --notiteration-id: int # Return issues which are not assigned to the iteration with the given ID (format: int32)
  --notiteration-title: string # Return issues which are not assigned to the iteration with the given title
  --scope: string@scope-completer-10 # Return issues for the given scope: `created_by_me`, `assigned_to_me` or `all` (default: created_by_me)
  --my-reaction-emoji: string # Return issues reacted by the authenticated user by the given emoji
  --confidential: string@bool-completer # Filter confidential or public issues
  --weight: int # The weight of the issue (format: int32)
  --epic-id: int # The ID of an epic associated with the issues (format: int32)
  --health-status: string@health-status-completer # The health status of the issue. Must be one of: on_track, needs_attention, at_risk, none, any
  --iteration-id: int # Return issues which are assigned to the iteration with the given ID (format: int32)
  --iteration-title: string # Return issues which are assigned to the iteration with the given title
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "private-token"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "labels" $labels "csv") (serialize-qp "milestone" $milestone "scalar") (serialize-qp "milestone_id" $milestone_id "scalar") (serialize-qp "iids" $iids "csv") (serialize-qp "search" $search "scalar") (serialize-qp "in" $in_param "scalar") (serialize-qp "author_id" $author_id "scalar") (serialize-qp "author_username" $author_username "scalar") (serialize-qp "assignee_id" $assignee_id "scalar") (serialize-qp "assignee_username" $assignee_username "csv") (serialize-qp "created_after" $created_after "scalar") (serialize-qp "created_before" $created_before "scalar") (serialize-qp "updated_after" $updated_after "scalar") (serialize-qp "updated_before" $updated_before "scalar") (serialize-qp "not[labels]" $notlabels "csv") (serialize-qp "not[milestone]" $notmilestone "scalar") (serialize-qp "not[milestone_id]" $notmilestone_id "scalar") (serialize-qp "not[iids]" $notiids "csv") (serialize-qp "not[author_id]" $notauthor_id "scalar") (serialize-qp "not[author_username]" $notauthor_username "scalar") (serialize-qp "not[assignee_id]" $notassignee_id "scalar") (serialize-qp "not[assignee_username]" $notassignee_username "csv") (serialize-qp "not[weight]" $notweight "scalar") (serialize-qp "not[iteration_id]" $notiteration_id "scalar") (serialize-qp "not[iteration_title]" $notiteration_title "scalar") (serialize-qp "scope" $scope "scalar") (serialize-qp "my_reaction_emoji" $my_reaction_emoji "scalar") (serialize-qp "confidential" $confidential "scalar") (serialize-qp "weight" $weight "scalar") (serialize-qp "epic_id" $epic_id "scalar") (serialize-qp "health_status" $health_status "scalar") (serialize-qp "iteration_id" $iteration_id "scalar") (serialize-qp "iteration_title" $iteration_title "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/v4/issues_statistics" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

