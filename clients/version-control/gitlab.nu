  --author-username: string # Return issues which are authored by the user with the given username
  --assignee-id: int # Return issues which are assigned to the user with the given ID (format: int32)
  --assignee-username: list # Return issues which are assigned to the user with the given username
  --created-after: string # Return issues created after the specified time (format: date-time)
  --created-before: string # Return issues created before the specified time (format: date-time)
  --updated-after: string # Return issues updated after the specified time (format: date-time)
  --updated-before: string # Return issues updated before the specified time (format: date-time)
  --notlabels: list # Comma-separated list of label names
  --notmilestone: string # Milestone title
  --notmilestone-id: string@notmilestone-id-completer # Return issues assigned to milestones without the specified timebox value ("Any", "None", "Upcoming" or "Started")
