  --payment-intent-data: record # A subset of parameters to be passed to PaymentIntent creation for Checkout Sessions in `payment` mode. — shape: {application_fee_amount?: int, capture_method?: "automatic"|"manual", description?: string, metadata?: record, on_behalf_of?: string, receipt_email?: string, setup_future_usage?: "off_session"|"on_session", shipping?: record, statement_descriptor?: string, statement_descriptor_suffix?: string, transfer_data?: record, transfer_group?: string}
