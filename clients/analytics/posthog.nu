up: string, receive_org_level_activity_logs: bool, business_model: any, conversations_enabled: bool, conversations_settings: any, logs_settings: any, proactive_tasks_enabled: bool, available_setup_task_ids: list<string>, is_pending_deletion: bool, project_id: int, user_access_level: string, managed_viewsets: record, revenue_analytics_config: record<base_currency: string, events: any, goals: any, filter_test_accounts: bool>, marketing_analytics_config: record<sources_map: any, conversion_goals: any, attribution_window_days: int, attribution_mode: string, campaign_name_mappings: any, custom_source_mappings: any, campaign_field_preferences: any>, customer_analytics_config: record<activity_event: any, signup_pageview_event: any, signup_event: any, subscription_event: any, payment_event: any, account_group_type_index: int>, workflows_config: record<capture_workflows_engagement_events: bool>, base_currency: string, capture_dead_clicks: bool, cookieless_server_hash_mode: any, human_friendly_comparison_periods: bool, feature_flag_confirmation_enabled: bool, feature_flag_confirmation_message: string, default_evaluation_contexts_enabled: bool, require_evaluation_contexts: bool, default_data_theme: int, onboarding_tasks: any, web_analytics_pre_aggregated_tables_enabled: bool> {
