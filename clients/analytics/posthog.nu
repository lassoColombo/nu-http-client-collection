# List compact error tracking issues
#
# POST /api/projects/{project_id}/error_tracking/query/issues/
# operationId: error_tracking_query_issues_list_create
# --filterGroup item shape: {key: string, value: any, operator?: any, type?: any}
export def "projects-error-tracking-query-issues create" [
  project_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --dateRange: any # Date range for issue aggregates. Defaults to the last 7 days.
  --status: any # Filter by issue status. Defaults to active.  * `archived` - archived * `active` - active * `resolved` - resolved * `pending_release` - pending_release * `suppressed` - suppressed * `all` - all (default: active)
  --assignee: any # Filter by issue assignee. Omit to include all assignees.
  --filterTestAccounts: oneof<nothing, bool> # When true, exclude internal/test account data from results. Defaults to true. (default: true)
  --searchQuery: string # Free-text search across exception types, values, stack frames, and email fields.
  --filterGroup: list # Advanced flat AND property filters. Prefer typed shortcut fields when they fit. HogQL filters are rejected. — item shape: {key: string, value: any, operator?: any, type?: any}
  --orderBy: any # Field used to sort issues. Defaults to occurrences.  * `last_seen` - last_seen * `first_seen` - first_seen * `occurrences` - occurrences * `users` - users * `sessions` - sessions (default: occurrences)
  --orderDirection: any # Sort direction. Defaults to DESC.  * `ASC` - ASC * `DESC` - DESC (default: DESC)
  --limit: int # Page size. (default: 25)
  --offset: int # Pagination offset. (default: 0)
  --volumeResolution: int # Number of volume buckets. Defaults to 0 for compact aggregate counts. (default: 0)
  --library: any # Filter by SDK/library value from event $lib, for example posthog-js.
  --release: string # Filter by exact release ID, version, or git commit ID captured in $exception_releases.
  --fingerprint: any # Filter by exact exception fingerprint hash, not fuzzy search.
  --user: string # Search user/email text.
