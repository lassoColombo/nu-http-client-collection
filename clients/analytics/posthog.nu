  --dry-run(-n) # Return the request that would be sent without executing it
  --account-executive: string # Filter by account executive. Use 'unassigned' or an integer user id.
  --account-owner: string # Filter by account owner. Use 'unassigned' or an integer user id.
  --all-roles-unassigned: oneof<nothing, bool> # When true, returns only accounts where CSM, account executive, and account owner are all unset.
  --csm: string # Filter by CSM. Use 'unassigned' for accounts with no CSM, or an integer user id.
  --limit: int # Number of results to return per page.
