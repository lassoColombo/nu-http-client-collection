  --offset-day: int # Day-of-week offset for weekly intervals (0=Sunday, 6=Saturday). Only valid when interval is 'week'. (nullable)
  --offset-hour: int # Hour-of-day offset (0-23) for daily and weekly intervals. Only valid when interval is 'day' or 'week'. (nullable)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/api/organizations/($organization_id)/batch_exports/($id)/run_test_step/")
  let body = {name: $name, model: $model, destination: $destination, interval: $interval, paused: $paused, last_paused_at: $last_paused_at, start_at: $start_at, end_at: $end_at, hogql_query: $hogql_query, filters: $filters, timezone: $timezone, offset_day: $offset_day, offset_hour: $offset_hour} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json" $body
}

# Unpause a BatchExport.
#
# POST /api/organizations/{organization_id}/batch_exports/{id}/unpause/
# DEPRECATED
# operationId: org_organizations_batch_exports_unpause_create
# --latest_runs item shape: {status: any, records_completed?: int, records_failed?: int, latest_error?: string, data_interval_start?: string, data_interval_end: string, cursor?: string, finished_at?: string, records_total_count?: int, bytes_exported?: int, batch_export_on_demand?: string, backfill?: string}
@deprecated
export def "organizations-batch-exports-unpause create" [
  id: string
  organization_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  name: string # A human-readable name for this BatchExport.
  --model: any # Which model this BatchExport is exporting.  * `events` - Events * `persons` - Persons * `sessions` - Sessions
  destination: any # Destination configuration (type, config, and optional integration).
  interval: any # How often the batch export should run.  * `hour` - hour * `day` - day * `week` - week * `every 5 minutes` - every 5 minutes * `every 15 minutes` - every 15 minutes
  --paused: oneof<nothing, bool> # Whether this BatchExport is paused or not.
  --last-paused-at: string # The timestamp at which this BatchExport was last paused. (nullable, format: date-time)
  --start-at: string # Time before which any Batch Export runs won't be triggered. (nullable, format: date-time)
  --end-at: string # Time after which any Batch Export runs won't be triggered. (nullable, format: date-time)
