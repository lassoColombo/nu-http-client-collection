  --source-type: string # Only return stored credentials for this source type (e.g. 'Stripe', 'Postgres').
]: nothing -> table<credential_id: string, source_type: string, created_at: string, expires_at: string> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "search" $search "scalar") (serialize-qp "source_type" $source_type "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/api/projects/($project_id)/external_data_sources/stored_credentials/" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

