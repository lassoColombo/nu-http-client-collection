# Get person properties as they existed at a specific point in time.  This endpoint reconstructs person properties by querying ClickHouse events for $set and $set_once operations up to the specified timestamp.  Query parameters: - distinct_id: The distinct_id of the person - timestamp: ISO datetime string for the point in time (e.g., "2023-06-15T14:30:00Z") - include_set_once: Whether to handle $set_once operations (default: false)
#
# GET /api/projects/{project_id}/persons/properties_at_time/
# operationId: persons_properties_at_time_retrieve
export def "projects-persons-properties-at-time get" [
  project_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer-1 # Response content type
  --distinct-id: string # The distinct_id of the person (mutually exclusive with person_id)
  --format: string@format-completer-1
  --include-set-once: oneof<nothing, bool> # Whether to handle $set_once operations (default: false)
  --person-id: string # The person_id (UUID) to build properties for (mutually exclusive with distinct_id)
  --timestamp: string # ISO datetime string for the point in time (e.g., '2023-06-15T14:30:00Z')
]: nothing -> record<id: int, name: string, distinct_ids: list<string>, properties: record, created_at: string, uuid: string, last_seen_at: string, point_in_time_metadata: record<queried_timestamp: string, include_set_once: bool, distinct_id_used: string, person_id_used: string, query_mode: string, distinct_ids_queried: list<string>, distinct_ids_count: int>> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "distinct_id" $distinct_id "scalar") (serialize-qp "format" $format "scalar") (serialize-qp "include_set_once" $include_set_once "scalar") (serialize-qp "person_id" $person_id "scalar") (serialize-qp "timestamp" $timestamp "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/api/projects/($project_id)/persons/properties_at_time/" $qp)
  let accept_val = ($accept | default "application/json")
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

