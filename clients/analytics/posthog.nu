  --data-attributes: any # Element attributes that posthog-js should capture as action identifiers (e.g. `['data-attr']`).
  --person-display-name-properties: list # Ordered list of person properties used to render a human-friendly display name in the UI. (nullable)
  --correlation-config: any
  --autocapture-opt-out: oneof<nothing, bool> # Disables posthog-js autocapture (clicks, page views) when true. (nullable)
  --autocapture-exceptions-opt-in: oneof<nothing, bool> # Enables automatic capture of JavaScript exceptions via the SDK. (nullable)
  --autocapture-web-vitals-opt-in: oneof<nothing, bool> # Enables automatic capture of Core Web Vitals performance metrics. (nullable)
  --autocapture-web-vitals-allowed-metrics: any
  --autocapture-exceptions-errors-to-ignore: any
  --capture-console-log-opt-in: oneof<nothing, bool> # Enables capturing browser console logs alongside session replays. (nullable)
  --capture-performance-opt-in: oneof<nothing, bool> # Enables capturing performance timing and network requests. (nullable)
  --session-recording-opt-in: oneof<nothing, bool> # Enables session replay recording for this project.
  --session-recording-sample-rate: string # Fraction of sessions to record, as a decimal string between `0.00` and `1.00` (e.g. `0.1` = 10%). (nullable, format: decimal)
  --session-recording-minimum-duration-milliseconds: int # Skip saving sessions shorter than this many milliseconds. (nullable)
  --session-recording-linked-flag: any
  --session-recording-network-payload-capture-config: any
  --session-recording-masking-config: any
  --session-recording-url-trigger-config: list # nullable
  --session-recording-url-blocklist-config: list # nullable
  --session-recording-event-trigger-config: list # nullable
  --session-recording-trigger-match-type-config: string # nullable
  --session-recording-trigger-groups: any # V2 trigger groups configuration for session recording. If present, takes precedence over legacy trigger fields.
  --session-recording-retention-period: any # How long to retain new session recordings. One of `30d`, `90d`, `1y`, or `5y` (availability depends on plan).  * `30d` - 30 Days * `90d` - 90 Days * `1y` - 1 Year * `5y` - 5 Years
  --session-replay-config: any
  --survey-config: any
  --access-control: oneof<nothing, bool>
  --week-start-day: any # First day of the week for date range filters. 0 = Sunday, 1 = Monday.  * `0` - Sunday * `1` - Monday
  --primary-dashboard: int # ID of the dashboard shown as the project's default landing dashboard. (nullable)
  --live-events-columns: list # nullable
  --recording-domains: list # Origins permitted to record session replays and heatmaps. Empty list allows all origins. (nullable)
  --inject-web-apps: oneof<nothing, bool> # nullable
  --extra-settings: any
  --modifiers: any
  --has-completed-onboarding-for: any
  --surveys-opt-in: oneof<nothing, bool> # Enables displaying surveys via posthog-js on allowed origins. (nullable)
  --heatmaps-opt-in: oneof<nothing, bool> # Enables heatmap recording on pages that host posthog-js. (nullable)
  --flags-persistence-default: oneof<nothing, bool> # Default value for the `persist` option on newly created feature flags. (nullable)
  --receive-org-level-activity-logs: oneof<nothing, bool> # nullable
  --business-model: any # Whether this project serves B2B or B2C customers. Used to optimize default UI layouts.  * `b2b` - B2B * `b2c` - B2C * `other` - Other
  --conversations-enabled: oneof<nothing, bool> # Enables the customer conversations / live chat product for this project. (nullable)
  --conversations-settings: any
  --logs-settings: any
