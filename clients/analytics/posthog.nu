  --session-recording-retention-period: any # How long to retain new session recordings. One of `30d`, `90d`, `1y`, or `5y` (availability depends on plan).  * `30d` - 30 Days * `90d` - 90 Days * `1y` - 1 Year * `5y` - 5 Years
  --session-replay-config: any
  --survey-config: any
  --access-control: oneof<nothing, bool>
  --week-start-day: any # First day of the week for date range filters. 0 = Sunday, 1 = Monday.  * `0` - Sunday * `1` - Monday
  --primary-dashboard: int # ID of the dashboard shown as the project's default landing dashboard. (nullable)
  --live-events-columns: list # nullable
  --recording-domains: list # Origins permitted to record session replays and heatmaps. Empty list allows all origins. (nullable)
  --inject-web-apps: oneof<nothing, bool> # nullable
  --extra-settings: any
  --modifiers: any
  --has-completed-onboarding-for: any
  --surveys-opt-in: oneof<nothing, bool> # Enables displaying surveys via posthog-js on allowed origins. (nullable)
  --heatmaps-opt-in: oneof<nothing, bool> # Enables heatmap recording on pages that host posthog-js. (nullable)
  --flags-persistence-default: oneof<nothing, bool> # Default value for the `persist` option on newly created feature flags. (nullable)
  --receive-org-level-activity-logs: oneof<nothing, bool> # nullable
  --business-model: any # Whether this project serves B2B or B2C customers. Used to optimize default UI layouts.  * `b2b` - B2B * `b2c` - B2C * `other` - Other
  --conversations-enabled: oneof<nothing, bool> # Enables the customer conversations / live chat product for this project. (nullable)
