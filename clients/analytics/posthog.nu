  --after: string # Only return entries after this ISO 8601 timestamp. (format: date-time)
  --before: string # Only return entries before this ISO 8601 timestamp. (format: date-time)
  --instance-id: string # Filter logs to a specific execution instance.
  --level: string # Comma-separated log levels to include, e.g. 'WARN,ERROR'. Valid levels: DEBUG, LOG, INFO, WARN, ERROR.
  --limit: int # Maximum number of log entries to return (1-500, default 50). (default: 50)
  --search: string # Case-insensitive substring search across log messages.
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "after" $after "scalar") (serialize-qp "before" $before "scalar") (serialize-qp "instance_id" $instance_id "scalar") (serialize-qp "level" $level "scalar") (serialize-qp "limit" $limit "scalar") (serialize-qp "search" $search "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/api/organizations/($organization_id)/batch_exports/($id)/logs/" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

