  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --summarize-type: any # Type of entity to summarize. Inferred automatically when using trace_id or generation_id.  * `trace` - trace * `event` - event
  --mode: any # Summary detail level: 'minimal' for 3-5 points, 'detailed' for 5-10 points  * `minimal` - minimal * `detailed` - detailed (default: minimal)
  --data: any # Data to summarize. For traces: {trace, hierarchy}. For events: {event}. Not required when using trace_id or generation_id.
  --force-refresh: oneof<nothing, bool> # Force regenerate summary, bypassing cache (default: false)
  --model: string # LLM model to use (defaults based on provider) (nullable)
  --trace-id: string # Trace ID to summarize. The backend fetches the trace data automatically. Requires date_from for efficient lookup.
  --generation-id: string # Generation event UUID to summarize. The backend fetches the event data automatically. Requires date_from for efficient lookup.
  --date-from: string # Start of date range for ID-based lookup (e.g. '-7d' or '2026-01-01'). Defaults to -30d. (nullable)
  --date-to: string # End of date range for ID-based lookup. Defaults to now. (nullable)
]: any -> record<summary: record<title: string, flow_diagram: string, summary_bullets: list<record>, interesting_notes: list<record>>, text_repr: string, metadata: any> {
