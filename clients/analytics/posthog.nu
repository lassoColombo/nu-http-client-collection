# POST /api/projects/{project_id}/subscriptions/
#
# operationId: subscriptions_create
export def "projects-subscriptions create" [
  project_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --dashboard: int # Dashboard ID to subscribe to (mutually exclusive with insight on create). (nullable)
  --insight: int # Insight ID to subscribe to (mutually exclusive with dashboard on create). (nullable)
  --dashboard-export-insights: list # List of insight IDs from the dashboard to include. Required for dashboard subscriptions, max 6.
  --prompt: string # Free-text prompt that drives the AI-generated report. Required when resource_type is 'ai_prompt'. Max 4000 characters. (nullable)
  target_type: any # Delivery channel: email or slack.  * `email` - Email * `slack` - Slack
  target_value: string # Recipient(s): comma-separated email addresses for email, or Slack channel name/ID for slack.
  frequency: any # How often to deliver: daily, weekly, monthly, or yearly.  * `daily` - Daily * `weekly` - Weekly * `monthly` - Monthly * `yearly` - Yearly
  interval: int # Interval multiplier (e.g. 2 with weekly frequency means every 2 weeks). Required on create; must be 1 or greater.
  --byweekday: list # Days of week for weekly subscriptions: monday, tuesday, wednesday, thursday, friday, saturday, sunday. (nullable)
  --bysetpos: int # Position within byweekday set for monthly frequency (e.g. 1 for first, -1 for last). (nullable)
  --count: int # Total number of deliveries before the subscription stops. Null for unlimited. (nullable)
  start_date: string # When to start delivering (ISO 8601 datetime). (format: date-time)
  --until-date: string # When to stop delivering (ISO 8601 datetime). Null for indefinite. (nullable, format: date-time)
  --deleted: oneof<nothing, bool> # Set to true to soft-delete. Subscriptions cannot be hard-deleted.
  --enabled: oneof<nothing, bool> # Whether the subscription is active. Set to false to pause delivery without deleting. Auto-set to false when the delivery integration becomes invalid.
  --title: string # Human-readable name for this subscription. (nullable)
  --integration-id: int # ID of a connected Slack integration. Required when target_type is slack. (nullable)
  --invite-message: string # Optional message included in the invitation email when adding new recipients. (nullable)
  --summary-enabled: oneof<nothing, bool> # Whether to attach an AI-generated summary to each delivery (insight and dashboard subscriptions only). Requires the organization to have approved AI data processing, and is subject to the org's active-summary cap and AI credit budget; otherwise the write is rejected. Not applicable to prompt subscriptions, which are themselves AI-generated.
  --summary-prompt-guide: string # Optional free-text guidance (max 500 chars) steering the AI summary, e.g. which metrics to emphasize. Only settable when AI summary context is enabled for the organization; clearing it (empty string) is always allowed.
]: any -> record<id: int, resource_type: record, dashboard: int, insight: int, insight_short_id: string, resource_name: string, dashboard_export_insights: list<int>, prompt: string, target_type: record, target_value: string, frequency: record, interval: int, byweekday: list<string>, bysetpos: int, count: int, start_date: string, until_date: string, created_at: string, created_by: record<id: int, uuid: string, distinct_id: string, first_name: string, last_name: string, email: string, is_email_verified: bool, hedgehog_config: record, role_at_organization: any>, deleted: bool, enabled: bool, title: string, summary: string, next_delivery_date: string, integration_id: int, invite_message: string, summary_enabled: bool, summary_prompt_guide: string> {
