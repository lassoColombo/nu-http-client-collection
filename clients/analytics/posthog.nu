  domain: string # The custom domain to proxy through, e.g. 'e.example.com'. Must be a valid subdomain you control.
]: any -> record<id: string, domain: string, target_cname: string, status: record, message: string, created_at: string, updated_at: string, created_by: int> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/api/organizations/($organization_id)/proxy_records/")
