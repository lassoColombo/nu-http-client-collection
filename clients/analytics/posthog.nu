# Upsert a wizard session. The `session_id` key is the idempotency anchor — reposting the same `session_id` replaces the existing row. Returns 201 on create, 200 on update.
#
# POST /api/projects/{project_id}/wizard/sessions/
# operationId: wizard_sessions_create
# --tasks item shape: {id: string, title: string, status: "pending"|"in_progress"|"completed"|"failed"|"canceled"}
export def "projects-wizard-sessions create" [
  project_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  session_id: string # Stable identifier the wizard mints for this run (format: '{workflow_id}-{skill_id}-{started_at_iso}'). Reposting with the same session_id upserts the existing row.
  workflow_id: string # High-level workflow being run, e.g. 'onboarding', 'migration', 'audit'.
  skill_id: string # Specific skill within the workflow, e.g. 'nextjs', 'django', 'laravel'.
  started_at: string # UTC timestamp when the wizard started this run. Matches the timestamp encoded in session_id. (format: date-time)
  run_phase: any # Lifecycle stage of the wizard run.  * `idle` - IDLE * `running` - RUNNING * `completed` - COMPLETED * `error` - ERROR
  tasks: list # item shape: {id: string, title: string, status: "pending"|"in_progress"|"completed"|"failed"|"canceled"}
  --event-plan: record # Optional structured plan of events the wizard intends to instrument. Schema is workflow-specific. (nullable)
  --body-error: record # Populated when run_phase='error'. Shape: { type: string, message: string }. (nullable)
]: any -> record<session_id: string, team_id: int, workflow_id: string, skill_id: string, started_at: string, run_phase: string, tasks: table<id: string, title: string, status: string>, event_plan: record, error: record, created_at: string, updated_at: string, is_stale: bool> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/api/projects/($project_id)/wizard/sessions/")
  let body = {session_id: $session_id, workflow_id: $workflow_id, skill_id: $skill_id, started_at: $started_at, run_phase: $run_phase, tasks: $tasks, event_plan: $event_plan, error: $body_error} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
