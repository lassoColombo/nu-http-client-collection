  tags: list # Tag names to add, remove, or set.
]: any -> record<updated: table<id: int, tags: list>, skipped: table<id: int, reason: string>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
