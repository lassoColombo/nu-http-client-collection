  --logs-settings: any
  --capture-performance-opt-in: oneof<nothing, bool> # nullable
  --session-recording-opt-in: oneof<nothing, bool>
  --session-recording-sample-rate: string # nullable, format: decimal
  --session-recording-minimum-duration-milliseconds: int # nullable
  --session-recording-linked-flag: any
  --session-recording-network-payload-capture-config: any
  --session-recording-masking-config: any
  --session-recording-url-trigger-config: list # nullable
  --session-recording-url-blocklist-config: list # nullable
  --session-recording-event-trigger-config: list # nullable
  --session-recording-trigger-match-type-config: string # nullable
  --session-recording-trigger-groups: any # V2 trigger groups configuration for session recording. If present, takes precedence over legacy trigger fields.
  --session-recording-retention-period: string@session-recording-retention-period-completer # * `30d` - 30 Days * `90d` - 90 Days * `1y` - 1 Year * `5y` - 5 Years
  --session-replay-config: any
  --survey-config: any
  --week-start-day: any
  --primary-dashboard: int # nullable
  --live-events-columns: list # nullable
  --recording-domains: list # nullable
  --cookieless-server-hash-mode: any
  --human-friendly-comparison-periods: oneof<nothing, bool> # nullable
  --inject-web-apps: oneof<nothing, bool> # nullable
  --extra-settings: any
  --modifiers: any
  --has-completed-onboarding-for: any
  --surveys-opt-in: oneof<nothing, bool> # nullable
  --heatmaps-opt-in: oneof<nothing, bool> # nullable
  --flags-persistence-default: oneof<nothing, bool> # nullable
  --feature-flag-confirmation-enabled: oneof<nothing, bool> # nullable
