# Create a new experiment in draft status with optional metrics.
#
# POST /api/projects/{project_id}/experiments/
# operationId: experiments_create
# --saved_metrics item shape: {experiment: int, saved_metric: int, metadata?: any}
export def "projects-experiments create" [
  project_id: string
  --base-url(-b): string@base-url-completer # API base URL
