  --date-from: string # Start of the window. Relative (e.g. '-7d', '-30d', '-1mStart') or an absolute 'YYYY-MM-DD' date. Defaults to '-7d'. Heatmap data is retained for 90 days. (default: -7d)
  --date-to: string # End of the window, inclusive. Relative or absolute 'YYYY-MM-DD'. Defaults to today.
  --filter-test-accounts: oneof<nothing, bool> # When true, exclude sessions from internal/test accounts using the project's test-account filters.
  --hide-zero-coordinates: oneof<nothing, bool> # When true (default), drop interactions recorded at the (0, 0) origin, which are usually noise. (default: true)
  --type: string # The interaction type to return. One of: 'click' (default), 'rageclick', 'mousemove', or 'scrolldepth'. Scrolldepth returns scroll buckets instead of x/y coordinates. (default: click)
