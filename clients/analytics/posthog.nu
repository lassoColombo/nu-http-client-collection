  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "created_by" $created_by "scalar") (serialize-qp "date_from" $date_from "scalar") (serialize-qp "date_to" $date_to "scalar") (serialize-qp "distinct_id" $distinct_id "scalar") (serialize-qp "has_exceptions" $has_exceptions "scalar") (serialize-qp "has_visual_confirmation" $has_visual_confirmation "scalar") (serialize-qp "limit" $limit "scalar") (serialize-qp "offset" $offset "scalar") (serialize-qp "order" $order "scalar") (serialize-qp "outcome" $outcome "scalar") (serialize-qp "session_ids" $session_ids "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/api/projects/($project_id)/single_session_summaries/" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

