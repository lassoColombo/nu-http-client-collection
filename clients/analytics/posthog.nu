  --default-data-theme: int # nullable
  --revenue-analytics-config: record # shape: {base_currency?: "AED"|"AFN"|"ALL"|"AMD"|"ANG"|"AOA"|"ARS"|"AUD"|"AWG"|"AZN"|"BAM"|"BBD"|"BDT"|"BGN"|"BHD"|"BIF"|"BMD"|"BND"|"BOB"|"BRL"|"BSD"|"BTC"|"BTN"|"BWP"|"BYN"|"BZD"|"CAD"|"CDF"|"CHF"|"CLP"|"CNY"|"COP"|"CRC"|"CVE"|"CZK"|"DJF"|"DKK"|"DOP"|"DZD"|"EGP"|"ERN"|"ETB"|"EUR"|"FJD"|"GBP"|"GEL"|"GHS"|"GIP"|"GMD"|"GNF"|"GTQ"|"GYD"|"HKD"|"HNL"|"HRK"|"HTG"|"HUF"|"IDR"|"ILS"|"INR"|"IQD"|"IRR"|"ISK"|"JMD"|"JOD"|"JPY"|"KES"|"KGS"|"KHR"|"KMF"|"KRW"|"KWD"|"KYD"|"KZT"|"LAK"|"LBP"|"LKR"|"LRD"|"LTL"|"LVL"|"LSL"|"LYD"|"MAD"|"MDL"|"MGA"|"MKD"|"MMK"|"MNT"|"MOP"|"MRU"|"MTL"|"MUR"|"MVR"|"MWK"|"MXN"|"MYR"|"MZN"|"NAD"|"NGN"|"NIO"|"NOK"|"NPR"|"NZD"|"OMR"|"PAB"|"PEN"|"PGK"|"PHP"|"PKR"|"PLN"|"PYG"|"QAR"|"RON"|"RSD"|"RUB"|"RWF"|"SAR"|"SBD"|"SCR"|"SDG"|"SEK"|"SGD"|"SRD"|"SSP"|"STN"|"SYP"|"SZL"|"THB"|"TJS"|"TMT"|"TND"|"TOP"|"TRY"|"TTD"|"TWD"|"TZS"|"UAH"|"UGX"|"USD"|"UYU"|"UZS"|"VES"|"VND"|"VUV"|"WST"|"XAF"|"XCD"|"XOF"|"XPF"|"YER"|"ZAR"|"ZMW", events?: any, goals?: any, filter_test_accounts?: bool}
  --marketing-analytics-config: record # shape: {sources_map?: any, conversion_goals?: any, attribution_window_days?: int, attribution_mode?: "first_touch"|"last_touch"|"linear"|"time_decay"|"position_based", campaign_name_mappings?: any, custom_source_mappings?: any, campaign_field_preferences?: any}
  --customer-analytics-config: record # shape: {activity_event?: any, signup_pageview_event?: any, signup_event?: any, subscription_event?: any, payment_event?: any, account_group_type_index?: int}
  --onboarding-tasks: any
  --base-currency: any # default: USD
  --web-analytics-pre-aggregated-tables-enabled: oneof<nothing, bool> # nullable
  --receive-org-level-activity-logs: oneof<nothing, bool> # nullable
  --business-model: any # Whether this project serves B2B or B2C customers, used to optimize the UI layout.  * `b2b` - B2B * `b2c` - B2C * `other` - Other
  --conversations-enabled: oneof<nothing, bool> # nullable
  --conversations-settings: any
  --proactive-tasks-enabled: oneof<nothing, bool> # nullable
  --workflows-config: record # shape: {capture_workflows_engagement_events?: bool}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/api/projects/($project_id)/environments/($id)/experiments_config/")
  let body = {name: $name, access_control: $access_control, app_urls: $app_urls, anonymize_ips: $anonymize_ips, completed_snippet_onboarding: $completed_snippet_onboarding, test_account_filters: $test_account_filters, test_account_filters_default_checked: $test_account_filters_default_checked, path_cleaning_filters: $path_cleaning_filters, is_demo: $is_demo, timezone: $timezone, data_attributes: $data_attributes, person_display_name_properties: $person_display_name_properties, correlation_config: $correlation_config, autocapture_opt_out: $autocapture_opt_out, autocapture_exceptions_opt_in: $autocapture_exceptions_opt_in, autocapture_web_vitals_opt_in: $autocapture_web_vitals_opt_in, autocapture_web_vitals_allowed_metrics: $autocapture_web_vitals_allowed_metrics, autocapture_exceptions_errors_to_ignore: $autocapture_exceptions_errors_to_ignore, capture_console_log_opt_in: $capture_console_log_opt_in, logs_settings: $logs_settings, capture_performance_opt_in: $capture_performance_opt_in, session_recording_opt_in: $session_recording_opt_in, session_recording_sample_rate: $session_recording_sample_rate, session_recording_minimum_duration_milliseconds: $session_recording_minimum_duration_milliseconds, session_recording_linked_flag: $session_recording_linked_flag, session_recording_network_payload_capture_config: $session_recording_network_payload_capture_config, session_recording_masking_config: $session_recording_masking_config, session_recording_url_trigger_config: $session_recording_url_trigger_config, session_recording_url_blocklist_config: $session_recording_url_blocklist_config, session_recording_event_trigger_config: $session_recording_event_trigger_config, session_recording_trigger_match_type_config: $session_recording_trigger_match_type_config, session_recording_trigger_groups: $session_recording_trigger_groups, session_recording_retention_period: $session_recording_retention_period, session_replay_config: $session_replay_config, survey_config: $survey_config, week_start_day: $week_start_day, primary_dashboard: $primary_dashboard, live_events_columns: $live_events_columns, recording_domains: $recording_domains, cookieless_server_hash_mode: $cookieless_server_hash_mode, human_friendly_comparison_periods: $human_friendly_comparison_periods, inject_web_apps: $inject_web_apps, extra_settings: $extra_settings, modifiers: $modifiers, has_completed_onboarding_for: $has_completed_onboarding_for, surveys_opt_in: $surveys_opt_in, heatmaps_opt_in: $heatmaps_opt_in, flags_persistence_default: $flags_persistence_default, feature_flag_confirmation_enabled: $feature_flag_confirmation_enabled, feature_flag_confirmation_message: $feature_flag_confirmation_message, default_evaluation_contexts_enabled: $default_evaluation_contexts_enabled, require_evaluation_contexts: $require_evaluation_contexts, capture_dead_clicks: $capture_dead_clicks, default_data_theme: $default_data_theme, revenue_analytics_config: $revenue_analytics_config, marketing_analytics_config: $marketing_analytics_config, customer_analytics_config: $customer_analytics_config, onboarding_tasks: $onboarding_tasks, base_currency: $base_currency, web_analytics_pre_aggregated_tables_enabled: $web_analytics_pre_aggregated_tables_enabled, receive_org_level_activity_logs: $receive_org_level_activity_logs, business_model: $business_model, conversations_enabled: $conversations_enabled, conversations_settings: $conversations_settings, proactive_tasks_enabled: $proactive_tasks_enabled, workflows_config: $workflows_config} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "patch" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json" $body
}

