# List stored AI-generated session summaries for the team, one row per session (latest summary kept). Use to discover which sessions have been summarized and to filter for sessions with specific problems — `has_exceptions=true`, `outcome=failure`, or a custom `session_ids` narrowing. Returns lightweight rows without the full summary JSON; use the retrieve endpoint for the per-segment / per-action detail.
#
# GET /api/projects/{project_id}/single_session_summaries/
# operationId: single_session_summaries_list
export def "projects-single-session-summaries list" [
  project_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --created-by: string # Filter to summaries triggered by a specific user, identified by `User.uuid`.
  --date-from: string # Inclusive lower bound on `created_at`, accepts relative shorthand like `-7d`.
  --date-to: string # Inclusive upper bound on `created_at`, accepts relative shorthand like `-1d`.
  --distinct-id: string # Filter to summaries for a single user (the session's `distinct_id`).
  --has-exceptions: oneof<nothing, bool> # When true, only summaries that surfaced one or more exception events; when false, only summaries without exceptions.
  --has-visual-confirmation: oneof<nothing, bool> # When true, only summaries produced via the video-based visual-confirmation workflow.
  --limit: int # Number of results to return per page.
  --offset: int # The initial index from which to return the results.
  --order: string@order-completer-1 # Ordering field, defaults to `-created_at` (most recent first). Allowed: `created_at`, `session_start_time`, `session_duration` (prefix with `-` for descending).
  --outcome: string@outcome-completer # Filter by the summary's recorded `session_outcome.success` field. `success` for true, `failure` for false, `unknown` for summaries without an outcome.
  --session-ids: string # Comma-separated list of session IDs to restrict the result to (uses the `(team, session_id)` index).
]: nothing -> record<count: int, next: string, previous: string, results: table<id: string, session_id: string, distinct_id: string, session_start_time: string, session_duration: int, session_outcome: record, exception_count: int, has_exceptions: bool, model_used: string, visual_confirmation: bool, extra_summary_context: record, created_at: string, created_by: any>> {
