  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  event_type: any # Type of LLM event to stringify  * `$ai_generation` - $ai_generation * `$ai_span` - $ai_span * `$ai_embedding` - $ai_embedding * `$ai_trace` - $ai_trace
  data: any # Event data to stringify. For traces, should include 'trace' and 'hierarchy' fields.
  --options: any # Optional configuration for text generation
]: any -> record<text: string, metadata: record<event_type: string, event_id: string, trace_id: string, rendering: string, char_count: int, truncated: bool, error: string>> {
