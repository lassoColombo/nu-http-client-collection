    body: {content_type: "application/json", kind: json, fields: [{name: dataRefreshWindowDays, var: data_refresh_window_days}, {name: dataSourceId, var: data_source_id}, {name: destinationDatasetId, var: destination_dataset_id}, {name: disabled, var: disabled}, {name: displayName, var: display_name}, {name: emailPreferences, var: email_preferences}, {name: name, var: name}, {name: notificationPubsubTopic, var: notification_pubsub_topic}, {name: ownerInfo, var: owner_info}, {name: params, var: params}, {name: schedule, var: schedule}, {name: scheduleOptions, var: schedule_options}, {name: userId, var: user_id}]}
    accept: ["application/json"]
    ok: [200]
