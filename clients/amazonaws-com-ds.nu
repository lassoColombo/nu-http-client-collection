# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    accept-shared-directory: "record<SharedDirectory: record<OwnerAccountId: string, OwnerDirectoryId: string, ShareMethod: string, SharedAccountId: string, SharedDirectoryId: string, ShareStatus: string, ShareNotes: string, CreatedDateTime: string, LastUpdatedDateTime: string>>"
    add-ip-routes: "record"
    add-region: "record"
    add-tags-to-resource: "record"
    cancel-schema-extension: "record"
    connect-directory: "record<DirectoryId: string>"
    create-alias: "record<DirectoryId: string, Alias: string>"
    create-computer: "record<Computer: record<ComputerId: string, ComputerName: string, ComputerAttributes: list<record>>>"
    create-conditional-forwarder: "record"
    create-directory: "record<DirectoryId: string>"
    create-log-subscription: "record"
    create-microsoft-ad: "record<DirectoryId: string>"
    create-snapshot: "record<SnapshotId: string>"
    create-trust: "record<TrustId: string>"
    delete-conditional-forwarder: "record"
    delete-directory: "record<DirectoryId: string>"
    delete-log-subscription: "record"
    delete-snapshot: "record<SnapshotId: string>"
    delete-trust: "record<TrustId: string>"
    deregister-certificate: "record"
    deregister-event-topic: "record"
    describe-certificate: "record<Certificate: record<CertificateId: string, State: string, StateReason: string, CommonName: string, RegisteredDateTime: string, ExpiryDateTime: string, Type: string, ClientCertAuthSettings: record<OCSPUrl: string>>>"
    describe-client-authentication-settings: "record<ClientAuthenticationSettingsInfo: table<Type: string, Status: string, LastUpdatedDateTime: string>, NextToken: string>"
    describe-conditional-forwarders: "record<ConditionalForwarders: table<RemoteDomainName: string, DnsIpAddrs: list, ReplicationScope: string>>"
    describe-directories: "record<DirectoryDescriptions: table<DirectoryId: string, Name: string, ShortName: string, Size: string, Edition: string, Alias: string, AccessUrl: string, Description: string, DnsIpAddrs: list, Stage: string, ShareStatus: string, ShareMethod: string, ShareNotes: string, LaunchTime: string, StageLastUpdatedDateTime: string, Type: string, VpcSettings: record, ConnectSettings: record, RadiusSettings: record, RadiusStatus: string, StageReason: string, SsoEnabled: bool, DesiredNumberOfDomainControllers: int, OwnerDirectoryDescription: record, RegionsInfo: record, OsVersion: string>, NextToken: string>"
    describe-domain-controllers: "record<DomainControllers: table<DirectoryId: string, DomainControllerId: string, DnsIpAddr: string, VpcId: string, SubnetId: string, AvailabilityZone: string, Status: string, StatusReason: string, LaunchTime: string, StatusLastUpdatedDateTime: string>, NextToken: string>"
    describe-event-topics: "record<EventTopics: table<DirectoryId: string, TopicName: string, TopicArn: string, CreatedDateTime: string, Status: string>>"
    describe-ldaps-settings: "record<LDAPSSettingsInfo: table<LDAPSStatus: string, LDAPSStatusReason: string, LastUpdatedDateTime: string>, NextToken: string>"
    describe-regions: "record<RegionsDescription: table<DirectoryId: string, RegionName: string, RegionType: string, Status: string, VpcSettings: record, DesiredNumberOfDomainControllers: int, LaunchTime: string, StatusLastUpdatedDateTime: string, LastUpdatedDateTime: string>, NextToken: string>"
    describe-settings: "record<DirectoryId: string, SettingEntries: table<Type: string, Name: string, AllowedValues: string, AppliedValue: string, RequestedValue: string, RequestStatus: string, RequestDetailedStatus: record, RequestStatusMessage: string, LastUpdatedDateTime: string, LastRequestedDateTime: string>, NextToken: string>"
    describe-shared-directories: "record<SharedDirectories: table<OwnerAccountId: string, OwnerDirectoryId: string, ShareMethod: string, SharedAccountId: string, SharedDirectoryId: string, ShareStatus: string, ShareNotes: string, CreatedDateTime: string, LastUpdatedDateTime: string>, NextToken: string>"
    describe-snapshots: "record<Snapshots: table<DirectoryId: string, SnapshotId: string, Type: string, Name: string, Status: string, StartTime: string>, NextToken: string>"
    describe-trusts: "record<Trusts: table<DirectoryId: string, TrustId: string, RemoteDomainName: string, TrustType: string, TrustDirection: string, TrustState: string, CreatedDateTime: string, LastUpdatedDateTime: string, StateLastUpdatedDateTime: string, TrustStateReason: string, SelectiveAuth: string>, NextToken: string>"
    describe-update-directory: "record<UpdateActivities: table<Region: string, Status: string, StatusReason: string, InitiatedBy: string, NewValue: record, PreviousValue: record, StartTime: string, LastUpdatedDateTime: string>, NextToken: string>"
    disable-client-authentication: "record"
    disable-ldaps: "record"
    disable-radius: "record"
    disable-sso: "record"
    enable-client-authentication: "record"
    enable-ldaps: "record"
    enable-radius: "record"
    enable-sso: "record"
    get-directory-limits: "record<DirectoryLimits: record<CloudOnlyDirectoriesLimit: int, CloudOnlyDirectoriesCurrentCount: int, CloudOnlyDirectoriesLimitReached: bool, CloudOnlyMicrosoftADLimit: int, CloudOnlyMicrosoftADCurrentCount: int, CloudOnlyMicrosoftADLimitReached: bool, ConnectedDirectoriesLimit: int, ConnectedDirectoriesCurrentCount: int, ConnectedDirectoriesLimitReached: bool>>"
    get-snapshot-limits: "record<SnapshotLimits: record<ManualSnapshotsLimit: int, ManualSnapshotsCurrentCount: int, ManualSnapshotsLimitReached: bool>>"
    list-certificates: "record<NextToken: string, CertificatesInfo: table<CertificateId: string, CommonName: string, State: string, ExpiryDateTime: string, Type: string>>"
    list-ip-routes: "record<IpRoutesInfo: table<DirectoryId: string, CidrIp: string, IpRouteStatusMsg: string, AddedDateTime: string, IpRouteStatusReason: string, Description: string>, NextToken: string>"
    list-log-subscriptions: "record<LogSubscriptions: table<DirectoryId: string, LogGroupName: string, SubscriptionCreatedDateTime: string>, NextToken: string>"
    list-schema-extensions: "record<SchemaExtensionsInfo: table<DirectoryId: string, SchemaExtensionId: string, Description: string, SchemaExtensionStatus: string, SchemaExtensionStatusReason: string, StartDateTime: string, EndDateTime: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>, NextToken: string>"
    register-certificate: "record<CertificateId: string>"
    register-event-topic: "record"
    reject-shared-directory: "record<SharedDirectoryId: string>"
    remove-ip-routes: "record"
    remove-region: "record"
    remove-tags-from-resource: "record"
    reset-user-password: "record"
    restore-from-snapshot: "record"
    share-directory: "record<SharedDirectoryId: string>"
    start-schema-extension: "record<SchemaExtensionId: string>"
    unshare-directory: "record<SharedDirectoryId: string>"
    update-conditional-forwarder: "record"
    update-directory-setup: "record"
    update-number-of-domain-controllers: "record"
    update-radius: "record"
    update-settings: "record<DirectoryId: string>"
    update-trust: "record<RequestId: string, TrustId: string>"
    verify-trust: "record<TrustId: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["accept-shared-directory" "add-ip-routes" "add-region" "add-tags-to-resource" "cancel-schema-extension" "connect-directory" "create-alias" "create-computer" "create-conditional-forwarder" "create-directory" "create-log-subscription" "create-microsoft-ad" "create-snapshot" "create-trust" "delete-conditional-forwarder" "delete-directory" "delete-log-subscription" "delete-snapshot" "delete-trust" "deregister-certificate" "deregister-event-topic" "describe-certificate" "describe-client-authentication-settings" "describe-conditional-forwarders" "describe-directories" "describe-domain-controllers" "describe-event-topics" "describe-ldaps-settings" "describe-regions" "describe-settings" "describe-shared-directories" "describe-snapshots" "describe-trusts" "describe-update-directory" "disable-client-authentication" "disable-ldaps" "disable-radius" "disable-sso" "enable-client-authentication" "enable-ldaps" "enable-radius" "enable-sso" "get-directory-limits" "get-snapshot-limits" "list-certificates" "list-ip-routes" "list-log-subscriptions" "list-schema-extensions" "list-tags-for-resource" "register-certificate" "register-event-topic" "reject-shared-directory" "remove-ip-routes" "remove-region" "remove-tags-from-resource" "reset-user-password" "restore-from-snapshot" "share-directory" "start-schema-extension" "unshare-directory" "update-conditional-forwarder" "update-directory-setup" "update-number-of-domain-controllers" "update-radius" "update-settings" "update-trust" "verify-trust" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Accepts a directory sharing request that was sent from the directory owner account.
#
# POST /
# Returns: record<SharedDirectory: record<OwnerAccountId: string, OwnerDirectoryId: string, ShareMethod: string, SharedAccountId: string, SharedDirectoryId: string, ShareStatus: string, ShareNotes: string, CreatedDateTime: string, LastUpdatedDateTime: string>>
# operationId: AcceptSharedDirectory
export def "accept-shared-directory" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  shared_directory_id: string # Identifier of the shared directory in the directory consumer account. This identifier is different for each directory owner account.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "DirectoryService_20150416.AcceptSharedDirectory"}]
    body: {content_type: "application/json", kind: json, fields: [{name: SharedDirectoryId, var: shared_directory_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, shared_directory_id: $shared_directory_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# If the DNS server for your self-managed domain uses a publicly addressable IP address, you must add a CIDR address block to correctly route traffic to and from your Microsoft AD on Amazon Web Services. AddIpRoutes adds this address block. You can also use AddIpRoutes to facilitate routing traffic that uses public IP ranges from your Microsoft AD on Amazon Web Services to a peer VPC. Before you call AddIpRoutes, ensure that all of the required permissions have been explicitly granted through a policy. For details about what permissions are required to run the AddIpRoutes operation, see Directory Service API Permissions: Actions, Resources, and Conditions Reference (http://docs.aws.amazon.com/directoryservice/latest/admin-guide/UsingWithDS_IAM_ResourcePermissions.html).
#
# POST /
# Returns: record
# operationId: AddIpRoutes
export def "add-ip-routes" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-1 # required
