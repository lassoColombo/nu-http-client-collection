  let full_url = (build-url $base ({parent: (encode-path-segment $parent)} | format pattern "/v2beta1/{parent}/traceSinks") $qp $auth.query)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let req = {
