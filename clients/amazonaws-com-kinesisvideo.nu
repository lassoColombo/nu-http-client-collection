def operation-completer [] { ["DECREASE_DATA_RETENTION" "INCREASE_DATA_RETENTION"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-signaling-channel: "record<ChannelARN: string>"
    create-stream: "record<StreamARN: string>"
    delete-signaling-channel: "record"
    delete-stream: "record"
    describe-edge-configuration: "record<StreamName: string, StreamARN: string, CreationTime: string, LastUpdatedTime: string, SyncStatus: string, FailedStatusDetails: string, EdgeConfig: record<HubDeviceArn: string, RecorderConfig: record<MediaSourceConfig: record, ScheduleConfig: record>, UploaderConfig: record<ScheduleConfig: record>, DeletionConfig: record<EdgeRetentionInHours: int, LocalSizeConfig: record, DeleteAfterUpload: bool>>>"
    describe-image-generation-configuration: "record<ImageGenerationConfiguration: record<Status: string, ImageSelectorType: string, DestinationConfig: record<Uri: string, DestinationRegion: string>, SamplingInterval: int, Format: string, FormatConfig: record, WidthPixels: int, HeightPixels: int>>"
    describe-mapped-resource-configuration: "record<MappedResourceConfigurationList: table<Type: string, ARN: string>, NextToken: string>"
    describe-media-storage-configuration: "record<MediaStorageConfiguration: record<StreamARN: string, Status: string>>"
    describe-notification-configuration: "record<NotificationConfiguration: record<Status: string, DestinationConfig: record<Uri: string>>>"
    describe-signaling-channel: "record<ChannelInfo: record<ChannelName: string, ChannelARN: string, ChannelType: string, ChannelStatus: string, CreationTime: string, SingleMasterConfiguration: record<MessageTtlSeconds: int>, Version: string>>"
    describe-stream: "record<StreamInfo: record<DeviceName: string, StreamName: string, StreamARN: string, MediaType: string, KmsKeyId: string, Version: string, Status: string, CreationTime: string, DataRetentionInHours: int>>"
    get-data-endpoint: "record<DataEndpoint: string>"
    get-signaling-channel-endpoint: "record<ResourceEndpointList: table<Protocol: string, ResourceEndpoint: string>>"
    list-signaling-channels: "record<ChannelInfoList: table<ChannelName: string, ChannelARN: string, ChannelType: string, ChannelStatus: string, CreationTime: string, SingleMasterConfiguration: record, Version: string>, NextToken: string>"
    list-streams: "record<StreamInfoList: table<DeviceName: string, StreamName: string, StreamARN: string, MediaType: string, KmsKeyId: string, Version: string, Status: string, CreationTime: string, DataRetentionInHours: int>, NextToken: string>"
    list-tags-for-resource: "record<NextToken: string, Tags: record>"
    list-tags-for-stream: "record<NextToken: string, Tags: record>"
    start-edge-configuration-update: "record<StreamName: string, StreamARN: string, CreationTime: string, LastUpdatedTime: string, SyncStatus: string, FailedStatusDetails: string, EdgeConfig: record<HubDeviceArn: string, RecorderConfig: record<MediaSourceConfig: record, ScheduleConfig: record>, UploaderConfig: record<ScheduleConfig: record>, DeletionConfig: record<EdgeRetentionInHours: int, LocalSizeConfig: record, DeleteAfterUpload: bool>>>"
    tag-resource: "record"
    tag-stream: "record"
    untag-resource: "record"
    untag-stream: "record"
    update-data-retention: "record"
    update-image-generation-configuration: "record"
    update-media-storage-configuration: "record"
    update-notification-configuration: "record"
    update-signaling-channel: "record"
    update-stream: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-signaling-channel" "create-stream" "delete-signaling-channel" "delete-stream" "describe-edge-configuration" "describe-image-generation-configuration" "describe-mapped-resource-configuration" "describe-media-storage-configuration" "describe-notification-configuration" "describe-signaling-channel" "describe-stream" "get-data-endpoint" "get-signaling-channel-endpoint" "list-signaling-channels" "list-streams" "list-tags-for-resource" "list-tags-for-stream" "start-edge-configuration-update" "tag-resource" "tag-stream" "untag-resource" "untag-stream" "update-data-retention" "update-image-generation-configuration" "update-media-storage-configuration" "update-notification-configuration" "update-signaling-channel" "update-stream" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

