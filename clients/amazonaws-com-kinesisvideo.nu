    body: {content_type: "application/json", kind: json, fields: [{name: DeviceName, var: device_name}, {name: StreamName, var: stream_name}, {name: MediaType, var: media_type}, {name: KmsKeyId, var: kms_key_id}, {name: DataRetentionInHours, var: data_retention_in_hours}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
