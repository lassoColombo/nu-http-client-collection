  --account-token: string # An [account token](https://api.stripe.com#create_account_token), used to securely provide details to the account.
  --bank-account: any # Either a token, like the ones returned by [Stripe.js](https://stripe.com/docs/js), or a dictionary containing a user's bank account details.
  --business-profile: record # Business information about the account. — shape: {annual_revenue?: record, estimated_worker_count?: int, mcc?: string, minority_owned_business_designation?: list, monthly_estimated_revenue?: record, name?: string, product_description?: string, support_address?: record, support_email?: string, support_phone?: string, support_url?: any, url?: string}
  --business-type: string@business-type-completer # The business type. Once you create an [Account Link](/api/account_links) or [Account Session](/api/account_sessions), this property can only be updated for accounts where [controller.requirement_collection](/api/accounts/object#account_object-controller-requirement_collection) is `application`, which includes Custom accounts.
  --capabilities: record # Each key of the dictionary represents a capability, and each capability maps to its settings (for example, whether it has been requested or not). Each capability is inactive until you have provided its specific requirements and Stripe has verified them. An account might have some of its requested capabilities be active and some be inactive.  Required when [account.controller.stripe_dashboard.type](/api/accounts/create#create_account-controller-dashboard-type) is `none`, which includes Custom accounts. — shape: {acss_debit_payments?: record, affirm_payments?: record, afterpay_clearpay_payments?: record, alma_payments?: record, amazon_pay_payments?: record, app_distribution?: record, au_becs_debit_payments?: record, bacs_debit_payments?: record, bancontact_payments?: record, bank_transfer_payments?: record, billie_payments?: record, bizum_payments?: record, blik_payments?: record, boleto_payments?: record, card_issuing?: record, card_payments?: record, cartes_bancaires_payments?: record, cashapp_payments?: record, crypto_payments?: record, eps_payments?: record, fpx_payments?: record, gb_bank_transfer_payments?: record, giropay_payments?: record, grabpay_payments?: record, ideal_payments?: record, india_international_payments?: record, jcb_payments?: record, jp_bank_transfer_payments?: record, kakao_pay_payments?: record, klarna_payments?: record, konbini_payments?: record, kr_card_payments?: record, legacy_payments?: record, link_payments?: record, mb_way_payments?: record, mobilepay_payments?: record, multibanco_payments?: record, mx_bank_transfer_payments?: record, naver_pay_payments?: record, nz_bank_account_becs_debit_payments?: record, oxxo_payments?: record, p24_payments?: record, pay_by_bank_payments?: record, payco_payments?: record, paynow_payments?: record, payto_payments?: record, pix_payments?: record, promptpay_payments?: record, revolut_pay_payments?: record, samsung_pay_payments?: record, satispay_payments?: record, scalapay_payments?: record, sepa_bank_transfer_payments?: record, sepa_debit_payments?: record, sofort_payments?: record, sunbit_payments?: record, swish_payments?: record, tax_reporting_us_1099_k?: record, tax_reporting_us_1099_misc?: record, transfers?: record, treasury?: record, twint_payments?: record, upi_payments?: record, us_bank_account_ach_payments?: record, us_bank_transfer_payments?: record, zip_payments?: record}
  --company: record # Information about the company or business. This field is available for any `business_type`. Once you create an [Account Link](/api/account_links) or [Account Session](/api/account_sessions), this property can only be updated for accounts where [controller.requirement_collection](/api/accounts/object#account_object-controller-requirement_collection) is `application`, which includes Custom accounts. — shape: {address?: record, address_kana?: record, address_kanji?: record, directors_provided?: bool, directorship_declaration?: record, executives_provided?: bool, export_license_id?: string, export_purpose_code?: string, name?: string, name_kana?: string, name_kanji?: string, owners_provided?: bool, ownership_declaration?: record, ownership_exemption_reason?: ""|"qualified_entity_exceeds_ownership_threshold"|"qualifies_as_financial_institution", phone?: string, registration_date?: any, registration_number?: string, representative_declaration?: record, structure?: ""|"free_zone_establishment"|"free_zone_llc"|"government_instrumentality"|"governmental_unit"|"incorporated_non_profit"|"incorporated_partnership"|"limited_liability_partnership"|"llc"|"multi_member_llc"|"private_company"|"private_corporation"|"private_partnership"|"public_company"|"public_corporation"|"public_partnership"|"registered_charity"|"single_member_llc"|"sole_establishment"|"sole_proprietorship"|"tax_exempt_government_instrumentality"|"unincorporated_association"|"unincorporated_non_profit"|"unincorporated_partnership", tax_id?: string, tax_id_registrar?: string, vat_id?: string, verification?: record}
  --controller: record # A hash of configuration describing the account controller's attributes. — shape: {fees?: record, losses?: record, requirement_collection?: "application"|"stripe", stripe_dashboard?: record}
  --country: string # The country in which the account holder resides, or in which the business is legally established. This should be an ISO 3166-1 alpha-2 country code. For example, if you are in the United States and the business for which you're creating an account is legally represented in Canada, you would use `CA` as the country for the account being created. Available countries include [Stripe's global markets](https://stripe.com/global) as well as countries where [cross-border payouts](https://stripe.com/docs/connect/cross-border-payouts) are supported.
  --default-currency: string # Three-letter ISO currency code representing the default currency for the account. This must be a currency that [Stripe supports in the account's country](https://docs.stripe.com/payouts). (format: currency)
  --documents: record # Documents that may be submitted to satisfy various informational requests. — shape: {bank_account_ownership_verification?: record, company_license?: record, company_memorandum_of_association?: record, company_ministerial_decree?: record, company_registration_verification?: record, company_tax_id_verification?: record, proof_of_address?: record, proof_of_registration?: record, proof_of_ultimate_beneficial_ownership?: record}
