# Create a payment link
#
# POST /v1/payment_links
# operationId: PostPaymentLinks
# --after_completion shape: {hosted_confirmation?: record, redirect?: record, type: "hosted_confirmation"|"redirect"}
# --automatic_tax shape: {enabled: bool, liability?: record}
# --consent_collection shape: {payment_method_reuse_agreement?: record, promotions?: "auto"|"none", terms_of_service?: "none"|"required"}
# --custom_fields item shape: {dropdown?: record, key: string, label: record, numeric?: record, optional?: bool, text?: record, type: "dropdown"|"numeric"|"text"}
# --custom_text shape: {after_submit?: any, shipping_address?: any, submit?: any, terms_of_service_acceptance?: any}
# --invoice_creation shape: {enabled: bool, invoice_data?: record}
# --line_items item shape: {adjustable_quantity?: record, price?: string, price_data?: record, quantity: int}
# --managed_payments shape: {enabled?: bool}
# --name_collection shape: {business?: record, individual?: record}
# --optional_items item shape: {adjustable_quantity?: record, price: string, quantity: int}
# --payment_intent_data shape: {capture_method?: "automatic"|"automatic_async"|"manual", description?: string, metadata?: record, setup_future_usage?: "off_session"|"on_session", statement_descriptor?: string, statement_descriptor_suffix?: string, transfer_group?: string}
# --payment_method_options shape: {card?: record}
# --phone_number_collection shape: {enabled: bool}
# --restrictions shape: {completed_sessions: record}
# --shipping_address_collection shape: {allowed_countries: list}
# --shipping_options item shape: {shipping_rate?: string}
# --subscription_data shape: {description?: string, invoice_settings?: record, metadata?: record, trial_period_days?: int, trial_settings?: record}
# --tax_id_collection shape: {enabled: bool, required?: "if_supported"|"never"}
# --transfer_data shape: {amount?: int, destination: string}
export def "payment-links PostPaymentLinks" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --after-completion: record # Behavior after the purchase is complete. — shape: {hosted_confirmation?: record, redirect?: record, type: "hosted_confirmation"|"redirect"}
  --allow-promotion-codes: string@bool-completer # Enables user redeemable promotion codes.
  --application-fee-amount: int # The amount of the application fee (if any) that will be requested to be applied to the payment and transferred to the application owner's Stripe account. Can only be applied when there are no line items with recurring prices.
  --application-fee-percent: float # A non-negative decimal between 0 and 100, with at most two decimal places. This represents the percentage of the subscription invoice total that will be transferred to the application owner's Stripe account. There must be at least 1 line item with a recurring price to use this field.
  --automatic-tax: record # Configuration for automatic tax collection. — shape: {enabled: bool, liability?: record}
  --billing-address-collection: string@billing-address-collection-completer # Configuration for collecting the customer's billing address. Defaults to `auto`.
  --consent-collection: record # Configure fields to gather active consent from customers. — shape: {payment_method_reuse_agreement?: record, promotions?: "auto"|"none", terms_of_service?: "none"|"required"}
  --currency: string # Three-letter [ISO currency code](https://www.iso.org/iso-4217-currency-codes.html), in lowercase. Must be a [supported currency](https://stripe.com/docs/currencies) and supported by each line item's price. (format: currency)
  --custom-fields: list # Collect additional information from your customer using custom fields. Up to 3 fields are supported. You can't set this parameter if `ui_mode` is `custom`. — item shape: {dropdown?: record, key: string, label: record, numeric?: record, optional?: bool, text?: record, type: "dropdown"|"numeric"|"text"}
  --custom-text: record # Display additional text for your customers using custom text. You can't set this parameter if `ui_mode` is `custom`. — shape: {after_submit?: any, shipping_address?: any, submit?: any, terms_of_service_acceptance?: any}
  --customer-creation: string@customer-creation-completer # Configures whether [checkout sessions](https://docs.stripe.com/api/checkout/sessions) created by this payment link create a [Customer](https://docs.stripe.com/api/customers).
  --expand: list # Specifies which fields in the response should be expanded.
  --inactive-message: string # The custom message to be displayed to a customer when a payment link is no longer active.
  --invoice-creation: record # Generate a post-purchase Invoice for one-time payments. — shape: {enabled: bool, invoice_data?: record}
  line_items: list # The line items representing what is being sold. Each line item represents an item being sold. Up to 20 line items are supported. — item shape: {adjustable_quantity?: record, price?: string, price_data?: record, quantity: int}
  --managed-payments: record # Settings for Managed Payments for this Payment Link and resulting [CheckoutSessions](/api/checkout/sessions/object), [PaymentIntents](/api/payment_intents/object), [Invoices](/api/invoices/object), and [Subscriptions](/api/subscriptions/object). — shape: {enabled?: bool}
  --metadata: record # Set of [key-value pairs](https://docs.stripe.com/api/metadata) that you can attach to an object. This can be useful for storing additional information about the object in a structured format. Individual keys can be unset by posting an empty value to them. All keys can be unset by posting an empty value to `metadata`. Metadata associated with this Payment Link will automatically be copied to [checkout sessions](https://docs.stripe.com/api/checkout/sessions) created by this payment link.
  --name-collection: record # Controls settings applied for collecting the customer's name. — shape: {business?: record, individual?: record}
  --on-behalf-of: string # The account on behalf of which to charge.
  --optional-items: list # A list of optional items the customer can add to their order at checkout. Use this parameter to pass one-time or recurring [Prices](https://docs.stripe.com/api/prices). There is a maximum of 10 optional items allowed on a payment link, and the existing limits on the number of line items allowed on a payment link apply to the combined number of line items and optional items. There is a maximum of 20 combined line items and optional items. — item shape: {adjustable_quantity?: record, price: string, quantity: int}
  --payment-intent-data: record # A subset of parameters to be passed to PaymentIntent creation for Checkout Sessions in `payment` mode. — shape: {capture_method?: "automatic"|"automatic_async"|"manual", description?: string, metadata?: record, setup_future_usage?: "off_session"|"on_session", statement_descriptor?: string, statement_descriptor_suffix?: string, transfer_group?: string}
  --payment-method-collection: string@payment-method-collection-completer # Specify whether Checkout should collect a payment method. When set to `if_required`, Checkout will not collect a payment method when the total due for the session is 0.This may occur if the Checkout Session includes a free trial or a discount.  Can only be set in `subscription` mode. Defaults to `always`.  If you'd like information on how to collect a payment method outside of Checkout, read the guide on [configuring subscriptions with a free trial](https://docs.stripe.com/payments/checkout/free-trials).
  --payment-method-options: record # shape: {card?: record}
  --payment-method-types: list # The list of payment method types that customers can use. If no value is passed, Stripe will dynamically show relevant payment methods from your [payment method settings](https://dashboard.stripe.com/settings/payment_methods) (20+ payment methods [supported](https://docs.stripe.com/payments/payment-methods/integration-options#payment-method-product-support)).
  --phone-number-collection: record # Controls phone number collection settings during checkout.  We recommend that you review your privacy policy and check with your legal contacts. — shape: {enabled: bool}
  --restrictions: record # Settings that restrict the usage of a payment link. — shape: {completed_sessions: record}
  --shipping-address-collection: record # Configuration for collecting the customer's shipping address. — shape: {allowed_countries: list}
