# Update an invoice
#
# POST /v1/invoices/{invoice}
# operationId: PostInvoicesInvoice
# --automatic_tax shape: {enabled: bool, liability?: record}
# --issuer shape: {account?: string, type: "account"|"self"}
# --payment_settings shape: {default_mandate?: any, payment_method_options?: record, payment_method_types?: any}
# --rendering shape: {amount_tax_display?: ""|"exclude_tax"|"include_inclusive_tax", pdf?: record, template?: string, template_version?: any}
export def "invoices PostInvoicesInvoice" [
  invoice: string
  --base-url(-b): string@base-url-completer # API base URL
