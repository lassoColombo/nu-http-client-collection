  --price-data: record # Data used to generate a new [Price](https://docs.stripe.com/api/prices) object inline. — shape: {currency: string, product: string, tax_behavior?: "exclusive"|"inclusive"|"unspecified", unit_amount?: int, unit_amount_decimal?: string}
