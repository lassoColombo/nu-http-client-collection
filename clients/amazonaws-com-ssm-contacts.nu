# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    accept-page: "record"
    activate-contact-channel: "record"
    create-contact: "record<ContactArn: string>"
    create-contact-channel: "record<ContactChannelArn: string>"
    create-rotation: "record<RotationArn: string>"
    create-rotation-override: "record<RotationOverrideId: string>"
    deactivate-contact-channel: "record"
    delete-contact: "record"
    delete-contact-channel: "record"
    delete-rotation: "record"
    delete-rotation-override: "record"
    describe-engagement: "record<ContactArn: string, EngagementArn: string, Sender: string, Subject: string, Content: string, PublicSubject: string, PublicContent: string, IncidentId: string, StartTime: string, StopTime: string>"
    describe-page: "record<PageArn: string, EngagementArn: string, ContactArn: string, Sender: string, Subject: string, Content: string, PublicSubject: string, PublicContent: string, IncidentId: string, SentTime: string, ReadTime: string, DeliveryTime: string>"
    get-contact: "record<ContactArn: string, Alias: string, DisplayName: string, Type: string, Plan: record<Stages: list<record>, RotationIds: list<string>>>"
    get-contact-channel: "record<ContactArn: string, ContactChannelArn: string, Name: string, Type: string, DeliveryAddress: record<SimpleAddress: string>, ActivationStatus: string>"
    get-contact-policy: "record<ContactArn: string, Policy: string>"
    get-rotation: "record<RotationArn: string, Name: string, ContactIds: list<string>, StartTime: string, TimeZoneId: string, Recurrence: record<MonthlySettings: list<record>, WeeklySettings: list<record>, DailySettings: list<record>, NumberOfOnCalls: int, ShiftCoverages: record, RecurrenceMultiplier: int>>"
    get-rotation-override: "record<RotationOverrideId: string, RotationArn: string, NewContactIds: list<string>, StartTime: string, EndTime: string, CreateTime: string>"
    list-contact-channels: "record<NextToken: string, ContactChannels: table<ContactChannelArn: string, ContactArn: string, Name: string, Type: string, DeliveryAddress: record, ActivationStatus: string>>"
    list-contacts: "record<NextToken: string, Contacts: table<ContactArn: string, Alias: string, DisplayName: string, Type: string>>"
    list-engagements: "record<NextToken: string, Engagements: table<EngagementArn: string, ContactArn: string, Sender: string, IncidentId: string, StartTime: string, StopTime: string>>"
    list-page-receipts: "record<NextToken: string, Receipts: table<ContactChannelArn: string, ReceiptType: string, ReceiptInfo: string, ReceiptTime: string>>"
    list-page-resolutions: "record<NextToken: string, PageResolutions: table<ContactArn: string, Type: string, StageIndex: int>>"
    list-pages-by-contact: "record<NextToken: string, Pages: table<PageArn: string, EngagementArn: string, ContactArn: string, Sender: string, IncidentId: string, SentTime: string, DeliveryTime: string, ReadTime: string>>"
    list-pages-by-engagement: "record<NextToken: string, Pages: table<PageArn: string, EngagementArn: string, ContactArn: string, Sender: string, IncidentId: string, SentTime: string, DeliveryTime: string, ReadTime: string>>"
    list-preview-rotation-shifts: "record<RotationShifts: table<ContactIds: list, StartTime: string, EndTime: string, Type: string, ShiftDetails: record>, NextToken: string>"
    list-rotation-overrides: "record<RotationOverrides: table<RotationOverrideId: string, NewContactIds: list, StartTime: string, EndTime: string, CreateTime: string>, NextToken: string>"
    list-rotation-shifts: "record<RotationShifts: table<ContactIds: list, StartTime: string, EndTime: string, Type: string, ShiftDetails: record>, NextToken: string>"
    list-rotations: "record<NextToken: string, Rotations: table<RotationArn: string, Name: string, ContactIds: list, StartTime: string, TimeZoneId: string, Recurrence: record>>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    put-contact-policy: "record"
    send-activation-code: "record"
    start-engagement: "record<EngagementArn: string>"
    stop-engagement: "record"
    tag-resource: "record"
    untag-resource: "record"
    update-contact: "record"
    update-contact-channel: "record"
    update-rotation: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["accept-page" "activate-contact-channel" "create-contact" "create-contact-channel" "create-rotation" "create-rotation-override" "deactivate-contact-channel" "delete-contact" "delete-contact-channel" "delete-rotation" "delete-rotation-override" "describe-engagement" "describe-page" "get-contact" "get-contact-channel" "get-contact-policy" "get-rotation" "get-rotation-override" "list-contact-channels" "list-contacts" "list-engagements" "list-page-receipts" "list-page-resolutions" "list-pages-by-contact" "list-pages-by-engagement" "list-preview-rotation-shifts" "list-rotation-overrides" "list-rotation-shifts" "list-rotations" "list-tags-for-resource" "put-contact-policy" "send-activation-code" "start-engagement" "stop-engagement" "tag-resource" "untag-resource" "update-contact" "update-contact-channel" "update-rotation" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Used to acknowledge an engagement to a contact channel during an incident.
#
# POST /
# Returns: record
# operationId: AcceptPage
export def "accept-page" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  page_id: string # The Amazon Resource Name (ARN) of the engagement to a contact channel.
  --contact-channel-id: string # The ARN of the contact channel.
  accept_type: string@accept-type-completer # The type indicates if the page was DELIVERED or READ.
  --note: string # Information provided by the user when the user acknowledges the page.
  accept_code: string # A 6-digit code used to acknowledge the page.
  --accept-code-validation: string@accept-code-validation-completer # An optional field that Incident Manager uses to ENFORCE AcceptCode validation when acknowledging an page. Acknowledgement can occur by replying to a page, or when entering the AcceptCode in the console. Enforcing AcceptCode validation causes Incident Manager to verify that the code entered by the user matches the code sent by Incident Manager with the page. Incident Manager can also IGNORE AcceptCode validation. Ignoring AcceptCode validation causes Incident Manager to accept any value entered for the AcceptCode.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "SSMContacts.AcceptPage"}]
    body: {content_type: "application/json", kind: json, fields: [{name: PageId, var: page_id}, {name: ContactChannelId, var: contact_channel_id}, {name: AcceptType, var: accept_type}, {name: Note, var: note}, {name: AcceptCode, var: accept_code}, {name: AcceptCodeValidation, var: accept_code_validation}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, page_id: $page_id, contact_channel_id: $contact_channel_id, accept_type: $accept_type, note: $note, accept_code: $accept_code, accept_code_validation: $accept_code_validation
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Activates a contact's contact channel. Incident Manager can't engage a contact until the contact channel has been activated.
#
# POST /
# Returns: record
# operationId: ActivateContactChannel
export def "activate-contact-channel" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-1 # required
  contact_channel_id: string # The Amazon Resource Name (ARN) of the contact channel.
  activation_code: string # The code sent to the contact channel when it was created in the contact.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "SSMContacts.ActivateContactChannel"}]
    body: {content_type: "application/json", kind: json, fields: [{name: ContactChannelId, var: contact_channel_id}, {name: ActivationCode, var: activation_code}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, contact_channel_id: $contact_channel_id, activation_code: $activation_code
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Contacts are either the contacts that Incident Manager engages during an incident or the escalation plans that Incident Manager uses to engage contacts in phases during an incident.
#
# POST /
# Returns: record<ContactArn: string>
# operationId: CreateContact
export def "create-contact" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-2 # required
  alias: string # The short name to quickly identify a contact or escalation plan. The contact alias must be unique and identifiable.
  --display-name: string # The full name of the contact or escalation plan.
  type: string@type-completer # To create an escalation plan use ESCALATION. To create a contact use PERSONAL.
  plan: record # Information about the stages and on-call rotation teams associated with an escalation plan or engagement plan. — shape: {Stages?: list, RotationIds?: list<string>}
  --tags: list # Adds a tag to the target. You can only tag resources created in the first Region of your replication set. — item shape: {Key?: string, Value?: string}
  --idempotency-token: string # A token ensuring that the operation is called only once with the specified details.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "SSMContacts.CreateContact"}]
    body: {content_type: "application/json", kind: json, fields: [{name: Alias, var: alias}, {name: DisplayName, var: display_name}, {name: Type, var: type}, {name: Plan, var: plan}, {name: Tags, var: tags}, {name: IdempotencyToken, var: idempotency_token}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, alias: $alias, display_name: $display_name, type: $type, plan: $plan, tags: $tags, idempotency_token: $idempotency_token
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# A contact channel is the method that Incident Manager uses to engage your contact.
#
# POST /
# Returns: record<ContactChannelArn: string>
# operationId: CreateContactChannel
export def "create-contact-channel" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
