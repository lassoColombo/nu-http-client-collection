  --take: int # Number of items to take. Defaults to 30 (format: int32)
]: nothing -> record<Id: string, Items: table<Created: string, Filename: string, Id: string, LastModifiedBy: string, LastModifiedOn: string, Links: record, LogCorrelationId: string, ServerTaskId: string, Source: string, SpaceId: string>, ItemsPerPage: int, ItemType: string, LastModifiedBy: string, LastModifiedOn: string, LastPageNumber: int, Links: record, NumberOfPages: int, TotalResults: int> {
