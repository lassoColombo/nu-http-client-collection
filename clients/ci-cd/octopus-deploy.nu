  Name: string
  --PackageAcquisitionLocationOptions: list
  --Slug: string
  SpaceId: string
]: any -> record<FeedType: string, Id: string, LastModifiedBy: string, LastModifiedOn: string, Links: record, Name: string, PackageAcquisitionLocationOptions: list<string>, Slug: string, SpaceId: string> {
