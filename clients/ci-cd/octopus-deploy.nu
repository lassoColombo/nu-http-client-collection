  --allow-errors(-e) # Return full response without error handling
  --ConcurrencyToken: string
  SpaceId: string
  TenantId: string
  Variables: list # item shape: {Id?: string, OwnerId: string, Scope: record, TemplateId: string, Value: record}
]: any -> record<TenantId: string, Variables: table<Id: string, ProjectId: string, ProjectName: string, Scope: record, Template: record, TemplateId: string, Value: record>> {
