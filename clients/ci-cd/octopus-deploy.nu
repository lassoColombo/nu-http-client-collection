  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --channelId: string # A Channel Id used to filter a query.
  --ids: list # A comma separated list of Deployment Environment resource ids used to filter a query.
  --projectId: string # A project Id used to filter a query.
]: nothing -> table<AllowDynamicInfrastructure: bool, Description: string, EnvironmentTags: list<string>, ExtensionSettings: list<record>, Id: string, LastModifiedBy: string, LastModifiedOn: string, Links: record, Name: string, Slug: string, SortOrder: int, SpaceId: string, UseGuidedFailure: bool> {
  let auth = (build-auth $token ($auth_scheme | default "x-octopus-apikey"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "channelId" $channelId "scalar") (serialize-qp "ids" $ids "multi") (serialize-qp "projectId" $projectId "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/($spaceId)/environments/all" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

