# --Variables item shape: {Id?: string, OwnerId: string, Scope: record, TemplateId: string, Value: record}
export def "tenants-projectvariables LegacyDefaultSpace-by-tenantId-2" [
  tenantId: string
  --base-url(-b): string@base-url-completer # API base URL
