# Get Insights metrics series for the Insights Report
#
# GET /spaces/{spaceIdentifier}/insights/reports/{reportId}/metrics
# operationId: getInsightsMetricsSeriesForReport
export def "spaces-insights-reports-metrics get-by-reportId-spaceIdentifier" [
  reportId: string
  spaceIdentifier: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --qp-split: string@split-completer # How to split the metrics
  --timeRange: string@timeRange-completer # The time period to get data for, defaults to last quarter if not supplied
  --granularity: string@granularity-completer # The data grouping granularity, defaults to weekly if not supplied
  --tenantTagSetId: string # If TenantTagSet is chosen for Split, this is required, otherwise it is ignored. It is the tag set to split on.
]: nothing -> record<Series: table<Intervals: list, Name: string>> {
  let auth = (build-auth $token ($auth_scheme | default "x-octopus-apikey"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "split" $qp_split "scalar") (serialize-qp "timeRange" $timeRange "scalar") (serialize-qp "granularity" $granularity "scalar") (serialize-qp "tenantTagSetId" $tenantTagSetId "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/spaces/($spaceIdentifier)/insights/reports/($reportId)/metrics" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

