    method: get
    path: "/"
    query: [{name: ClusterIdentifier, var: cluster_identifier, required: true}, {name: RetentionPeriod, var: retention_period, required: true}, {name: Manual, var: manual}, {name: Action, var: action, required: true, default: ModifySnapshotCopyRetentionPeriod}, {name: Version, var: version, required: true, default: "2012-12-01"}]
