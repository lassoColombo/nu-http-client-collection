"post-describe-event-categories" "get-describe-event-subscriptions" "post-describe-event-subscriptions" "get-describe-events" "post-describe-events" "get-describe-hsm-client-certificates" "post-describe-hsm-client-certificates" "get-describe-hsm-configurations" "post-describe-hsm-configurations" "get-describe-logging-status" "post-describe-logging-status" "get-describe-node-configuration-options" "post-describe-node-configuration-options" "get-describe-orderable-cluster-options" "post-describe-orderable-cluster-options" "get-describe-partners" "post-describe-partners" "get-describe-reserved-node-exchange-status" "post-describe-reserved-node-exchange-status" "get-describe-reserved-node-offerings" "post-describe-reserved-node-offerings" "get-describe-reserved-nodes" "post-describe-reserved-nodes" "get-describe-resize" "post-describe-resize" "get-describe-scheduled-actions" "post-describe-scheduled-actions" "get-describe-snapshot-copy-grants" "post-describe-snapshot-copy-grants" "get-describe-snapshot-schedules" "post-describe-snapshot-schedules" "get-describe-storage" "post-describe-storage" "get-describe-table-restore-status" "post-describe-table-restore-status" "get-describe-tags" "post-describe-tags" "get-describe-usage-limits" "post-describe-usage-limits" "get-disable-logging" "post-disable-logging" "get-disable-snapshot-copy" "post-disable-snapshot-copy" "get-disassociate-data-share-consumer" "post-disassociate-data-share-consumer" "get-enable-logging" "post-enable-logging" "get-enable-snapshot-copy" "post-enable-snapshot-copy" "get-get-cluster-credentials" "post-get-cluster-credentials" "get-get-cluster-credentials-with-iam" "post-get-cluster-credentials-with-iam" "get-get-reserved-node-exchange-configuration-options" "post-get-reserved-node-exchange-configuration-options" "get-get-reserved-node-exchange-offerings" "post-get-reserved-node-exchange-offerings" "get-modify-aqua-configuration" "post-modify-aqua-configuration" "get-modify-authentication-profile" "post-modify-authentication-profile" "get-modify-cluster" "post-modify-cluster" "get-modify-cluster-db-revision" "post-modify-cluster-db-revision" "get-modify-cluster-iam-roles" "post-modify-cluster-iam-roles" "get-modify-cluster-maintenance" "post-modify-cluster-maintenance" "get-modify-cluster-parameter-group" "post-modify-cluster-parameter-group" "get-modify-cluster-snapshot" "post-modify-cluster-snapshot" "get-modify-cluster-snapshot-schedule" "post-modify-cluster-snapshot-schedule" "get-modify-cluster-subnet-group" "post-modify-cluster-subnet-group" "get-modify-endpoint-access" "post-modify-endpoint-access" "get-modify-event-subscription" "post-modify-event-subscription" "get-modify-scheduled-action" "post-modify-scheduled-action" "get-modify-snapshot-copy-retention-period" "post-modify-snapshot-copy-retention-period" "get-modify-snapshot-schedule" "post-modify-snapshot-schedule" "get-modify-usage-limit" "post-modify-usage-limit" "get-pause-cluster" "post-pause-cluster" "get-purchase-reserved-node-offering" "post-purchase-reserved-node-offering" "get-reboot-cluster" "post-reboot-cluster" "get-reject-data-share" "post-reject-data-share" "get-reset-cluster-parameter-group" "post-reset-cluster-parameter-group" "get-resize-cluster" "post-resize-cluster" "get-restore-from-cluster-snapshot" "post-restore-from-cluster-snapshot" "get-restore-table-from-cluster-snapshot" "post-restore-table-from-cluster-snapshot" "get-resume-cluster" "post-resume-cluster" "get-revoke-cluster-security-group-ingress" "post-revoke-cluster-security-group-ingress" "get-revoke-endpoint-access" "post-revoke-endpoint-access" "get-revoke-snapshot-access" "post-revoke-snapshot-access" "get-rotate-encryption-key" "post-rotate-encryption-key" "get-update-partner-status" "post-update-partner-status" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Exchanges a DC1 Reserved Node for a DC2 Reserved Node with no changes to the configuration (term, payment type, or number of nodes) and no additional costs.
#
# GET /
# operationId: GET_AcceptReservedNodeExchange
export def "get-accept-reserved-node-exchange" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --reserved-node-id: string # A string representing the node identifier of the DC1 Reserved Node to be exchanged. (required)
  --target-reserved-node-offering-id: string # The unique identifier of the DC2 Reserved Node offering to be used for the exchange. You can obtain the value for the parameter by calling GetReservedNodeExchangeOfferings (required)
  --action: string@action-completer # required
  --version: string@version-completer # required
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> any {
  http-request {
    method: get
    path: "/"
    query: [{name: ReservedNodeId, var: reserved_node_id, required: true}, {name: TargetReservedNodeOfferingId, var: target_reserved_node_offering_id, required: true}, {name: Action, var: action, required: true, default: AcceptReservedNodeExchange}, {name: Version, var: version, required: true, default: "2012-12-01"}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    accept: ["text/xml"]
    ok: [200]
    auth: bearer
  } {
    reserved_node_id: $reserved_node_id, target_reserved_node_offering_id: $target_reserved_node_offering_id, action: $action, version: $version, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Exchanges a DC1 Reserved Node for a DC2 Reserved Node with no changes to the configuration (term, payment type, or number of nodes) and no additional costs.
#
# POST /
# operationId: POST_AcceptReservedNodeExchange
export def "post-accept-reserved-node-exchange" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --action: string@action-completer # required
  --version: string@version-completer # required
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
