# Creates an API destination, which is an HTTP invocation endpoint configured as a target for events.
#
# POST /
# Returns: record<ApiDestinationArn: string, ApiDestinationState: string, CreationTime: string, LastModifiedTime: string>
# operationId: CreateApiDestination
export def "create-api-destination" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-2 # required
  name: string # The name for the API destination to create.
  --description: string # A description for the API destination to create.
  connection_arn: string # The ARN of the connection to use for the API destination. The destination endpoint must support the authorization type specified for the connection.
  invocation_endpoint: string # The URL to the HTTP invocation endpoint for the API destination.
  http_method: string@http-method-completer # The method to use for the request to the HTTP invocation endpoint.
  --invocation-rate-limit-per-second: int # The maximum number of requests per second to send to the HTTP invocation endpoint.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "AWSEvents.CreateApiDestination"}]
    body: {content_type: "application/json", kind: json, fields: [{name: Name, var: name}, {name: Description, var: description}, {name: ConnectionArn, var: connection_arn}, {name: InvocationEndpoint, var: invocation_endpoint}, {name: HttpMethod, var: http_method}, {name: InvocationRateLimitPerSecond, var: invocation_rate_limit_per_second}]}
    accept: ["application/json"]
    ok: [200]
