# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cancel-replay: "record<ReplayArn: string, State: string, StateReason: string>"
    create-api-destination: "record<ApiDestinationArn: string, ApiDestinationState: string, CreationTime: string, LastModifiedTime: string>"
    create-archive: "record<ArchiveArn: string, State: string, StateReason: string, CreationTime: string>"
    create-connection: "record<ConnectionArn: string, ConnectionState: string, CreationTime: string, LastModifiedTime: string>"
    create-event-bus: "record<EventBusArn: string>"
    create-partner-event-source: "record<EventSourceArn: string>"
    deauthorize-connection: "record<ConnectionArn: string, ConnectionState: string, CreationTime: string, LastModifiedTime: string, LastAuthorizedTime: string>"
    delete-api-destination: "record"
    delete-archive: "record"
    delete-connection: "record<ConnectionArn: string, ConnectionState: string, CreationTime: string, LastModifiedTime: string, LastAuthorizedTime: string>"
    describe-api-destination: "record<ApiDestinationArn: string, Name: string, Description: string, ApiDestinationState: string, ConnectionArn: string, InvocationEndpoint: string, HttpMethod: string, InvocationRateLimitPerSecond: int, CreationTime: string, LastModifiedTime: string>"
    describe-archive: "record<ArchiveArn: string, ArchiveName: string, EventSourceArn: string, Description: string, EventPattern: string, State: string, StateReason: string, RetentionDays: int, SizeBytes: int, EventCount: int, CreationTime: string>"
    describe-connection: "record<ConnectionArn: string, Name: string, Description: string, ConnectionState: string, StateReason: string, AuthorizationType: string, SecretArn: string, AuthParameters: record<BasicAuthParameters: record<Username: string>, OAuthParameters: record<ClientParameters: record, AuthorizationEndpoint: string, HttpMethod: string, OAuthHttpParameters: record>, ApiKeyAuthParameters: record<ApiKeyName: string>, InvocationHttpParameters: record<HeaderParameters: list, QueryStringParameters: list, BodyParameters: list>>, CreationTime: string, LastModifiedTime: string, LastAuthorizedTime: string>"
    describe-event-bus: "record<Name: string, Arn: string, Policy: string>"
    describe-event-source: "record<Arn: string, CreatedBy: string, CreationTime: string, ExpirationTime: string, Name: string, State: string>"
    describe-partner-event-source: "record<Arn: string, Name: string>"
    describe-replay: "record<ReplayName: string, ReplayArn: string, Description: string, State: string, StateReason: string, EventSourceArn: string, Destination: record<Arn: string, FilterArns: list<string>>, EventStartTime: string, EventEndTime: string, EventLastReplayedTime: string, ReplayStartTime: string, ReplayEndTime: string>"
    describe-rule: "record<Name: string, Arn: string, EventPattern: string, ScheduleExpression: string, State: string, Description: string, RoleArn: string, ManagedBy: string, EventBusName: string, CreatedBy: string>"
    list-api-destinations: "record<ApiDestinations: table<ApiDestinationArn: string, Name: string, ApiDestinationState: string, ConnectionArn: string, InvocationEndpoint: string, HttpMethod: string, InvocationRateLimitPerSecond: int, CreationTime: string, LastModifiedTime: string>, NextToken: string>"
    list-archives: "record<Archives: table<ArchiveName: string, EventSourceArn: string, State: string, StateReason: string, RetentionDays: int, SizeBytes: int, EventCount: int, CreationTime: string>, NextToken: string>"
    list-connections: "record<Connections: table<ConnectionArn: string, Name: string, ConnectionState: string, StateReason: string, AuthorizationType: string, CreationTime: string, LastModifiedTime: string, LastAuthorizedTime: string>, NextToken: string>"
    list-event-buses: "record<EventBuses: table<Name: string, Arn: string, Policy: string>, NextToken: string>"
    list-event-sources: "record<EventSources: table<Arn: string, CreatedBy: string, CreationTime: string, ExpirationTime: string, Name: string, State: string>, NextToken: string>"
    list-partner-event-source-accounts: "record<PartnerEventSourceAccounts: table<Account: string, CreationTime: string, ExpirationTime: string, State: string>, NextToken: string>"
    list-partner-event-sources: "record<PartnerEventSources: table<Arn: string, Name: string>, NextToken: string>"
    list-replays: "record<Replays: table<ReplayName: string, EventSourceArn: string, State: string, StateReason: string, EventStartTime: string, EventEndTime: string, EventLastReplayedTime: string, ReplayStartTime: string, ReplayEndTime: string>, NextToken: string>"
    list-rule-names-by-target: "record<RuleNames: list<string>, NextToken: string>"
    list-rules: "record<Rules: table<Name: string, Arn: string, EventPattern: string, State: string, Description: string, ScheduleExpression: string, RoleArn: string, ManagedBy: string, EventBusName: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    list-targets-by-rule: "record<Targets: table<Id: string, Arn: string, RoleArn: string, Input: string, InputPath: string, InputTransformer: record, KinesisParameters: record, RunCommandParameters: record, EcsParameters: record, BatchParameters: record, SqsParameters: record, HttpParameters: record, RedshiftDataParameters: record, SageMakerPipelineParameters: record, DeadLetterConfig: record, RetryPolicy: record>, NextToken: string>"
    put-events: "record<FailedEntryCount: int, Entries: table<EventId: string, ErrorCode: string, ErrorMessage: string>>"
    put-partner-events: "record<FailedEntryCount: int, Entries: table<EventId: string, ErrorCode: string, ErrorMessage: string>>"
    put-rule: "record<RuleArn: string>"
    put-targets: "record<FailedEntryCount: int, FailedEntries: table<TargetId: string, ErrorCode: string, ErrorMessage: string>>"
    remove-targets: "record<FailedEntryCount: int, FailedEntries: table<TargetId: string, ErrorCode: string, ErrorMessage: string>>"
    start-replay: "record<ReplayArn: string, State: string, StateReason: string, ReplayStartTime: string>"
    tag-resource: "record"
    test-event-pattern: "record<Result: bool>"
    untag-resource: "record"
    update-api-destination: "record<ApiDestinationArn: string, ApiDestinationState: string, CreationTime: string, LastModifiedTime: string>"
    update-archive: "record<ArchiveArn: string, State: string, StateReason: string, CreationTime: string>"
    update-connection: "record<ConnectionArn: string, ConnectionState: string, CreationTime: string, LastModifiedTime: string, LastAuthorizedTime: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["activate-event-source" "cancel-replay" "create-api-destination" "create-archive" "create-connection" "create-event-bus" "create-partner-event-source" "deactivate-event-source" "deauthorize-connection" "delete-api-destination" "delete-archive" "delete-connection" "delete-event-bus" "delete-partner-event-source" "delete-rule" "describe-api-destination" "describe-archive" "describe-connection" "describe-event-bus" "describe-event-source" "describe-partner-event-source" "describe-replay" "describe-rule" "disable-rule" "enable-rule" "list-api-destinations" "list-archives" "list-connections" "list-event-buses" "list-event-sources" "list-partner-event-source-accounts" "list-partner-event-sources" "list-replays" "list-rule-names-by-target" "list-rules" "list-tags-for-resource" "list-targets-by-rule" "put-events" "put-partner-events" "put-permission" "put-rule" "put-targets" "remove-permission" "remove-targets" "start-replay" "tag-resource" "test-event-pattern" "untag-resource" "update-api-destination" "update-archive" "update-connection" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Activates a partner event source that has been deactivated. Once activated, your matching event bus will start receiving events from the event source.
#
# POST /
# operationId: ActivateEventSource
export def "activate-event-source" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  name: string # The name of the partner event source to activate.
]: any -> any {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "AWSEvents.ActivateEventSource"}]
    body: {content_type: "application/json", kind: json, fields: [{name: Name, var: name}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, name: $name
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

