    search-profiles: "record<Profiles: table<ProfileArn: string, ProfileName: string, IsDefault: bool, Address: string, Timezone: string, DistanceUnit: string, TemperatureUnit: string, WakeWord: string, Locale: string>, NextToken: string, TotalCount: int>"
    search-rooms: "record<Rooms: table<RoomArn: string, RoomName: string, Description: string, ProviderCalendarId: string, ProfileArn: string, ProfileName: string>, NextToken: string, TotalCount: int>"
    search-skill-groups: "record<SkillGroups: table<SkillGroupArn: string, SkillGroupName: string, Description: string>, NextToken: string, TotalCount: int>"
    search-users: "record<Users: table<UserArn: string, FirstName: string, LastName: string, Email: string, EnrollmentStatus: string, EnrollmentId: string>, NextToken: string, TotalCount: int>"
    send-announcement: "record<AnnouncementArn: string>"
    send-invitation: "record"
    start-device-sync: "record"
    start-smart-home-appliance-discovery: "record"
    tag-resource: "record"
    untag-resource: "record"
    update-address-book: "record"
    update-business-report-schedule: "record"
