    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: issue_number, var: issue_number}]
    query: [{name: since, var: since}, {name: per_page, var: per_page}, {name: page, var: page}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    owner: $owner, repo: $repo, issue_number: $issue_number, since: $since, per_page: $per_page, page: $page
