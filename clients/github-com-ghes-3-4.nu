# operationId: repos/update
@deprecated --flag use-squash-pr-title-as-default
export def "repos-update" [
  owner: string
  repo: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --allow-forking: oneof<nothing, bool> # Either `true` to allow private forks, or `false` to prevent private forks. (default: false)
  --allow-merge-commit: oneof<nothing, bool> # Either `true` to allow merging pull requests with a merge commit, or `false` to prevent merging pull requests with merge commits. (default: true)
  --allow-rebase-merge: oneof<nothing, bool> # Either `true` to allow rebase-merging pull requests, or `false` to prevent rebase-merging. (default: true)
  --allow-squash-merge: oneof<nothing, bool> # Either `true` to allow squash-merging pull requests, or `false` to prevent squash-merging. (default: true)
  --allow-update-branch: oneof<nothing, bool> # Either `true` to always allow a pull request head branch that is behind its base branch to be updated even if it is not required to be up to date before merging, or false otherwise. (default: false)
  --archived: oneof<nothing, bool> # Whether to archive this repository. **Note**: You cannot unarchive repositories through the API. (default: false)
  --default-branch: string # Updates the default branch for this repository.
  --delete-branch-on-merge: oneof<nothing, bool> # Either `true` to allow automatically deleting head branches when pull requests are merged, or `false` to prevent automatic deletion. (default: false)
  --description: string # A short description of the repository.
  --has-issues: oneof<nothing, bool> # Either `true` to enable issues for this repository or `false` to disable them. (default: true)
  --has-projects: oneof<nothing, bool> # Either `true` to enable projects for this repository or `false` to disable them. **Note:** If you're creating a repository in an organization that has disabled repository projects, the default is `false`, and if you pass `true`, the API returns an error. (default: true)
  --has-wiki: oneof<nothing, bool> # Either `true` to enable the wiki for this repository or `false` to disable it. (default: true)
  --homepage: string # A URL with more information about the repository.
  --is-template: oneof<nothing, bool> # Either `true` to make this repo available as a template repository or `false` to prevent it. (default: false)
  --merge-commit-message: string@merge-commit-message-completer # The default value for a merge commit message. - `PR_TITLE` - default to the pull request's title. - `PR_BODY` - default to the pull request's body. - `BLANK` - default to a blank commit message.
  --merge-commit-title: string@merge-commit-title-completer # The default value for a merge commit title. - `PR_TITLE` - default to the pull request's title. - `MERGE_MESSAGE` - default to the classic title for a merge message (e.g., Merge pull request #123 from branch-name).
  --name: string # The name of the repository.
  --private: oneof<nothing, bool> # Either `true` to make the repository private or `false` to make it public. Default: `false`. **Note**: You will get a `422` error if the organization restricts [changing repository visibility](https://docs.github.com/enterprise-server@3.4/articles/repository-permission-levels-for-an-organization#changing-the-visibility-of-repositories) to organization owners and a non-owner tries to change the value of private. (default: false)
  --squash-merge-commit-message: string@squash-merge-commit-message-completer # The default value for a squash merge commit message: - `PR_BODY` - default to the pull request's body. - `COMMIT_MESSAGES` - default to the branch's commit messages. - `BLANK` - default to a blank commit message.
  --squash-merge-commit-title: string@squash-merge-commit-title-completer # The default value for a squash merge commit title: - `PR_TITLE` - default to the pull request's title. - `COMMIT_OR_PR_TITLE` - default to the commit's title (if only one commit) or the pull request's title (when more than one commit).
  --use-squash-pr-title-as-default: oneof<nothing, bool> # Either `true` to allow squash-merge commits to use pull request title, or `false` to use commit message. **This property has been deprecated. Please use `squash_merge_commit_title` instead. (DEPRECATED, default: false)
  --visibility: string@visibility-completer-2 # The visibility of the repository.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: patch
    path: "/repos/{owner}/{repo}"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}]
    body: {content_type: "application/json", kind: json, fields: [{name: allow_forking, var: allow_forking}, {name: allow_merge_commit, var: allow_merge_commit}, {name: allow_rebase_merge, var: allow_rebase_merge}, {name: allow_squash_merge, var: allow_squash_merge}, {name: allow_update_branch, var: allow_update_branch}, {name: archived, var: archived}, {name: default_branch, var: default_branch}, {name: delete_branch_on_merge, var: delete_branch_on_merge}, {name: description, var: description}, {name: has_issues, var: has_issues}, {name: has_projects, var: has_projects}, {name: has_wiki, var: has_wiki}, {name: homepage, var: homepage}, {name: is_template, var: is_template}, {name: merge_commit_message, var: merge_commit_message}, {name: merge_commit_title, var: merge_commit_title}, {name: name, var: name}, {name: private, var: private}, {name: squash_merge_commit_message, var: squash_merge_commit_message}, {name: squash_merge_commit_title, var: squash_merge_commit_title}, {name: use_squash_pr_title_as_default, var: use_squash_pr_title_as_default}, {name: visibility, var: visibility}]}
    accept: ["application/json"]
    ok: [200, 307]
    auth: bearer
  } {
    owner: $owner, repo: $repo, allow_forking: $allow_forking, allow_merge_commit: $allow_merge_commit, allow_rebase_merge: $allow_rebase_merge, allow_squash_merge: $allow_squash_merge, allow_update_branch: $allow_update_branch, archived: $archived, default_branch: $default_branch, delete_branch_on_merge: $delete_branch_on_merge, description: $description, has_issues: $has_issues, has_projects: $has_projects, has_wiki: $has_wiki, homepage: $homepage, is_template: $is_template, merge_commit_message: $merge_commit_message, merge_commit_title: $merge_commit_title, name: $name, private: $private, squash_merge_commit_message: $squash_merge_commit_message, squash_merge_commit_title: $squash_merge_commit_title, use_squash_pr_title_as_default: $use_squash_pr_title_as_default, visibility: $visibility
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# List artifacts for a repository
#
# GET /repos/{owner}/{repo}/actions/artifacts
# Docs: https://docs.github.com/enterprise-server@3.4/rest/reference/actions#list-artifacts-for-a-repository — API method documentation
# Returns: record<artifacts: table<archive_download_url: string, created_at: string, expired: bool, expires_at: string, id: int, name: string, node_id: string, size_in_bytes: int, updated_at: string, url: string, workflow_run: record>, total_count: int>
# operationId: actions/list-artifacts-for-repo
export def "actions-list-artifacts-for-repo" [
  owner: string
  repo: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --per-page: int # The number of results per page (max 100). (default: 30)
  --page: int # Page number of the results to fetch. (default: 1)
  --name: string # Filters artifacts by exact match on their name field.
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/repos/{owner}/{repo}/actions/artifacts"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}]
    query: [{name: per_page, var: per_page}, {name: page, var: page}, {name: name, var: name}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    owner: $owner, repo: $repo, per_page: $per_page, page: $page, name: $name
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Delete an artifact
