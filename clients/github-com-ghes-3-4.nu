  --dry-run(-n) # Return the request that would be sent without executing it
  content: string # The new blob's content.
  --encoding: string # The encoding used for `content`. Currently, `"utf-8"` and `"base64"` are supported. (default: utf-8)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/repos/{owner}/{repo}/git/blobs"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}]
    body: {content_type: "application/json", kind: json, fields: [{name: content, var: content}, {name: encoding, var: encoding}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    owner: $owner, repo: $repo, content: $content, encoding: $encoding
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

