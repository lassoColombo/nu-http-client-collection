# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    activate-anomaly-detector: "record"
    back-test-anomaly-detector: "record"
    create-alert: "record<AlertArn: string>"
    create-anomaly-detector: "record<AnomalyDetectorArn: string>"
    create-metric-set: "record<MetricSetArn: string>"
    deactivate-anomaly-detector: "record"
    delete-alert: "record"
    delete-anomaly-detector: "record"
    describe-alert: "record<Alert: record<Action: record<SNSConfiguration: record, LambdaConfiguration: record>, AlertDescription: string, AlertArn: string, AnomalyDetectorArn: string, AlertName: string, AlertSensitivityThreshold: int, AlertType: string, AlertStatus: string, LastModificationTime: string, CreationTime: string, AlertFilters: record<MetricList: list, DimensionFilterList: list>>>"
    describe-anomaly-detection-executions: "record<ExecutionList: table<Timestamp: string, Status: string, FailureReason: string>, NextToken: string>"
    describe-anomaly-detector: "record<AnomalyDetectorArn: string, AnomalyDetectorName: string, AnomalyDetectorDescription: string, AnomalyDetectorConfig: record<AnomalyDetectorFrequency: string>, CreationTime: string, LastModificationTime: string, Status: string, FailureReason: string, KmsKeyArn: string, FailureType: string>"
    describe-metric-set: "record<MetricSetArn: string, AnomalyDetectorArn: string, MetricSetName: string, MetricSetDescription: string, CreationTime: string, LastModificationTime: string, Offset: int, MetricList: table<MetricName: string, AggregationFunction: string, Namespace: string>, TimestampColumn: record<ColumnName: string, ColumnFormat: string>, DimensionList: list<string>, MetricSetFrequency: string, Timezone: string, MetricSource: record<S3SourceConfig: record<RoleArn: string, TemplatedPathList: list, HistoricalDataPathList: list, FileFormatDescriptor: record>, AppFlowConfig: record<RoleArn: string, FlowName: string>, CloudWatchConfig: record<RoleArn: string, BackTestConfiguration: record>, RDSSourceConfig: record<DBInstanceIdentifier: string, DatabaseHost: string, DatabasePort: int, SecretManagerArn: string, DatabaseName: string, TableName: string, RoleArn: string, VpcConfiguration: record>, RedshiftSourceConfig: record<ClusterIdentifier: string, DatabaseHost: string, DatabasePort: int, SecretManagerArn: string, DatabaseName: string, TableName: string, RoleArn: string, VpcConfiguration: record>, AthenaSourceConfig: record<RoleArn: string, DatabaseName: string, DataCatalog: string, TableName: string, WorkGroupName: string, S3ResultsPath: string, BackTestConfiguration: record>>, DimensionFilterList: table<Name: string, FilterList: list>>"
    detect-metric-set-config: "record<DetectedMetricSetConfig: record<Offset: record<Value: record, Confidence: string, Message: string>, MetricSetFrequency: record<Value: record, Confidence: string, Message: string>, MetricSource: record<S3SourceConfig: record>>>"
    get-anomaly-group: "record<AnomalyGroup: record<StartTime: string, EndTime: string, AnomalyGroupId: string, AnomalyGroupScore: float, PrimaryMetricName: string, MetricLevelImpactList: list<record>>>"
    get-data-quality-metrics: "record<AnomalyDetectorDataQualityMetricList: table<StartTimestamp: string, MetricSetDataQualityMetricList: list>>"
    get-feedback: "record<AnomalyGroupTimeSeriesFeedback: table<TimeSeriesId: string, IsAnomaly: bool>, NextToken: string>"
    get-sample-data: "record<HeaderValues: list<string>, SampleRows: list<list<string>>>"
    list-alerts: "record<AlertSummaryList: table<AlertArn: string, AnomalyDetectorArn: string, AlertName: string, AlertSensitivityThreshold: int, AlertType: string, AlertStatus: string, LastModificationTime: string, CreationTime: string, Tags: record>, NextToken: string>"
    list-anomaly-detectors: "record<AnomalyDetectorSummaryList: table<AnomalyDetectorArn: string, AnomalyDetectorName: string, AnomalyDetectorDescription: string, CreationTime: string, LastModificationTime: string, Status: string, Tags: record>, NextToken: string>"
    list-anomaly-group-related-metrics: "record<InterMetricImpactList: table<MetricName: string, AnomalyGroupId: string, RelationshipType: string, ContributionPercentage: float>, NextToken: string>"
    list-anomaly-group-summaries: "record<AnomalyGroupSummaryList: table<StartTime: string, EndTime: string, AnomalyGroupId: string, AnomalyGroupScore: float, PrimaryMetricName: string>, AnomalyGroupStatistics: record<EvaluationStartDate: string, TotalCount: int, ItemizedMetricStatsList: list<record>>, NextToken: string>"
    list-anomaly-group-time-series: "record<AnomalyGroupId: string, MetricName: string, TimestampList: list<string>, NextToken: string, TimeSeriesList: table<TimeSeriesId: string, DimensionList: list, MetricValueList: list>>"
    list-metric-sets: "record<MetricSetSummaryList: table<MetricSetArn: string, AnomalyDetectorArn: string, MetricSetDescription: string, MetricSetName: string, CreationTime: string, LastModificationTime: string, Tags: record>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    put-feedback: "record"
    untag-resource: "record"
    update-alert: "record<AlertArn: string>"
    update-anomaly-detector: "record<AnomalyDetectorArn: string>"
    update-metric-set: "record<MetricSetArn: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["activate-anomaly-detector" "back-test-anomaly-detector" "create-alert" "create-anomaly-detector" "create-metric-set" "deactivate-anomaly-detector" "delete-alert" "delete-anomaly-detector" "describe-alert" "describe-anomaly-detection-executions" "describe-anomaly-detector" "describe-metric-set" "detect-metric-set-config" "get-anomaly-group" "get-data-quality-metrics" "get-feedback" "get-sample-data" "list-alerts" "list-anomaly-detectors" "list-anomaly-group-related-metrics" "list-anomaly-group-summaries" "list-anomaly-group-time-series" "list-metric-sets" "list-tags-for-resource" "tag-resource" "put-feedback" "untag-resource" "update-alert" "update-anomaly-detector" "update-metric-set" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Activates an anomaly detector.
#
