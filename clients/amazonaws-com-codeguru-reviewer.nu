    body: {content_type: "application/json", kind: json, fields: [{name: CodeReviewArn, var: code_review_arn}, {name: RecommendationId, var: recommendation_id}, {name: Reactions, var: reactions}]}
    accept: ["application/json"]
    ok: [200]
