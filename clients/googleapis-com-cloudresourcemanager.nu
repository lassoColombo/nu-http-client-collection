# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cloudresourcemanager-effective-tags-list: "record<effectiveTags: table<inherited: bool, namespacedTagKey: string, namespacedTagValue: string, tagKey: string, tagKeyParentName: string, tagValue: string>, nextPageToken: string>"
