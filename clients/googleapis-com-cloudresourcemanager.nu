    cloudresourcemanager-projects-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-projects-search: "record<nextPageToken: string, projects: table<createTime: string, deleteTime: string, displayName: string, etag: string, labels: record, name: string, parent: string, projectId: string, state: string, updateTime: string>>"
    cloudresourcemanager-tag-bindings-list: "record<nextPageToken: string, tagBindings: table<name: string, parent: string, tagValue: string, tagValueNamespacedName: string>>"
    cloudresourcemanager-tag-bindings-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-tag-keys-list: "record<nextPageToken: string, tagKeys: table<createTime: string, description: string, etag: string, name: string, namespacedName: string, parent: string, purpose: string, purposeData: record, shortName: string, updateTime: string>>"
    cloudresourcemanager-tag-keys-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-tag-keys-get-namespaced: "record<createTime: string, description: string, etag: string, name: string, namespacedName: string, parent: string, purpose: string, purposeData: record, shortName: string, updateTime: string>"
    cloudresourcemanager-tag-values-list: "record<nextPageToken: string, tagValues: table<createTime: string, description: string, etag: string, name: string, namespacedName: string, parent: string, shortName: string, updateTime: string>>"
    cloudresourcemanager-tag-values-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-tag-values-get-namespaced: "record<createTime: string, description: string, etag: string, name: string, namespacedName: string, parent: string, shortName: string, updateTime: string>"
    cloudresourcemanager-tag-values-tag-holds-delete: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-tag-values-get: "record<createTime: string, description: string, etag: string, name: string, namespacedName: string, parent: string, shortName: string, updateTime: string>"
    cloudresourcemanager-tag-values-patch: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-projects-move: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-projects-undelete: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-tag-values-tag-holds-list: "record<nextPageToken: string, tagHolds: table<createTime: string, helpLink: string, holder: string, name: string, origin: string>>"
    cloudresourcemanager-tag-values-tag-holds-create: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    cloudresourcemanager-tag-values-get-iam-policy: "record<auditConfigs: table<auditLogConfigs: list, service: string>, bindings: table<condition: record, members: list, role: string>, etag: string, version: int>"
    cloudresourcemanager-tag-values-set-iam-policy: "record<auditConfigs: table<auditLogConfigs: list, service: string>, bindings: table<condition: record, members: list, role: string>, etag: string, version: int>"
    cloudresourcemanager-tag-values-test-iam-permissions: "record<permissions: list<string>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["cloudresourcemanager-effective-tags-list" "cloudresourcemanager-folders-list" "cloudresourcemanager-folders-create" "cloudresourcemanager-folders-search" "cloudresourcemanager-liens-list" "cloudresourcemanager-liens-create" "cloudresourcemanager-organizations-search" "cloudresourcemanager-projects-list" "cloudresourcemanager-projects-create" "cloudresourcemanager-projects-search" "cloudresourcemanager-tag-bindings-list" "cloudresourcemanager-tag-bindings-create" "cloudresourcemanager-tag-keys-list" "cloudresourcemanager-tag-keys-create" "cloudresourcemanager-tag-keys-get-namespaced" "cloudresourcemanager-tag-values-list" "cloudresourcemanager-tag-values-create" "cloudresourcemanager-tag-values-get-namespaced" "cloudresourcemanager-tag-values-tag-holds-delete" "cloudresourcemanager-tag-values-get" "cloudresourcemanager-tag-values-patch" "cloudresourcemanager-projects-move" "cloudresourcemanager-projects-undelete" "cloudresourcemanager-tag-values-tag-holds-list" "cloudresourcemanager-tag-values-tag-holds-create" "cloudresourcemanager-tag-values-get-iam-policy" "cloudresourcemanager-tag-values-set-iam-policy" "cloudresourcemanager-tag-values-test-iam-permissions" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

