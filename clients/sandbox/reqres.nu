# List agent users (cursor pagination)
#
# GET /agent/v1/users
# operationId: agentListUsers
export def "agent-users agentListUsers" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --cursor: string # Opaque cursor from previous response. Omit for first page.
  --limit: int # Page size (silently clamped at 100). (default: 20)
  --qp-fields: string # Comma-separated sparse fieldset (e.g. id,email,full_name).
  --seed: int # Deterministic fixture seed. (default: 42)
]: nothing -> record<data: table<id: string, email: string, full_name: string, locale: string, created_at: string, updated_at: string, timezone: string, profile: record, preferences: record, status: string>, meta: record<limit: int, returned: int, next_cursor: string, prev_cursor: string, has_more: bool, total_estimate: int>> {
  let auth = (build-auth $token ($auth_scheme | default "x-api-key"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "cursor" $cursor "scalar") (serialize-qp "limit" $limit "scalar") (serialize-qp "fields" $qp_fields "scalar") (serialize-qp "seed" $seed "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/agent/v1/users" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

