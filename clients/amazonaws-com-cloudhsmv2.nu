# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    copy-backup-to-region: "record<DestinationBackup: record<CreateTimestamp: string, SourceRegion: string, SourceBackup: string, SourceCluster: string>>"
    create-cluster: "record<Cluster: record<BackupPolicy: string, BackupRetentionPolicy: record<Type: string, Value: string>, ClusterId: string, CreateTimestamp: string, Hsms: list<record>, HsmType: string, PreCoPassword: string, SecurityGroup: string, SourceBackupId: string, State: string, StateMessage: string, SubnetMapping: record, VpcId: string, Certificates: record<ClusterCsr: string, HsmCertificate: string, AwsHardwareCertificate: string, ManufacturerHardwareCertificate: string, ClusterCertificate: string>, TagList: list<record>>>"
    create-hsm: "record<Hsm: record<AvailabilityZone: string, ClusterId: string, SubnetId: string, EniId: string, EniIp: string, HsmId: string, State: string, StateMessage: string>>"
    delete-backup: "record<Backup: record<BackupId: string, BackupState: string, ClusterId: string, CreateTimestamp: string, CopyTimestamp: string, NeverExpires: bool, SourceRegion: string, SourceBackup: string, SourceCluster: string, DeleteTimestamp: string, TagList: list<record>>>"
    delete-cluster: "record<Cluster: record<BackupPolicy: string, BackupRetentionPolicy: record<Type: string, Value: string>, ClusterId: string, CreateTimestamp: string, Hsms: list<record>, HsmType: string, PreCoPassword: string, SecurityGroup: string, SourceBackupId: string, State: string, StateMessage: string, SubnetMapping: record, VpcId: string, Certificates: record<ClusterCsr: string, HsmCertificate: string, AwsHardwareCertificate: string, ManufacturerHardwareCertificate: string, ClusterCertificate: string>, TagList: list<record>>>"
    delete-hsm: "record<HsmId: string>"
    describe-backups: "record<Backups: table<BackupId: string, BackupState: string, ClusterId: string, CreateTimestamp: string, CopyTimestamp: string, NeverExpires: bool, SourceRegion: string, SourceBackup: string, SourceCluster: string, DeleteTimestamp: string, TagList: list>, NextToken: string>"
    describe-clusters: "record<Clusters: table<BackupPolicy: string, BackupRetentionPolicy: record, ClusterId: string, CreateTimestamp: string, Hsms: list, HsmType: string, PreCoPassword: string, SecurityGroup: string, SourceBackupId: string, State: string, StateMessage: string, SubnetMapping: record, VpcId: string, Certificates: record, TagList: list>, NextToken: string>"
    initialize-cluster: "record<State: string, StateMessage: string>"
    list-tags: "record<TagList: table<Key: string, Value: string>, NextToken: string>"
    modify-backup-attributes: "record<Backup: record<BackupId: string, BackupState: string, ClusterId: string, CreateTimestamp: string, CopyTimestamp: string, NeverExpires: bool, SourceRegion: string, SourceBackup: string, SourceCluster: string, DeleteTimestamp: string, TagList: list<record>>>"
    modify-cluster: "record<Cluster: record<BackupPolicy: string, BackupRetentionPolicy: record<Type: string, Value: string>, ClusterId: string, CreateTimestamp: string, Hsms: list<record>, HsmType: string, PreCoPassword: string, SecurityGroup: string, SourceBackupId: string, State: string, StateMessage: string, SubnetMapping: record, VpcId: string, Certificates: record<ClusterCsr: string, HsmCertificate: string, AwsHardwareCertificate: string, ManufacturerHardwareCertificate: string, ClusterCertificate: string>, TagList: list<record>>>"
    restore-backup: "record<Backup: record<BackupId: string, BackupState: string, ClusterId: string, CreateTimestamp: string, CopyTimestamp: string, NeverExpires: bool, SourceRegion: string, SourceBackup: string, SourceCluster: string, DeleteTimestamp: string, TagList: list<record>>>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["copy-backup-to-region" "create-cluster" "create-hsm" "delete-backup" "delete-cluster" "delete-hsm" "describe-backups" "describe-clusters" "initialize-cluster" "list-tags" "modify-backup-attributes" "modify-cluster" "restore-backup" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Copy an AWS CloudHSM cluster backup to a different region.
