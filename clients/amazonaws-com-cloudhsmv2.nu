# Returns: record<DestinationBackup: record<CreateTimestamp: string, SourceRegion: string, SourceBackup: string, SourceCluster: string>>
# operationId: CopyBackupToRegion
export def "copy-backup-to-region" [
  --base-url(-b): string@base-url-completer # API base URL
