    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    conversation_id: $conversation_id, action: $action, channel: $channel, knocking_id: $knocking_id, media: $media, member_id: $member_id, member_id_inviting: $member_id_inviting, user_id: $user_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

