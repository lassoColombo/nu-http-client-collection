# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-entity-to-thing: "record"
    create-flow-template: "record<summary: record<id: string, arn: string, revisionNumber: int, createdAt: string>>"
    create-system-instance: "record<summary: record<id: string, arn: string, status: string, target: string, greengrassGroupName: string, createdAt: string, updatedAt: string, greengrassGroupId: string, greengrassGroupVersionId: string>>"
    create-system-template: "record<summary: record<id: string, arn: string, revisionNumber: int, createdAt: string>>"
    delete-flow-template: "record"
    delete-namespace: "record<namespaceArn: string, namespaceName: string>"
    delete-system-instance: "record"
    delete-system-template: "record"
    deploy-system-instance: "record<summary: record<id: string, arn: string, status: string, target: string, greengrassGroupName: string, createdAt: string, updatedAt: string, greengrassGroupId: string, greengrassGroupVersionId: string>, greengrassDeploymentId: string>"
    deprecate-flow-template: "record"
    deprecate-system-template: "record"
    describe-namespace: "record<namespaceArn: string, namespaceName: string, trackingNamespaceName: string, trackingNamespaceVersion: int, namespaceVersion: int>"
    dissociate-entity-from-thing: "record"
    get-entities: "record<descriptions: table<id: string, arn: string, type: string, createdAt: string, definition: record>>"
    get-flow-template: "record<description: record<summary: record<id: string, arn: string, revisionNumber: int, createdAt: string>, definition: record<language: string, text: string>, validatedNamespaceVersion: int>>"
    get-flow-template-revisions: "record<summaries: table<id: string, arn: string, revisionNumber: int, createdAt: string>, nextToken: string>"
    get-namespace-deletion-status: "record<namespaceArn: string, namespaceName: string, status: string, errorCode: string, errorMessage: string>"
    get-system-instance: "record<description: record<summary: record<id: string, arn: string, status: string, target: string, greengrassGroupName: string, createdAt: string, updatedAt: string, greengrassGroupId: string, greengrassGroupVersionId: string>, definition: record<language: string, text: string>, s3BucketName: string, metricsConfiguration: record<cloudMetricEnabled: bool, metricRuleRoleArn: string>, validatedNamespaceVersion: int, validatedDependencyRevisions: list<record>, flowActionsRoleArn: string>>"
    get-system-template: "record<description: record<summary: record<id: string, arn: string, revisionNumber: int, createdAt: string>, definition: record<language: string, text: string>, validatedNamespaceVersion: int>>"
    get-system-template-revisions: "record<summaries: table<id: string, arn: string, revisionNumber: int, createdAt: string>, nextToken: string>"
    get-upload-status: "record<uploadId: string, uploadStatus: string, namespaceArn: string, namespaceName: string, namespaceVersion: int, failureReason: list<string>, createdDate: string>"
    list-flow-execution-messages: "record<messages: table<messageId: string, eventType: string, timestamp: string, payload: string>, nextToken: string>"
    list-tags-for-resource: "record<tags: table<key: string, value: string>, nextToken: string>"
    search-entities: "record<descriptions: table<id: string, arn: string, type: string, createdAt: string, definition: record>, nextToken: string>"
    search-flow-executions: "record<summaries: table<flowExecutionId: string, status: string, systemInstanceId: string, flowTemplateId: string, createdAt: string, updatedAt: string>, nextToken: string>"
    search-flow-templates: "record<summaries: table<id: string, arn: string, revisionNumber: int, createdAt: string>, nextToken: string>"
    search-system-instances: "record<summaries: table<id: string, arn: string, status: string, target: string, greengrassGroupName: string, createdAt: string, updatedAt: string, greengrassGroupId: string, greengrassGroupVersionId: string>, nextToken: string>"
    search-system-templates: "record<summaries: table<id: string, arn: string, revisionNumber: int, createdAt: string>, nextToken: string>"
    search-things: "record<things: table<thingArn: string, thingName: string>, nextToken: string>"
    tag-resource: "record"
    undeploy-system-instance: "record<summary: record<id: string, arn: string, status: string, target: string, greengrassGroupName: string, createdAt: string, updatedAt: string, greengrassGroupId: string, greengrassGroupVersionId: string>>"
    untag-resource: "record"
    update-flow-template: "record<summary: record<id: string, arn: string, revisionNumber: int, createdAt: string>>"
    update-system-template: "record<summary: record<id: string, arn: string, revisionNumber: int, createdAt: string>>"
    upload-entity-definitions: "record<uploadId: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-entity-to-thing" "create-flow-template" "create-system-instance" "create-system-template" "delete-flow-template" "delete-namespace" "delete-system-instance" "delete-system-template" "deploy-system-instance" "deprecate-flow-template" "deprecate-system-template" "describe-namespace" "dissociate-entity-from-thing" "get-entities" "get-flow-template" "get-flow-template-revisions" "get-namespace-deletion-status" "get-system-instance" "get-system-template" "get-system-template-revisions" "get-upload-status" "list-flow-execution-messages" "list-tags-for-resource" "search-entities" "search-flow-executions" "search-flow-templates" "search-system-instances" "search-system-templates" "search-things" "tag-resource" "undeploy-system-instance" "untag-resource" "update-flow-template" "update-system-template" "upload-entity-definitions" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Associates a device with a concrete thing that is in the user's registry. A thing can be associated with only one device at a time. If you associate a thing with a new device id, its previous association will be removed.
