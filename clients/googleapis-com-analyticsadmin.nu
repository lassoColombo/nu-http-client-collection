    analyticsadmin-properties-custom-metrics-create: "record<description: string, displayName: string, measurementUnit: string, name: string, parameterName: string, restrictedMetricType: list<string>, scope: string>"
    analyticsadmin-properties-data-streams-list: "record<dataStreams: table<androidAppStreamData: record, createTime: string, displayName: string, iosAppStreamData: record, name: string, type: string, updateTime: string, webStreamData: record>, nextPageToken: string>"
    analyticsadmin-properties-data-streams-create: "record<androidAppStreamData: record<firebaseAppId: string, packageName: string>, createTime: string, displayName: string, iosAppStreamData: record<bundleId: string, firebaseAppId: string>, name: string, type: string, updateTime: string, webStreamData: record<defaultUri: string, firebaseAppId: string, measurementId: string>>"
    analyticsadmin-properties-firebase-links-list: "record<firebaseLinks: table<createTime: string, name: string, project: string>, nextPageToken: string>"
    analyticsadmin-properties-firebase-links-create: "record<createTime: string, name: string, project: string>"
    analyticsadmin-properties-google-ads-links-list: "record<googleAdsLinks: table<adsPersonalizationEnabled: bool, canManageClients: bool, createTime: string, creatorEmailAddress: string, customerId: string, name: string, updateTime: string>, nextPageToken: string>"
    analyticsadmin-properties-google-ads-links-create: "record<adsPersonalizationEnabled: bool, canManageClients: bool, createTime: string, creatorEmailAddress: string, customerId: string, name: string, updateTime: string>"
    analyticsadmin-properties-data-streams-measurement-protocol-secrets-list: "record<measurementProtocolSecrets: table<displayName: string, name: string, secretValue: string>, nextPageToken: string>"
    analyticsadmin-properties-data-streams-measurement-protocol-secrets-create: "record<displayName: string, name: string, secretValue: string>"
    analyticsadmin-properties-acknowledge-user-data-collection: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["analyticsadmin-account-summaries-list" "analyticsadmin-accounts-list" "analyticsadmin-accounts-provision-account-ticket" "analyticsadmin-properties-list" "analyticsadmin-properties-create" "analyticsadmin-accounts-search-change-history-events" "analyticsadmin-properties-run-access-report" "analyticsadmin-properties-google-ads-links-delete" "analyticsadmin-properties-data-streams-measurement-protocol-secrets-get" "analyticsadmin-properties-google-ads-links-patch" "analyticsadmin-properties-custom-metrics-archive" "analyticsadmin-properties-conversion-events-list" "analyticsadmin-properties-conversion-events-create" "analyticsadmin-properties-custom-dimensions-list" "analyticsadmin-properties-custom-dimensions-create" "analyticsadmin-properties-custom-metrics-list" "analyticsadmin-properties-custom-metrics-create" "analyticsadmin-properties-data-streams-list" "analyticsadmin-properties-data-streams-create" "analyticsadmin-properties-firebase-links-list" "analyticsadmin-properties-firebase-links-create" "analyticsadmin-properties-google-ads-links-list" "analyticsadmin-properties-google-ads-links-create" "analyticsadmin-properties-data-streams-measurement-protocol-secrets-list" "analyticsadmin-properties-data-streams-measurement-protocol-secrets-create" "analyticsadmin-properties-acknowledge-user-data-collection" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

