    body: {content_type: "application/json", kind: json, fields: [{name: name, var: name}, {name: description, var: description}, {name: clientRequestToken, var: client_request_token}, {name: instanceType, var: instance_type}, {name: subnetId, var: subnet_id}, {name: imageId, var: image_id}, {name: automaticStopTimeMinutes, var: automatic_stop_time_minutes}, {name: ownerArn, var: owner_arn}, {name: tags, var: tags}, {name: connectionType, var: connection_type}, {name: dryRun, var: body_dry_run}]}
