  --dry-run(-n) # Return the request that would be sent without executing it
  --account: record # The account linked to your event. — shape: {id: string}
  application: record # The application in which you want to send your events. — shape: {id: string}
  event: record # Fields used for the event. — shape: {name: string}
  --session: record # The session linked to your event. — shape: {id: string}
  type: string@type-completer-1 # The type of Product Analytics event. Must be `server` for server-side events. (e.g. server)
  --usr: record # The user linked to your event. — shape: {id: string}
]: any -> record {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "dd-api-key"))
  let base = ($base_url | default "https://{site}")
  let full_url = (build-url $base "/api/v2/prodlytics")
  let body = {account: $account, application: $application, event: $event, session: $session, type: $type, usr: $usr} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json" $body
}

