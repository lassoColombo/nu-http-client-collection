export def "deletion-requests GetDataDeletionRequests" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --next-page: string # The next page of the previous search. If the next_page parameter is included, the rest of the query elements are ignored. (e.g. cGFnZTI=)
  --product: string # Retrieve only the requests related to the given product. (e.g. logs)
  --qp-query: string # Retrieve only the requests that matches the given query. (e.g. service:xyz host:abc)
  --status: string # Retrieve only the requests with the given status. (e.g. pending)
  --page-size: int # Sets the page size of the search. (format: int64, default: 50, e.g. 50)
]: nothing -> record<data: table<attributes: record, id: string, type: string>, meta: record<count_product: record, count_status: record, next_page: string, product: string, request_status: string>> {
  let auth = (build-auth $token ($auth_scheme | default "dd-api-key"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "next_page" $next_page "scalar") (serialize-qp "product" $product "scalar") (serialize-qp "query" $qp_query "scalar") (serialize-qp "status" $status "scalar") (serialize-qp "page_size" $page_size "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/v2/deletion/requests" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

