# Get a list of spans
#
# GET /api/v2/spans/events
# operationId: ListSpansGet
export def "spans-events ListSpansGet" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --filterquery: string # Search query following spans syntax. (e.g. @datacenter:us @role:db)
  --filterfrom: string # Minimum timestamp for requested spans. Supports date-time ISO8601, date math, and regular timestamps (milliseconds). (e.g. 2023-01-02T09:42:36.320Z)
  --filterto: string # Maximum timestamp for requested spans. Supports date-time ISO8601, date math, and regular timestamps (milliseconds). (e.g. 2023-01-03T09:42:36.320Z)
  --qp-sort: string@sort-completer-2 # Order of spans in results.
  --pagecursor: string # List following results with a cursor provided in the previous query. (e.g. eyJzdGFydEF0IjoiQVFBQUFYS2tMS3pPbm40NGV3QUFBQUJCV0V0clRFdDZVbG8zY3pCRmNsbHJiVmxDWlEifQ==)
  --pagelimit: int # Maximum number of spans in the response. (format: int32, default: 10, e.g. 25)
]: nothing -> record<data: table<attributes: record, id: string, type: string>, links: record<next: string>, meta: record<elapsed: int, page: record<after: string>, request_id: string, status: string, warnings: list<record>>> {
  let auth = (build-auth $token ($auth_scheme | default "dd-api-key"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "filter[query]" $filterquery "scalar") (serialize-qp "filter[from]" $filterfrom "scalar") (serialize-qp "filter[to]" $filterto "scalar") (serialize-qp "sort" $qp_sort "scalar") (serialize-qp "page[cursor]" $pagecursor "scalar") (serialize-qp "page[limit]" $pagelimit "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/v2/spans/events" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

