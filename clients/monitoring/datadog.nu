# List LLM Observability spans
#
# GET /api/v2/llm-obs/v1/spans/events
# operationId: ListLLMObsSpans
export def "llm-obs-spans-events ListLLMObsSpans" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --filterfrom: string # Start of the time range. Accepts ISO 8601 or relative format (e.g., `now-15m`). Defaults to `now-15m`. (e.g. now-900s)
  --filterto: string # End of the time range. Accepts ISO 8601 or relative format. Defaults to `now`. (e.g. now)
  --filterquery: string # Search query using LLM Observability query syntax. Supports attribute filters using the field:value syntax (e.g. session_id, trace_id, ml_app, meta.span.kind). When provided, structured field filters (`filter[span_id]`, `filter[trace_id]`, etc.) are ignored. (e.g. @session_id:abc123def456)
  --filterspan-id: string # Filter by exact span ID.
  --filtertrace-id: string # Filter by exact trace ID.
  --filterspan-kind: string # Filter by span kind (e.g., llm, agent, tool, task, workflow).
  --filterspan-name: string # Filter by span name.
  --filterml-app: string # Filter by ML application name.
  --pagelimit: int # Maximum number of spans to return. Defaults to `10`. (format: int64)
  --pagecursor: string # Cursor from the previous response to retrieve the next page.
  --qp-sort: string # Sort order for the results.
  --include-attachments: oneof<nothing, bool> # Whether to include attachment data in the response. Defaults to `true`.
]: nothing -> record<data: table<attributes: record, id: string, type: string>, links: record<next: string>, meta: record<elapsed: int, page: record<after: string>, request_id: string, status: string>> {
  let auth = (build-auth $token ($auth_scheme | default "dd-api-key"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "filter[from]" $filterfrom "scalar") (serialize-qp "filter[to]" $filterto "scalar") (serialize-qp "filter[query]" $filterquery "scalar") (serialize-qp "filter[span_id]" $filterspan_id "scalar") (serialize-qp "filter[trace_id]" $filtertrace_id "scalar") (serialize-qp "filter[span_kind]" $filterspan_kind "scalar") (serialize-qp "filter[span_name]" $filterspan_name "scalar") (serialize-qp "filter[ml_app]" $filterml_app "scalar") (serialize-qp "page[limit]" $pagelimit "scalar") (serialize-qp "page[cursor]" $pagecursor "scalar") (serialize-qp "sort" $qp_sort "scalar") (serialize-qp "include_attachments" $include_attachments "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/v2/llm-obs/v1/spans/events" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

