  let qp = [(serialize-qp "filter[query]" $filterquery "scalar") (serialize-qp "filter[from]" $filterfrom "scalar") (serialize-qp "filter[to]" $filterto "scalar") (serialize-qp "sort" $qp_sort "scalar") (serialize-qp "page[cursor]" $pagecursor "scalar") (serialize-qp "page[limit]" $pagelimit "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/v2/rum/events" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

