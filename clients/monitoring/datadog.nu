# List vulnerable assets
#
# GET /api/v2/security/vulnerable-assets
# operationId: ListVulnerableAssets
export def "security-vulnerable-assets ListVulnerableAssets" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --pagetoken: string # Its value must come from the `links` section of the response of the first request. Do not manually edit it. (e.g. b82cef018aab81ed1d4bb4xb35xxfc065da7efa685fbcecdbd338f3015e3afabbbfa3a911b4984_721ee28a-zecb-4e45-9960-c42065b574f4)
  --pagenumber: int # The page number to be retrieved. It should be equal or greater than `1` (format: int64, e.g. 1)
  --filtername: string # Filter by name. This field supports the usage of wildcards (*). (e.g. datadog-agent)
  --filtertype: string@filtertype-completer-2 # Filter by type. (e.g. Repository)
  --filterversionfirst: string # Filter by the first version of the asset since it has been vulnerable. (e.g. v1.15.1)
  --filterversionlast: string # Filter by the last detected version of the asset. (e.g. v1.15.1)
  --filterrepository-url: string # Filter by the repository url associated to the asset. (e.g. github.com/DataDog/datadog-agent.git)
  --filterrisksin-production: oneof<nothing, bool> # Filter whether the asset is in production or not. (e.g. false)
  --filterrisksunder-attack: oneof<nothing, bool> # Filter whether the asset (Service) is under attack or not. (e.g. false)
  --filterrisksis-publicly-accessible: oneof<nothing, bool> # Filter whether the asset (Host) is publicly accessible or not. (e.g. false)
  --filterriskshas-privileged-access: oneof<nothing, bool> # Filter whether the asset (Host) has privileged access or not. (e.g. false)
  --filterriskshas-access-to-sensitive-data: oneof<nothing, bool> # Filter whether the asset (Host)  has access to sensitive data or not. (e.g. false)
  --filterenvironments: string # Filter by environment. (e.g. staging)
  --filterteams: string # Filter by teams. (e.g. compute)
  --filterarch: string # Filter by architecture. (e.g. arm64)
  --filteroperating-systemname: string # Filter by operating system name. (e.g. ubuntu)
  --filteroperating-systemversion: string # Filter by operating system version. (e.g. 24.04)
]: nothing -> record<data: table<attributes: record, id: string, type: string>, links: record<first: string, last: string, next: string, previous: string, self: string>, meta: record<count: int, token: string, total: int>> {
  let auth = (build-auth $token ($auth_scheme | default "dd-api-key"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "page[token]" $pagetoken "scalar") (serialize-qp "page[number]" $pagenumber "scalar") (serialize-qp "filter[name]" $filtername "scalar") (serialize-qp "filter[type]" $filtertype "scalar") (serialize-qp "filter[version.first]" $filterversionfirst "scalar") (serialize-qp "filter[version.last]" $filterversionlast "scalar") (serialize-qp "filter[repository_url]" $filterrepository_url "scalar") (serialize-qp "filter[risks.in_production]" $filterrisksin_production "scalar") (serialize-qp "filter[risks.under_attack]" $filterrisksunder_attack "scalar") (serialize-qp "filter[risks.is_publicly_accessible]" $filterrisksis_publicly_accessible "scalar") (serialize-qp "filter[risks.has_privileged_access]" $filterriskshas_privileged_access "scalar") (serialize-qp "filter[risks.has_access_to_sensitive_data]" $filterriskshas_access_to_sensitive_data "scalar") (serialize-qp "filter[environments]" $filterenvironments "scalar") (serialize-qp "filter[teams]" $filterteams "scalar") (serialize-qp "filter[arch]" $filterarch "scalar") (serialize-qp "filter[operating_system.name]" $filteroperating_systemname "scalar") (serialize-qp "filter[operating_system.version]" $filteroperating_systemversion "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/api/v2/security/vulnerable-assets" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json"
}

