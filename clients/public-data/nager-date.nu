# Retrieve all long weekends for a given country and year
#
# GET /api/v3/LongWeekend/{year}/{countryCode}
export def "long-weekend get" [
  year: int
  countryCode: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --availableBridgeDays: int # The maximum number of bridge days to include when determining long-weekend opportunities. (format: int32, default: 1)
  --subdivisionCode: string # Narrow the calculation to a specific federal state, province, or subdivision (where supported).
]: nothing -> table<startDate: string, endDate: string, dayCount: int, needBridgeDay: bool, bridgeDays: list<string>> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "availableBridgeDays" $availableBridgeDays "scalar") (serialize-qp "subdivisionCode" $subdivisionCode "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/api/v3/LongWeekend/($year)/($countryCode)" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

