  --accept: string@accept-completer # Response content type
  --updatedSince: string # ISO 8601 full-date in the format YYYY-MM-DD. Filters the list of available ID values by their lastUpdated parameter. (format: date)
  --format: string@format-completer # The response type desired. (default: json)
]: nothing -> record<id: int, lastUpdated: string> {
