def transaction-type-completer [] { ["READ_AND_WRITE" "READ_ONLY"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    add-lf-tags-to-resource: "record<Failures: table<LFTag: record, Error: record>>"
    assume-decorated-role-with-saml: "record<AccessKeyId: string, SecretAccessKey: string, SessionToken: string, Expiration: string>"
    batch-grant-permissions: "record<Failures: table<RequestEntry: record, Error: record>>"
    batch-revoke-permissions: "record<Failures: table<RequestEntry: record, Error: record>>"
    cancel-transaction: "record"
    commit-transaction: "record<TransactionStatus: string>"
    create-data-cells-filter: "record"
    create-lf-tag: "record"
    delete-data-cells-filter: "record"
    delete-lf-tag: "record"
    delete-objects-on-cancel: "record"
    deregister-resource: "record"
    describe-resource: "record<ResourceInfo: record<ResourceArn: string, RoleArn: string, LastModified: string, WithFederation: bool>>"
    describe-transaction: "record<TransactionDescription: record<TransactionId: string, TransactionStatus: string, TransactionStartTime: string, TransactionEndTime: string>>"
    extend-transaction: "record"
    get-data-cells-filter: "record<DataCellsFilter: record<TableCatalogId: string, DatabaseName: string, TableName: string, Name: string, RowFilter: record<FilterExpression: string, AllRowsWildcard: record>, ColumnNames: list<string>, ColumnWildcard: record<ExcludedColumnNames: list>, VersionId: string>>"
    get-data-lake-settings: "record<DataLakeSettings: record<DataLakeAdmins: list<record>, CreateDatabaseDefaultPermissions: list<record>, CreateTableDefaultPermissions: list<record>, Parameters: record, TrustedResourceOwners: list<string>, AllowExternalDataFiltering: bool, ExternalDataFilteringAllowList: list<record>, AuthorizedSessionTagValueList: list<string>>>"
    get-effective-permissions-for-path: "record<Permissions: table<Principal: record, Resource: record, Permissions: list, PermissionsWithGrantOption: list, AdditionalDetails: record>, NextToken: string>"
    get-lf-tag: "record<CatalogId: string, TagKey: string, TagValues: list<string>>"
    get-query-state: "record<Error: string, State: string>"
    get-query-statistics: "record<ExecutionStatistics: record<AverageExecutionTimeMillis: int, DataScannedBytes: int, WorkUnitsExecutedCount: int>, PlanningStatistics: record<EstimatedDataToScanBytes: int, PlanningTimeMillis: int, QueueTimeMillis: int, WorkUnitsGeneratedCount: int>, QuerySubmissionTime: string>"
    get-resource-lf-tags: "record<LFTagOnDatabase: table<CatalogId: string, TagKey: string, TagValues: list>, LFTagsOnTable: table<CatalogId: string, TagKey: string, TagValues: list>, LFTagsOnColumns: table<Name: string, LFTags: list>>"
    get-table-objects: "record<Objects: table<PartitionValues: list, Objects: list>, NextToken: string>"
    get-temporary-glue-partition-credentials: "record<AccessKeyId: string, SecretAccessKey: string, SessionToken: string, Expiration: string>"
    get-temporary-glue-table-credentials: "record<AccessKeyId: string, SecretAccessKey: string, SessionToken: string, Expiration: string>"
    get-work-unit-results: "record<ResultStream: string>"
    get-work-units: "record<NextToken: string, QueryId: string, WorkUnitRanges: table<WorkUnitIdMax: int, WorkUnitIdMin: int, WorkUnitToken: string>>"
    grant-permissions: "record"
    list-data-cells-filter: "record<DataCellsFilters: table<TableCatalogId: string, DatabaseName: string, TableName: string, Name: string, RowFilter: record, ColumnNames: list, ColumnWildcard: record, VersionId: string>, NextToken: string>"
    list-lf-tags: "record<LFTags: table<CatalogId: string, TagKey: string, TagValues: list>, NextToken: string>"
    list-permissions: "record<PrincipalResourcePermissions: table<Principal: record, Resource: record, Permissions: list, PermissionsWithGrantOption: list, AdditionalDetails: record>, NextToken: string>"
    list-resources: "record<ResourceInfoList: table<ResourceArn: string, RoleArn: string, LastModified: string, WithFederation: bool>, NextToken: string>"
    list-table-storage-optimizers: "record<StorageOptimizerList: table<StorageOptimizerType: string, Config: record, ErrorMessage: string, Warnings: string, LastRunDetails: string>, NextToken: string>"
    list-transactions: "record<Transactions: table<TransactionId: string, TransactionStatus: string, TransactionStartTime: string, TransactionEndTime: string>, NextToken: string>"
    put-data-lake-settings: "record"
    register-resource: "record"
    remove-lf-tags-from-resource: "record<Failures: table<LFTag: record, Error: record>>"
    revoke-permissions: "record"
    search-databases-by-lf-tags: "record<NextToken: string, DatabaseList: table<Database: record, LFTags: list>>"
    search-tables-by-lf-tags: "record<NextToken: string, TableList: table<Table: record, LFTagOnDatabase: list, LFTagsOnTable: list, LFTagsOnColumns: list>>"
    start-query-planning: "record<QueryId: string>"
    start-transaction: "record<TransactionId: string>"
    update-data-cells-filter: "record"
    update-lf-tag: "record"
    update-resource: "record"
    update-table-objects: "record"
    update-table-storage-optimizer: "record<Result: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["add-lf-tags-to-resource" "assume-decorated-role-with-saml" "batch-grant-permissions" "batch-revoke-permissions" "cancel-transaction" "commit-transaction" "create-data-cells-filter" "create-lf-tag" "delete-data-cells-filter" "delete-lf-tag" "delete-objects-on-cancel" "deregister-resource" "describe-resource" "describe-transaction" "extend-transaction" "get-data-cells-filter" "get-data-lake-settings" "get-effective-permissions-for-path" "get-lf-tag" "get-query-state" "get-query-statistics" "get-resource-lf-tags" "get-table-objects" "get-temporary-glue-partition-credentials" "get-temporary-glue-table-credentials" "get-work-unit-results" "get-work-units" "grant-permissions" "list-data-cells-filter" "list-lf-tags" "list-permissions" "list-resources" "list-table-storage-optimizers" "list-transactions" "put-data-lake-settings" "register-resource" "remove-lf-tags-from-resource" "revoke-permissions" "search-databases-by-lf-tags" "search-tables-by-lf-tags" "start-query-planning" "start-transaction" "update-data-cells-filter" "update-lf-tag" "update-resource" "update-table-objects" "update-table-storage-optimizer" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Attaches one or more LF-tags to an existing resource.
#
# POST /AddLFTagsToResource
# Returns: record<Failures: table<LFTag: record, Error: record>>
# operationId: AddLFTagsToResource
export def "add-lf-tags-to-resource" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --catalog-id: string # The identifier for the Data Catalog. By default, the account ID. The Data Catalog is the persistent metadata store. It contains database definitions, table definitions, and other control information to manage your Lake Formation environment.
  resource: record # A structure for the resource. — shape: {Catalog?: record, Database?: record, Table?: record, TableWithColumns?: record, DataLocation?: record, DataCellsFilter?: record, LFTag?: record, LFTagPolicy?: record}
  lf_tags: list # The LF-tags to attach to the resource. — item shape: {CatalogId?: string, TagKey: string, TagValues: list<string>}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/AddLFTagsToResource"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: CatalogId, var: catalog_id}, {name: Resource, var: resource}, {name: LFTags, var: lf_tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, catalog_id: $catalog_id, resource: $resource, lf_tags: $lf_tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Allows a caller to assume an IAM role decorated as the SAML user specified in the SAML assertion included in the request. This decoration allows Lake Formation to enforce access policies against the SAML users and groups. This API operation requires SAML federation setup in the caller’s account as it can only be called with valid SAML assertions. Lake Formation does not scope down the permission of the assumed role. All permissions attached to the role via the SAML federation setup will be included in the role session. This decorated role is expected to access data in Amazon S3 by getting temporary access from Lake Formation which is authorized via the virtual API GetDataAccess. Therefore, all SAML roles that can be assumed via AssumeDecoratedRoleWithSAML must at a minimum include lakeformation:GetDataAccess in their role policies. A typical IAM policy attached to such a role would look as follows:
#
# POST /AssumeDecoratedRoleWithSAML
# Returns: record<AccessKeyId: string, SecretAccessKey: string, SessionToken: string, Expiration: string>
# operationId: AssumeDecoratedRoleWithSAML
export def "assume-decorated-role-with-saml" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  saml_assertion: string # A SAML assertion consisting of an assertion statement for the user who needs temporary credentials. This must match the SAML assertion that was issued to IAM. This must be Base64 encoded.
  role_arn: string # The role that represents an IAM principal whose scope down policy allows it to call credential vending APIs such as GetTemporaryTableCredentials. The caller must also have iam:PassRole permission on this role.
  principal_arn: string # The Amazon Resource Name (ARN) of the SAML provider in IAM that describes the IdP.
  --duration-seconds: int # The time period, between 900 and 43,200 seconds, for the timeout of the temporary credentials.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/AssumeDecoratedRoleWithSAML"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: SAMLAssertion, var: saml_assertion}, {name: RoleArn, var: role_arn}, {name: PrincipalArn, var: principal_arn}, {name: DurationSeconds, var: duration_seconds}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, saml_assertion: $saml_assertion, role_arn: $role_arn, principal_arn: $principal_arn, duration_seconds: $duration_seconds
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

