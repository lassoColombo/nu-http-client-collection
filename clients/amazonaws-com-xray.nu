# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    batch-get-traces: "record<Traces: table<Id: string, Duration: float, LimitExceeded: bool, Segments: list>, UnprocessedTraceIds: list<string>, NextToken: string>"
    create-group: "record<Group: record<GroupName: string, GroupARN: string, FilterExpression: string, InsightsConfiguration: record<InsightsEnabled: bool, NotificationsEnabled: bool>>>"
    create-sampling-rule: "record<SamplingRuleRecord: record<SamplingRule: record<RuleName: string, RuleARN: string, ResourceARN: string, Priority: int, FixedRate: float, ReservoirSize: int, ServiceName: string, ServiceType: string, Host: string, HTTPMethod: string, URLPath: string, Version: int, Attributes: record>, CreatedAt: string, ModifiedAt: string>>"
    delete-group: "record"
    delete-resource-policy: "record"
    delete-sampling-rule: "record<SamplingRuleRecord: record<SamplingRule: record<RuleName: string, RuleARN: string, ResourceARN: string, Priority: int, FixedRate: float, ReservoirSize: int, ServiceName: string, ServiceType: string, Host: string, HTTPMethod: string, URLPath: string, Version: int, Attributes: record>, CreatedAt: string, ModifiedAt: string>>"
    get-encryption-config: "record<EncryptionConfig: record<KeyId: string, Status: string, Type: string>>"
    get-group: "record<Group: record<GroupName: string, GroupARN: string, FilterExpression: string, InsightsConfiguration: record<InsightsEnabled: bool, NotificationsEnabled: bool>>>"
    get-groups: "record<Groups: table<GroupName: string, GroupARN: string, FilterExpression: string, InsightsConfiguration: record>, NextToken: string>"
    get-insight: "record<Insight: record<InsightId: string, GroupARN: string, GroupName: string, RootCauseServiceId: record<Name: string, Names: list, AccountId: string, Type: string>, Categories: list<string>, State: string, StartTime: string, EndTime: string, Summary: string, ClientRequestImpactStatistics: record<FaultCount: int, OkCount: int, TotalCount: int>, RootCauseServiceRequestImpactStatistics: record<FaultCount: int, OkCount: int, TotalCount: int>, TopAnomalousServices: list<record>>>"
    get-insight-events: "record<InsightEvents: table<Summary: string, EventTime: string, ClientRequestImpactStatistics: record, RootCauseServiceRequestImpactStatistics: record, TopAnomalousServices: list>, NextToken: string>"
    get-insight-impact-graph: "record<InsightId: string, StartTime: string, EndTime: string, ServiceGraphStartTime: string, ServiceGraphEndTime: string, Services: table<ReferenceId: int, Type: string, Name: string, Names: list, AccountId: string, Edges: list>, NextToken: string>"
    get-insight-summaries: "record<InsightSummaries: table<InsightId: string, GroupARN: string, GroupName: string, RootCauseServiceId: record, Categories: list, State: string, StartTime: string, EndTime: string, Summary: string, ClientRequestImpactStatistics: record, RootCauseServiceRequestImpactStatistics: record, TopAnomalousServices: list, LastUpdateTime: string>, NextToken: string>"
    get-sampling-rules: "record<SamplingRuleRecords: table<SamplingRule: record, CreatedAt: string, ModifiedAt: string>, NextToken: string>"
    get-sampling-statistic-summaries: "record<SamplingStatisticSummaries: table<RuleName: string, Timestamp: string, RequestCount: int, BorrowCount: int, SampledCount: int>, NextToken: string>"
    get-sampling-targets: "record<SamplingTargetDocuments: table<RuleName: string, FixedRate: float, ReservoirQuota: int, ReservoirQuotaTTL: string, Interval: int>, LastRuleModification: string, UnprocessedStatistics: table<RuleName: string, ErrorCode: string, Message: string>>"
    get-service-graph: "record<StartTime: string, EndTime: string, Services: table<ReferenceId: int, Name: string, Names: list, Root: bool, AccountId: string, Type: string, State: string, StartTime: string, EndTime: string, Edges: list, SummaryStatistics: record, DurationHistogram: list, ResponseTimeHistogram: list>, ContainsOldGroupVersions: bool, NextToken: string>"
    get-time-series-service-statistics: "record<TimeSeriesServiceStatistics: table<Timestamp: string, EdgeSummaryStatistics: record, ServiceSummaryStatistics: record, ServiceForecastStatistics: record, ResponseTimeHistogram: list>, ContainsOldGroupVersions: bool, NextToken: string>"
    get-trace-graph: "record<Services: table<ReferenceId: int, Name: string, Names: list, Root: bool, AccountId: string, Type: string, State: string, StartTime: string, EndTime: string, Edges: list, SummaryStatistics: record, DurationHistogram: list, ResponseTimeHistogram: list>, NextToken: string>"
    get-trace-summaries: "record<TraceSummaries: table<Id: string, Duration: float, ResponseTime: float, HasFault: bool, HasError: bool, HasThrottle: bool, IsPartial: bool, Http: record, Annotations: record, Users: list, ServiceIds: list, ResourceARNs: list, InstanceIds: list, AvailabilityZones: list, EntryPoint: record, FaultRootCauses: list, ErrorRootCauses: list, ResponseTimeRootCauses: list, Revision: int, MatchedEventTime: string>, ApproximateTime: string, TracesProcessedCount: int, NextToken: string>"
    list-resource-policies: "record<ResourcePolicies: table<PolicyName: string, PolicyDocument: string, PolicyRevisionId: string, LastUpdatedTime: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>, NextToken: string>"
    put-encryption-config: "record<EncryptionConfig: record<KeyId: string, Status: string, Type: string>>"
    put-resource-policy: "record<ResourcePolicy: record<PolicyName: string, PolicyDocument: string, PolicyRevisionId: string, LastUpdatedTime: string>>"
    put-telemetry-records: "record"
    put-trace-segments: "record<UnprocessedTraceSegments: table<Id: string, ErrorCode: string, Message: string>>"
    tag-resource: "record"
    untag-resource: "record"
    update-group: "record<Group: record<GroupName: string, GroupARN: string, FilterExpression: string, InsightsConfiguration: record<InsightsEnabled: bool, NotificationsEnabled: bool>>>"
    update-sampling-rule: "record<SamplingRuleRecord: record<SamplingRule: record<RuleName: string, RuleARN: string, ResourceARN: string, Priority: int, FixedRate: float, ReservoirSize: int, ServiceName: string, ServiceType: string, Host: string, HTTPMethod: string, URLPath: string, Version: int, Attributes: record>, CreatedAt: string, ModifiedAt: string>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["batch-get-traces" "create-group" "create-sampling-rule" "delete-group" "delete-resource-policy" "delete-sampling-rule" "get-encryption-config" "get-group" "get-groups" "get-insight" "get-insight-events" "get-insight-impact-graph" "get-insight-summaries" "get-sampling-rules" "get-sampling-statistic-summaries" "get-sampling-targets" "get-service-graph" "get-time-series-service-statistics" "get-trace-graph" "get-trace-summaries" "list-resource-policies" "list-tags-for-resource" "put-encryption-config" "put-resource-policy" "put-telemetry-records" "put-trace-segments" "tag-resource" "untag-resource" "update-group" "update-sampling-rule" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Retrieves a list of traces specified by ID. Each trace is a collection of segment documents that originates from a single request. Use GetTraceSummaries to get a list of trace IDs.
#
# POST /Traces
# Returns: record<Traces: table<Id: string, Duration: float, LimitExceeded: bool, Segments: list>, UnprocessedTraceIds: list<string>, NextToken: string>
# operationId: BatchGetTraces
export def "batch-get-traces" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --next-token: string # Pagination token
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  trace_ids: list<string> # Specify the trace IDs of requests for which to retrieve segments.
  --body-next-token: string # Pagination token. (spec name: NextToken)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/Traces"
    query: [{name: NextToken, var: next_token}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: TraceIds, var: trace_ids}, {name: NextToken, var: body_next_token}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    next_token: $next_token, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, trace_ids: $trace_ids, body_next_token: $body_next_token
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

