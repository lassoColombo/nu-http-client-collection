def auth-scheme-completer [] { ["bearer"] }


# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-resource: "record"
    create-canary: "record<Canary: record<Id: string, Name: string, Code: record<SourceLocationArn: string, Handler: string>, ExecutionRoleArn: string, Schedule: record<Expression: string, DurationInSeconds: int>, RunConfig: record<TimeoutInSeconds: int, MemoryInMB: int, ActiveTracing: bool>, SuccessRetentionPeriodInDays: int, FailureRetentionPeriodInDays: int, Status: record<State: string, StateReason: string, StateReasonCode: string>, Timeline: record<Created: string, LastModified: string, LastStarted: string, LastStopped: string>, ArtifactS3Location: string, EngineArn: string, RuntimeVersion: string, VpcConfig: record<VpcId: string, SubnetIds: list, SecurityGroupIds: list>, VisualReference: record<BaseScreenshots: list, BaseCanaryRunId: string>, Tags: record, ArtifactConfig: record<S3Encryption: record>>>"
    create-group: "record<Group: record<Id: string, Name: string, Arn: string, Tags: record, CreatedTime: string, LastModifiedTime: string>>"
    delete-canary: "record"
    get-canary: "record<Canary: record<Id: string, Name: string, Code: record<SourceLocationArn: string, Handler: string>, ExecutionRoleArn: string, Schedule: record<Expression: string, DurationInSeconds: int>, RunConfig: record<TimeoutInSeconds: int, MemoryInMB: int, ActiveTracing: bool>, SuccessRetentionPeriodInDays: int, FailureRetentionPeriodInDays: int, Status: record<State: string, StateReason: string, StateReasonCode: string>, Timeline: record<Created: string, LastModified: string, LastStarted: string, LastStopped: string>, ArtifactS3Location: string, EngineArn: string, RuntimeVersion: string, VpcConfig: record<VpcId: string, SubnetIds: list, SecurityGroupIds: list>, VisualReference: record<BaseScreenshots: list, BaseCanaryRunId: string>, Tags: record, ArtifactConfig: record<S3Encryption: record>>>"
    update-canary: "record"
    delete-group: "record"
    get-group: "record<Group: record<Id: string, Name: string, Arn: string, Tags: record, CreatedTime: string, LastModifiedTime: string>>"
    describe-canaries: "record<Canaries: table<Id: string, Name: string, Code: record, ExecutionRoleArn: string, Schedule: record, RunConfig: record, SuccessRetentionPeriodInDays: int, FailureRetentionPeriodInDays: int, Status: record, Timeline: record, ArtifactS3Location: string, EngineArn: string, RuntimeVersion: string, VpcConfig: record, VisualReference: record, Tags: record, ArtifactConfig: record>, NextToken: string>"
    describe-canaries-last-run: "record<CanariesLastRun: table<CanaryName: string, LastRun: record>, NextToken: string>"
    describe-runtime-versions: "record<RuntimeVersions: table<VersionName: string, Description: string, ReleaseDate: string, DeprecationDate: string>, NextToken: string>"
    disassociate-resource: "record"
    get-canary-runs: "record<CanaryRuns: table<Id: string, Name: string, Status: record, Timeline: record, ArtifactS3Location: string>, NextToken: string>"
    list-associated-groups: "record<Groups: table<Id: string, Name: string, Arn: string>, NextToken: string>"
    list-group-resources: "record<Resources: list<string>, NextToken: string>"
    list-groups: "record<Groups: table<Id: string, Name: string, Arn: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    start-canary: "record"
    stop-canary: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-resource" "create-canary" "create-group" "delete-canary" "get-canary" "update-canary" "delete-group" "get-group" "describe-canaries" "describe-canaries-last-run" "describe-runtime-versions" "disassociate-resource" "get-canary-runs" "list-associated-groups" "list-group-resources" "list-groups" "list-tags-for-resource" "tag-resource" "start-canary" "stop-canary" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Associates a canary with a group. Using groups can help you with managing and automating your canaries, and you can also view aggregated run results and statistics for all canaries in a group. You must run this operation in the Region where the canary exists.
#
# PATCH /group/{groupIdentifier}/associate
# Returns: record
# operationId: AssociateResource
export def "associate-resource" [
  group_identifier: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
