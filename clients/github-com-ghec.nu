# Docs: https://docs.github.com/enterprise-cloud@latest//rest/reference/reactions#create-reaction-for-an-issue-comment — API method documentation
# Returns: record<content: string, created_at: string, id: int, node_id: string, user: record<avatar_url: string, email: string, events_url: string, followers_url: string, following_url: string, gists_url: string, gravatar_id: string, html_url: string, id: int, login: string, name: string, node_id: string, organizations_url: string, received_events_url: string, repos_url: string, site_admin: bool, starred_at: string, starred_url: string, subscriptions_url: string, type: string, url: string>>
# operationId: reactions/create-for-issue-comment
export def "reactions-create-for-issue-comment" [
  owner: string
  repo: string
  comment_id: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  content: string@content-completer # The [reaction type](https://docs.github.com/enterprise-cloud@latest//rest/reference/reactions#reaction-types) to add to the issue comment.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/repos/{owner}/{repo}/issues/comments/{comment_id}/reactions"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: comment_id, var: comment_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: content, var: content}]}
    accept: ["application/json"]
    ok: [200, 201]
    auth: bearer
  } {
    owner: $owner, repo: $repo, comment_id: $comment_id, content: $content
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

