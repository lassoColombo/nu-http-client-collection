# Merge a pull request
#
# PUT /repos/{owner}/{repo}/pulls/{pull_number}/merge
# Docs: https://docs.github.com/enterprise-cloud@latest//rest/reference/pulls#merge-a-pull-request — API method documentation
# Returns: record<merged: bool, message: string, sha: string>
# operationId: pulls/merge
export def "pulls-merge" [
  owner: string
  repo: string
  pull_number: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --commit-message: string # Extra detail to append to automatic commit message.
  --commit-title: string # Title for the automatic commit message.
  --merge-method: string@merge-method-completer # The merge method to use.
  --sha: string # SHA that pull request head must match to allow merge.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/repos/{owner}/{repo}/pulls/{pull_number}/merge"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: pull_number, var: pull_number}]
    body: {content_type: "application/json", kind: json, fields: [{name: commit_message, var: commit_message}, {name: commit_title, var: commit_title}, {name: merge_method, var: merge_method}, {name: sha, var: sha}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    owner: $owner, repo: $repo, pull_number: $pull_number, commit_message: $commit_message, commit_title: $commit_title, merge_method: $merge_method, sha: $sha
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

