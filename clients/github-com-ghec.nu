# operationId: checks/create
export def "checks-create" [
  owner: string
  repo: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --actions: list # Displays a button on GitHub that can be clicked to alert your app to do additional tasks. For example, a code linting app can display a button that automatically fixes detected errors. The button created in this object is displayed after the check run completes. When a user clicks the button, GitHub sends the [`check_run.requested_action` webhook](https://docs.github.com/enterprise-cloud@latest//webhooks/event-payloads/#check_run) to your app. Each action includes a `label`, `identifier` and `description`. A maximum of three actions are accepted. To learn more about check runs and requested actions, see "[Check runs and requested actions](https://docs.github.com/enterprise-cloud@latest//rest/reference/checks#check-runs-and-requested-actions)." — item shape: {description: string, identifier: string, label: string}
  --completed-at: string # The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
  --conclusion: string@conclusion-completer # **Required if you provide `completed_at` or a `status` of `completed`**. The final conclusion of the check. **Note:** Providing `conclusion` will automatically set the `status` parameter to `completed`. You cannot change a check run conclusion to `stale`, only GitHub can set this.
  --details-url: string # The URL of the integrator's site that has the full details of the check. If the integrator does not provide this, then the homepage of the GitHub app is used.
  --external-id: string # A reference for the run on the integrator's system.
  head_sha: string # The SHA of the commit.
  name: string # The name of the check. For example, "code-coverage".
  --output: record # Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run. — shape: {annotations?: list, images?: list, summary: string, text?: string, title: string}
  --started-at: string # The time that the check run began. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
  --status: string@status-completer-1 # The current status. (default: queued)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/repos/{owner}/{repo}/check-runs"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}]
    body: {content_type: "application/json", kind: json, fields: [{name: actions, var: actions}, {name: completed_at, var: completed_at}, {name: conclusion, var: conclusion}, {name: details_url, var: details_url}, {name: external_id, var: external_id}, {name: head_sha, var: head_sha}, {name: name, var: name}, {name: output, var: output}, {name: started_at, var: started_at}, {name: status, var: status}]}
