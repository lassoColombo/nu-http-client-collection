# operationId: actions/create-or-update-repo-secret
export def "actions-create-or-update-repo-secret" [
  owner: string
  repo: string
  secret_name: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --encrypted-value: string # Value for your secret, encrypted with [LibSodium](https://libsodium.gitbook.io/doc/bindings_for_other_languages) using the public key retrieved from the [Get a repository public key](https://docs.github.com/enterprise-cloud@latest//rest/reference/actions#get-a-repository-public-key) endpoint.
  --key-id: string # ID of the key you used to encrypt the secret.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/repos/{owner}/{repo}/actions/secrets/{secret_name}"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: secret_name, var: secret_name}]
    body: {content_type: "application/json", kind: json, fields: [{name: encrypted_value, var: encrypted_value}, {name: key_id, var: key_id}]}
    accept: ["application/json"]
    ok: [201, 204]
    auth: bearer
  } {
    owner: $owner, repo: $repo, secret_name: $secret_name, encrypted_value: $encrypted_value, key_id: $key_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

