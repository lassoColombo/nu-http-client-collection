export def "repos-create-for-authenticated-user" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --allow-auto-merge: oneof<nothing, bool> # Whether to allow Auto-merge to be used on pull requests. (default: false, e.g. false)
  --allow-merge-commit: oneof<nothing, bool> # Whether to allow merge commits for pull requests. (default: true, e.g. true)
  --allow-rebase-merge: oneof<nothing, bool> # Whether to allow rebase merges for pull requests. (default: true, e.g. true)
  --allow-squash-merge: oneof<nothing, bool> # Whether to allow squash merges for pull requests. (default: true, e.g. true)
  --auto-init: oneof<nothing, bool> # Whether the repository is initialized with a minimal README. (default: false)
  --delete-branch-on-merge: oneof<nothing, bool> # Whether to delete head branches when pull requests are merged (default: false, e.g. false)
  --description: string # A short description of the repository.
  --gitignore-template: string # The desired language or platform to apply to the .gitignore. (e.g. Haskell)
  --has-discussions: oneof<nothing, bool> # Whether discussions are enabled. (default: false, e.g. true)
  --has-downloads: oneof<nothing, bool> # Whether downloads are enabled. (default: true, e.g. true)
  --has-issues: oneof<nothing, bool> # Whether issues are enabled. (default: true, e.g. true)
  --has-projects: oneof<nothing, bool> # Whether projects are enabled. (default: true, e.g. true)
  --has-wiki: oneof<nothing, bool> # Whether the wiki is enabled. (default: true, e.g. true)
  --homepage: string # A URL with more information about the repository.
  --is-template: oneof<nothing, bool> # Whether this repository acts as a template that can be used to generate new repositories. (default: false, e.g. true)
  --license-template: string # The license keyword of the open source license for this repository. (e.g. mit)
  --merge-commit-message: string@merge-commit-message-completer # The default value for a merge commit message. - `PR_TITLE` - default to the pull request's title. - `PR_BODY` - default to the pull request's body. - `BLANK` - default to a blank commit message.
  --merge-commit-title: string@merge-commit-title-completer # The default value for a merge commit title. - `PR_TITLE` - default to the pull request's title. - `MERGE_MESSAGE` - default to the classic title for a merge message (e.g., Merge pull request #123 from branch-name).
  name: string # The name of the repository. (e.g. Team Environment)
  --private: oneof<nothing, bool> # Whether the repository is private. (default: false)
  --squash-merge-commit-message: string@squash-merge-commit-message-completer # The default value for a squash merge commit message: - `PR_BODY` - default to the pull request's body. - `COMMIT_MESSAGES` - default to the branch's commit messages. - `BLANK` - default to a blank commit message.
  --squash-merge-commit-title: string@squash-merge-commit-title-completer # The default value for a squash merge commit title: - `PR_TITLE` - default to the pull request's title. - `COMMIT_OR_PR_TITLE` - default to the commit's title (if only one commit) or the pull request's title (when more than one commit).
  --team-id: int # The id of the team that will be granted access to this repository. This is only valid when creating a repository in an organization.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/user/repos"
    body: {content_type: "application/json", kind: json, fields: [{name: allow_auto_merge, var: allow_auto_merge}, {name: allow_merge_commit, var: allow_merge_commit}, {name: allow_rebase_merge, var: allow_rebase_merge}, {name: allow_squash_merge, var: allow_squash_merge}, {name: auto_init, var: auto_init}, {name: delete_branch_on_merge, var: delete_branch_on_merge}, {name: description, var: description}, {name: gitignore_template, var: gitignore_template}, {name: has_discussions, var: has_discussions}, {name: has_downloads, var: has_downloads}, {name: has_issues, var: has_issues}, {name: has_projects, var: has_projects}, {name: has_wiki, var: has_wiki}, {name: homepage, var: homepage}, {name: is_template, var: is_template}, {name: license_template, var: license_template}, {name: merge_commit_message, var: merge_commit_message}, {name: merge_commit_title, var: merge_commit_title}, {name: name, var: name}, {name: private, var: private}, {name: squash_merge_commit_message, var: squash_merge_commit_message}, {name: squash_merge_commit_title, var: squash_merge_commit_title}, {name: team_id, var: team_id}]}
    accept: ["application/json"]
    ok: [201, 304]
    auth: bearer
  } {
    allow_auto_merge: $allow_auto_merge, allow_merge_commit: $allow_merge_commit, allow_rebase_merge: $allow_rebase_merge, allow_squash_merge: $allow_squash_merge, auto_init: $auto_init, delete_branch_on_merge: $delete_branch_on_merge, description: $description, gitignore_template: $gitignore_template, has_discussions: $has_discussions, has_downloads: $has_downloads, has_issues: $has_issues, has_projects: $has_projects, has_wiki: $has_wiki, homepage: $homepage, is_template: $is_template, license_template: $license_template, merge_commit_message: $merge_commit_message, merge_commit_title: $merge_commit_title, name: $name, private: $private, squash_merge_commit_message: $squash_merge_commit_message, squash_merge_commit_title: $squash_merge_commit_title, team_id: $team_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
