  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --actions: list # Possible further actions the integrator can perform, which a user may trigger. Each action includes a `label`, `identifier` and `description`. A maximum of three actions are accepted. See the [`actions` object](https://docs.github.com/enterprise-cloud@latest//rest/reference/checks#actions-object) description. To learn more about check runs and requested actions, see "[Check runs and requested actions](https://docs.github.com/enterprise-cloud@latest//rest/reference/checks#check-runs-and-requested-actions)." — item shape: {description: string, identifier: string, label: string}
  --completed-at: string # The time the check completed. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
  --conclusion: string@conclusion-completer # **Required if you provide `completed_at` or a `status` of `completed`**. The final conclusion of the check. **Note:** Providing `conclusion` will automatically set the `status` parameter to `completed`. You cannot change a check run conclusion to `stale`, only GitHub can set this.
  --details-url: string # The URL of the integrator's site that has the full details of the check.
  --external-id: string # A reference for the run on the integrator's system.
  --name: string # The name of the check. For example, "code-coverage".
  --output: record # Check runs can accept a variety of data in the `output` object, including a `title` and `summary` and can optionally provide descriptive details about the run. — shape: {annotations?: list, images?: list, summary: string, text?: string, title?: string}
  --started-at: string # This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
  --status: string@status-completer-1 # The current status.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: patch
    path: "/repos/{owner}/{repo}/check-runs/{check_run_id}"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: check_run_id, var: check_run_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: actions, var: actions}, {name: completed_at, var: completed_at}, {name: conclusion, var: conclusion}, {name: details_url, var: details_url}, {name: external_id, var: external_id}, {name: name, var: name}, {name: output, var: output}, {name: started_at, var: started_at}, {name: status, var: status}]}
