# operationId: repos/list-for-authenticated-user
export def "repos-list-for-authenticated-user" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --visibility: string@visibility-completer-5 # Limit results to repositories with the specified visibility. (default: all)
  --affiliation: string # Comma-separated list of values. Can include: * `owner`: Repositories that are owned by the authenticated user. * `collaborator`: Repositories that the user has been added to as a collaborator. * `organization_member`: Repositories that the user has access to through being a member of an organization. This includes every repository on every team that the user is on. (default: owner,collaborator,organization_member)
  --type: string@type-completer-2 # Limit results to repositories of the specified type. Will cause a `422` error if used in the same request as **visibility** or **affiliation**. (default: all)
  --sort: string@sort-completer-2 # The property to sort the results by. (default: full_name)
  --direction: string@direction-completer # The order to sort by. Default: `asc` when using `full_name`, otherwise `desc`.
  --per-page: int # The number of results per page (max 100). (default: 30)
  --page: int # Page number of the results to fetch. (default: 1)
  --since: string # Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
  --before: string # Only show notifications updated before the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
]: nothing -> oneof<list<any>, record, string, nothing> {
  http-request {
    method: get
    path: "/user/repos"
    query: [{name: visibility, var: visibility}, {name: affiliation, var: affiliation}, {name: type, var: type}, {name: sort, var: sort}, {name: direction, var: direction}, {name: per_page, var: per_page}, {name: page, var: page}, {name: since, var: since}, {name: before, var: before}]
    accept: ["application/json"]
    ok: [200, 304]
    auth: bearer
  } {
    visibility: $visibility, affiliation: $affiliation, type: $type, sort: $sort, direction: $direction, per_page: $per_page, page: $page, since: $since, before: $before
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

