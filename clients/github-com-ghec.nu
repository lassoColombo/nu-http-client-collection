  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --client-ip: string # IP for location auto-detection when proxying a request
  --devcontainer-path: string # Path to devcontainer.json config to use for this codespace
  --display-name: string # Display name for this codespace
  --idle-timeout-minutes: int # Time in minutes before codespace stops from inactivity
  --location: string # Location for this codespace. Assigned by IP if not provided
  --machine: string # Machine type to use for this codespace
  --multi-repo-permissions-opt-out: oneof<nothing, bool> # Whether to authorize requested permissions from devcontainer.json
  --retention-period-minutes: int # Duration in minutes after codespace has gone idle in which it will be deleted. Must be integer minutes between 0 and 43200 (30 days).
  --working-directory: string # Working directory for this codespace
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/repos/{owner}/{repo}/pulls/{pull_number}/codespaces"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: pull_number, var: pull_number}]
    body: {content_type: "application/json", kind: json, fields: [{name: client_ip, var: client_ip}, {name: devcontainer_path, var: devcontainer_path}, {name: display_name, var: display_name}, {name: idle_timeout_minutes, var: idle_timeout_minutes}, {name: location, var: location}, {name: machine, var: machine}, {name: multi_repo_permissions_opt_out, var: multi_repo_permissions_opt_out}, {name: retention_period_minutes, var: retention_period_minutes}, {name: working_directory, var: working_directory}]}
    accept: ["application/json"]
    ok: [201, 202]
    auth: bearer
  } {
    owner: $owner, repo: $repo, pull_number: $pull_number, client_ip: $client_ip, devcontainer_path: $devcontainer_path, display_name: $display_name, idle_timeout_minutes: $idle_timeout_minutes, location: $location, machine: $machine, multi_repo_permissions_opt_out: $multi_repo_permissions_opt_out, retention_period_minutes: $retention_period_minutes, working_directory: $working_directory
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

