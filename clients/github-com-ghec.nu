# operationId: issues/update
export def "issues-update" [
  owner: string
  repo: string
  issue_number: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --assignee: string # Username to assign to this issue. **This field is deprecated.** (nullable)
  --assignees: list<string> # Usernames to assign to this issue. Pass one or more user logins to _replace_ the set of assignees on this issue. Send an empty array (`[]`) to clear all assignees from the issue. Only users with push access can set assignees for new issues. Without push access to the repository, assignee changes are silently dropped.
  --body: string # The contents of the issue. (nullable)
  --labels: list # Labels to associate with this issue. Pass one or more labels to _replace_ the set of labels on this issue. Send an empty array (`[]`) to clear all labels from the issue. Only users with push access can set labels for issues. Without push access to the repository, label changes are silently dropped.
  --milestone: any # nullable
  --state: string@state-completer-7 # The open or closed state of the issue.
  --state-reason: string@state-reason-completer # The reason for the state change. Ignored unless `state` is changed. (nullable, e.g. not_planned)
  --title: any # The title of the issue. (nullable)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: patch
    path: "/repos/{owner}/{repo}/issues/{issue_number}"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: issue_number, var: issue_number}]
    body: {content_type: "application/json", kind: json, fields: [{name: assignee, var: assignee}, {name: assignees, var: assignees}, {name: body, var: body}, {name: labels, var: labels}, {name: milestone, var: milestone}, {name: state, var: state}, {name: state_reason, var: state_reason}, {name: title, var: title}]}
    accept: ["application/json"]
    ok: [200, 301]
    auth: bearer
  } {
    owner: $owner, repo: $repo, issue_number: $issue_number, assignee: $assignee, assignees: $assignees, body: $body, labels: $labels, milestone: $milestone, state: $state, state_reason: $state_reason, title: $title
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

