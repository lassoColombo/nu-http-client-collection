# operationId: pulls/update
export def "pulls-update" [
  owner: string
  repo: string
  pull_number: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --base: string # The name of the branch you want your changes pulled into. This should be an existing branch on the current repository. You cannot update the base branch on a pull request to point to another repository.
  --body: string # The contents of the pull request.
  --maintainer-can-modify: oneof<nothing, bool> # Indicates whether [maintainers can modify](https://docs.github.com/enterprise-cloud@latest//articles/allowing-changes-to-a-pull-request-branch-created-from-a-fork/) the pull request.
  --state: string@state-completer-7 # State of this Pull Request. Either `open` or `closed`.
  --title: string # The title of the pull request.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: patch
    path: "/repos/{owner}/{repo}/pulls/{pull_number}"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: pull_number, var: pull_number}]
    body: {content_type: "application/json", kind: json, fields: [{name: base, var: base}, {name: body, var: body}, {name: maintainer_can_modify, var: maintainer_can_modify}, {name: state, var: state}, {name: title, var: title}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    owner: $owner, repo: $repo, pull_number: $pull_number, base: $base, body: $body, maintainer_can_modify: $maintainer_can_modify, state: $state, title: $title
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Create a codespace from a pull request
#
