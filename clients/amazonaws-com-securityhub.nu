def control-status-completer [] { ["DISABLED" "ENABLED"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    accept-administrator-invitation: "record"
    get-administrator-account: "record<Administrator: record<AccountId: string, InvitationId: string, InvitedAt: string, MemberStatus: string>>"
    accept-invitation: "record"
    get-master-account: "record<Master: record<AccountId: string, InvitationId: string, InvitedAt: string, MemberStatus: string>>"
    batch-disable-standards: "record<StandardsSubscriptions: table<StandardsSubscriptionArn: string, StandardsArn: string, StandardsInput: record, StandardsStatus: string, StandardsStatusReason: record>>"
    batch-enable-standards: "record<StandardsSubscriptions: table<StandardsSubscriptionArn: string, StandardsArn: string, StandardsInput: record, StandardsStatus: string, StandardsStatusReason: record>>"
    batch-get-security-controls: "record<SecurityControls: table<SecurityControlId: string, SecurityControlArn: string, Title: string, Description: string, RemediationUrl: string, SeverityRating: string, SecurityControlStatus: string>, UnprocessedIds: table<SecurityControlId: string, ErrorCode: string, ErrorReason: string>>"
    batch-get-standards-control-associations: "record<StandardsControlAssociationDetails: table<StandardsArn: string, SecurityControlId: string, SecurityControlArn: string, AssociationStatus: string, RelatedRequirements: list, UpdatedAt: string, UpdatedReason: string, StandardsControlTitle: string, StandardsControlDescription: string, StandardsControlArns: list>, UnprocessedAssociations: table<StandardsControlAssociationId: record, ErrorCode: string, ErrorReason: string>>"
    batch-import-findings: "record<FailedCount: int, SuccessCount: int, FailedFindings: table<Id: string, ErrorCode: string, ErrorMessage: string>>"
    batch-update-findings: "record<ProcessedFindings: table<Id: string, ProductArn: string>, UnprocessedFindings: table<FindingIdentifier: record, ErrorCode: string, ErrorMessage: string>>"
    batch-update-standards-control-associations: "record<UnprocessedAssociationUpdates: table<StandardsControlAssociationUpdate: record, ErrorCode: string, ErrorReason: string>>"
    create-action-target: "record<ActionTargetArn: string>"
    create-finding-aggregator: "record<FindingAggregatorArn: string, FindingAggregationRegion: string, RegionLinkingMode: string, Regions: list<string>>"
    create-insight: "record<InsightArn: string>"
    create-members: "record<UnprocessedAccounts: table<AccountId: string, ProcessingResult: string>>"
    list-members: "record<Members: table<AccountId: string, Email: string, MasterId: string, AdministratorId: string, MemberStatus: string, InvitedAt: string, UpdatedAt: string>, NextToken: string>"
    decline-invitations: "record<UnprocessedAccounts: table<AccountId: string, ProcessingResult: string>>"
    delete-action-target: "record<ActionTargetArn: string>"
    update-action-target: "record"
    delete-finding-aggregator: "record"
    delete-insight: "record<InsightArn: string>"
    update-insight: "record"
    delete-invitations: "record<UnprocessedAccounts: table<AccountId: string, ProcessingResult: string>>"
    delete-members: "record<UnprocessedAccounts: table<AccountId: string, ProcessingResult: string>>"
    describe-action-targets: "record<ActionTargets: table<ActionTargetArn: string, Name: string, Description: string>, NextToken: string>"
    describe-hub: "record<HubArn: string, SubscribedAt: string, AutoEnableControls: bool, ControlFindingGenerator: string>"
    disable-security-hub: "record"
    enable-security-hub: "record"
    update-security-hub-configuration: "record"
    describe-organization-configuration: "record<AutoEnable: bool, MemberAccountLimitReached: bool, AutoEnableStandards: string>"
    update-organization-configuration: "record"
    describe-products: "record<Products: table<ProductArn: string, ProductName: string, CompanyName: string, Description: string, Categories: list, IntegrationTypes: list, MarketplaceUrl: string, ActivationUrl: string, ProductSubscriptionResourcePolicy: string>, NextToken: string>"
    describe-standards: "record<Standards: table<StandardsArn: string, Name: string, Description: string, EnabledByDefault: bool, StandardsManagedBy: record>, NextToken: string>"
    describe-standards-controls: "record<Controls: table<StandardsControlArn: string, ControlStatus: string, DisabledReason: string, ControlStatusUpdatedAt: string, ControlId: string, Title: string, Description: string, RemediationUrl: string, SeverityRating: string, RelatedRequirements: list>, NextToken: string>"
    disable-import-findings-for-product: "record"
    disable-organization-admin-account: "record"
    disassociate-from-administrator-account: "record"
    disassociate-from-master-account: "record"
    disassociate-members: "record"
    enable-import-findings-for-product: "record<ProductSubscriptionArn: string>"
    list-enabled-products-for-import: "record<ProductSubscriptions: list<string>, NextToken: string>"
    enable-organization-admin-account: "record"
    get-enabled-standards: "record<StandardsSubscriptions: table<StandardsSubscriptionArn: string, StandardsArn: string, StandardsInput: record, StandardsStatus: string, StandardsStatusReason: record>, NextToken: string>"
    get-finding-aggregator: "record<FindingAggregatorArn: string, FindingAggregationRegion: string, RegionLinkingMode: string, Regions: list<string>>"
    get-findings: "record<Findings: table<SchemaVersion: string, Id: string, ProductArn: string, ProductName: string, CompanyName: string, Region: string, GeneratorId: string, AwsAccountId: string, Types: list, FirstObservedAt: string, LastObservedAt: string, CreatedAt: string, UpdatedAt: string, Severity: record, Confidence: int, Criticality: int, Title: string, Description: string, Remediation: record, SourceUrl: string, ProductFields: record, UserDefinedFields: record, Malware: list, Network: record, NetworkPath: list, Process: record, Threats: list, ThreatIntelIndicators: list, Resources: list, Compliance: record, VerificationState: string, WorkflowState: string, Workflow: record, RecordState: string, RelatedFindings: list, Note: record, Vulnerabilities: list, PatchSummary: record, Action: record, FindingProviderFields: record, Sample: bool>, NextToken: string>"
    update-findings: "record"
    get-insight-results: "record<InsightResults: record<InsightArn: string, GroupByAttribute: string, ResultValues: list<record>>>"
    get-insights: "record<Insights: table<InsightArn: string, Name: string, Filters: record, GroupByAttribute: string>, NextToken: string>"
    get-invitations-count: "record<InvitationsCount: int>"
    get-members: "record<Members: table<AccountId: string, Email: string, MasterId: string, AdministratorId: string, MemberStatus: string, InvitedAt: string, UpdatedAt: string>, UnprocessedAccounts: table<AccountId: string, ProcessingResult: string>>"
    invite-members: "record<UnprocessedAccounts: table<AccountId: string, ProcessingResult: string>>"
    list-finding-aggregators: "record<FindingAggregators: table<FindingAggregatorArn: string>, NextToken: string>"
    list-invitations: "record<Invitations: table<AccountId: string, InvitationId: string, InvitedAt: string, MemberStatus: string>, NextToken: string>"
    list-organization-admin-accounts: "record<AdminAccounts: table<AccountId: string, Status: string>, NextToken: string>"
    list-security-control-definitions: "record<SecurityControlDefinitions: table<SecurityControlId: string, Title: string, Description: string, RemediationUrl: string, SeverityRating: string, CurrentRegionAvailability: string>, NextToken: string>"
    list-standards-control-associations: "record<StandardsControlAssociationSummaries: table<StandardsArn: string, SecurityControlId: string, SecurityControlArn: string, AssociationStatus: string, RelatedRequirements: list, UpdatedAt: string, UpdatedReason: string, StandardsControlTitle: string, StandardsControlDescription: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    untag-resource: "record"
    update-finding-aggregator: "record<FindingAggregatorArn: string, FindingAggregationRegion: string, RegionLinkingMode: string, Regions: list<string>>"
    update-standards-control: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["accept-administrator-invitation" "get-administrator-account" "accept-invitation" "get-master-account" "batch-disable-standards" "batch-enable-standards" "batch-get-security-controls" "batch-get-standards-control-associations" "batch-import-findings" "batch-update-findings" "batch-update-standards-control-associations" "create-action-target" "create-finding-aggregator" "create-insight" "create-members" "list-members" "decline-invitations" "delete-action-target" "update-action-target" "delete-finding-aggregator" "delete-insight" "update-insight" "delete-invitations" "delete-members" "describe-action-targets" "describe-hub" "disable-security-hub" "enable-security-hub" "update-security-hub-configuration" "describe-organization-configuration" "update-organization-configuration" "describe-products" "describe-standards" "describe-standards-controls" "disable-import-findings-for-product" "disable-organization-admin-account" "disassociate-from-administrator-account" "disassociate-from-master-account" "disassociate-members" "enable-import-findings-for-product" "list-enabled-products-for-import" "enable-organization-admin-account" "get-enabled-standards" "get-finding-aggregator" "get-findings" "update-findings" "get-insight-results" "get-insights" "get-invitations-count" "get-members" "invite-members" "list-finding-aggregators" "list-invitations" "list-organization-admin-accounts" "list-security-control-definitions" "list-standards-control-associations" "list-tags-for-resource" "tag-resource" "untag-resource" "update-finding-aggregator" "update-standards-control" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Accepts the invitation to be a member account and be monitored by the Security Hub administrator account that the invitation was sent from. This operation is only used by member accounts that are not added through Organizations. When the member account accepts the invitation, permission is granted to the administrator account to view findings generated in the member account.
#
# POST /administrator
# Returns: record
# operationId: AcceptAdministratorInvitation
export def "accept-administrator-invitation" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  administrator_id: string # The account ID of the Security Hub administrator account that sent the invitation.
  invitation_id: string # The identifier of the invitation sent from the Security Hub administrator account.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/administrator"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: AdministratorId, var: administrator_id}, {name: InvitationId, var: invitation_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, administrator_id: $administrator_id, invitation_id: $invitation_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Provides the details for the Security Hub administrator account for the current member account. Can be used by both member accounts that are managed using Organizations and accounts that were invited manually.
