# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-fhir-datastore: "record<DatastoreId: string, DatastoreArn: string, DatastoreStatus: string, DatastoreEndpoint: string>"
    delete-fhir-datastore: "record<DatastoreId: string, DatastoreArn: string, DatastoreStatus: string, DatastoreEndpoint: string>"
    describe-fhir-datastore: "record<DatastoreProperties: record<DatastoreId: string, DatastoreArn: string, DatastoreName: string, DatastoreStatus: string, CreatedAt: string, DatastoreTypeVersion: string, DatastoreEndpoint: string, SseConfiguration: record<KmsEncryptionConfig: record>, PreloadDataConfig: record<PreloadDataType: string>>>"
    describe-fhir-export-job: "record<ExportJobProperties: record<JobId: string, JobName: string, JobStatus: string, SubmitTime: string, EndTime: string, DatastoreId: string, OutputDataConfig: record<S3Configuration: record>, DataAccessRoleArn: string, Message: string>>"
    describe-fhir-import-job: "record<ImportJobProperties: record<JobId: string, JobName: string, JobStatus: string, SubmitTime: string, EndTime: string, DatastoreId: string, InputDataConfig: record<S3Uri: string>, JobOutputDataConfig: record<S3Configuration: record>, DataAccessRoleArn: string, Message: string>>"
    list-fhir-datastores: "record<DatastorePropertiesList: table<DatastoreId: string, DatastoreArn: string, DatastoreName: string, DatastoreStatus: string, CreatedAt: string, DatastoreTypeVersion: string, DatastoreEndpoint: string, SseConfiguration: record, PreloadDataConfig: record>, NextToken: string>"
    list-fhir-export-jobs: "record<ExportJobPropertiesList: table<JobId: string, JobName: string, JobStatus: string, SubmitTime: string, EndTime: string, DatastoreId: string, OutputDataConfig: record, DataAccessRoleArn: string, Message: string>, NextToken: string>"
    list-fhir-import-jobs: "record<ImportJobPropertiesList: table<JobId: string, JobName: string, JobStatus: string, SubmitTime: string, EndTime: string, DatastoreId: string, InputDataConfig: record, JobOutputDataConfig: record, DataAccessRoleArn: string, Message: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    start-fhir-export-job: "record<JobId: string, JobStatus: string, DatastoreId: string>"
    start-fhir-import-job: "record<JobId: string, JobStatus: string, DatastoreId: string>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-fhir-datastore" "delete-fhir-datastore" "describe-fhir-datastore" "describe-fhir-export-job" "describe-fhir-import-job" "list-fhir-datastores" "list-fhir-export-jobs" "list-fhir-import-jobs" "list-tags-for-resource" "start-fhir-export-job" "start-fhir-import-job" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Creates a Data Store that can ingest and export FHIR formatted data.
#
# POST /
# Returns: record<DatastoreId: string, DatastoreArn: string, DatastoreStatus: string, DatastoreEndpoint: string>
# operationId: CreateFHIRDatastore
export def "create-fhir-datastore" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  --datastore-name: string # The user generated name for the Data Store.
  datastore_type_version: string@datastore-type-version-completer # The FHIR version of the Data Store. The only supported version is R4.
  --sse-configuration: record # The server-side encryption key configuration for a customer provided encryption key. — shape: {KmsEncryptionConfig: record}
  --preload-data-config: record # The input properties for the preloaded Data Store. Only data preloaded from Synthea is supported. — shape: {PreloadDataType: "SYNTHEA"}
  --client-token: string # Optional user provided token used for ensuring idempotency.
  --tags: list # Resource tags that are applied to a Data Store when it is created. — item shape: {Key: string, Value: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "HealthLake.CreateFHIRDatastore"}]
    body: {content_type: "application/json", kind: json, fields: [{name: DatastoreName, var: datastore_name}, {name: DatastoreTypeVersion, var: datastore_type_version}, {name: SseConfiguration, var: sse_configuration}, {name: PreloadDataConfig, var: preload_data_config}, {name: ClientToken, var: client_token}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, datastore_name: $datastore_name, datastore_type_version: $datastore_type_version, sse_configuration: $sse_configuration, preload_data_config: $preload_data_config, client_token: $client_token, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

