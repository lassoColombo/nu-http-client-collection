# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    acknowledge-job: "record<status: string>"
    acknowledge-third-party-job: "record<status: string>"
    create-custom-action-type: "record<actionType: record<id: record<category: string, owner: string, provider: string, version: string>, settings: record<thirdPartyConfigurationUrl: string, entityUrlTemplate: string, executionUrlTemplate: string, revisionUrlTemplate: string>, actionConfigurationProperties: list<record>, inputArtifactDetails: record<minimumCount: int, maximumCount: int>, outputArtifactDetails: record<minimumCount: int, maximumCount: int>>, tags: table<key: string, value: string>>"
    create-pipeline: "record<pipeline: record<name: string, roleArn: string, artifactStore: record<type: string, location: string, encryptionKey: record>, artifactStores: record, stages: list<record>, version: int>, tags: table<key: string, value: string>>"
    delete-webhook: "record"
    deregister-webhook-with-third-party: "record"
    get-action-type: "record<actionType: record<description: string, executor: record<configuration: record, type: string, policyStatementsTemplate: string, jobTimeout: int>, id: record<category: string, owner: string, provider: string, version: string>, inputArtifactDetails: record<minimumCount: int, maximumCount: int>, outputArtifactDetails: record<minimumCount: int, maximumCount: int>, permissions: record<allowedAccounts: list>, properties: any, urls: record<configurationUrl: string, entityUrlTemplate: string, executionUrlTemplate: string, revisionUrlTemplate: string>>>"
    get-job-details: "record<jobDetails: record<id: string, data: record<actionTypeId: record, actionConfiguration: record, pipelineContext: record, inputArtifacts: list, outputArtifacts: list, artifactCredentials: record, continuationToken: string, encryptionKey: record>, accountId: string>>"
    get-pipeline: "record<pipeline: record<name: string, roleArn: string, artifactStore: record<type: string, location: string, encryptionKey: record>, artifactStores: record, stages: list<record>, version: int>, metadata: record<pipelineArn: string, created: string, updated: string>>"
    get-pipeline-execution: "record<pipelineExecution: record<pipelineName: string, pipelineVersion: int, pipelineExecutionId: string, status: string, statusSummary: string, artifactRevisions: list<record>>>"
    get-pipeline-state: "record<pipelineName: string, pipelineVersion: int, stageStates: table<stageName: string, inboundExecution: record, inboundTransitionState: record, actionStates: list, latestExecution: record>, created: string, updated: string>"
    get-third-party-job-details: "record<jobDetails: record<id: string, data: record<actionTypeId: record, actionConfiguration: record, pipelineContext: record, inputArtifacts: list, outputArtifacts: list, artifactCredentials: record, continuationToken: string, encryptionKey: record>, nonce: string>>"
    list-action-executions: "record<actionExecutionDetails: table<pipelineExecutionId: string, actionExecutionId: string, pipelineVersion: int, stageName: string, actionName: string, startTime: string, lastUpdateTime: string, status: string, input: record, output: record>, nextToken: string>"
    list-action-types: "record<actionTypes: table<id: record, settings: record, actionConfigurationProperties: list, inputArtifactDetails: record, outputArtifactDetails: record>, nextToken: string>"
    list-pipeline-executions: "record<pipelineExecutionSummaries: table<pipelineExecutionId: string, status: string, startTime: string, lastUpdateTime: string, sourceRevisions: list, trigger: record, stopTrigger: record>, nextToken: string>"
    list-pipelines: "record<pipelines: table<name: string, version: int, created: string, updated: string>, nextToken: string>"
    list-tags-for-resource: "record<tags: table<key: string, value: string>, nextToken: string>"
    list-webhooks: "record<webhooks: table<definition: record, url: string, errorMessage: string, errorCode: string, lastTriggered: string, arn: string, tags: list>, NextToken: string>"
    poll-for-jobs: "record<jobs: table<id: string, data: record, nonce: string, accountId: string>>"
    poll-for-third-party-jobs: "record<jobs: table<clientId: string, jobId: string>>"
    put-action-revision: "record<newRevision: bool, pipelineExecutionId: string>"
    put-approval-result: "record<approvedAt: string>"
    put-webhook: "record<webhook: record<definition: record<name: string, targetPipeline: string, targetAction: string, filters: list, authentication: string, authenticationConfiguration: record>, url: string, errorMessage: string, errorCode: string, lastTriggered: string, arn: string, tags: list<record>>>"
    register-webhook-with-third-party: "record"
    retry-stage-execution: "record<pipelineExecutionId: string>"
    start-pipeline-execution: "record<pipelineExecutionId: string>"
    stop-pipeline-execution: "record<pipelineExecutionId: string>"
    tag-resource: "record"
    untag-resource: "record"
    update-pipeline: "record<pipeline: record<name: string, roleArn: string, artifactStore: record<type: string, location: string, encryptionKey: record>, artifactStores: record, stages: list<record>, version: int>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["acknowledge-job" "acknowledge-third-party-job" "create-custom-action-type" "create-pipeline" "delete-custom-action-type" "delete-pipeline" "delete-webhook" "deregister-webhook-with-third-party" "disable-stage-transition" "enable-stage-transition" "get-action-type" "get-job-details" "get-pipeline" "get-pipeline-execution" "get-pipeline-state" "get-third-party-job-details" "list-action-executions" "list-action-types" "list-pipeline-executions" "list-pipelines" "list-tags-for-resource" "list-webhooks" "poll-for-jobs" "poll-for-third-party-jobs" "put-action-revision" "put-approval-result" "put-job-failure-result" "put-job-success-result" "put-third-party-job-failure-result" "put-third-party-job-success-result" "put-webhook" "register-webhook-with-third-party" "retry-stage-execution" "start-pipeline-execution" "stop-pipeline-execution" "tag-resource" "untag-resource" "update-action-type" "update-pipeline" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Returns information about a specified job and whether that job has been received by the job worker. Used for custom actions only.
#
# POST /
# Returns: record<status: string>
# operationId: AcknowledgeJob
export def "acknowledge-job" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  job_id: string # The unique system-generated ID of the job for which you want to confirm receipt.
  nonce: string # A system-generated random number that AWS CodePipeline uses to ensure that the job is being worked on by only one job worker. Get this number from the response of the PollForJobs request that returned this job.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "CodePipeline_20150709.AcknowledgeJob"}]
    body: {content_type: "application/json", kind: json, fields: [{name: jobId, var: job_id}, {name: nonce, var: nonce}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, job_id: $job_id, nonce: $nonce
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

