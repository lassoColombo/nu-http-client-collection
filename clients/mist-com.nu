# createOrgMxTunnel
#
# POST /api/v1/orgs/{org_id}/mxtunnels
# Returns: record<anchor_mxtunnel_ids: list<string>, auto_preemption: record<day_of_week: string, enabled: bool, time_of_day: string>, created_time: float, for_site: bool, hello_interval: int, hello_retries: int, id: string, ipsec: record<dns_servers: list<string>, dns_suffix: list<string>, enabled: bool, extra_routes: list<record>, split_tunnel: bool, use_mxedge: bool>, modified_time: float, mtu: int, mxcluster_ids: list<string>, name: string, org_id: string, protocol: string, site_id: string, vlan_ids: list<int>>
