# --ip_config shape: {dns?: list<string>, dns_suffix?: list<string>, gateway?: string, gateway6?: string, ip?: string, ip6?: string, mtu?: int, netmask?: string, netmask6?: string, type?: "static"|"dhcp", type6?: "static"|"dhcp", vlan_id?: int}
# --led shape: {brightness?: int, enabled?: bool}
