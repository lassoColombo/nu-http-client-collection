# updateOrgWxTunnel
#
# PUT /api/v1/orgs/{org_id}/wxtunnels/{wxtunnel_id}
# Returns: record<created_time: float, dmvpn: record<enabled: bool, holding_time: int, host_routes: list<string>>, for_mgmt: bool, for_site: bool, hello_interval: int, hello_retries: int, hostname: string, id: string, ipsec: record<enabled: bool, psk: string>, is_static: bool, modified_time: float, mtu: int, name: string, org_id: string, peers: list<string>, router_id: string, secret: string, sessions: table<ap_as_session_id: string, comment: string, enable_cookie: bool, ethertype: string, local_session_id: int, "pseudo_802.1ad_enabled": bool, remote_id: string, remote_session_id: int, use_ap_as_session_ids: bool>, site_id: string, udp_port: int, use_udp: bool>
# operationId: updateOrgWxTunnel
export def "update-org-wx-tunnel" [
  org_id: string
  wxtunnel_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --dmvpn: record # Dynamic Multipoint VPN configurations — shape: {enabled?: bool, holding_time?: int, host_routes?: list<string>}
  --for-mgmt: oneof<nothing, bool> # determined during creation time and cannot be toggled. A management tunnel cannot be used by wxlan rule or by wlan (default: false)
  --hello-interval: int # in seconds, used as heartbeat to detect if a tunnel is alive. AP will try another peer after missing N hellos specified by hello_retries. (default: 60)
  --hello-retries: int # default: 7
  --hostname: string # optional, overwrite the hostname in SCCRQ control message, default is “” or null, %H and %M can be used, which will be replace with corresponding values: * %H: name of the ap if provided (and will be stripped so it can be used for hostname) and fallbacks to MAC * %M: MAC (e.g. 5c5b350e0060)
  --ipsec: record # IPSec-related configurations; requires DMVPN be enabled — shape: {enabled?: bool, psk: string}
  --is-static: oneof<nothing, bool> # whether it’s static/unmanaged (i.e. no control session). As the session configurations are not compatible, cannot be toggled. (default: false)
  --mtu: int # 0 to enable PMTU, 552-1500 to start PMTU with a lower MTU (default: 0)
  name: string # The name of the tunnel
  --body-org-id: string # format: uuid (spec name: org_id)
  --peers: list<string> # list of remote peers’ IP or hostname
  --router-id: string # optional, overwrite the router-id in SCCRQ control message, default is “0” or null, can also be an IPv4 address
  --secret: string # secret, ‘’ if no auth is used
  --sessions: list # sessions to be established with the tunnel. Has to be >= 1 in order for this tunnel to be useful. For management tunnel, it can only have 1 — item shape: {ap_as_session_id?: string, comment?: string, enable_cookie?: bool, ethertype?: "ethernet"|"vlan", local_session_id?: int, pseudo_802.1ad_enabled?: bool, remote_id?: string, remote_session_id?: int, use_ap_as_session_ids?: bool}
  --udp-port: int # udp port if `use_udp`==`true`
  --use-udp: oneof<nothing, bool> # whether to use UDP instead of IP (proto=115, which is default of L2TPv3) (default: false)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/api/v1/orgs/{org_id}/wxtunnels/{wxtunnel_id}"
    path_params: [{name: org_id, var: org_id}, {name: wxtunnel_id, var: wxtunnel_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: dmvpn, var: dmvpn}, {name: for_mgmt, var: for_mgmt}, {name: hello_interval, var: hello_interval}, {name: hello_retries, var: hello_retries}, {name: hostname, var: hostname}, {name: ipsec, var: ipsec}, {name: is_static, var: is_static}, {name: mtu, var: mtu}, {name: name, var: name}, {name: org_id, var: body_org_id}, {name: peers, var: peers}, {name: router_id, var: router_id}, {name: secret, var: secret}, {name: sessions, var: sessions}, {name: udp_port, var: udp_port}, {name: use_udp, var: use_udp}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    org_id: $org_id, wxtunnel_id: $wxtunnel_id, dmvpn: $dmvpn, for_mgmt: $for_mgmt, hello_interval: $hello_interval, hello_retries: $hello_retries, hostname: $hostname, ipsec: $ipsec, is_static: $is_static, mtu: $mtu, name: $name, body_org_id: $body_org_id, peers: $peers, router_id: $router_id, secret: $secret, sessions: $sessions, udp_port: $udp_port, use_udp: $use_udp
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
