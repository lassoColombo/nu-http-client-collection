# --pwr_config shape: {base?: float, prefer_usb_over_wifi?: bool}
# --radio_config shape: {allow_rrm_disable?: bool, ant_gain_24?: int, ant_gain_5?: int, ant_gain_6?: int, antenna_mode?: "default"|"1x1"|"2x2"|"3x3"|"4x4", band_24?: record, band_24_usage?: "24"|"5"|"auto", band_5?: record, band_5_on_24_radio?: record, band_6?: record, scanning_enabled?: bool}
# --uplink_port_config shape: {dot1x?: bool}
# --usb_config shape: {cacert?: string, channel?: int, enabled?: bool, host?: string, port?: int, type?: "imagotag"|"solum"|"hanshow", verify_cert?: bool, vlan_id?: int}
# --acl_policies item shape: {allow_dst_tags?: list<string>, deny_dst_tags?: list<string>, name?: string, src_tags?: list<string>}
# --acl_tags shape: {any?: record}
# --dhcp_config shape: {enabled?: bool}
# --dhcp_snooping shape: {all_networks?: bool, enable_arp_spoof_check?: bool, enable_ip_source_guard?: bool, enabled?: bool, networks?: list<string>}
# --evpn_config shape: {enabled?: bool, role?: "core"|"distribution"|"access"}
# --networks shape: {dns?: list<string>, dns_suffix?: list<string>, gateway?: string, ospf_interface_type?: string, subnet?: string, vlan_id: int, zone?: string}
# --oob_ip_config shape: {dns?: list<string>, dns_suffix?: list<string>, gateway?: string, ip?: string, netmask?: string, network?: string, type?: "static"|"dynamic", use_mgmt_vrf?: bool, use_mgmt_vrf_for_host_out?: bool}
# --ospf_config shape: {areas?: record, enabled?: bool}
# --port_mirroring shape: {port_mirror?: record}
# --port_usages shape: {dynamic?: record}
# --radius_config shape: {acct_interim_interval?: int, acct_servers?: list, auth_servers?: list, auth_servers_retries?: int, auth_servers_timeout?: int, coa_enabled?: bool, coa_port?: int, network?: string, source_ip?: string}
# --virtual_chassis shape: {members?: list, preprovisioned?: bool}
# --vrf_config shape: {enabled?: bool}
# --vrrp_config shape: {enabled?: bool, groups?: record}
# --dhcpd_config shape: {enabled?: bool}
export def "sites-devices create" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --aeroscout: record # Aeroscout AP settings — shape: {enabled?: bool, host?: string, locate_connected?: bool}
  --ble-config: record # BLE AP settings — shape: {beacon_enabled?: bool, beacon_rate?: int, beacon_rate_mode?: "default"|"custom", beam_disabled?: list<int>, eddystone_uid_adv_power?: int, eddystone_uid_beams?: string, eddystone_uid_enabled?: bool, eddystone_uid_freq_msec?: int, eddystone_uid_instance?: string, eddystone_uid_namespace?: string, eddystone_url_adv_power?: int, eddystone_url_beams?: string, eddystone_url_enabled?: bool, eddystone_url_freq_msec?: int, eddystone_url_url?: string, ibeacon_adv_power?: int, ibeacon_beams?: string, ... (7 more fields)}
  --centrak: record # shape: {enabled?: bool}
  --client-bridge: record # shape: {auth?: record, enabled?: bool, ssid?: string}
  --deviceprofile-id: string # nullable, format: uuid
  --disable-eth1: oneof<nothing, bool> # whether to disable eth1 port (default: false)
  --disable-eth2: oneof<nothing, bool> # whether to disable eth2 port (default: false)
  --disable-eth3: oneof<nothing, bool> # whether to disable eth3 port (default: false)
  --disable-module: oneof<nothing, bool> # whether to disable module port (default: false)
  --height: float # height, in meters, optional
  --image1-url: string # nullable
  --image2-url: string # nullable
  --image3-url: string # nullable
  --iot-config: record # IoT AP settings — shape: {A1?: record, A2?: record, A3?: record, A4?: record, DI1?: record, DI2?: record, DO?: record}
  --ip-config: record # IP AP settings — shape: {dns?: list<string>, dns_suffix?: list<string>, gateway?: string, gateway6?: string, ip?: string, ip6?: string, mtu?: int, netmask?: string, netmask6?: string, type?: "static"|"dhcp", type6?: "static"|"dhcp", vlan_id?: int}
  --led: record # LED AP settings — shape: {brightness?: int, enabled?: bool}
  --locked: oneof<nothing, bool> # whether this map is considered locked down
  --map-id: string # map where the device belongs to (format: uuid)
  --mesh: record # Mesh AP settings — shape: {enabled?: bool, group?: int, role?: "base"|"remote"}
  --name: string
  --notes: string # any notes about this AP
  --ntp-servers: list<string>
  --orientation: float # orientation, 0-359, in degrees, up is 0, right is 90.
  --poe-passthrough: oneof<nothing, bool> # whether to enable power out through module port (for APH) or eth1 (for APL/BT11) (default: false)
  --port-config: record # eth0 is allowed in mesh relay mode, otherwise eth0 is not allowed here. The property key is the interface(s) name (e.g. "eth1" or"eth1,eth2")
  --pwr-config: record # power related configs — shape: {base?: float, prefer_usb_over_wifi?: bool}
  --radio-config: record # Radio AP settings — shape: {allow_rrm_disable?: bool, ant_gain_24?: int, ant_gain_5?: int, ant_gain_6?: int, antenna_mode?: "default"|"1x1"|"2x2"|"3x3"|"4x4", band_24?: record, band_24_usage?: "24"|"5"|"auto", band_5?: record, band_5_on_24_radio?: record, band_6?: record, scanning_enabled?: bool}
  --uplink-port-config: record # shape: {dot1x?: bool}
  --usb-config: record # USB AP settings — shape: {cacert?: string, channel?: int, enabled?: bool, host?: string, port?: int, type?: "imagotag"|"solum"|"hanshow", verify_cert?: bool, vlan_id?: int}
  --vars: record # a dictionary of name->value, the vars can then be used in Wlans. This can overwrite those from Site Vars
  --x: float # x in pixel
  --y: float # y in pixel
  --acl-policies: list # item shape: {allow_dst_tags?: list<string>, deny_dst_tags?: list<string>, name?: string, src_tags?: list<string>}
  --acl-tags: record # ACL Tags to identify traffic source or destination. Key name is the tag name — shape: {any?: record}
  --additional-config-cmds: list<string>
  --dhcp-config: record # if DHCP Server/Relay is intended. The property key is the network name — shape: {enabled?: bool}
  --dhcp-snooping: record # shape: {all_networks?: bool, enable_arp_spoof_check?: bool, enable_ip_source_guard?: bool, enabled?: bool, networks?: list<string>}
  --disable-auto-config: oneof<nothing, bool> # for a claimed switch, we control the configs by default. This option (disables the behavior) (default: false)
  --dns-servers: list<string> # Global dns settings. To keep compatibility, dns settings in `ip_config` and `oob_ip_config` will overwrite this setting
  --dns-suffix: list<string> # Global dns settings. To keep compatibility, dns settings in `ip_config` and `oob_ip_config` will overwrite this setting
  --evpn-config: record # EVPN Junos settings — shape: {enabled?: bool, role?: "core"|"distribution"|"access"}
  --extra-routes: record # The property key is the network name or a CIDR
  --managed: oneof<nothing, bool> # for an adopted switch, we don’t overwrite their existing configs automatically (default: false)
  --networks: record # A network represents a network segment. It can either represent a VLAN (then usually ties to a L3 subnet), optionally associate it with a subnet which can later be used to create addition routes. Used for ports doing `family ethernet-switching`. It can also be a pure L3-subnet that can then be used against a port that with `family inet`. — shape: {dns?: list<string>, dns_suffix?: list<string>, gateway?: string, ospf_interface_type?: string, subnet?: string, vlan_id: int, zone?: string}
  --oob-ip-config: record # Junos out-of-band (vme/em0/fxp0) IP config — shape: {dns?: list<string>, dns_suffix?: list<string>, gateway?: string, ip?: string, netmask?: string, network?: string, type?: "static"|"dynamic", use_mgmt_vrf?: bool, use_mgmt_vrf_for_host_out?: bool}
  --ospf-config: record # Junos OSPF config — shape: {areas?: record, enabled?: bool}
  --other-ip-configs: record # The property key is the network name
  --port-mirroring: record # shape: {port_mirror?: record}
  --port-usages: record # The property key is the port profile name — shape: {dynamic?: record}
  --radius-config: record # Junos Radius config — shape: {acct_interim_interval?: int, acct_servers?: list, auth_servers?: list, auth_servers_retries?: int, auth_servers_timeout?: int, coa_enabled?: bool, coa_port?: int, network?: string, source_ip?: string}
  --role: string@role-completer # default: access
  --router-id: string # used for OSPF / BGP / EVPN
  --virtual-chassis: record # required for preprovisioned Virtual Chassis — shape: {members?: list, preprovisioned?: bool}
  --vrf-config: record # shape: {enabled?: bool}
  --vrrp-config: record # Junos VRRP config — shape: {enabled?: bool, groups?: record}
  --dhcpd-config: record # if DHCP Server/Relay is intended. The property key is the network name — shape: {enabled?: bool}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({site_id: (encode-path-segment $site_id)} | format pattern "/api/v1/sites/{site_id}/devices"))
  let req_body = {"aeroscout": $aeroscout, "ble_config": $ble_config, "centrak": $centrak, "client_bridge": $client_bridge, "deviceprofile_id": $deviceprofile_id, "disable_eth1": $disable_eth1, "disable_eth2": $disable_eth2, "disable_eth3": $disable_eth3, "disable_module": $disable_module, "height": $height, "image1_url": $image1_url, "image2_url": $image2_url, "image3_url": $image3_url, "iot_config": $iot_config, "ip_config": $ip_config, "led": $led, "locked": $locked, "map_id": $map_id, "mesh": $mesh, "name": $name, "notes": $notes, "ntp_servers": $ntp_servers, "orientation": $orientation, "poe_passthrough": $poe_passthrough, "port_config": $port_config, "pwr_config": $pwr_config, "radio_config": $radio_config, "uplink_port_config": $uplink_port_config, "usb_config": $usb_config, "vars": $vars, "x": $x, "y": $y, "acl_policies": $acl_policies, "acl_tags": $acl_tags, "additional_config_cmds": $additional_config_cmds, "dhcp_config": $dhcp_config, "dhcp_snooping": $dhcp_snooping, "disable_auto_config": $disable_auto_config, "dns_servers": $dns_servers, "dns_suffix": $dns_suffix, "evpn_config": $evpn_config, "extra_routes": $extra_routes, "managed": $managed, "networks": $networks, "oob_ip_config": $oob_ip_config, "ospf_config": $ospf_config, "other_ip_configs": $other_ip_configs, "port_mirroring": $port_mirroring, "port_usages": $port_usages, "radius_config": $radius_config, "role": $role, "router_id": $router_id, "virtual_chassis": $virtual_chassis, "vrf_config": $vrf_config, "vrrp_config": $vrrp_config, "dhcpd_config": $dhcpd_config} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

