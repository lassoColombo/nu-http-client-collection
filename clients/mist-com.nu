export def "update-site-local-switch-port-config" [
  site_id: string
  device_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --ae-disable-lacp: oneof<nothing, bool> # To disable LACP support for the AE interface
  --ae-idx: int # Users could force to use the designated AE name
  --aggregated: oneof<nothing, bool> # default: false
  --critical: oneof<nothing, bool> # if want to generate port up/down alarm
  --description: string
  --disable-autoneg: oneof<nothing, bool> # if `speed` and `duplex` are specified, whether to disable autonegotiation (default: false)
  --duplex: string@duplex-completer # default: auto
  --dynamic-usage: string # Enable dynamic usage for this port. Set to `dynamic` to enable. (nullable)
  --esilag: oneof<nothing, bool>
  --mtu: int # media maximum transmission unit (MTU) is the largest data unit that can be forwarded without fragmentation (default: 1514)
  --no-local-overwrite: oneof<nothing, bool> # prevent helpdesk to override the port config
  --poe-disabled: oneof<nothing, bool> # default: false
  --speed: string@speed-completer # default: auto
  usage: string # port usage name. If EVPN is used, use `evpn_uplink`or `evpn_downlink`
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/api/v1/sites/{site_id}/devices/{device_id}/local_port_config"
    path_params: [{name: site_id, var: site_id}, {name: device_id, var: device_id}]
