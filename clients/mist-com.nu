  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --acct-interim-interval: int # how frequently should interim accounting be reported, 60-65535. default is 0 (use one specified in Access-Accept request from RADIUS Server). Very frequent messages can affect the performance of the radius server, 600 and up is recommended when enabled (default: 0)
  --acct-servers: list # list of RADIUS accounting servers, optional, order matters where the first one is treated as primary — item shape: {host: string, keywrap_enabled?: bool, keywrap_format?: string, keywrap_kek?: string, keywrap_mack?: string, port: int, secret: string}
  --airwatch: record # airwatch wlan settings — shape: {api_key?: string, console_url?: string, enabled?: bool, password?: string, username?: string}
  --allow-ipv6-ndp: oneof<nothing, bool> # only applicable when limit_bcast==true, which allows or disallows ipv6 Neighbor Discovery packets to go through (default: true)
  --allow-mdns: oneof<nothing, bool> # only applicable when limit_bcast==true, which allows mDNS / Bonjour packets to go through (default: false)
  --allow-ssdp: oneof<nothing, bool> # only applicable when `limit_bcast`==`tru`e, which allows SSDP (default: false)
  --ap-ids: list<string> # list of device ids (nullable)
  --app-limit: record # bandwidth limiting for apps (applies to up/down) — shape: {apps?: record, enabled?: bool, wxtag_ids?: record}
  --app-qos: record # app qos wlan settings — shape: {apps?: record, enabled?: bool, others?: list}
  --apply-to: string@apply-to-completer # nullable
  --arp-filter: oneof<nothing, bool> # whether to enable smart arp filter (default: false)
  --body-auth: record # authentication wlan settings — shape: {anticlog_threshold?: int, eap_reauth?: bool, enable_mac_auth?: bool, key_idx?: int, keys?: list<string>, multi_psk_only?: bool, owe?: string, pairwise?: list<string>, private_wlan?: bool, psk?: string, type: "open"|"psk"|"wep"|"eap"|"psk-tkip"|"psk-wpa2-tkip", wep_as_secondary_auth?: bool}
  --auth-server-selection: string@auth-server-selection-completer # When ordered, AP will prefer and go back to the first server if possible (nullable, default: ordered)
  --auth-servers: list # list of RADIUS authentication servers, at least one is needed if `auth type`==`eap`, order matters where the first one is treated as primary — item shape: {host: string, keywrap_enabled?: bool, keywrap_format?: string, keywrap_kek?: string, keywrap_mack?: string, port: int, secret: string}
  --auth-servers-nas-id: string # optional, up to 48 bytes, will be dynamically generated if not provided. used only for authentication servers (nullable)
  --auth-servers-nas-ip: string # optional, NAS-IP-ADDRESS to use (nullable)
  --auth-servers-retries: int # radius auth session retries (default: 2)
  --auth-servers-timeout: int # radius auth session timeout (default: 5)
  --band: string # `band` is deprecated and kept for backward compability. Use bands instead (DEPRECATED)
  --band-steer: oneof<nothing, bool> # whether to enable band_steering, this works only when band==both (default: false)
  --band-steer-force-band5: oneof<nothing, bool> # force dual-band capable client to connect to 5G (default: false)
  --bands: list<string> # list of radios that the wlan should apply to (default: [24, 5])
  --block-blacklist-clients: oneof<nothing, bool> # whether to block the clients in the blacklist (up to first 256 macs)
  --bonjour: record # bonjour gateway wlan settings — shape: {additional_vlan_ids: list<int>, enabled?: bool, services: record}
  --cisco-cwa: record # Cisco CWA (central web authentication) required RADIUS with COA in order to work. See CWA: https://www.cisco.com/c/en/us/support/docs/security/identity-services-engine/115732-central-web-auth-00.html — shape: {allowed_hostnames?: list<string>, allowed_subnets?: list<string>, blocked_subnets?: list<string>, enabled?: bool}
  --client-limit-down: int # kbps
  --client-limit-down-enabled: oneof<nothing, bool> # if downlink limiting per-client is enabled (default: false)
  --client-limit-up: int # kbps
  --client-limit-up-enabled: oneof<nothing, bool> # if uplink limiting per-client is enabled (default: false)
  --coa-servers: list # list of COA (change of authorization) servers, optional (nullable) — item shape: {disable_event_timestamp_check: bool, enabled: bool, ip: string, port: string, secret: string}
  --disable-11ax: oneof<nothing, bool> # some old WLAN drivers may not be compatible (default: false)
  --disable-ht-vht-rates: oneof<nothing, bool> # to disable ht or vht rates (default: false)
  --disable-uapsd: oneof<nothing, bool> # whether to disable U-APSD (default: false)
  --disable-v1-roam-notify: oneof<nothing, bool> # disable sending v2 roam notification messages (default: true)
  --disable-v2-roam-notify: oneof<nothing, bool> # disable sending v2 roam notification messages (default: false)
  --disable-wmm: oneof<nothing, bool> # whether to disable WMM (default: false)
  --dns-server-rewrite: record # for radius_group-based DNS server (rewrite DNS request depending on the Group RADIUS server returns) (nullable) — shape: {enabled?: bool, radius_groups?: record}
  --dtim: int # default: 2
  --dynamic-psk: record # for dynamic PSK where we get per-user PSK from Radius dynamic_psk allows PSK to be selected at runtime depending on context (wlan/site/user/...) thus following configurations are assumed (currently) - PSK will come from RADIUS server - AP sends client MAC as username ans password (i.e. `enable_mac_auth` is assumed) - AP sends BSSID:SSID as Caller-Station-ID - `auth_servers` is required - PSK will come from cloud WLC if source is cloud_psks - default_psk will be used if cloud WLC is not available - `multi_psk_only` and `psk` is ignored - `pairwise` can only be wpa2-ccmp (for now, wpa3 support on the roadmap) (nullable) — shape: {default_psk?: string, default_vlan_id?: int, enabled?: bool, source?: "radius"|"cloud_psks", vlan_ids?: list<int>}
  --dynamic-vlan: record # for 802.1x (nullable) — shape: {default_vlan_id?: int, enabled?: bool, local_vlan_ids?: list<int>, type?: "standard"|"airespace-interface-name", vlans?: record}
  --enable-local-keycaching: oneof<nothing, bool> # enable AP-AP keycaching via multicast (default: false)
  --enable-wireless-bridging: oneof<nothing, bool> # whether to enable wireless bridging, which allows more broadcast packets to go through (allows forwarding of DHCP response to client not associated with the AP)
  --enabled: oneof<nothing, bool> # if this wlan is enabled (default: true)
  --hide-ssid: oneof<nothing, bool> # whether to hide SSID in beacon (default: false)
  --hostname-ie: oneof<nothing, bool> # include hostname inside IE in AP beacons / probe responses (default: false)
  --hotspot20: record # hostspot 2.0 wlan settings — shape: {enabled?: bool, operators?: list<string>, venue_name?: string}
  --interface: string@interface-completer # where this WLAN will be connected to (default: all)
  --isolation: oneof<nothing, bool> # whether to allow clients to talk to each other (default: false)
  --l2-isolation: oneof<nothing, bool> # if isolation is enabled, whether to deny clients to talk to L2 on the LAN (default: false)
  --legacy-overds: oneof<nothing, bool> # legacy devices requires the Over-DS (for Fast BSS Transition) bit set (while our chip doesn’t support it). Warning! Enabling this will cause problem for iOS devices.
  --limit-bcast: oneof<nothing, bool> # whether to limit broadcast packets going to wireless (i.e. only allow certain bcast packets to go through) (default: false)
  --limit-probe-response: oneof<nothing, bool> # limit probe response base on some heuristic rules
  --max-idletime: int # max idle time in seconds (default: 1800)
  --mist-nac: record # shape: {enabled?: bool}
  --mxtunnel: record # when `interface`=`site_medge`, the definition of the Mist Tunnels (key is the name)
  --mxtunnel-id: string # when `interface`=`mxtunnel`, id of the Mist Tunnel (nullable, format: uuid)
  --mxtunnel-name: string # when `interface`=`site_medge`, name of the mxtunnel that in mxtunnels under Site Setting (nullable, default: default)
  --no-static-dns: oneof<nothing, bool> # whether to only allow client to use DNS that we’ve learned from DHCP response (default: false)
  --no-static-ip: oneof<nothing, bool> # whether to only allow client that we’ve learned from DHCP exchange to talk (default: false)
  --portal: record # portal wlan settings — shape: {amazon_client_id?: string, amazon_client_secret?: string, amazon_email_domains?: list<string>, amazon_enabled?: bool, auth?: "none"|"email"|"external"|"sso", azure_client_id?: string, azure_client_secret?: string, azure_enabled?: bool, azure_tenant_id?: string, broadnet_password?: string, broadnet_sid?: string, broadnet_user_id?: string, bypass_when_cloud_down?: bool, clickatell_api_key?: string, cross_site?: bool, email_enabled?: bool, enabled?: bool, expire?: float, ... (52 more fields)}
  --portal-allowed-hostnames: list<string> # list of hostnames without http(s):// (matched by substring)
  --portal-allowed-subnets: list<string> # list of CIDRs
  --portal-api-secret: string # api secret (auto-generated) that can be used to sign guest authorization requests (nullable)
  --portal-denied-hostnames: list<string> # list of hostnames without http(s):// (matched by substring), this takes precedence over portal_allowed_hostnames
  --portal-image: string # Url of portal background image (nullable, format: uri)
  --portal-sso-url: string # nullable
  --portal-template-url: string # N.B portal_template will be forked out of wlan objects soon. To fetch portal_template, please query portal_template_url. To update portal_template, use Wlan Portal Template. (nullable)
  --qos: record # shape: {class?: "background"|"best_effort"|"video"|"voice", overwrite?: bool}
  --radsec: record # Radsec settings — shape: {enabled?: bool, idle_timeout?: int, mxcluster_ids?: list<string>, server_name?: string, servers?: list, use_mxedge?: bool, use_site_mxedge?: bool}
  --rateset: record # shape: {5?: record, 24?: record}
  --roam-mode: string@roam-mode-completer # nullable, default: none
  --schedule: record # WLAN operating schedule, default is disabled — shape: {enabled?: bool, hours?: record}
  --sle-excluded: oneof<nothing, bool> # whether to exclude this WLAN from SLE metrics (default: false)
  ssid: string # the name of the SSID
  --template-id: string # nullable, format: uuid
  --thumbnail: string # Url of portal background image thumbnail (nullable, format: uri)
  --use-eapol-v1: oneof<nothing, bool> # if `auth.type`==’eap’ or ‘psk’, should only be set for legacy client, such as pre-2004, 802.11b devices (default: false)
  --vlan-enabled: oneof<nothing, bool> # if vlan tagging is enabled (default: false)
  --vlan-id: int # nullable
  --vlan-ids: list<int> # list of VLAN ids
  --vlan-pooling: oneof<nothing, bool> # vlan pooling allows AP to place client on different VLAN using a deterministic algorithm (default: false)
  --wlan-limit-down: int # kbps
  --wlan-limit-down-enabled: oneof<nothing, bool> # if downlink limiting for whole wlan is enabled (default: false)
  --wlan-limit-up: int # kbps
  --wlan-limit-up-enabled: oneof<nothing, bool> # if uplink limiting for whole wlan is enabled (default: false)
