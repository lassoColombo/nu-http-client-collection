  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --body-param: string # Site Template ID (format: uuid)
  --address: string # full address of the site (e.g. 1601 S. Deanza Blvd., Cupertino, CA, 95014)
  --alarmtemplate-id: string # Alarm Template ID, this takes precedence over the Org-level alarmtemplate_id (nullable, format: uuid, e.g. 684dfc5c-fe77-2290-eb1d-ef3d677fe168)
  --aptemplate-id: string # AP Template ID, used by APs (e.g. 16bdf952-ade2-4491-80b0-85ce506c760b)
  --country-code: string # country code for the site (for AP config generation), in two-character (e.g. US)
  --gatewaytemplate-id: string # Gateway Template ID, used by gateways (nullable, format: uuid, e.g. 6f9b2e75-9b2f-b5ae-81e3-e14c76f1a90f)
  --latlng: record # site location — shape: {lat?: float, lng?: float}
  name: string # e.g. Mist Office
  --networktemplate-id: string # Network Template ID, this takes precedence over Site Settings (nullable, format: uuid, e.g. 12ae9bd2-e0ab-107b-72e8-a7a005565ec2)
  --notes: string # optional, any notes about the site
  --rftemplate-id: string # RF Template ID, this takes precedence over Site Settings (nullable, format: uuid, e.g. bb8a9017-1e36-5d6c-6f2b-551abe8a76a2)
  --secpolicy-id: string # SecPolicy ID (nullable, format: uuid, e.g. 3bcd0beb-5d0a-4cbd-92c1-14aea91e98ef)
  --sitegroup-ids: list<string> # sitegroups this site belongs to
  --timezone: string # Timezone the site is at (e.g. America/Los_Angeles)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({site_id: (encode-path-segment $site_id)} | format pattern "/api/v1/sites/{site_id}"))
  let req_body = {"field-1": $body_param, "address": $address, "alarmtemplate_id": $alarmtemplate_id, "aptemplate_id": $aptemplate_id, "country_code": $country_code, "gatewaytemplate_id": $gatewaytemplate_id, "latlng": $latlng, "name": $name, "networktemplate_id": $networktemplate_id, "notes": $notes, "rftemplate_id": $rftemplate_id, "secpolicy_id": $secpolicy_id, "sitegroup_ids": $sitegroup_ids, "timezone": $timezone} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

