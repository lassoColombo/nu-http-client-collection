# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    get-alarm-definitions: "table<display: string, fields: list<string>, group: string, key: string, marvis_suggestion_category: string, severity: string>"
    get-ap-channels: "record<band24_channels: record, band24_enabled: bool, band5_channels: record, band5_enabled: bool, code: int, dfs_ok: bool, key: string, name: string>"
    get-ap-led-definition: "table<code: string, description: string, key: string, name: string>"
    get-applications: "table<app_id: bool, app_image_url: string, app_probe: bool, group: string, key: string, name: string, signature_based: bool, ssr_app_id: bool>"
    get-call-events-definitions: "table<description: string, display: string, example: record<app: string, meeting_id: string, org_id: string, site_id: string, timestamp: int, type: string, wcid: string>, key: string>"
    get-client-events-definitions: "table<display: string, key: string>"
    get-country-codes: "table<alpha2: string, certified: bool, name: string, numeric: float>"
    get-getaway-default-config: "record"
    get-device-events-definitions: "table<description: string, display: string, example: record, key: string>"
    get-device-models: "list<any>"
    get-site-available-insight-metrics: "record"
    get-site-languages: "table<display: string, display_native: string, key: string>"
    get-mx-edge-events-definitions: "table<description: string, display: string, example: record, key: string>"
    get-mx-edge-models: "table<custom_ports: bool, display: string, model: string, ports: record<\"0\": record, \"1\": record, \"2\": record, \"3\": record>>"
    get-system-events-definitions: "table<display: string, group: string, key: string>"
    get-traffic-types: "table<dscp: float, failover_policy: string, name: string, traffic_class: string>"
    get-installer-alarm-templates: "table<id: string, name: string>"
    get-installer-device-profiles-wip: "table<id: string, name: string>"
    get-installer-list-of-renctly-claimed-devices: "table<connected: bool, height: float, map_id: string, orientation: float, x: float, y: float>"
