  ticket_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({org_id: (encode-path-segment $org_id), ticket_id: (encode-path-segment $ticket_id)} | format pattern "/api/v1/orgs/{org_id}/tickets/{ticket_id}"))
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json"
}

# updateOrgTicket
#
# PUT /api/v1/orgs/{org_id}/tickets/{ticket_id}
# operationId: updateOrgTicket
# --comments item shape: {attachments?: list, author: string, comment: string, created_at: int}
export def "orgs-tickets update" [
  org_id: string
  ticket_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --comments: list # item shape: {attachments?: list, author: string, comment: string, created_at: int}
  --requester-email: string # email of the requester (format: email)
  --status: string@status-completer-1 # Status open: ticket is open, Mist is working on it * pending: ticket is open and Requester attention is needed (e.g. Mist is asking for some more information) * solved: ticket is marked as solved / considered by Mist (requester can update it, causing it to re-open; or rate it) * closed: ticket is archived and cannot be changed
  subject: string
  type: string # question (default) / bug / critical
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({org_id: (encode-path-segment $org_id), ticket_id: (encode-path-segment $ticket_id)} | format pattern "/api/v1/orgs/{org_id}/tickets/{ticket_id}"))
  let req_body = {"comments": $comments, "requester_email": $requester_email, "status": $status, "subject": $subject, "type": $type} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

