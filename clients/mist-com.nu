  --no-static-dns: oneof<nothing, bool> # whether to only allow client to use DNS that we’ve learned from DHCP response (default: false)
  --no-static-ip: oneof<nothing, bool> # whether to only allow client that we’ve learned from DHCP exchange to talk (default: false)
