# Returns: record<counts: record<download_requested: int, downloaded: int, failed: int, reboot_in_progress: int, rebooted: int, scheduled: int, skipped: int, total: int, upgraded: int>, current_phase: int, enable_p2p: bool, force: bool, id: string, max_failure_percentage: int, max_failures: list<int>, reboot_at: int, start_time: float, status: string, strategy: string, target_version: string, upgrade_plan: record>
# operationId: multiUpgradeSiteDevices
export def "multi-upgrade-site-devices" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --canary-phases: list<int> # phases for canary deployment. Each phase represents percentage of AP’s that need to be upgraded. default is [1, 10, 50, 100] (default: [1, 10, 50, 100])
  --device-ids: list<string>
  --enable-p2p: oneof<nothing, bool> # whether to allow local AP-to-AP FW upgrade
  --force: oneof<nothing, bool> # true will force upgrade when requested version is same as running version (default: false)
  --max-failure-percentage: float # percentage of failures allowed across the entire upgrade(not applicable for `big_bang`) (default: 5)
  --max-failures: list<int> # number of failures allowed within each phase(applicable for `canary` or `rrm`). Will be used if provided, else max_failure_percentage will be used
  --models: list<string>
  --p2p-cluster-size: int # default: 10, e.g. 0
  --p2p-parallelism: int # number of parallel p2p download batches to creat
  --reboot: oneof<nothing, bool> # Reboot device immediately after upgrade is completed (Available on Junos OS devices) (default: false)
  --reboot-at: float # reboot start time in epoch seconds, default is `start_time` (e.g. 1624399840)
  --rrm-first-batch-percentage: int # percentage of AP’s that need to be present in the first rrm batch (e.g. 2)
  --rrm-max-batch-percentage: int # max percentage of AP’s that need to be present in each rrm batch (e.g. 10)
  --rrm-mesh-upgrade: string # sequential or parallel (default parallel). Whether to upgrade mesh AP’s parallelly or sequentially at the end of the upgrade
  --rrm-node-order: string@rrm-node-order-completer # Used in rrm to determine whether to start upgrade from fringe or center AP’s (default: fringe_to_center)
  --rrm-slow-ramp: oneof<nothing, bool> # true will make rrm batch sizes slowly ramp up
  --snapshot: oneof<nothing, bool> # Perform recovery snapshot after device is rebooted (Available on Junos OS devices) (default: false)
  --start-time: float # upgrade start time in epoch seconds, default is now (e.g. 1624399840)
  --strategy: string@strategy-completer # `big_bang` (upgrade all at once), `serial` (one at a time), `canary` or `rrm` (default: big_bang)
  --version: string # default: stable, e.g. 3.1.5
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/api/v1/sites/{site_id}/devices/upgrade"
    path_params: [{name: site_id, var: site_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: canary_phases, var: canary_phases}, {name: device_ids, var: device_ids}, {name: enable_p2p, var: enable_p2p}, {name: force, var: force}, {name: max_failure_percentage, var: max_failure_percentage}, {name: max_failures, var: max_failures}, {name: models, var: models}, {name: p2p_cluster_size, var: p2p_cluster_size}, {name: p2p_parallelism, var: p2p_parallelism}, {name: reboot, var: reboot}, {name: reboot_at, var: reboot_at}, {name: rrm_first_batch_percentage, var: rrm_first_batch_percentage}, {name: rrm_max_batch_percentage, var: rrm_max_batch_percentage}, {name: rrm_mesh_upgrade, var: rrm_mesh_upgrade}, {name: rrm_node_order, var: rrm_node_order}, {name: rrm_slow_ramp, var: rrm_slow_ramp}, {name: snapshot, var: snapshot}, {name: start_time, var: start_time}, {name: strategy, var: strategy}, {name: version, var: version}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    site_id: $site_id, canary_phases: $canary_phases, device_ids: $device_ids, enable_p2p: $enable_p2p, force: $force, max_failure_percentage: $max_failure_percentage, max_failures: $max_failures, models: $models, p2p_cluster_size: $p2p_cluster_size, p2p_parallelism: $p2p_parallelism, reboot: $reboot, reboot_at: $reboot_at, rrm_first_batch_percentage: $rrm_first_batch_percentage, rrm_max_batch_percentage: $rrm_max_batch_percentage, rrm_mesh_upgrade: $rrm_mesh_upgrade, rrm_node_order: $rrm_node_order, rrm_slow_ramp: $rrm_slow_ramp, snapshot: $snapshot, start_time: $start_time, strategy: $strategy, version: $version
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

