    path_params: [{name: org_id, var: org_id}, {name: mxedge_id, var: mxedge_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: model, var: model}, {name: mxcluster_id, var: mxcluster_id}, {name: mxedge_mgmt, var: mxedge_mgmt}, {name: name, var: name}, {name: ntp_servers, var: ntp_servers}, {name: oob_ip_config, var: oob_ip_config}, {name: proxy, var: proxy}, {name: services, var: services}, {name: tunterm_dhcpd_config, var: tunterm_dhcpd_config}, {name: tunterm_extra_routes, var: tunterm_extra_routes}, {name: tunterm_igmp_snooping_config, var: tunterm_igmp_snooping_config}, {name: tunterm_ip_config, var: tunterm_ip_config}, {name: tunterm_monitoring, var: tunterm_monitoring}, {name: tunterm_other_ip_configs, var: tunterm_other_ip_configs}, {name: tunterm_port_config, var: tunterm_port_config}, {name: tunterm_switch_config, var: tunterm_switch_config}, {name: versions, var: versions}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    org_id: $org_id, mxedge_id: $mxedge_id, model: $model, mxcluster_id: $mxcluster_id, mxedge_mgmt: $mxedge_mgmt, name: $name, ntp_servers: $ntp_servers, oob_ip_config: $oob_ip_config, proxy: $proxy, services: $services, tunterm_dhcpd_config: $tunterm_dhcpd_config, tunterm_extra_routes: $tunterm_extra_routes, tunterm_igmp_snooping_config: $tunterm_igmp_snooping_config, tunterm_ip_config: $tunterm_ip_config, tunterm_monitoring: $tunterm_monitoring, tunterm_other_ip_configs: $tunterm_other_ip_configs, tunterm_port_config: $tunterm_port_config, tunterm_switch_config: $tunterm_switch_config, versions: $versions
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
