  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --dmvpn: record # Dynamic Multipoint VPN configurations — shape: {enabled?: bool, holding_time?: int, host_routes?: list<string>}
  --for-mgmt: oneof<nothing, bool> # determined during creation time and cannot be toggled. A management tunnel cannot be used by wxlan rule or by wlan (default: false)
  --hello-interval: int # in seconds, used as heartbeat to detect if a tunnel is alive. AP will try another peer after missing N hellos specified by hello_retries. (default: 60)
  --hello-retries: int # default: 7
  --hostname: string # optional, overwrite the hostname in SCCRQ control message, default is “” or null, %H and %M can be used, which will be replace with corresponding values: * %H: name of the ap if provided (and will be stripped so it can be used for hostname) and fallbacks to MAC * %M: MAC (e.g. 5c5b350e0060)
  --ipsec: record # IPSec-related configurations; requires DMVPN be enabled — shape: {enabled?: bool, psk: string}
  --is-static: oneof<nothing, bool> # whether it’s static/unmanaged (i.e. no control session). As the session configurations are not compatible, cannot be toggled. (default: false)
  --mtu: int # 0 to enable PMTU, 552-1500 to start PMTU with a lower MTU (default: 0)
  name: string # The name of the tunnel
  --org-id: string # format: uuid
  --peers: list<string> # list of remote peers’ IP or hostname
  --router-id: string # optional, overwrite the router-id in SCCRQ control message, default is “0” or null, can also be an IPv4 address
  --secret: string # secret, ‘’ if no auth is used
  --sessions: list # sessions to be established with the tunnel. Has to be >= 1 in order for this tunnel to be useful. For management tunnel, it can only have 1 — item shape: {ap_as_session_id?: string, comment?: string, enable_cookie?: bool, ethertype?: "ethernet"|"vlan", local_session_id?: int, pseudo_802.1ad_enabled?: bool, remote_id?: string, remote_session_id?: int, use_ap_as_session_ids?: bool}
  --udp-port: int # udp port if `use_udp`==`true`
  --use-udp: oneof<nothing, bool> # whether to use UDP instead of IP (proto=115, which is default of L2TPv3) (default: false)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({site_id: (encode-path-segment $site_id), wxtunnel_id: (encode-path-segment $wxtunnel_id)} | format pattern "/api/v1/sites/{site_id}/wxtunnels/{wxtunnel_id}"))
  let req_body = {"dmvpn": $dmvpn, "for_mgmt": $for_mgmt, "hello_interval": $hello_interval, "hello_retries": $hello_retries, "hostname": $hostname, "ipsec": $ipsec, "is_static": $is_static, "mtu": $mtu, "name": $name, "org_id": $org_id, "peers": $peers, "router_id": $router_id, "secret": $secret, "sessions": $sessions, "udp_port": $udp_port, "use_udp": $use_udp} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

