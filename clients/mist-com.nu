  --dry-run(-n) # Return the request that would be sent without executing it
  --addresses: list<string> # if `type`==`custom`, the subnets where the service resides (if more specific is required)
  --app-caetgories: list<string> # list of application categories are available through /api/v1/const/app_categories
  --apps: list<string> # when `type`==`app`, comes from `/api/v1/const/apps` when `type`==`app_categories`, comes from `/api/v1/const/app_categories`
  --description: string
  --dscp: int # when `traffic_type`==`custom`
  --failover-policy: string@failover-policy-completer # default: revertable
  --hostnames: list<string> # if `type`==`custom`
  --id: string # format: uuid
  --max-jitter: int # when `traffic_type`==`custom`, for uplink selection
  --max-latency: string # when `traffic_type`==`custom`, for uplink selection
  --max-loss: int # when `traffic_type`==`custom`, for uplink selection
  --name: string
  --sle-enabled: oneof<nothing, bool> # whether to enable measure SLE (default: false)
  --specs: list # when `type`==`addresses` or `type`==`hostnames` — item shape: {port_range?: int, protocol?: string}
