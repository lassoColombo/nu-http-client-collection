]: any -> record<added: list<string>, duplicated: list<string>, error: list<string>, inventory_added: table<mac: string, magic: string, model: string, serial: string, type: string>, inventory_duplicated: table<mac: string, magic: string, model: string, serial: string, type: string>> {
