  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --flags: record # name/val pair objects for location engine to use
  --height: float # when type=image, height of the image map
  --height-m: float
  --latlng-br: record # when type=google, latitude / longitude of the bottom-right corner — shape: {lat?: string, lng?: string}
  --latlng-tl: record # when type=google, latitude / longitude of the top-left corner — shape: {lat?: string, lng?: string}
  --locked: oneof<nothing, bool> # whether this map is considered locked down (default: false)
  --name: string # The name of the map
  --occupancy-limit: int
  --orientation: float # orientation of the map, 0 means up is north, 90 means up is west (default: 0)
  --origin-x: float # the user-annotated x origin, pixels
  --origin-y: float # the user-annotated y origin, pixels
  --ppm: float # when type=image, pixels per meter
  --sitesurvey-path: list # sitesurvey_path — item shape: {coordinate?: string, id?: string, name?: string, nodes?: list}
  --type: string@type-completer # default: image
  --use-auto-orientation: oneof<nothing, bool> # whether this map uses autooreintation values or ignores them (default: false)
  --use-auto-placement: oneof<nothing, bool> # whether this map uses autoplacement values or ignores them (default: false)
  --view: string@view-completer # when type=google (nullable)
  --wall-path: record # a JSON blob for wall definition (same format as wayfinding_path) — shape: {coordinate?: string, name?: string, nodes?: list}
  --wayfinding: record # properties related to wayfinding — shape: {micello?: record, snap_to_path?: bool}
  --wayfinding-path: record # a JSON blob for wayfinding (using Dijkstra’s algorithm) — shape: {coordinate?: string, nodes?: list}
  --width: float # when type=image, width of the image map
  --width-m: float
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/api/v1/installer/orgs/{org_id}/sites/{site_name}/maps/{map_id}"
    path_params: [{name: org_id, var: org_id}, {name: site_name, var: site_name}, {name: map_id, var: map_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: flags, var: flags}, {name: height, var: height}, {name: height_m, var: height_m}, {name: latlng_br, var: latlng_br}, {name: latlng_tl, var: latlng_tl}, {name: locked, var: locked}, {name: name, var: name}, {name: occupancy_limit, var: occupancy_limit}, {name: orientation, var: orientation}, {name: origin_x, var: origin_x}, {name: origin_y, var: origin_y}, {name: ppm, var: ppm}, {name: sitesurvey_path, var: sitesurvey_path}, {name: type, var: type}, {name: use_auto_orientation, var: use_auto_orientation}, {name: use_auto_placement, var: use_auto_placement}, {name: view, var: view}, {name: wall_path, var: wall_path}, {name: wayfinding, var: wayfinding}, {name: wayfinding_path, var: wayfinding_path}, {name: width, var: width}, {name: width_m, var: width_m}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    org_id: $org_id, site_name: $site_name, map_id: $map_id, flags: $flags, height: $height, height_m: $height_m, latlng_br: $latlng_br, latlng_tl: $latlng_tl, locked: $locked, name: $name, occupancy_limit: $occupancy_limit, orientation: $orientation, origin_x: $origin_x, origin_y: $origin_y, ppm: $ppm, sitesurvey_path: $sitesurvey_path, type: $type, use_auto_orientation: $use_auto_orientation, use_auto_placement: $use_auto_placement, view: $view, wall_path: $wall_path, wayfinding: $wayfinding, wayfinding_path: $wayfinding_path, width: $width, width_m: $width_m
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
