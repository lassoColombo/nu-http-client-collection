  --authorized: oneof<nothing, bool> # whether the guest is current authorized
  --authorized-expiring-time: int # when the authorization would expire (e.g. 1480704955)
  --authorized-time: int # when the guest was authorized (e.g. 1480704355)
  --company: string # optional, the info provided by user (e.g. abc)
