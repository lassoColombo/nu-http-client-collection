# updateOrgInventoryAssignment
#
# PUT /api/v1/orgs/{org_id}/inventory
# Returns: record<error: list<string>, op: string, success: list<string>>
# operationId: updateOrgInventoryAssignment
export def "update-org-inventory-assignment" [
  org_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --disable-auto-config: oneof<nothing, bool> # if `op`==`assign`, a cloud-ready switch/gateway will be managed/configured by Mist by default, this disabled the behavior (default: false)
  --macs: list<string> # if `op`==`assign`, `op`==`unassign`, `op`==`manage`or `op`==`unmanage` , list of MAC, e.g. ["5c5b350e0001"]
  --managed: oneof<nothing, bool> # if `op`==`assign`, an adopted switch/gateway will not be managed/configured by Mist by default, this enables the behavior (default: false)
  --no-reassign: oneof<nothing, bool> # if `op`==`assign`, if true, treat site assignment against an already assigned AP as error
  op: string@op-completer-2 # * if `op`== `manage`: Upgrade to mist-managed * if `op`== `unmanage`: Downgrade to basic monitoring * if `op`== `assign`: Assign inventory to a site * if `op`== `unassign`: Unassign inventory to a site * if `op`== `delete`: Delete multiple inventory from org
  --serials: list<string> # if `op`==`delete`, list of serial numbers, e.g. ["FXLH2015150025"]
  --site-id: string # if `op`==`assign`, target site id (format: uuid)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/api/v1/orgs/{org_id}/inventory"
    path_params: [{name: org_id, var: org_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: disable_auto_config, var: disable_auto_config}, {name: macs, var: macs}, {name: managed, var: managed}, {name: no_reassign, var: no_reassign}, {name: op, var: op}, {name: serials, var: serials}, {name: site_id, var: site_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    org_id: $org_id, disable_auto_config: $disable_auto_config, macs: $macs, managed: $managed, no_reassign: $no_reassign, op: $op, serials: $serials, site_id: $site_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

