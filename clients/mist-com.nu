  applies: record # Object defines the scope (within the org e.g. whole org, and/or some site-groups, and/or some sites) for which the alarm service has to be suppressed for some `duration` — shape: {org_id: string, site_ids: list<string>, sitegroup_ids: list<string>}
  --duration: float # duration, in seconds (default: 60)
]: any -> any {
  let input = $in
