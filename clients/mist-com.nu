# createOrgNetwork
#
# POST /api/v1/orgs/{org_id}/networks
# operationId: createOrgNetwork
# --internal_access shape: {enabled?: bool}
# --internet_access shape: {create_simple_service_policy?: bool, destination_nat?: record, enabled?: bool, restricted?: bool, static_nat?: record}
export def "orgs-networks create" [
  org_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --disallow-mist-services: oneof<nothing, bool> # whether to disallow Mist Devices in the network (default: false)
  --gateway: string # format: ipv4, e.g. 192.168.70.1
  --hosts: record
  --internal-access: record # shape: {enabled?: bool}
  --internet-access: record # whether this network has direct internet access — shape: {create_simple_service_policy?: bool, destination_nat?: record, enabled?: bool, restricted?: bool, static_nat?: record}
  --isolation: oneof<nothing, bool> # whether to allow clients in the network to talk to each other
  --name: string
  --subnet: string # e.g. 192.168.70.0/24
  --tenants: record
  --vlan-id: int
  --vpn-access: record # whether this network can be accessed from vpn
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({org_id: (encode-path-segment $org_id)} | format pattern "/api/v1/orgs/{org_id}/networks"))
  let req_body = {"disallow_mist_services": $disallow_mist_services, "gateway": $gateway, "hosts": $hosts, "internal_access": $internal_access, "internet_access": $internet_access, "isolation": $isolation, "name": $name, "subnet": $subnet, "tenants": $tenants, "vlan_id": $vlan_id, "vpn_access": $vpn_access} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

