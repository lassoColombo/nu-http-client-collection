  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --canary-phases: list<int> # phases for canary deployment. Each phase represents percentage of AP’s that need to be upgraded. default is [1, 10, 50, 100] (default: [1, 10, 50, 100])
  --device-ids: list<string>
  --enable-p2p: oneof<nothing, bool> # whether to allow local AP-to-AP FW upgrade
  --force: oneof<nothing, bool> # true will force upgrade when requested version is same as running version (default: false)
  --max-failure-percentage: float # percentage of failures allowed across the entire upgrade(not applicable for `big_bang`) (default: 5)
  --max-failures: list<int> # number of failures allowed within each phase(applicable for `canary` or `rrm`). Will be used if provided, else max_failure_percentage will be used
  --models: list<string>
  --p2p-cluster-size: int # default: 10, e.g. 0
  --p2p-parallelism: int # number of parallel p2p download batches to creat
  --reboot: oneof<nothing, bool> # Reboot device immediately after upgrade is completed (Available on Junos OS devices) (default: false)
  --reboot-at: float # reboot start time in epoch seconds, default is `start_time` (e.g. 1624399840)
  --rrm-first-batch-percentage: int # percentage of AP’s that need to be present in the first rrm batch (e.g. 2)
  --rrm-max-batch-percentage: int # max percentage of AP’s that need to be present in each rrm batch (e.g. 10)
  --rrm-mesh-upgrade: string # sequential or parallel (default parallel). Whether to upgrade mesh AP’s parallelly or sequentially at the end of the upgrade
  --rrm-node-order: string@rrm-node-order-completer # Used in rrm to determine whether to start upgrade from fringe or center AP’s (default: fringe_to_center)
  --rrm-slow-ramp: oneof<nothing, bool> # true will make rrm batch sizes slowly ramp up
  --snapshot: oneof<nothing, bool> # Perform recovery snapshot after device is rebooted (Available on Junos OS devices) (default: false)
  --start-time: float # upgrade start time in epoch seconds, default is now (e.g. 1624399840)
  --strategy: string@strategy-completer # `big_bang` (upgrade all at once), `serial` (one at a time), `canary` or `rrm` (default: big_bang)
  --version: string # default: stable, e.g. 3.1.5
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({site_id: (encode-path-segment $site_id)} | format pattern "/api/v1/sites/{site_id}/devices/upgrade"))
  let req_body = {"canary_phases": $canary_phases, "device_ids": $device_ids, "enable_p2p": $enable_p2p, "force": $force, "max_failure_percentage": $max_failure_percentage, "max_failures": $max_failures, "models": $models, "p2p_cluster_size": $p2p_cluster_size, "p2p_parallelism": $p2p_parallelism, "reboot": $reboot, "reboot_at": $reboot_at, "rrm_first_batch_percentage": $rrm_first_batch_percentage, "rrm_max_batch_percentage": $rrm_max_batch_percentage, "rrm_mesh_upgrade": $rrm_mesh_upgrade, "rrm_node_order": $rrm_node_order, "rrm_slow_ramp": $rrm_slow_ramp, "snapshot": $snapshot, "start_time": $start_time, "strategy": $strategy, "version": $version} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

