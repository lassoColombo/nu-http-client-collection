# updateSiteInfo
#
# PUT /api/v1/sites/{site_id}
# Returns: record<"": string, address: string, alarmtemplate_id: string, aptemplate_id: string, country_code: string, created_time: float, gatewaytemplate_id: string, id: string, latlng: record<lat: float, lng: float>, modified_time: float, name: string, networktemplate_id: string, notes: string, org_id: string, rftemplate_id: string, secpolicy_id: string, sitegroup_ids: list<string>, timezone: string>
# operationId: updateSiteInfo
export def "update-site-info" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --param: string # Site Template ID (format: uuid)
  --address: string # full address of the site (e.g. 1601 S. Deanza Blvd., Cupertino, CA, 95014)
  --alarmtemplate-id: string # Alarm Template ID, this takes precedence over the Org-level alarmtemplate_id (nullable, format: uuid, e.g. 684dfc5c-fe77-2290-eb1d-ef3d677fe168)
  --aptemplate-id: string # AP Template ID, used by APs (e.g. 16bdf952-ade2-4491-80b0-85ce506c760b)
  --country-code: string # country code for the site (for AP config generation), in two-character (e.g. US)
  --gatewaytemplate-id: string # Gateway Template ID, used by gateways (nullable, format: uuid, e.g. 6f9b2e75-9b2f-b5ae-81e3-e14c76f1a90f)
  --latlng: record # site location — shape: {lat?: float, lng?: float}
  name: string # e.g. Mist Office
  --networktemplate-id: string # Network Template ID, this takes precedence over Site Settings (nullable, format: uuid, e.g. 12ae9bd2-e0ab-107b-72e8-a7a005565ec2)
  --notes: string # optional, any notes about the site
  --rftemplate-id: string # RF Template ID, this takes precedence over Site Settings (nullable, format: uuid, e.g. bb8a9017-1e36-5d6c-6f2b-551abe8a76a2)
  --secpolicy-id: string # SecPolicy ID (nullable, format: uuid, e.g. 3bcd0beb-5d0a-4cbd-92c1-14aea91e98ef)
  --sitegroup-ids: list<string> # sitegroups this site belongs to
  --timezone: string # Timezone the site is at (e.g. America/Los_Angeles)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/api/v1/sites/{site_id}"
    path_params: [{name: site_id, var: site_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: field-1, var: param}, {name: address, var: address}, {name: alarmtemplate_id, var: alarmtemplate_id}, {name: aptemplate_id, var: aptemplate_id}, {name: country_code, var: country_code}, {name: gatewaytemplate_id, var: gatewaytemplate_id}, {name: latlng, var: latlng}, {name: name, var: name}, {name: networktemplate_id, var: networktemplate_id}, {name: notes, var: notes}, {name: rftemplate_id, var: rftemplate_id}, {name: secpolicy_id, var: secpolicy_id}, {name: sitegroup_ids, var: sitegroup_ids}, {name: timezone, var: timezone}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    site_id: $site_id, param: $param, address: $address, alarmtemplate_id: $alarmtemplate_id, aptemplate_id: $aptemplate_id, country_code: $country_code, gatewaytemplate_id: $gatewaytemplate_id, latlng: $latlng, name: $name, networktemplate_id: $networktemplate_id, notes: $notes, rftemplate_id: $rftemplate_id, secpolicy_id: $secpolicy_id, sitegroup_ids: $sitegroup_ids, timezone: $timezone
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

