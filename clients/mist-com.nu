# --radsec shape: {acct_servers?: list, auth_servers?: list, enabled?: bool, match_ssid?: bool, proxy_hosts?: list<string>, server_selection?: "ordered"|"unordered", source?: "tunnel"|"oob"|"any"}
# --radsec_tls shape: {keypair?: string}
# --tunterm_dhcpd_config shape: {enabled?: bool, servers?: list<string>, type?: "relay"}
# --tunterm_monitoring item shape: {host?: string, port?: int, protocol?: "arp"|"ping"|"tcp", timeout?: int}
export def "orgs-mxclusters update-mx-edge" [
  org_id: string
  mxcluster_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --mist-das: record # configure cloud-assisted dynamic authorization service on this cluster of mist edges — shape: {coa_servers?: list, enabled?: bool}
  --mist-nac: record # shape: {acct_server_port?: int, auth_server_port?: int, client_ips?: record, enabled?: bool, secret?: string}
  --name: string
  --proxy: record # Proxy Configuration to talk to Mist — shape: {url?: string}
  --radsec: record # MxEdge Radsec Configuration — shape: {acct_servers?: list, auth_servers?: list, enabled?: bool, match_ssid?: bool, proxy_hosts?: list<string>, server_selection?: "ordered"|"unordered", source?: "tunnel"|"oob"|"any"}
  --radsec-tls: record # shape: {keypair?: string}
  --tunterm-ap-subnets: list<string> # list of subnets where we allow AP to establish Mist Tunnels from
  --tunterm-dhcpd-config: record # DHCP server/relay configuration of Mist Tunneled VLANs. The property key is the VLAN ID — shape: {enabled?: bool, servers?: list<string>, type?: "relay"}
  --tunterm-extra-routes: record # extra routes for Mist Tunneled VLANs. The property key is a CIDR
  --tunterm-hosts: list<string> # hostnames or IPs where a Mist Tunnel will use as the Peer (i.e. they are reachable from AP)
  --tunterm-hosts-order: list<int> # list of index of tunterm_hosts
  --tunterm-hosts-selection: string@tunterm-hosts-selection-completer # Ordering of tunterm_hosts for mxedge within the same mxcluster. * When `shuffle`, the ordering of tunterm_hosts is randomized by the device’s MAC. * When `shuffle-by-site`, we shuffle by site_id+tunnel_id (so when client connects to a specific Tunnel, it will go to the same (order of) mxedge, and we load-balancing between tunnels). * When `ordered`, the order is decided by tunterm_hosts_order (default: shuffle)
  --tunterm-monitoring: list # item shape: {host?: string, port?: int, protocol?: "arp"|"ping"|"tcp", timeout?: int}
  --tunterm-monitoring-disabled: oneof<nothing, bool>
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({org_id: (encode-path-segment $org_id), mxcluster_id: (encode-path-segment $mxcluster_id)} | format pattern "/api/v1/orgs/{org_id}/mxclusters/{mxcluster_id}"))
  let req_body = {"mist_das": $mist_das, "mist_nac": $mist_nac, "name": $name, "proxy": $proxy, "radsec": $radsec, "radsec_tls": $radsec_tls, "tunterm_ap_subnets": $tunterm_ap_subnets, "tunterm_dhcpd_config": $tunterm_dhcpd_config, "tunterm_extra_routes": $tunterm_extra_routes, "tunterm_hosts": $tunterm_hosts, "tunterm_hosts_order": $tunterm_hosts_order, "tunterm_hosts_selection": $tunterm_hosts_selection, "tunterm_monitoring": $tunterm_monitoring, "tunterm_monitoring_disabled": $tunterm_monitoring_disabled} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

