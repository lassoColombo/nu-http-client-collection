# createSiteMxEdge
#
# POST /api/v1/sites/{site_id}/mxedges
# operationId: createSiteMxEdge
# --mxedge_mgmt shape: {mist_password?: string, root_password?: string}
# --oob_ip_config shape: {dns?: list<string>, gateway?: string, ip?: string, netmask?: string, type?: "static"|"dhcp"}
# --proxy shape: {url?: string}
# --tunterm_dhcpd_config shape: {enabled?: bool, servers?: list<string>, type?: "relay"}
# --tunterm_igmp_snooping_config shape: {enabled?: bool, querier?: record, vlan_ids?: list<int>}
# --tunterm_ip_config shape: {gateway: string, ip: string, netmask: string}
# --tunterm_monitoring item shape: {host?: string, port?: int, protocol?: "arp"|"ping"|"tcp", timeout?: int}
# --tunterm_port_config shape: {downstream_ports?: list<string>, separate_upstream_downstream?: bool, upstream_port_vlan_id?: int, upstream_ports?: list<string>}
# --tunterm_switch_config shape: {enabled?: bool}
# --versions shape: {mxagent?: string, tuntnerm?: string}
export def "sites-mxedges create-mx-edge" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  model: string # e.g. ME-100
  --mxcluster-id: string # MxCluster this MxEdge belongs to (format: uuid, e.g. 572586b7-f97b-a22b-526c-8b97a3f609c4)
  --mxedge-mgmt: record # shape: {mist_password?: string, root_password?: string}
  name: string # e.g. Guest
  --ntp-servers: list<string>
  --oob-ip-config: record # ip configuration of the Mist Edge out-of-band management interface — shape: {dns?: list<string>, gateway?: string, ip?: string, netmask?: string, type?: "static"|"dhcp"}
  --proxy: record # shape: {url?: string}
  --services: list<string> # list of services to run, tunterm only for now
  --tunterm-dhcpd-config: record # global and per-VLAN. The property key is the VLAN ID — shape: {enabled?: bool, servers?: list<string>, type?: "relay"}
  --tunterm-extra-routes: record # The property key is a CIDR
  --tunterm-igmp-snooping-config: record # shape: {enabled?: bool, querier?: record, vlan_ids?: list<int>}
  --tunterm-ip-config: record # ip configuration of the Mist Tunnel interface — shape: {gateway: string, ip: string, netmask: string}
  --tunterm-monitoring: list # item shape: {host?: string, port?: int, protocol?: "arp"|"ping"|"tcp", timeout?: int}
  --tunterm-other-ip-configs: record # ip configs by VLAN ID. The property key is the VLAN ID
  --tunterm-port-config: record # ethernet port configurations — shape: {downstream_ports?: list<string>, separate_upstream_downstream?: bool, upstream_port_vlan_id?: int, upstream_ports?: list<string>}
  --tunterm-switch-config: record # if custom vlan settings are desired — shape: {enabled?: bool}
  --versions: record # shape: {mxagent?: string, tuntnerm?: string}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({site_id: (encode-path-segment $site_id)} | format pattern "/api/v1/sites/{site_id}/mxedges"))
  let req_body = {"model": $model, "mxcluster_id": $mxcluster_id, "mxedge_mgmt": $mxedge_mgmt, "name": $name, "ntp_servers": $ntp_servers, "oob_ip_config": $oob_ip_config, "proxy": $proxy, "services": $services, "tunterm_dhcpd_config": $tunterm_dhcpd_config, "tunterm_extra_routes": $tunterm_extra_routes, "tunterm_igmp_snooping_config": $tunterm_igmp_snooping_config, "tunterm_ip_config": $tunterm_ip_config, "tunterm_monitoring": $tunterm_monitoring, "tunterm_other_ip_configs": $tunterm_other_ip_configs, "tunterm_port_config": $tunterm_port_config, "tunterm_switch_config": $tunterm_switch_config, "versions": $versions} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

