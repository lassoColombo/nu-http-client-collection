e" "subscribe-site" "get-site-synthetic-test-status" "trigger-site-synthetic-test" "get-site-curd-settings" "create-site-curd-settings" "get-site-derived-curd-setting" "delete-site-curd-setting" "get-site-curd-setting" "update-site-curd-setting" "get-site-v-beacons" "create-site-v-beacon" "delete-site-v-beacon" "get-site-v-beacon" "update-site-v-beacon" "get-site-webhooks" "create-site-webhook" "delete-site-webhook" "get-site-webhook" "update-site-webhook" "ping-site-webhook" "count-site-clients-wired" "search-site-clients-wired" "get-site-wlans" "create-site-wlan" "get-site-wlan-derived" "delete-site-wlan" "get-site-wlan" "update-site-wlan" "upload-site-wlan-portal-image" "update-site-wlan-portal-template" "get-site-wx-rules" "create-site-wx-rule" "get-site-wx-rules-derived" "delete-site-wx-rule" "get-site-wx-rule" "update-site-wx-rule" "get-site-wx-tags" "create-site-wx-tag" "get-site-application-list" "delete-site-wx-tag" "get-site-wx-tag" "update-site-wx-tag" "get-site-current-matching-clients-of-a-wx-tag" "get-site-wx-tunnels" "create-site-wx-tunnel" "delete-site-wx-tunnel" "get-site-wx-tunnel" "update-site-wx-tunnel" "get-site-zones" "create-site-zone" "delete-site-zone" "get-site-zone" "update-site-zone" "count-site-zone-sessions" "search-site-zone-sessions" "test-site-wlan-telstra-setup" "test-site-wlan-twilio-setup" "alarms" "asset-raw" "audits" "client-join" "client-sessions" "device-events" "device-up-down" "discovered-raw-rssi" "location" "occupancy-alerts" "ping" "sdkclient-scan-data" "zone" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# getAlarmDefinitions
#
# GET /api/v1/const/alarm_defs
# Returns: table<display: string, fields: list<string>, group: string, key: string, marvis_suggestion_category: string, severity: string>
# operationId: getAlarmDefinitions
export def "get-alarm-definitions" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
]: nothing -> oneof<list<any>, record, string, nothing> {
  http-request {
    method: get
    path: "/api/v1/const/alarm_defs"
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

