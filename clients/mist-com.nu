# startSitePacketCapture
#
# POST /api/v1/sites/{site_id}/pcaps/capture
# operationId: startSitePacketCapture
export def "sites-pcaps-capture start-packet" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --ap-mac: string # nullable
  --client-mac: string # client mac, required if `type`==`client`; optional otherwise (nullable)
  --duration: int # duration of the capture, in seconds (default: 600)
  --includes-mcast: oneof<nothing, bool>
  --max-pkt-len: int # default: 128
  --num-packets: int # number of packets to capture, 0 for unlimited, default is 1024 for client-capture (default: 1024)
  --ssid: string # optional filter by ssid (nullable)
  --type: string@type-completer-22 # client (default: client)
  --format: string@format-completer # pcap format (default: pcap)
  --tcpdump-expression: string # tcpdump expression
  --band: string@band-completer-1 # default: 24
  --wlan-id: string # WLAN ID (format: uuid)
  --radiotap-tcpdump-expression: string # tcpdump expression for radiotap interface (802.11 + radio headers)
  --wired-tcpdump-expression: string # tcpdump expression for wired
  --wireless-tcpdump-expression: string # tcpdump expression for radiotap interface (802.11)
  --gateways: record # List of SSRs. Property key is the SSR MAC
  --channel: string # specify the channel value where scan PCAP has to be started
  --width: string # specify the bandwidth value with respect to the channel.
  --switches: record # Property key is the switch mac
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({site_id: (encode-path-segment $site_id)} | format pattern "/api/v1/sites/{site_id}/pcaps/capture"))
  let req_body = {"ap_mac": $ap_mac, "client_mac": $client_mac, "duration": $duration, "includes_mcast": $includes_mcast, "max_pkt_len": $max_pkt_len, "num_packets": $num_packets, "ssid": $ssid, "type": $type, "format": $format, "tcpdump_expression": $tcpdump_expression, "band": $band, "wlan_id": $wlan_id, "radiotap_tcpdump_expression": $radiotap_tcpdump_expression, "wired_tcpdump_expression": $wired_tcpdump_expression, "wireless_tcpdump_expression": $wireless_tcpdump_expression, "gateways": $gateways, "channel": $channel, "width": $width, "switches": $switches} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

