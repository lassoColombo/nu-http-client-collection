  --legacy-overds: oneof<nothing, bool> # legacy devices requires the Over-DS (for Fast BSS Transition) bit set (while our chip doesn’t support it). Warning! Enabling this will cause problem for iOS devices.
  --limit-bcast: oneof<nothing, bool> # whether to limit broadcast packets going to wireless (i.e. only allow certain bcast packets to go through) (default: false)
  --limit-probe-response: oneof<nothing, bool> # limit probe response base on some heuristic rules
  --max-idletime: int # max idle time in seconds (default: 1800)
