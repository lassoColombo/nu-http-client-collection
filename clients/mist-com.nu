  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --custom-logout-url: string # optional, a URL we will redirect the user after user logout from Mist (for some IdP which supports a custom logout URL that is different from SP-initiated SLO process)
  --default-role: string # default role to assign if there’s no match. By default, an assertion is treated as invalid when there’s no role matched
  --domain: string
  --idp-cert: string # if `idp_type`==`saml`. IDP Cert (used to verify the signed response)
  --idp-sign-algo: string # if `idp_type`==`saml`. Signing algorithm for SAML Assertion
  --idp-sso-url: string # IDP Single-Sign-On URL
  --idp-type: string@idp-type-completer # default: saml
  --ignore-unmatched-roles: oneof<nothing, bool> # ignore any unmatched roles provided in assertion. By default, an assertion is treated as invalid for any unmatched role
  --issuer: string # if `idp_type`==`saml`. IDP issuer URL
  --ldap-base-dn: string # if `idp_type`==`ldap`
  --ldap-bind-dn: string # if `idp_type`==`ldap`
  --ldap-bind-password: string # if `idp_type`==`ldap`
  --ldap-certs: list<string> # if `idp_type`==`ldap`
  --ldap-client-cert: string # if `idp_type`==`ldap`
  --ldap-client-key: string # if `idp_type`==`ldap`
  --ldap-group-attr: string # if `idp_type`==`ldap`
  --ldap-group-dn: string # if `ldap_type`==`custom`
  --ldap-group-filter: string # if `ldap_type`==`custom`
  --ldap-server-hosts: list<string> # if `idp_type`==`ldap`
  --ldap-type: string@ldap-type-completer # if `idp_type`==`ldap` (default: ad)
  --ldap-user-filter: string # * if `ldap_type`==`ad`: "(CN=%s)" * if `ldap_type`==`okta`: "(uid=%s)" * if `ldap_type`==`custom`
  name: string # name
  --nameid-format: string@nameid-format-completer # if `idp_type`==`saml` (default: email)
  --oauth-cc-client-id: string # if `oauth_type`==`okta`, Client Credentials (e.g. e60da615-7def-4c5a-8196-43675f45e174)
  --oauth-cc-client-secret: string # if `oauth_type`==`okta`, oauth_cc_client_secret is RSA private key, of the form "-----BEGIN RSA PRIVATE KEY--...." (e.g. akL8Q~5kWFMVFYl4TFZ3fi~7cMdyDONi6cj01cpH)
  --oauth-discovery-url: string # if `idp_type`==`oauth`
  --oauth-ropc-client-id: string # ropc = Resource Owner Password Credentials (e.g. 9ce04c97-b5b1-4ec8-af17-f5ed42d2daf7)
  --oauth-ropc-secret: string # oauth_ropc_client_secret can be empty if oauth_type is azure (e.g. blM9R~6kWFMVFYl4TFZ3fi~8cMdyDONi6cj01dqI)
  --oauth-tenant-id: string # if `oauth_type`==`okta`, oauth_tenant_id (e.g. dev-88336535)
  --oauth-type: string@oauth-type-completer # default: azure
  --role-attr-extraction: string # optional, custom role attribute parsing scheme Supported Role Parsing Schemes NameSchemecnThe expected role attribute format in SAML Assertion is “CN=cn,OU=ou1,OU=ou2,…”CN (the key) is case insensitive and exactly 1 CN is expected (or the entire entry will be ignored)E.g. if role attribute is “CN=cn,OU=ou1,OU=ou2” then parsed role value is “cn”
  --role-attr-from: string # name of the attribute in SAML Assertion to extract role from (default: role)
  --type: string
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({org_id: (encode-path-segment $org_id), sso_id: (encode-path-segment $sso_id)} | format pattern "/api/v1/orgs/{org_id}/ssos/{sso_id}"))
  let req_body = {"custom_logout_url": $custom_logout_url, "default_role": $default_role, "domain": $domain, "idp_cert": $idp_cert, "idp_sign_algo": $idp_sign_algo, "idp_sso_url": $idp_sso_url, "idp_type": $idp_type, "ignore_unmatched_roles": $ignore_unmatched_roles, "issuer": $issuer, "ldap_base_dn": $ldap_base_dn, "ldap_bind_dn": $ldap_bind_dn, "ldap_bind_password": $ldap_bind_password, "ldap_certs": $ldap_certs, "ldap_client_cert": $ldap_client_cert, "ldap_client_key": $ldap_client_key, "ldap_group_attr": $ldap_group_attr, "ldap_group_dn": $ldap_group_dn, "ldap_group_filter": $ldap_group_filter, "ldap_server_hosts": $ldap_server_hosts, "ldap_type": $ldap_type, "ldap_user_filter": $ldap_user_filter, "name": $name, "nameid_format": $nameid_format, "oauth_cc_client_id": $oauth_cc_client_id, "oauth_cc_client_secret": $oauth_cc_client_secret, "oauth_discovery_url": $oauth_discovery_url, "oauth_ropc_client_id": $oauth_ropc_client_id, "oauth_ropc_secret": $oauth_ropc_secret, "oauth_tenant_id": $oauth_tenant_id, "oauth_type": $oauth_type, "role_attr_extraction": $role_attr_extraction, "role_attr_from": $role_attr_from, "type": $type} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json" $req_body
}

