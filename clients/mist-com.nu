# createSiteMap
#
# POST /api/v1/sites/{site_id}/maps
# operationId: createSiteMap
# --latlng_br shape: {lat?: string, lng?: string}
# --latlng_tl shape: {lat?: string, lng?: string}
# --sitesurvey_path item shape: {coordinate?: string, id?: string, name?: string, nodes?: list}
# --wall_path shape: {coordinate?: string, name?: string, nodes?: list}
# --wayfinding shape: {micello?: record, snap_to_path?: bool}
# --wayfinding_path shape: {coordinate?: string, nodes?: list}
export def "sites-maps create" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --flags: record # name/val pair objects for location engine to use
  --height: float # when type=image, height of the image map
  --height-m: float
  --latlng-br: record # when type=google, latitude / longitude of the bottom-right corner — shape: {lat?: string, lng?: string}
  --latlng-tl: record # when type=google, latitude / longitude of the top-left corner — shape: {lat?: string, lng?: string}
  --locked: oneof<nothing, bool> # whether this map is considered locked down (default: false)
  --name: string # The name of the map
  --occupancy-limit: int
  --orientation: float # orientation of the map, 0 means up is north, 90 means up is west (default: 0)
  --origin-x: float # the user-annotated x origin, pixels
  --origin-y: float # the user-annotated y origin, pixels
  --ppm: float # when type=image, pixels per meter
  --sitesurvey-path: list # sitesurvey_path — item shape: {coordinate?: string, id?: string, name?: string, nodes?: list}
  --type: string@type-completer # default: image
  --use-auto-orientation: oneof<nothing, bool> # whether this map uses autooreintation values or ignores them (default: false)
  --use-auto-placement: oneof<nothing, bool> # whether this map uses autoplacement values or ignores them (default: false)
  --view: string@view-completer # when type=google (nullable)
  --wall-path: record # a JSON blob for wall definition (same format as wayfinding_path) — shape: {coordinate?: string, name?: string, nodes?: list}
  --wayfinding: record # properties related to wayfinding — shape: {micello?: record, snap_to_path?: bool}
