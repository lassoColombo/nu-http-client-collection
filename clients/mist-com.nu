# --ble_config shape: {beacon_enabled?: bool, beacon_rate?: int, beacon_rate_mode?: "default"|"custom", beam_disabled?: list<int>, eddystone_uid_adv_power?: int, eddystone_uid_beams?: string, eddystone_uid_enabled?: bool, eddystone_uid_freq_msec?: int, eddystone_uid_instance?: string, eddystone_uid_namespace?: string, eddystone_url_adv_power?: int, eddystone_url_beams?: string, eddystone_url_enabled?: bool, eddystone_url_freq_msec?: int, eddystone_url_url?: string, ibeacon_adv_power?: int, ibeacon_beams?: string, ... (7 more fields)}
# --engagement shape: {dwell_tag_names: record, dwell_tags?: record, hours?: record, max_dwell?: int, min_dwell?: int}
# --evpn_options shape: {core_as_border?: bool, overlay?: record, per_vlan_vga_v4_mac?: bool, routed_at?: "edge"|"core"|"distribution", underlay?: record}
# --gateway_mgmt shape: {admin_sshkeys?: list<string>, app_probing?: record, app_usage?: bool, config_revert_timer?: float, probe_hosts?: list<string>, root_password?: string, security_log_source_address?: string, security_log_source_interface?: string}
# --led shape: {brightness?: int, enabled?: bool}
# --mxedge shape: {mist_das?: record, radsec?: record}
# --mxedge_mgmt shape: {mist_password?: string, root_password?: string}
# --mxtunnels shape: {ap_subnets?: list<string>, clusters?: list, hello_interval?: int, hello_retries?: int, hosts?: list<string>, mtu?: int, protocol?: "udp"|"ip", radsec?: record, vlan_ids?: list}
# --occupancy shape: {assets_enabled?: bool, clients_enabled?: bool, min_duration?: int, sdkclients_enabled?: bool, unconnected_clients_enabled?: bool}
# --port_usages shape: {dynamic?: record}
# --proxy shape: {url?: string}
# --radio_config shape: {allow_rrm_disable?: bool, ant_gain_24?: int, ant_gain_5?: int, ant_gain_6?: int, antenna_mode?: "default"|"1x1"|"2x2"|"3x3"|"4x4", band_24?: record, band_24_usage?: "24"|"5"|"auto", band_5?: record, band_5_on_24_radio?: record, band_6?: record, scanning_enabled?: bool}
# --radius_config shape: {acct_interim_interval?: int, acct_servers?: list, auth_servers?: list, auth_servers_retries?: int, auth_servers_timeout?: int, coa_enabled?: bool, coa_port?: int, network?: string, source_ip?: string}
# --remote_syslog shape: {archive?: record, console?: record, enabled?: bool, files?: list, network?: string, send_to_all_servers?: bool, servers?: list, time_format?: "millisecond"|"year"|"year millisecond", users?: list}
# --rogue shape: {enabled?: bool, honeypot_enabled?: bool, min_duration?: int, min_rssi?: int, whitelisted_bssids?: list<string>, whitelisted_ssids?: list<string>}
# --rtsa shape: {app_waking?: bool, disable_dead_reckoning?: bool, disable_pressure_sensor?: bool, enabled?: bool, track_asset?: bool}
# --simple_alert shape: {arp_failure?: record, dhcp_failure?: record, dns_failure?: record}
# --skyatp shape: {enabled?: bool, send_ip_mac_mapping?: bool}
# --srx_app shape: {enabled?: bool}
# --ssr shape: {conductor_hosts?: list<string>, disable_stats?: bool}
# --status_portal shape: {enabled?: bool, hostnames?: list<string>}
# --switch_matching shape: {additional_config_cmds?: list<string>, enabled?: bool, rules?: list}
# --switch_mgmt shape: {ap_affinity_threshold?: int, config_revert_timer?: float, dhcp_option_fqdn?: bool, mxedge_proxy_host?: string, mxedge_proxy_port?: int, protect_re?: record, root_password?: string, use_mxedge_proxy?: bool}
# --tunterm_monitoring item shape: {host?: string, port?: int, protocol?: "arp"|"ping"|"tcp", timeout?: int}
# --vna shape: {enabled?: bool}
# --wan_vna shape: {enabled?: bool}
# --wids shape: {repeated_auth_failures?: record}
# --wifi shape: {cisco_enabled?: bool, disable_11k?: bool, disable_radios_when_power_constrained?: bool, enable_arp_spoof_check?: bool, enable_channel_144?: bool, enable_shared_radio_scanning?: bool, enable_vna?: bool, enabled?: bool, locate_connected?: bool, locate_unconnected?: bool, mesh_allow_dfs?: bool, mesh_enable_crm?: bool, mesh_enabled?: bool, mesh_psk?: string, mesh_ssid?: string, proxy_arp?: "default"|"enabled"|"disabled"}
# --wired_vna shape: {enabled?: bool}
# --zone_occupancy_alert shape: {email_notifiers?: list<string>, enabled?: bool, threshold?: int}
export def "sites-setting update" [
  site_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --additional-config-cmds: list<string> # additional CLI commands to append to the generated switches config
  --analytic: record # shape: {enabled?: bool}
  --ap-matching: record # shape: {enabled?: bool, rules?: list}
  --ap-port-config: record # shape: {model_specific?: record}
  --auto-placement: record # if we're able to determine its x/y/orientation, this will be populated — shape: {orientation?: float, x?: float, y?: float}
  --auto-preemption: record # schedule to preempt ap’s which are not connected to preferred peer — shape: {day_of_week?: "any"|"mon"|"tue"|"wed"|"thu"|"fri"|"sat"|"sun", enabled?: bool, time_of_day?: string}
  --auto-upgrade: record # Auto Upgrade Settings — shape: {custom_versions?: record, day_of_week?: "any"|"mon"|"tue"|"wed"|"thu"|"fri"|"sat"|"sun"|"", enabled?: bool, time_of_day?: string, version?: "beta"|"stable"|"custom"}
  --ble-config: record # BLE AP settings — shape: {beacon_enabled?: bool, beacon_rate?: int, beacon_rate_mode?: "default"|"custom", beam_disabled?: list<int>, eddystone_uid_adv_power?: int, eddystone_uid_beams?: string, eddystone_uid_enabled?: bool, eddystone_uid_freq_msec?: int, eddystone_uid_instance?: string, eddystone_uid_namespace?: string, eddystone_url_adv_power?: int, eddystone_url_beams?: string, eddystone_url_enabled?: bool, eddystone_url_freq_msec?: int, eddystone_url_url?: string, ibeacon_adv_power?: int, ibeacon_beams?: string, ... (7 more fields)}
  --config-auto-revert: oneof<nothing, bool> # whether to enable ap auto config revert (default: false)
  --device-updown-threshold: int # sending AP_DISCONNECTED event in device-updowns only if AP_CONNECTED is not seen within the threshold, in minutes (default: 0)
  --dns-servers: list<string> # list of NTP servers
  --dns-suffix: list<string> # list of NTP servers
  --enable-channel-144: oneof<nothing, bool> # whether to enable channel 144 (some older clients may not support it) (default: false)
  --engagement: record # **Note**: if hours does not exist, it’s treated as everyday of the week, 00:00-23:59. Currently we don’t allow multiple ranges for the same day **Note**: default values for `dwell_tags`: passerby (1,300) bounce (301, 14400) engaged (14401, 28800) stationed (28801, 42000) **Note**: default values for `dwell_tag_names`: passerby = “Passerby”, bounce = “Visitor”, engaged = “Associates”, stationed = “Assets” — shape: {dwell_tag_names: record, dwell_tags?: record, hours?: record, max_dwell?: int, min_dwell?: int}
  --evpn-options: record # EVPN Options — shape: {core_as_border?: bool, overlay?: record, per_vlan_vga_v4_mac?: bool, routed_at?: "edge"|"core"|"distribution", underlay?: record}
  --flags: record # name/val pair objects for location engine to use
  --gateway-additional-config-cmds: list<string> # additional CLI commands to append to the generated config for gateways **Note**: no check is done
  --gateway-mgmt: record # Gateway Site settings — shape: {admin_sshkeys?: list<string>, app_probing?: record, app_usage?: bool, config_revert_timer?: float, probe_hosts?: list<string>, root_password?: string, security_log_source_address?: string, security_log_source_interface?: string}
  --led: record # LED AP settings — shape: {brightness?: int, enabled?: bool}
  --mxedge: record # site mist edges form a cluster of radsecproxy servers — shape: {mist_das?: record, radsec?: record}
  --mxedge-mgmt: record # shape: {mist_password?: string, root_password?: string}
  --mxtunnels: record # Site MxTunnel — shape: {ap_subnets?: list<string>, clusters?: list, hello_interval?: int, hello_retries?: int, hosts?: list<string>, mtu?: int, protocol?: "udp"|"ip", radsec?: record, vlan_ids?: list}
  --networks: record # the property key is the network name
  --ntp-servers: list<string> # list of NTP servers
  --occupancy: record # Occupancy Analytics settings — shape: {assets_enabled?: bool, clients_enabled?: bool, min_duration?: int, sdkclients_enabled?: bool, unconnected_clients_enabled?: bool}
  --ospf-areas: record # the property key is the OSPF area
  --persist-config-on-device: oneof<nothing, bool> # whether to store the config on AP (default: false)
  --port-usages: record # the property key is the port usage name — shape: {dynamic?: record}
  --proxy: record # Proxy Configuration for APs and Site Edges to talk to Mist — shape: {url?: string}
  --radio-config: record # Radio AP settings — shape: {allow_rrm_disable?: bool, ant_gain_24?: int, ant_gain_5?: int, ant_gain_6?: int, antenna_mode?: "default"|"1x1"|"2x2"|"3x3"|"4x4", band_24?: record, band_24_usage?: "24"|"5"|"auto", band_5?: record, band_5_on_24_radio?: record, band_6?: record, scanning_enabled?: bool}
  --radius-config: record # Junos Radius config — shape: {acct_interim_interval?: int, acct_servers?: list, auth_servers?: list, auth_servers_retries?: int, auth_servers_timeout?: int, coa_enabled?: bool, coa_port?: int, network?: string, source_ip?: string}
  --remote-syslog: record # shape: {archive?: record, console?: record, enabled?: bool, files?: list, network?: string, send_to_all_servers?: bool, servers?: list, time_format?: "millisecond"|"year"|"year millisecond", users?: list}
  --report-gatt: oneof<nothing, bool> # whether AP should periodically connect to BLE devices and report GATT device info (device name, manufacturer name, serial number, battery %, temperature, humidity) (default: false)
  --rogue: record # Rogue site settings — shape: {enabled?: bool, honeypot_enabled?: bool, min_duration?: int, min_rssi?: int, whitelisted_bssids?: list<string>, whitelisted_ssids?: list<string>}
  --rtsa: record # managed mobility — shape: {app_waking?: bool, disable_dead_reckoning?: bool, disable_pressure_sensor?: bool, enabled?: bool, track_asset?: bool}
  --simple-alert: record # Set of heuristic rules will be enabled when marvis subscription is not available. It triggers when, in a Z minute window, there are more than Y distinct client encountring over X failures — shape: {arp_failure?: record, dhcp_failure?: record, dns_failure?: record}
  --skyatp: record # shape: {enabled?: bool, send_ip_mac_mapping?: bool}
  --srx-app: record # shape: {enabled?: bool}
  --ssh-keys: list<string> # when limit_ssh_access = true in Org Setting, list of SSH public keys provided by Mist Support to install onto APs (see Org:Setting)
  --ssr: record # shape: {conductor_hosts?: list<string>, disable_stats?: bool}
  --status-portal: record # shape: {enabled?: bool, hostnames?: list<string>}
  --switch-matching: record # shape: {additional_config_cmds?: list<string>, enabled?: bool, rules?: list}
  --switch-mgmt: record # Switch site settings — shape: {ap_affinity_threshold?: int, config_revert_timer?: float, dhcp_option_fqdn?: bool, mxedge_proxy_host?: string, mxedge_proxy_port?: int, protect_re?: record, root_password?: string, use_mxedge_proxy?: bool}
  --track-anonymous-devices: oneof<nothing, bool> # whether to track anonymous BLE assets (requires ‘track_asset’ enabled) (default: false)
  --tunterm-monitoring: list # item shape: {host?: string, port?: int, protocol?: "arp"|"ping"|"tcp", timeout?: int}
  --tunterm-monitoring-disabled: oneof<nothing, bool>
  --vars: record
  --vna: record # shape: {enabled?: bool}
  --vrf-instances: record # the property key is the network name
  --vrrp-groups: record # the property key is the vrrp group
  --wan-vna: record # shape: {enabled?: bool}
  --wids: record # WIDS site settings — shape: {repeated_auth_failures?: record}
  --wifi: record # Wi-Fi site settings — shape: {cisco_enabled?: bool, disable_11k?: bool, disable_radios_when_power_constrained?: bool, enable_arp_spoof_check?: bool, enable_channel_144?: bool, enable_shared_radio_scanning?: bool, enable_vna?: bool, enabled?: bool, locate_connected?: bool, locate_unconnected?: bool, mesh_allow_dfs?: bool, mesh_enable_crm?: bool, mesh_enabled?: bool, mesh_psk?: string, mesh_ssid?: string, proxy_arp?: "default"|"enabled"|"disabled"}
  --wired-vna: record # shape: {enabled?: bool}
  --zone-occupancy-alert: record # Zone Occupancy alert site settings — shape: {email_notifiers?: list<string>, enabled?: bool, threshold?: int}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
