# Returns: record<auth: string, bg_image_url: string, cleanup_psk: bool, created_time: int, expire_time: int, expiry_notification_time: int, hide_psks_created_by_other_admins: bool, id: string, max_usage: int, modified_time: int, name: string, notify_expiry: bool, notify_on_create_or_edit: bool, org_id: string, passphrase_rules: record<alphaberts_enabled: bool, length: int, max_length: int, min_length: int, numerics_enabled: bool, symbols: string, symbols_enabled: bool>, required_fields: list<string>, role: string, ssid: string, sso: record<allowed_roles: list<string>, idp_cert: string, idp_sign_algo: string, idp_sso_url: string, issuer: string, nameid_format: string, role_mapping: record, use_sso_role_for_psk_role: bool>, template_url: string, thumbnail_url: string, type: string, vlan_id: int>
