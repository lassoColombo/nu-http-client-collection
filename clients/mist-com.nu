# searchMspOrgs
#
# GET /api/v1/msps/{msp_id}/orgs/search
# operationId: searchMspOrgs
export def "msps-orgs-search list" [
  msp_id: any
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --name: string # default: 
  --org-id: string # org id (format: uuid)
  --sub-insufficient: oneof<nothing, bool> # if this org has sufficient subscription
  --trial-enabled: oneof<nothing, bool> # if this org is under trial period
  --usage-types: list<string> # a list of types that enabled by usage
  --limit: int # default: 100
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "name" $name "scalar") (serialize-qp "org_id" $org_id "scalar") (serialize-qp "sub_insufficient" $sub_insufficient "scalar") (serialize-qp "trial_enabled" $trial_enabled "scalar") (serialize-qp "usage_types" $usage_types "multi") (serialize-qp "limit" $limit "scalar")] | flatten | str join "&"
  let full_url = (build-url $base ({msp_id: (encode-path-segment $msp_id)} | format pattern "/api/v1/msps/{msp_id}/orgs/search") $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json"
}

