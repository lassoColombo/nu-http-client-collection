  --expire-time: int # unit min
  --expiry-notification-time: int # Number of days before psk is expired. Used as to when to start sending reminder notification when the psk is about to expire
  --hide-psks-created-by-other-admins: oneof<nothing, bool> # only if `type`==`admin` (default: false)
