  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --anchor-mxtunnel-ids: list<string> # list of anchor mxtunnels used for forming edge to edge tunnels
  --auto-preemption: record # shape: {day_of_week?: "any"|"mon"|"tue"|"wed"|"thu"|"fri"|"sat"|"sun", enabled?: bool, time_of_day?: string}
  --hello-interval: int # in seconds, used as heartbeat to detect if a tunnel is alive. AP will try another peer after missing N hellos specified by `hello_retries`. (nullable, default: 60)
