  --does-wage-include-wajong: oneof<nothing, bool> # Indicates whether wage include Wajong benefits (affects payrolling). NL: LoonInclusiefWajong (e.g. false)
  --has-employee-loan: oneof<nothing, bool> # Whether an employee loan (Personeelslening) is applicable may be indicated here. The Personeelslening indirectly affects the income tax calculations. (e.g. false)
  --percentage-foreign-income: float # Indicates what percentage of the income of this employment is taxable outside the Netherlands. NL: PercentageBuitenlandsInkomen (nullable, format: double, e.g. 50)
