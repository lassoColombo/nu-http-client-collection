"post-workflow-trigger-mapping-by-employer-id" "get-provider-leave-policy-by-leave-policy-id" "get-provider-age-based-leave-by-leave-policy-id" "get-provider-wage-based-leave-by-leave-policy-id" "get-provider-years-of-service-based-leave-by-leave-policy-id" "get-notification-set-by-notification-set-id" "get-configured-external-tenant-by-provider-user-id" "patch-configured-external-tenant-by-provider-user-id" "get-applicationsets-by-provider-id" "post-application-set-by-provider-id" "get-authorizations-by-provider-id" "get-authorization-sets-by-provider-id" "get-billable-items-by-provider-id" "get-email-identities-by-provider-id" "post-email-identity-by-provider-id" "post-verify-email-identity-by-provider-id" "get-email-templates-by-provider-id" "get-email-template-by-provider-id-and-email-template-id" "post-employer-by-provider-id" "get-external-tenants-by-provider-id" "get-provider-leave-policies-by-provider-id" "get-provider-logo" "get-provider-logo-by-version" "get-notification-sets-by-provider-id" "get-payroll-process-status-by-provider-id" "get-qwoater-employers-by-user" "get-additional-taxliability-by-license-plate-number" "get-user-by-token" "put-user-by-token" "get-user-filter-settings-by-employer-id" "put-user-filter-settings-by-employer-id" "delete-user-photo-by-token" "get-user-photo-by-token" "post-user-photo-by-token" "delete-user-application-set-by-application-set-id" "put-user-application-set-by-application-set-id" "get-initiated-workflows-by-bearer-token" "get-integrations-by-bearer-token" "get-applicationsets-by-user-id" "post-application-set-by-user-id" "get-yourcampus-url-by-user-id" "get-cla-data-for-wage-projection-by-collective-labor-agreement-id" "get-collective-labor-agreements-by-user-id" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# list of insurance contracts
#
# GET /achmeainsurancecontracts
# Returns: record<currentPage: int, pageSize: int, totalPages: int, totalSize: int, version: record<obsoleteDate: string, resourceVersion: string>, messages: table<code: int, description: string, id: string, properties: list, type: string>, _embedded: table<belongsToEmployerId: string, contractNumber: string, endDate: string, id: string, startDate: string>>
# operationId: GetAchmeaInsuranceContractsByUserId
export def "get-achmea-insurance-contracts-by-user-id" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --filter: string # Filter the collection (e.g. cancellationPeriodTimeUnit.key eq 4)
  --order-by: string # Order the collection on one or more fields (e.g. -companyName,address.houseNumber)
  --page-number: int # Specifies which page should be returned (format: int32, default: 1, e.g. 2)
  --page-size: int # Specifies the number of objects per page (format: int32, default: 250, e.g. 20)
  --authorization: string # A valid Bearer token for authorizing the request. (required, e.g. Bearer <TOKEN>)
  --hdr-accept: string # The accept header is used to influence what type of output is returned and in most cases the version of the output (required, e.g. application/json;version=2018-01-01) (spec name: Accept)
]: nothing -> oneof<record, string, nothing> {
