# --temporaryTaxExemption shape: {key?: int}
# --typeOfEmployee shape: {key?: int}
# --typeOfParticipation shape: {key?: int}
# --vacationCoupons shape: {key?: int}
# --valueOfParticipation shape: {key?: int}
export def "providers-employers-employees-employments update" [
  employment_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --authorization: string # A valid Bearer token for authorizing the request. (e.g. Bearer <TOKEN>)
  --hdr-accept: string # The accept header is used to influence what type of output is returned and in most cases the version of the output (e.g. application/json;version=2018-01-01)
  --if-match: string # Input the value acquired in the ETag header for concurrency control. Please note this is optional (and not recommended for most types of integrations).
  --calculate-working-hours: oneof<nothing, bool> # Automatically calculate working hours for the employment if the option automatically calculate hours is selected for a given period. NL: Completeren/Berekenen uren (e.g. true)
  --cancellation-notice-date: string # The date on which the notice was given by either the employee or the employer. NL: DatumOpzegging (nullable, format: date, e.g. 2018-05-31)
  --cancellation-period-employee: int # The notice period an employee is required to give the employer when resigning. The unit of time that applies to this field is described in the noticePeriodTimeUnit property. NL: OpzegtermijnWerknemer (nullable, format: int32, e.g. 1)
  --cancellation-period-employer: int # The notice period an employer is required to give the employee when terminating the contract. The unit of time that applies to this field is described in the noticePeriodTimeUnit property. NL: OpzegtermijnWerkgever (nullable, format: int32, e.g. 1)
  --cancellation-period-time-unit: record # The unit of time used for the noticePeriodeEmployee and noticePeriodEmployer properties. NL: PeriodeOpzegTermijn (nullable, format: metadata) — shape: {key?: int}
  --commission-until-date: string # The date on which the employment will end. NL: AanstellingTot (nullable, format: date, e.g. 2019-01-01)
  --commission-until-date1: string # Until date for commision #1. NL: AanstellingTot1 (nullable, format: date, e.g. 2018-05-31)
  --commission-until-date2: string # Until date for commision #2. NL: AanstellingTot2 (nullable, format: date, e.g. 2018-05-31)
  --commission-until-date3: string # Until date for commision #3. NL: AanstellingTot3 (nullable, format: date, e.g. 2018-05-31)
  --commission-until-date4: string # Until date for commision #4. NL: AanstellingTot4 (nullable, format: date, e.g. 2018-05-31)
  --commission-until-date5: string # Until date for commision #5. NL: AanstellingTot5 (nullable, format: date, e.g. 2018-05-31)
  --commission-until-date6: string # Until date for commision #6. NL: AanstellingTot6 (nullable, format: date, e.g. 2018-05-31)
  --deviating-cla-external-party: int # CLA (CAO) code in case of a deviating CLA for external parties . NL: CaoKlantgroepAfwijkend (nullable, format: int32, e.g. 2)
  --deviating-cla-tax-return: int # CLA (CAO) code in case of a deviating CLA for tax returns. NL: CAOUWV (nullable, format: int32, e.g. 2)
  --email-leave-request: string # Recipient e-mail adress for notification in case of leave requests. NL: EmailVerlofaanvraag (nullable, e.g. api@loket.nl)
  --employee-profile-id: record # References to an employeeprofile that is specified in the payroll administration level. NL: WerknemerProfielID `employeeProfileId` is a metadata field within the payroll administration context. Possible values can be managed by the user. (nullable, format: metadata) — shape: {key?: int}
  --employment-contract-type: record # The type of employment applicable for the employment. NL: BasisDienstverband (nullable, format: metadata) — shape: {key?: int}
  --employment-duration-type: record # A selection of pre defined durations for the employment. NL: SoortDienstverband (format: metadata) — shape: {key?: int}
  --exemption-insurance-obligation: record # Indicates whether an exemption applies for the insurance obligation. If NULL than there is no exemption, thus insurance obligation applies in that case (verzekingsplicht). NL: CodeUitzondering (format: metadata) — shape: {key?: int}
  --exemption-premium-waiver-marginal-labour: oneof<nothing, bool> # Indicates whether an exemption (i.e. waiver) on the premium marginal labour (vrijstelling marginale arbeid) applies for this employment. NL: PremieVrijstellingMarginaleArbeid (e.g. false)
  --exemption-work-related-expense-scheme: oneof<nothing, bool> # Indicates whether an exemption (i.e. non-participation) on the work-related expense scheme (werkkostenregeling) applies for this employment. NL: WerkkostenRegelingUitsluiting (e.g. false)
  --has-on-call-appearance-obligation: oneof<nothing, bool> # In the case of an on-call employment this field indicates whether the employment has an appearance obligation. This field can be `null` in cases where it is unknown whether the employment has an appearance obligation. NL: SoortOproepkrachtOfInvalkracht (nullable, e.g. true)
  --historical-start-date: string # The historical date on which the employee was first employed. This field is used when an employee has multiple employments in time. In most cases this field should be used as the date on which the employee started working for the company. NL: HistorischeDatumInDienst (nullable, format: date, e.g. 2012-05-01)
  --income-relationship-number: int # The income relationship number that is required in the tax return. Together with the citizen service number (burgerservicenummer, BSN) and wage tax number, the income relationship number uniquely identifies an employment. NL: NummerInkomstenVerhouding (format: int32, e.g. 12)
  --is-anonymous-employee: oneof<nothing, bool> # An employee that wants to remain anonymous related to social security instances. NL: IsAnoniemeWerknemer (e.g. true)
  --is-director-and-major-shareholder: oneof<nothing, bool> # Indicates whether the employment can be classified as a director and major shareholder (Dutch: directeur-grootaandeelhouder or DGA). This field can be `null` in cases where it is unknown whether the employment can be classified as a director and major shareholder. NL: IsDirecteurGrootAandeelhouder (nullable, e.g. false)
  --is-family-of-owner: oneof<nothing, bool> # Indicates whether the employment can be classified as a previous owner. This field can be `null` in cases where it is unknown whether the employment can be classified as a director and major shareholder. NL: IsFamilieVanEigenaar (nullable, e.g. false)
  --is-gemoedsbezwaard-employee-insurance: oneof<nothing, bool> # Gemoedsbezwaard Werknemerverzekering. NL: IsGemoedsbezwaardWerknemerverzekering (e.g. true)
  --is-gemoedsbezwaard-national-insurance: oneof<nothing, bool> # Gemoedsbezwaard Volksverzekering. NL: IsGemoedsbezwaardVolksverzekering (e.g. true)
  --is-on-call-employment: oneof<nothing, bool> # Indicates whether the employment is an on-call employment. This field can be `null` in cases where it is unknown whether the employment is an on-call employment. NL: IsOproepkrachtOfInvalkracht (e.g. true)
  --is-previous-owner: oneof<nothing, bool> # Indicates whether the employment can be classified as a previous owner. This field can be `null` in cases where it is unknown whether the employment can be classified as a director and major shareholder. NL: IsVorigeEigenaar (nullable, e.g. false)
  --name-payslip: string # Name that is visible on payslips for the employment. NL: NaamLoonstrook (nullable, e.g. Steve Jobs)
  --participation55plus-regulation-uwv: oneof<nothing, bool> # Indicates whether the 55 plus regulation (55 plus regeling) is applicable for the employment. NL: Deelname55Plus (e.g. false)
  --period-pay-grade-adjustment: int # The values is used for two processes. First off, a message can be configured to notify the user(s) of a upcoming wage raise/negotiation based on the value of this field. Second, the value, in combination with `signalSalaryScaleAdjustment`, is used to signal a wage raises based on the `payScale` and ‘payGrade’. NL: PeriodeSalarisPeriodiek (nullable, format: int32, e.g. 2)
  --profession-code: int # A code field for a profession. This field only applies in case of a specific CLA (Bouw / Infra). Please leave empty if not applicable. NL: BeroepUWV (nullable, format: int32, e.g. 4)
  --send-to-external-party: record # Indicates whether payroll information of this employment is sent to external pension funds. Attention: this indication ONLY applies regarding the information to pension funds. If NULL then setting according to regulation is leading. NL: AanleveringExternePartij (nullable, format: metadata) — shape: {key?: int}
  --signal-pay-grade-adjustment: oneof<nothing, bool> # Indicates whether signaling regarding salary scale adjustments are enabled for the employment. NL: SalarisschaalSignaleren (e.g. false)
  --special-income-ratio: record # Indicates the special income ratio. NL: SpecialeInkomstenVerhouding (nullable, format: metadata) — shape: {key?: int}
  --start-cancellation-notice-period: string # The date on which the term of notice period starts. If the agrement states that a notice periode always starts on the first day of the month and the notice was given on the 15th the start notice periode will be the first day of the next month. NL: AanvangOpzegtermijn (nullable, format: date, e.g. 2018-06-01)
  --start-date-contract-of-indefinite-duration: string # When did the value of `employmentDurationType` change for definite to indefinite. NL: Startdatum onbepaalde tijd This value should be te samen as the `startDate` if the contract was indefinite from the start. (nullable, format: date, e.g. 2018-05-08)
  --temporary-tax-exemption: record # Indicates whether there a temporary tax exemption is to be applied for the employment. NL: TijdelijkeHeffingskorting (format: metadata) — shape: {key?: int}
  --type-of-employee: record # A selection of pre defined employee-types for the employment. NL: SoortWerknemer (format: metadata) — shape: {key?: int}
  --type-of-participation: record # The type of participation (aard van deelnemerschap) is only applicable in case the person related to this employment is eligible for pension (product required). NL: AardDeelnemerschap (nullable, format: metadata) — shape: {key?: int}
  --vacation-coupons: record # Indication for vacation coupons (vakantiebonnen). This is only applies to a limited set of CLA`s. NL: Vakantiebonnen (nullable, format: metadata) — shape: {key?: int}
  --value-of-participation: record # The value of participation (waarde van deelnemerschap) is only applicable in case the person related to this employment is eligible for pension (product required). NL: WaardeDeelnemerschap (nullable, format: metadata) — shape: {key?: int}
  --wachtgeld-old-regulation: oneof<nothing, bool> # Indicates whether the (old) wachtgeld regulation is applicable for the employment. NL: WachtgeldOudeRegeling (e.g. false)
  --written-employment-contract: oneof<nothing, bool> # Did the employment and employer make a written contract? NL: Schriftelijke overeenkomst (e.g. true)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
