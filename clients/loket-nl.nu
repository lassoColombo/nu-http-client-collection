# --accidentType shape: {key?: int}
# --actionToBeTakenByOccupationalHealthAndSafetyService shape: {key?: int}
# --caseManager shape: {function?: string, name?: string, organization?: string, phoneNumber?: string}
# --causeOfAbsence shape: {key?: int}
# --contactInformation shape: {city: string, country: record, endDate?: string, furtherIndication?: record, houseNumber: int, houseNumberAddition?: string, locationType?: record, name?: string, phoneNumber?: string, postalCode: string, startDate: string, street: string}
# --expectedDuration shape: {key?: int}
# --progress shape: {currentIncapacityPercentage?: int, startDate?: string}
# --reintegration shape: {dateOfFinalizingPlanOfAction?: string, reintegrationGoal?: record}
export def "providers-employers-employees-absences create" [
  employee_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --authorization: string # A valid Bearer token for authorizing the request. (e.g. Bearer <TOKEN>)
  --hdr-accept: string # The accept header is used to influence what type of output is returned and in most cases the version of the output (e.g. application/json;version=2018-01-01)
  --accident-type: record # The type of accident that led to the absence. This field will be NULL if the absence is not related to an accident. (nullable, format: metadata) — shape: {key?: int}
  --action-to-be-taken-by-occupational-health-and-safety-service: record # The desired action to be taken regarding the absence by the occupational health and safety service (arbodienst). (format: metadata) — shape: {key?: int}
  --case-manager: record # nullable — shape: {function?: string, name?: string, organization?: string, phoneNumber?: string}
  --cause-of-absence: record # The cause of the absence. This endpoint is intended for the registration of two types of absence: 1) Illness/sickness 2) "Vangnet" such as maternity leave, organ donation or adoption leave Other absences such as Vacation days, unpayed leave and Personal leave are registerd using the leave endpoint (format: metadata) — shape: {key?: int}
  --comments: string # Free text field to register any relevant information. (nullable, e.g. Lorem ipsum dolor sit amet, id nibh adhuc omnium vix, ne nec eius inani aliquip.)
  --contact-information: record # nullable — shape: {city: string, country: record, endDate?: string, furtherIndication?: record, houseNumber: int, houseNumberAddition?: string, locationType?: record, name?: string, phoneNumber?: string, postalCode: string, startDate: string, street: string}
  --expected-date-of-childbirth: string # Bevallingsdatum (nullable, format: date, e.g. 2018-01-21)
  --expected-duration: record # The expected duration of the absence. If the expected duration is unknown, this field will be NULL. (nullable, format: metadata) — shape: {key?: int}
  --expected-end-date-of-maternity-leave: string # verwachte datum einde zwangerschapsverlof (nullable, format: date, e.g. 2018-04-21)
  --has-mobility-issue: oneof<nothing, bool> # This field indicates whether the Employee has an issue limiting its mobility. (nullable, e.g. false)
  --hours-worked-on-first-day-of-absence: int # The number of hours worked on the first day of the absence. (nullable, e.g. 3)
  --is-disrupted-employment-relationship: oneof<nothing, bool> # Indicates whether the employement relationship between employee and employer is disrupted. (e.g. true)
  --is-hospitalised: oneof<nothing, bool> # Betreft het een ziekenhuisopnamen (nullable, e.g. false)
  --is-recovered-within-two-weeks: oneof<nothing, bool> # This field indicates whether the Employee is (expected) recoverd within two weeks, relating to a full recovery. (e.g. false)
  --is-third-party-liability: oneof<nothing, bool> # This field is related to `accidentType`. When `accidentType` is specified, this field indicates whether a third party is liable for the accident. (nullable, e.g. false)
  --is-work-related-illness: oneof<nothing, bool> # Beroepsziekte (e.g. false)
  --progress: record # shape: {currentIncapacityPercentage?: int, startDate?: string}
  --reintegration: record # nullable — shape: {dateOfFinalizingPlanOfAction?: string, reintegrationGoal?: record}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($employee_id | is-empty) { error make --unspanned { msg: "path parameter 'employeeId' must be non-empty" } }
  let full_url = (build-url $base ({employee_id: (encode-path-segment $employee_id)} | format pattern "/providers/employers/employees/{employee_id}/absences"))
  let req_body = {"accidentType": $accident_type, "actionToBeTakenByOccupationalHealthAndSafetyService": $action_to_be_taken_by_occupational_health_and_safety_service, "caseManager": $case_manager, "causeOfAbsence": $cause_of_absence, "comments": $comments, "contactInformation": $contact_information, "expectedDateOfChildbirth": $expected_date_of_childbirth, "expectedDuration": $expected_duration, "expectedEndDateOfMaternityLeave": $expected_end_date_of_maternity_leave, "hasMobilityIssue": $has_mobility_issue, "hoursWorkedOnFirstDayOfAbsence": $hours_worked_on_first_day_of_absence, "isDisruptedEmploymentRelationship": $is_disrupted_employment_relationship, "isHospitalised": $is_hospitalised, "isRecoveredWithinTwoWeeks": $is_recovered_within_two_weeks, "isThirdPartyLiability": $is_third_party_liability, "isWorkRelatedIllness": $is_work_related_illness, "progress": $progress, "reintegration": $reintegration} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json;version=2020-03-16"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let extra_headers = {"Authorization": $authorization, "Accept": $hdr_accept} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json;version=2020-03-16" $req_body {query: {}, body: $req_body}
}

