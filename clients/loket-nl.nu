  --cost-center: record # The cost center on which the payroll period data for this record will be booked for the ledger. `costCenter` is a metadata field within the payroll administration context. Possible values can be managed by the user. (nullable, format: metadata) — shape: {key?: int}
  --cost-unit: record # The cost unit on which the data for this record will be booked for the ledger `costUnit` is a metadata field within the payroll administration context. Possible values can be managed by the user. (nullable, format: metadata) — shape: {key?: int}
  --distribution-unit: record # Distribution unit, used in several reports and the "basic wage journal" functionality. Commonly used as a cost center. `distributionUnit` is a metadata field within the employer context. Possible values can be managed by the user. (format: metadata) — shape: {key?: string}
  --payroll-components: list # item shape: {isSupplement?: bool, payrollComponent?: record, value?: float}
  --payroll-period: record # format: metadata — shape: {periodNumber?: int, year?: int}
  --payslip-text: string # A custom text to be displayed on the payslip. (nullable, e.g. Additional payslip for bonus)
  --payslip-type: record # The type of payslip (as defined by the Dutch tax authorities) (format: metadata) — shape: {key?: int}
  --shift: record # The shift determines the full-time hours and bonus percentage. `shift` is a metadata field within the payroll administration context. Possible values can be managed by the user. (format: metadata) — shape: {shiftNumber?: int}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($employment_id | is-empty) { error make --unspanned { msg: "path parameter 'employmentId' must be non-empty" } }
  let full_url = (build-url $base ({employment_id: (encode-path-segment $employment_id)} | format pattern "/providers/employers/employees/employments/{employment_id}/payrollperioddata"))
  let req_body = {"costCenter": $cost_center, "costUnit": $cost_unit, "distributionUnit": $distribution_unit, "payrollComponents": $payroll_components, "payrollPeriod": $payroll_period, "payslipText": $payslip_text, "payslipType": $payslip_type, "shift": $shift} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json;version=2018-01-01"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let extra_headers = {"Authorization": $authorization, "Accept": $hdr_accept} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  do-request "post" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json;version=2018-01-01" $req_body {query: {}, body: $req_body}
