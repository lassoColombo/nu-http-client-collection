  --filter: string # Filter the collection (e.g. cancellationPeriodTimeUnit.key eq 4)
  --order-by: string # Order the collection on one or more fields (e.g. -companyName,address.houseNumber)
  --page-number: int # Specifies which page should be returned (format: int32, default: 1, e.g. 2)
