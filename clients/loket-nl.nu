  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --authorization: string # A valid Bearer token for authorizing the request. (e.g. Bearer <TOKEN>)
  --hdr-accept: string # The accept header is used to influence what type of output is returned and in most cases the version of the output (e.g. application/json;version=2018-01-01)
  --if-match: string # Input the value acquired in the ETag header for concurrency control. Please note this is optional (and not recommended for most types of integrations).
  --brand: string # Brand of the vehicle. (nullable, e.g. Volvo)
  --catalog-value: float # The catalog value of the car. (nullable, format: double, e.g. 20000)
  --comments: string # Any comments on the car or the contract. (nullable, e.g. This car is very nice)
  --end-date: string # The end date of the entity. The date is up to and including. (nullable, format: date, e.g. 2023-10-23)
  --fuel-card-number: string # Registration number of the fuel card. (nullable, e.g. B100.323.903)
  --kilometers-private-use: int # The number kilometers per year the employee can use the car for private purposes. (nullable, format: int32, e.g. 10000)
  --lease: record # Details of the leasecontract (nullable) — shape: {contractNumber?: string, endDate?: string, startDate?: string}
  --lease-or-buy: record # Indication of the ownership of the company car. (format: metaData) — shape: {key?: int}
  --license-plate-number: string # Vehicle registration number (license plate) of the company car. The number should be provided with or without any hyphens (-). (e.g. GP586D)
  --model: string # Model of the vehicle. (nullable, e.g. V60)
  --start-date: string # The start date of the entity. (format: date, e.g. 2021-01-01)
  --supplier: string # Name of the company the delivered the company car. (nullable, e.g. Leasemaatschappij Tilburg)
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($company_car_id | is-empty) { error make --unspanned { msg: "path parameter 'companyCarId' must be non-empty" } }
  let full_url = (build-url $base ({company_car_id: (encode-path-segment $company_car_id)} | format pattern "/providers/employers/employees/employments/companycars/{company_car_id}"))
  let req_body = {"brand": $brand, "catalogValue": $catalog_value, "comments": $comments, "endDate": $end_date, "fuelCardNumber": $fuel_card_number, "kilometersPrivateUse": $kilometers_private_use, "lease": $lease, "leaseOrBuy": $lease_or_buy, "licensePlateNumber": $license_plate_number, "model": $model, "startDate": $start_date, "supplier": $supplier} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json;version=2018-01-01"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let extra_headers = {"Authorization": $authorization, "Accept": $hdr_accept, "If-Match": $if_match} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json;version=2018-01-01" $req_body {query: {}, body: $req_body}
}

