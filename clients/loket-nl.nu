# Insert or update payroll period data
#
# PATCH /providers/employers/employees/employments/{employmentId}/payrollperioddata
# operationId: PatchPayrollPeriodDataByEmploymentId
# --costCenter shape: {key?: int}
# --costUnit shape: {key?: int}
# --distributionUnit shape: {key?: string}
# --payrollComponents item shape: {isSupplement?: bool, payrollComponent?: record, value?: float}
# --payrollPeriod shape: {periodNumber?: int, year?: int}
# --payslipType shape: {key?: int}
# --shift shape: {shiftNumber?: int}
export def "providers-employers-employees-employments-payrollperioddata update-payroll-period-data" [
  employment_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --filter: string # Filter the collection (e.g. cancellationPeriodTimeUnit.key eq 4)
  --order-by: string # Order the collection on one or more fields (e.g. -companyName,address.houseNumber)
  --page-number: int # Specifies which page should be returned (format: int32, default: 1, e.g. 2)
  --page-size: int # Specifies the number of objects per page (format: int32, default: 250, e.g. 20)
  --authorization: string # A valid Bearer token for authorizing the request. (e.g. Bearer <TOKEN>)
  --hdr-accept: string # The accept header is used to influence what type of output is returned and in most cases the version of the output (e.g. application/json;version=2018-01-01)
  --cost-center: record # The cost center on which the payroll period data for this record will be booked for the ledger. (nullable, format: metadata) — shape: {key?: int}
  --cost-unit: record # The cost unit on which the data for this record will be booked for the ledger (nullable, format: metadata) — shape: {key?: int}
  --distribution-unit: record # Distribution unit (verdelingseenheid), used in several reports and the "basic wage journal" functionality. Commonly used as a cost center. (format: metadata) — shape: {key?: string}
  --payroll-components: list # item shape: {isSupplement?: bool, payrollComponent?: record, value?: float}
  --payroll-period: record # format: metadata — shape: {periodNumber?: int, year?: int}
  --payslip-text: string # A custom text to be displayed on the payslip. (nullable, e.g. Additional payslip for bonus)
  --payslip-type: record # The type of payslip (as defined by the Dutch tax authorities) (format: metadata) — shape: {key?: int}
  --shift: record # The shift determines the full-time hours and bonus percentage. (format: metadata) — shape: {shiftNumber?: int}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  if ($employment_id | is-empty) { error make --unspanned { msg: "path parameter 'employmentId' must be non-empty" } }
  let qp = [(serialize-qp "filter" $filter "scalar") (serialize-qp "orderBy" $order_by "scalar") (serialize-qp "pageNumber" $page_number "scalar") (serialize-qp "pageSize" $page_size "scalar")] | flatten | str join "&"
  let full_url = (build-url $base ({employment_id: (encode-path-segment $employment_id)} | format pattern "/providers/employers/employees/employments/{employment_id}/payrollperioddata") $qp)
  let req_body = {"costCenter": $cost_center, "costUnit": $cost_unit, "distributionUnit": $distribution_unit, "payrollComponents": $payroll_components, "payrollPeriod": $payroll_period, "payslipText": $payslip_text, "payslipType": $payslip_type, "shift": $shift} | compact
  let req_body = if ($input | describe | str starts-with "record") { $input | merge deep ($req_body | default {}) } else { $req_body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let extra_headers = {"Authorization": $authorization, "Accept": $hdr_accept} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  do-request "patch" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors $full "application/json;version=2018-01-01" $req_body {query: ({"filter": $filter, "orderBy": $order_by, "pageNumber": $page_number, "pageSize": $page_size} | compact), body: $req_body}
}

