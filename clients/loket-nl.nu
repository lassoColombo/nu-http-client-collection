  --batch-booking: string@batch-booking-completer # Determines whether the Batch Booking \<BtchBookg\> tag is included in the SEPA file and if it is which value it is set to. By defualt this value is set to Exclude. Possible values for this parameter are: - Exclude: Do not include \<BtchBookg\> tag in SEPA file - IncludeTrue: Include \<BtchBookg\> tag in SEPA file and set it to 'True' - IncludeFalse: Include \<BtchBookg\> tag in SEPA file and set it to 'False' (default: BtchBookgExclude)
  --requested-execution-date: string # This value is used when creating the sepa file to set the value of \<ReqdExctnDt\> (format: date)
