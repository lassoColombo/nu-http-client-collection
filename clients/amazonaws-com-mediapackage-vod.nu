# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    configure-logs: "record<Arn: string, Authorization: record<CdnIdentifierSecret: string, SecretsRoleArn: string>, CreatedAt: string, DomainName: string, EgressAccessLogs: record<LogGroupName: string>, Id: string, Tags: record>"
    create-asset: "record<Arn: string, CreatedAt: string, EgressEndpoints: table<PackagingConfigurationId: string, Status: string, Url: string>, Id: string, PackagingGroupId: string, ResourceId: string, SourceArn: string, SourceRoleArn: string, Tags: record>"
    list-assets: "record<Assets: table<Arn: string, CreatedAt: string, Id: string, PackagingGroupId: string, ResourceId: string, SourceArn: string, SourceRoleArn: string, Tags: record>, NextToken: string>"
    create-packaging-configuration: "record<Arn: string, CmafPackage: record<Encryption: record<ConstantInitializationVector: string, SpekeKeyProvider: record>, HlsManifests: list<record>, IncludeEncoderConfigurationInSegments: bool, SegmentDurationSeconds: int>, CreatedAt: string, DashPackage: record<DashManifests: list<record>, Encryption: record<SpekeKeyProvider: record>, IncludeEncoderConfigurationInSegments: bool, IncludeIframeOnlyStream: bool, PeriodTriggers: list<string>, SegmentDurationSeconds: int, SegmentTemplateFormat: string>, HlsPackage: record<Encryption: record<ConstantInitializationVector: string, EncryptionMethod: string, SpekeKeyProvider: record>, HlsManifests: list<record>, IncludeDvbSubtitles: bool, SegmentDurationSeconds: int, UseAudioRenditionGroup: bool>, Id: string, MssPackage: record<Encryption: record<SpekeKeyProvider: record>, MssManifests: list<record>, SegmentDurationSeconds: int>, PackagingGroupId: string, Tags: record>"
    list-packaging-configurations: "record<NextToken: string, PackagingConfigurations: table<Arn: string, CmafPackage: record, CreatedAt: string, DashPackage: record, HlsPackage: record, Id: string, MssPackage: record, PackagingGroupId: string, Tags: record>>"
    create-packaging-group: "record<Arn: string, Authorization: record<CdnIdentifierSecret: string, SecretsRoleArn: string>, CreatedAt: string, DomainName: string, EgressAccessLogs: record<LogGroupName: string>, Id: string, Tags: record>"
    list-packaging-groups: "record<NextToken: string, PackagingGroups: table<ApproximateAssetCount: int, Arn: string, Authorization: record, CreatedAt: string, DomainName: string, EgressAccessLogs: record, Id: string, Tags: record>>"
    delete-asset: "record"
    describe-asset: "record<Arn: string, CreatedAt: string, EgressEndpoints: table<PackagingConfigurationId: string, Status: string, Url: string>, Id: string, PackagingGroupId: string, ResourceId: string, SourceArn: string, SourceRoleArn: string, Tags: record>"
    delete-packaging-configuration: "record"
    describe-packaging-configuration: "record<Arn: string, CmafPackage: record<Encryption: record<ConstantInitializationVector: string, SpekeKeyProvider: record>, HlsManifests: list<record>, IncludeEncoderConfigurationInSegments: bool, SegmentDurationSeconds: int>, CreatedAt: string, DashPackage: record<DashManifests: list<record>, Encryption: record<SpekeKeyProvider: record>, IncludeEncoderConfigurationInSegments: bool, IncludeIframeOnlyStream: bool, PeriodTriggers: list<string>, SegmentDurationSeconds: int, SegmentTemplateFormat: string>, HlsPackage: record<Encryption: record<ConstantInitializationVector: string, EncryptionMethod: string, SpekeKeyProvider: record>, HlsManifests: list<record>, IncludeDvbSubtitles: bool, SegmentDurationSeconds: int, UseAudioRenditionGroup: bool>, Id: string, MssPackage: record<Encryption: record<SpekeKeyProvider: record>, MssManifests: list<record>, SegmentDurationSeconds: int>, PackagingGroupId: string, Tags: record>"
    delete-packaging-group: "record"
    describe-packaging-group: "record<ApproximateAssetCount: int, Arn: string, Authorization: record<CdnIdentifierSecret: string, SecretsRoleArn: string>, CreatedAt: string, DomainName: string, EgressAccessLogs: record<LogGroupName: string>, Id: string, Tags: record>"
    update-packaging-group: "record<ApproximateAssetCount: int, Arn: string, Authorization: record<CdnIdentifierSecret: string, SecretsRoleArn: string>, CreatedAt: string, DomainName: string, EgressAccessLogs: record<LogGroupName: string>, Id: string, Tags: record>"
    list-tags-for-resource: "record<Tags: record>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["configure-logs" "create-asset" "list-assets" "create-packaging-configuration" "list-packaging-configurations" "create-packaging-group" "list-packaging-groups" "delete-asset" "describe-asset" "delete-packaging-configuration" "describe-packaging-configuration" "delete-packaging-group" "describe-packaging-group" "update-packaging-group" "list-tags-for-resource" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

