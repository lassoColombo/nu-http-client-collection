# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cancel-journal-kinesis-stream: "record<StreamId: string>"
    describe-journal-kinesis-stream: "record<Stream: record<LedgerName: string, CreationTime: string, InclusiveStartTime: string, ExclusiveEndTime: string, RoleArn: string, StreamId: string, Arn: string, Status: string, KinesisConfiguration: record<StreamArn: string, AggregationEnabled: bool>, ErrorCause: string, StreamName: string>>"
    create-ledger: "record<Name: string, Arn: string, State: string, CreationDateTime: string, PermissionsMode: string, DeletionProtection: bool, KmsKeyArn: string>"
    list-ledgers: "record<Ledgers: table<Name: string, State: string, CreationDateTime: string>, NextToken: string>"
    describe-ledger: "record<Name: string, Arn: string, State: string, CreationDateTime: string, PermissionsMode: string, DeletionProtection: bool, EncryptionDescription: record<KmsKeyArn: string, EncryptionStatus: string, InaccessibleKmsKeyDateTime: string>>"
    update-ledger: "record<Name: string, Arn: string, State: string, CreationDateTime: string, DeletionProtection: bool, EncryptionDescription: record<KmsKeyArn: string, EncryptionStatus: string, InaccessibleKmsKeyDateTime: string>>"
    describe-journal-s3-export: "record<ExportDescription: record<LedgerName: string, ExportId: string, ExportCreationTime: string, Status: string, InclusiveStartTime: string, ExclusiveEndTime: string, S3ExportConfiguration: record<Bucket: string, Prefix: string, EncryptionConfiguration: record>, RoleArn: string, OutputFormat: string>>"
    export-journal-to-s3: "record<ExportId: string>"
    list-journal-s3-exports-for-ledger: "record<JournalS3Exports: table<LedgerName: string, ExportId: string, ExportCreationTime: string, Status: string, InclusiveStartTime: string, ExclusiveEndTime: string, S3ExportConfiguration: record, RoleArn: string, OutputFormat: string>, NextToken: string>"
    get-block: "record<Block: record<IonText: string>, Proof: record<IonText: string>>"
    get-digest: "record<Digest: string, DigestTipAddress: record<IonText: string>>"
    get-revision: "record<Proof: record<IonText: string>, Revision: record<IonText: string>>"
    list-journal-kinesis-streams-for-ledger: "record<Streams: table<LedgerName: string, CreationTime: string, InclusiveStartTime: string, ExclusiveEndTime: string, RoleArn: string, StreamId: string, Arn: string, Status: string, KinesisConfiguration: record, ErrorCause: string, StreamName: string>, NextToken: string>"
    stream-journal-to-kinesis: "record<StreamId: string>"
    list-journal-s3-exports: "record<JournalS3Exports: table<LedgerName: string, ExportId: string, ExportCreationTime: string, Status: string, InclusiveStartTime: string, ExclusiveEndTime: string, S3ExportConfiguration: record, RoleArn: string, OutputFormat: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    untag-resource: "record"
    update-ledger-permissions-mode: "record<Name: string, Arn: string, PermissionsMode: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["cancel-journal-kinesis-stream" "describe-journal-kinesis-stream" "create-ledger" "list-ledgers" "delete-ledger" "describe-ledger" "update-ledger" "describe-journal-s3-export" "export-journal-to-s3" "list-journal-s3-exports-for-ledger" "get-block" "get-digest" "get-revision" "list-journal-kinesis-streams-for-ledger" "stream-journal-to-kinesis" "list-journal-s3-exports" "list-tags-for-resource" "tag-resource" "untag-resource" "update-ledger-permissions-mode" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Ends a given Amazon QLDB journal stream. Before a stream can be canceled, its current status must be ACTIVE. You can't restart a stream after you cancel it. Canceled QLDB stream resources are subject to a 7-day retention period, so they are automatically deleted after this limit expires.
#
# DELETE /ledgers/{name}/journal-kinesis-streams/{streamId}
# Returns: record<StreamId: string>
