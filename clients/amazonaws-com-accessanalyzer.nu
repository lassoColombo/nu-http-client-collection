# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cancel-policy-generation: "record"
    get-generated-policy: "record<jobDetails: record<jobId: string, status: string, startedOn: string, completedOn: string, jobError: record<code: string, message: string>>, generatedPolicyResult: record<properties: any, generatedPolicies: list<record>>>"
    create-access-preview: "record<id: string>"
    create-analyzer: "record<arn: string>"
    list-analyzers: "record<analyzers: table<arn: string, name: string, type: string, createdAt: string, lastResourceAnalyzed: string, lastResourceAnalyzedAt: string, tags: record, status: string, statusReason: record>, nextToken: string>"
    list-archive-rules: "record<archiveRules: table<ruleName: string, filter: record, createdAt: string, updatedAt: string>, nextToken: string>"
    get-analyzer: "record<analyzer: record<arn: string, name: string, type: string, createdAt: string, lastResourceAnalyzed: string, lastResourceAnalyzedAt: string, tags: record, status: string, statusReason: record<code: string>>>"
    get-archive-rule: "record<archiveRule: record<ruleName: string, filter: record, createdAt: string, updatedAt: string>>"
    get-access-preview: "record<accessPreview: record<id: string, analyzerArn: string, configurations: record, createdAt: string, status: string, statusReason: record<code: string>>>"
    get-analyzed-resource: "record<resource: record<resourceArn: string, resourceType: string, createdAt: string, analyzedAt: string, updatedAt: string, isPublic: bool, actions: list<string>, sharedVia: list<string>, status: string, resourceOwnerAccount: string, error: string>>"
    get-finding: "record<finding: record<id: string, principal: record, action: list<string>, resource: string, isPublic: bool, resourceType: string, condition: record, createdAt: string, analyzedAt: string, updatedAt: string, status: string, resourceOwnerAccount: string, error: string, sources: list<record>>>"
    list-access-preview-findings: "record<findings: table<id: string, existingFindingId: string, existingFindingStatus: string, principal: record, action: list, condition: record, resource: string, isPublic: bool, resourceType: string, createdAt: string, changeType: string, status: string, resourceOwnerAccount: string, error: string, sources: list>, nextToken: string>"
    list-access-previews: "record<accessPreviews: table<id: string, analyzerArn: string, createdAt: string, status: string, statusReason: record>, nextToken: string>"
    list-analyzed-resources: "record<analyzedResources: table<resourceArn: string, resourceOwnerAccount: string, resourceType: string>, nextToken: string>"
    list-findings: "record<findings: table<id: string, principal: record, action: list, resource: string, isPublic: bool, resourceType: string, condition: record, createdAt: string, analyzedAt: string, updatedAt: string, status: string, resourceOwnerAccount: string, error: string, sources: list>, nextToken: string>"
    list-policy-generations: "record<policyGenerations: table<jobId: string, principalArn: string, status: string, startedOn: string, completedOn: string>, nextToken: string>"
    start-policy-generation: "record<jobId: string>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    untag-resource: "record"
    validate-policy: "record<findings: table<findingDetails: string, findingType: string, issueCode: string, learnMoreLink: string, locations: list>, nextToken: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["apply-archive-rule" "cancel-policy-generation" "get-generated-policy" "create-access-preview" "create-analyzer" "list-analyzers" "create-archive-rule" "list-archive-rules" "delete-analyzer" "get-analyzer" "delete-archive-rule" "get-archive-rule" "update-archive-rule" "get-access-preview" "get-analyzed-resource" "get-finding" "list-access-preview-findings" "list-access-previews" "list-analyzed-resources" "list-findings" "update-findings" "list-policy-generations" "start-policy-generation" "list-tags-for-resource" "tag-resource" "start-resource-scan" "untag-resource" "validate-policy" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Retroactively applies the archive rule to existing findings that meet the archive rule criteria.
#
# PUT /archive-rule
# operationId: ApplyArchiveRule
export def "apply-archive-rule" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  analyzer_arn: string # The Amazon resource name (ARN) of the analyzer.
  rule_name: string # The name of the rule to apply.
  --client-token: string # A client token.
]: any -> any {
  $in | http-request {
    method: put
    path: "/archive-rule"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: analyzerArn, var: analyzer_arn}, {name: ruleName, var: rule_name}, {name: clientToken, var: client_token}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, analyzer_arn: $analyzer_arn, rule_name: $rule_name, client_token: $client_token
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

