    season-upcoming: "int"
    week-upcoming: "int"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["legacy-box-scores-active" "teams-all" "are-games-in-progress" "legacy-box-score" "box-score-by-scoreid-v" "box-score-v" "legacy-box-scores" "legacy-box-scores-delta" "box-scores-delta-v" "bye-weeks" "season-current" "week-current" "daily-fantasy-players" "daily-fantasy-scoring" "dfs-slates-by-date" "dfs-slates-by-week" "fantasy-defense-game-stats" "fantasy-defense-game-stats-by-team" "fantasy-defense-season-stats" "fantasy-defense-season-stats-by-team" "fantasy-players-with-adp" "idp-fantasy-players-with-adp" "legacy-box-scores-final" "player-details-by-free-agents" "league-leaders-by-week" "game-stats-by-season-deprecated-use-team-game-stats-instead" "game-stats-by-week-deprecated-use-team-game-stats-instead" "injuries" "injuries-by-team" "season-last-completed" "week-last-completed" "legacy-box-scores-live" "news" "news-by-date" "news-by-player" "news-by-team" "player-details-by-player" "player-game-red-zone-stats-inside-five" "player-game-red-zone-stats-inside-ten" "player-game-red-zone-stats" "player-game-stats-by-player" "player-game-logs-by-season" "player-game-stats-by-team" "player-game-stats-by-week" "player-game-stats-by-week-delta" "player-game-stats-delta" "fantasy-player-ownership-percentages-season-long" "player-season-red-zone-stats-inside-five" "player-season-red-zone-stats-inside-ten" "player-season-red-zone-stats" "player-season-stats" "player-season-stats-by-player" "player-season-stats-by-team" "player-season-third-down-stats" "player-details-by-available" "player-details-by-team" "pro-bowlers" "legacy-box-scores-delta-current-week" "player-details-by-rookie-draft-year" "schedule" "scores-by-season" "scores-by-date" "scores-by-week" "league-leaders-by-season" "box-scores-v-simulation" "scores-by-week-simulation" "stadiums" "standings" "team-game-stats" "team-game-logs-by-season" "team-season-stats" "teams-active" "teams-by-season" "timeframes" "season-upcoming" "week-upcoming" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

