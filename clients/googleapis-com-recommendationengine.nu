    body: {content_type: "application/json", kind: json, fields: [{name: eventDetail, var: event_detail}, {name: eventSource, var: event_source}, {name: eventTime, var: event_time}, {name: eventType, var: event_type}, {name: productEventDetail, var: product_event_detail}, {name: userInfo, var: user_info}]}
