  let full_url = (build-url $base ({name: (encode-path-segment $name)} | format pattern "/v2alpha1/{name}") $qp $auth.query)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  let req = {
