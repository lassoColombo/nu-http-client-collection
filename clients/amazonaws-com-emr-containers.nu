# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    cancel-job-run: "record<id: string, virtualClusterId: string>"
    describe-job-run: "record<jobRun: record<id: string, name: string, virtualClusterId: string, arn: string, state: string, clientToken: string, executionRoleArn: string, releaseLabel: string, configurationOverrides: record<applicationConfiguration: list, monitoringConfiguration: record>, jobDriver: record<sparkSubmitJobDriver: record, sparkSqlJobDriver: record>, createdAt: string, createdBy: string, finishedAt: string, stateDetails: string, failureReason: string, tags: record, retryPolicyConfiguration: record<maxAttempts: int>, retryPolicyExecution: record<currentAttemptCount: int>>>"
    create-job-template: "record<id: string, name: string, arn: string, createdAt: string>"
    list-job-templates: "record<templates: table<name: string, id: string, arn: string, createdAt: string, createdBy: string, tags: record, jobTemplateData: record, kmsKeyArn: string, decryptionError: string>, nextToken: string>"
    create-managed-endpoint: "record<id: string, name: string, arn: string, virtualClusterId: string>"
    list-managed-endpoints: "record<endpoints: table<id: string, name: string, arn: string, virtualClusterId: string, type: string, state: string, releaseLabel: string, executionRoleArn: string, certificateArn: string, certificateAuthority: record, configurationOverrides: record, serverUrl: string, createdAt: string, securityGroup: string, subnetIds: list, stateDetails: string, failureReason: string, tags: record>, nextToken: string>"
    create-virtual-cluster: "record<id: string, name: string, arn: string>"
    list-virtual-clusters: "record<virtualClusters: table<id: string, name: string, arn: string, state: string, containerProvider: record, createdAt: string, tags: record>, nextToken: string>"
    delete-job-template: "record<id: string>"
    describe-job-template: "record<jobTemplate: record<name: string, id: string, arn: string, createdAt: string, createdBy: string, tags: record, jobTemplateData: record<executionRoleArn: string, releaseLabel: string, configurationOverrides: record, jobDriver: record, parameterConfiguration: record, jobTags: record>, kmsKeyArn: string, decryptionError: string>>"
    delete-managed-endpoint: "record<id: string, virtualClusterId: string>"
    describe-managed-endpoint: "record<endpoint: record<id: string, name: string, arn: string, virtualClusterId: string, type: string, state: string, releaseLabel: string, executionRoleArn: string, certificateArn: string, certificateAuthority: record<certificateArn: string, certificateData: string>, configurationOverrides: record<applicationConfiguration: list, monitoringConfiguration: record>, serverUrl: string, createdAt: string, securityGroup: string, subnetIds: list<string>, stateDetails: string, failureReason: string, tags: record>>"
    delete-virtual-cluster: "record<id: string>"
    describe-virtual-cluster: "record<virtualCluster: record<id: string, name: string, arn: string, state: string, containerProvider: record<type: string, id: string, info: record>, createdAt: string, tags: record>>"
    list-job-runs: "record<jobRuns: table<id: string, name: string, virtualClusterId: string, arn: string, state: string, clientToken: string, executionRoleArn: string, releaseLabel: string, configurationOverrides: record, jobDriver: record, createdAt: string, createdBy: string, finishedAt: string, stateDetails: string, failureReason: string, tags: record, retryPolicyConfiguration: record, retryPolicyExecution: record>, nextToken: string>"
    start-job-run: "record<id: string, name: string, arn: string, virtualClusterId: string>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["cancel-job-run" "describe-job-run" "create-job-template" "list-job-templates" "create-managed-endpoint" "list-managed-endpoints" "create-virtual-cluster" "list-virtual-clusters" "delete-job-template" "describe-job-template" "delete-managed-endpoint" "describe-managed-endpoint" "delete-virtual-cluster" "describe-virtual-cluster" "list-job-runs" "start-job-run" "list-tags-for-resource" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

