    chromepolicy-customers-policies-resolve: "record<nextPageToken: string, resolvedPolicies: table<addedSourceKey: record, sourceKey: record, targetKey: record, value: record>>"
    chromepolicy-customers-policy-schemas-get: "record<accessRestrictions: list<string>, additionalTargetKeyNames: table<key: string, keyDescription: string>, categoryTitle: string, definition: record<enumType: list<record>, messageType: list<record>, name: string, package: string, syntax: string>, fieldDescriptions: table<defaultValue: any, description: string, field: string, fieldConstraints: record, fieldDependencies: list, fieldDescription: string, inputConstraint: string, knownValueDescriptions: list, name: string, nestedFieldDescriptions: list, requiredItems: list>, name: string, notices: table<acknowledgementRequired: bool, field: string, noticeMessage: string, noticeValue: string>, policyApiLifecycle: record<deprecatedInFavorOf: list<string>, description: string, endSupport: record<day: int, month: int, year: int>, policyApiLifecycleStage: string>, policyDescription: string, schemaName: string, supportUri: string, validTargetResources: list<string>>"
    chromepolicy-customers-policy-schemas-list: "record<nextPageToken: string, policySchemas: table<accessRestrictions: list, additionalTargetKeyNames: list, categoryTitle: string, definition: record, fieldDescriptions: list, name: string, notices: list, policyApiLifecycle: record, policyDescription: string, schemaName: string, supportUri: string, validTargetResources: list>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["chromepolicy-media-upload" "chromepolicy-customers-policies-groups-batch-delete" "chromepolicy-customers-policies-groups-batch-modify" "chromepolicy-customers-policies-groups-list-group-priority-ordering" "chromepolicy-customers-policies-groups-update-group-priority-ordering" "chromepolicy-customers-policies-networks-define-certificate" "chromepolicy-customers-policies-networks-define-network" "chromepolicy-customers-policies-networks-remove-certificate" "chromepolicy-customers-policies-networks-remove-network" "chromepolicy-customers-policies-orgunits-batch-inherit" "chromepolicy-customers-policies-orgunits-batch-modify" "chromepolicy-customers-policies-resolve" "chromepolicy-customers-policy-schemas-get" "chromepolicy-customers-policy-schemas-list" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

