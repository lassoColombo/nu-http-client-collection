  --x-app-token: string # e.g. cQovpGcdUT1CSzgYk0KPYdAI0 (e.g. cQovpGcdUT1CSzgYk0KPYdAI0)
]: nothing -> any {
  http-request {
    method: get
    path: "/data/v1/map/new"
    query: [{name: variable, var: variable, required: true}, {name: entity_id, var: entity_id, required: true}, {name: constraint, var: constraint}, {name: app_token, var: app_token}]
