  --use-new-blob-for-pdf: string # Reserved for DocuSign.
  --use-new-blob-for-pdf-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
  --use-new-envelope-search: string
  --use-new-envelope-search-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
  --use-safe-signer-certificates: string # When **true,** signers are required to use SAFE digital signatures.
