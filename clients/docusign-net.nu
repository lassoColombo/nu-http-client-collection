  --email-tabs: list # A list of [Email tabs][email]. An Email tab enables the recipient to enter an email address. This is a one-line field that checks that a valid email address is entered. It uses the same parameters as a Text tab, with the validation message and pattern set for email information. This value can be set. When getting information that includes this tab type, the original value of the tab when the associated envelope was sent is included in the response. [email]: /docs/esign-rest-api/reference/envelopes/enveloperecipienttabs/ — item shape: {anchorAllowWhiteSpaceInCharacters?: string, anchorAllowWhiteSpaceInCharactersMetadata?: record, anchorCaseSensitive?: string, anchorCaseSensitiveMetadata?: record, anchorHorizontalAlignment?: string, anchorHorizontalAlignmentMetadata?: record, anchorIgnoreIfNotPresent?: string, anchorIgnoreIfNotPresentMetadata?: record, anchorMatchWholeWord?: string, anchorMatchWholeWordMetadata?: record, anchorString?: string, anchorStringMetadata?: record, anchorTabProcessorVersion?: string, ... (103 more fields)}
