  --validations-allowed: string # Boolean that specifies whether validations on recipient email domains are allowed.
  --validations-allowed-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
  --validations-brand: string # Valid values are: - `docusign` - `account`
