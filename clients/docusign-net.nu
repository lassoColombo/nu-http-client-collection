# --folders item shape: {errorDetails?: record, filter?: record, folderId?: string, folderItems?: list, folders?: list, hasAccess?: string, hasSubFolders?: string, itemCount?: string, name?: string, owner?: record, parentFolderId?: string, parentFolderUri?: string, subFolderCount?: string, type?: string, uri?: string}
