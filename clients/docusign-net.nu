  --use-consumer-disclosure-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
  --use-consumer-disclosure-within-account: string # When **true,** specifies that recipients in the same account as the sender must agree to eSign an Electronic Record and Signature Disclosure Statement.
  --use-consumer-disclosure-within-account-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
  --use-derived-keys: string # Reserved for DocuSign.
