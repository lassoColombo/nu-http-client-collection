  --text-tabs: list # A list of Text tabs. A text tab enables the recipient to enter free text. This value can be set. Find descriptions of all tab types in the [EnvelopeRecipientTabs Resource][ert]. [ert]: /docs/esign-rest-api/reference/envelopes/enveloperecipienttabs/ — item shape: {anchorAllowWhiteSpaceInCharacters?: string, anchorAllowWhiteSpaceInCharactersMetadata?: record, anchorCaseSensitive?: string, anchorCaseSensitiveMetadata?: record, anchorHorizontalAlignment?: string, anchorHorizontalAlignmentMetadata?: record, anchorIgnoreIfNotPresent?: string, anchorIgnoreIfNotPresentMetadata?: record, anchorMatchWholeWord?: string, anchorMatchWholeWordMetadata?: record, anchorString?: string, anchorStringMetadata?: record, anchorTabProcessorVersion?: string, ... (105 more fields)}
  --title-tabs: list # A list of [Title tabs][title]. A Title tab displays the recipient's title. This value can't be set. [title]: /docs/esign-rest-api/reference/envelopes/enveloperecipienttabs/ — item shape: {anchorAllowWhiteSpaceInCharacters?: string, anchorAllowWhiteSpaceInCharactersMetadata?: record, anchorCaseSensitive?: string, anchorCaseSensitiveMetadata?: record, anchorHorizontalAlignment?: string, anchorHorizontalAlignmentMetadata?: record, anchorIgnoreIfNotPresent?: string, anchorIgnoreIfNotPresentMetadata?: record, anchorMatchWholeWord?: string, anchorMatchWholeWordMetadata?: record, anchorString?: string, anchorStringMetadata?: record, anchorTabProcessorVersion?: string, ... (89 more fields)}
  --view-tabs: list # A list of [View tabs][view]. A View tab is used with an Approve tab to handle supplemental documents. This value can be set. [view]: /docs/esign-rest-api/reference/envelopes/enveloperecipienttabs/ — item shape: {anchorAllowWhiteSpaceInCharacters?: string, anchorAllowWhiteSpaceInCharactersMetadata?: record, anchorCaseSensitive?: string, anchorCaseSensitiveMetadata?: record, anchorHorizontalAlignment?: string, anchorHorizontalAlignmentMetadata?: record, anchorIgnoreIfNotPresent?: string, anchorIgnoreIfNotPresentMetadata?: record, anchorMatchWholeWord?: string, anchorMatchWholeWordMetadata?: record, anchorString?: string, anchorStringMetadata?: record, anchorTabProcessorVersion?: string, ... (78 more fields)}
  --zip-tabs: list # A list of [Zip tabs][zip]. A Zip tab enables the recipient to enter a ZIP code. The ZIP code can be five digits or nine digits ( in ZIP+4 format), and can be entered with or without dashes. It uses the same parameters as a Text tab, with the validation message and pattern set for ZIP code information. This value can be set. [zip]: /docs/esign-rest-api/reference/envelopes/enveloperecipienttabs/ — item shape: {anchorAllowWhiteSpaceInCharacters?: string, anchorAllowWhiteSpaceInCharactersMetadata?: record, anchorCaseSensitive?: string, anchorCaseSensitiveMetadata?: record, anchorHorizontalAlignment?: string, anchorHorizontalAlignmentMetadata?: record, anchorIgnoreIfNotPresent?: string, anchorIgnoreIfNotPresentMetadata?: record, anchorMatchWholeWord?: string, anchorMatchWholeWordMetadata?: record, anchorString?: string, anchorStringMetadata?: record, anchorTabProcessorVersion?: string, ... (105 more fields)}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
