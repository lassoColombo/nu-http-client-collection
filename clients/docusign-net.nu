  --use-docu-sign-express-signer-certificate: string # When **true,** signers are required to use Express Digital Signatures.
  --use-docu-sign-express-signer-certificate-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
