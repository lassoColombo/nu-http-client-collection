  --use-signature-provider-platform: string # Boolean that specifies whether the account uses the digital signature provider platform to eSign.
  --use-signature-provider-platform-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
  --use-smart-contracts-v1: string
