  --water-mark-enabled: string # When **true,** the [watermark feature](https://support.docusign.com/en/articles/How-do-I-manage-the-watermark-for-In-Process-envelopes-sent-from-my-account) is enabled for the account.
  --water-mark-enabled-metadata: record # Metadata that indicates whether a property is editable and describes setting-specific options. — shape: {is21CFRPart11?: string, options?: list<string>, rights?: string, uiHint?: string, uiOrder?: string, uiType?: string}
