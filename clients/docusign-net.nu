# operationId: NotaryJurisdictions_PutNotaryJurisdiction
# --errorDetails shape: {errorCode?: string, message?: string}
# --jurisdiction shape: {allowSystemCreatedSeal?: string, allowUserUploadedSeal?: string, commissionIdInSeal?: string, county?: string, countyInSeal?: string, enabled?: string, jurisdictionId?: string, name?: string, notaryPublicInSeal?: string, stateNameInSeal?: string}
