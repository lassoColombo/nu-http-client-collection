  --dry-run(-n) # Return the request that would be sent without executing it
  --document-fields: list # The array of name/value custom data strings to be added to a document. Custom document field information is returned in the status, but otherwise is not used by DocuSign. The array contains the elements: * name - A string that can be a maximum of 50 characters. * value - A string that can be a maximum of 200 characters. *IMPORTANT*: If you are using xml, the name/value pair is contained in a nameValue element. — item shape: {errorDetails?: record, name?: string, originalValue?: string, value?: string}
