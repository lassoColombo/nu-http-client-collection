  --zip-tabs: list # A list of [Zip tabs][zip]. A Zip tab enables the recipient to enter a ZIP code. The ZIP code can be five digits or nine digits ( in ZIP+4 format), and can be entered with or without dashes. It uses the same parameters as a Text tab, with the validation message and pattern set for ZIP code information. This value can be set. [zip]: /docs/esign-rest-api/reference/envelopes/enveloperecipienttabs/ — item shape: {anchorAllowWhiteSpaceInCharacters?: string, anchorAllowWhiteSpaceInCharactersMetadata?: record, anchorCaseSensitive?: string, anchorCaseSensitiveMetadata?: record, anchorHorizontalAlignment?: string, anchorHorizontalAlignmentMetadata?: record, anchorIgnoreIfNotPresent?: string, anchorIgnoreIfNotPresentMetadata?: record, anchorMatchWholeWord?: string, anchorMatchWholeWordMetadata?: record, anchorString?: string, anchorStringMetadata?: record, anchorTabProcessorVersion?: string, ... (105 more fields)}
]: any -> any {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base ({account_id: (encode-path-segment $account_id), envelope_id: (encode-path-segment $envelope_id), recipient_id: (encode-path-segment $recipient_id)} | format pattern "/v2.1/accounts/{account_id}/envelopes/{envelope_id}/recipients/{recipient_id}/tabs"))
