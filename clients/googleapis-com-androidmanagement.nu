# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    androidmanagement-enterprises-list: "record<enterprises: table<appAutoApprovalEnabled: bool, contactInfo: record, enabledNotificationTypes: list, enterpriseDisplayName: string, logo: record, name: string, primaryColor: int, pubsubTopic: string, signinDetails: list, termsAndConditions: list>, nextPageToken: string>"
