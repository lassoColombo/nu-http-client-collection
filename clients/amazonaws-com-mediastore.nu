# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-container: "record<Container: record<Endpoint: string, CreationTime: string, ARN: string, Name: string, Status: string, AccessLoggingEnabled: bool>>"
    delete-container: "record"
    delete-container-policy: "record"
    delete-cors-policy: "record"
    delete-lifecycle-policy: "record"
    delete-metric-policy: "record"
    describe-container: "record<Container: record<Endpoint: string, CreationTime: string, ARN: string, Name: string, Status: string, AccessLoggingEnabled: bool>>"
    get-container-policy: "record<Policy: string>"
    get-cors-policy: "record<CorsPolicy: table<AllowedOrigins: list, AllowedMethods: list, AllowedHeaders: list, MaxAgeSeconds: int, ExposeHeaders: list>>"
    get-lifecycle-policy: "record<LifecyclePolicy: string>"
    get-metric-policy: "record<MetricPolicy: record<ContainerLevelMetrics: string, MetricPolicyRules: list<record>>>"
    list-containers: "record<Containers: table<Endpoint: string, CreationTime: string, ARN: string, Name: string, Status: string, AccessLoggingEnabled: bool>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    put-container-policy: "record"
    put-cors-policy: "record"
    put-lifecycle-policy: "record"
    put-metric-policy: "record"
    start-access-logging: "record"
    stop-access-logging: "record"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-container" "delete-container" "delete-container-policy" "delete-cors-policy" "delete-lifecycle-policy" "delete-metric-policy" "describe-container" "get-container-policy" "get-cors-policy" "get-lifecycle-policy" "get-metric-policy" "list-containers" "list-tags-for-resource" "put-container-policy" "put-cors-policy" "put-lifecycle-policy" "put-metric-policy" "start-access-logging" "stop-access-logging" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Creates a storage container to hold objects. A container is similar to a bucket in the Amazon S3 service.
#
# POST /
# Returns: record<Container: record<Endpoint: string, CreationTime: string, ARN: string, Name: string, Status: string, AccessLoggingEnabled: bool>>
# operationId: CreateContainer
export def "create-container" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  container_name: string # The name for the container. The name must be from 1 to 255 characters. Container names must be unique to your AWS account within a specific region. As an example, you could create a container named movies in every region, as long as you don’t have an existing container with that name.
  --tags: list # An array of key:value pairs that you define. These values can be anything that you want. Typically, the tag key represents a category (such as "environment") and the tag value represents a specific value within that category (such as "test," "development," or "production"). You can add up to 50 tags to each container. For more information about tagging, including naming and usage conventions, see Tagging Resources in MediaStore (https://docs.aws.amazon.com/mediastore/latest/ug/tagging.html). — item shape: {Key: string, Value?: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "MediaStore_20170901.CreateContainer"}]
    body: {content_type: "application/json", kind: json, fields: [{name: ContainerName, var: container_name}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, container_name: $container_name, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

