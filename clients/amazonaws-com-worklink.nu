# Completers for enum parameters
def authorization-provider-type-completer [] { ["SAML"] }
def identity-provider-type-completer [] { ["SAML"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    associate-domain: "record"
    associate-website-authorization-provider: "record<AuthorizationProviderId: string>"
    associate-website-certificate-authority: "record<WebsiteCaId: string>"
    create-fleet: "record<FleetArn: string>"
    delete-fleet: "record"
    describe-audit-stream-configuration: "record<AuditStreamArn: string>"
    describe-company-network-configuration: "record<VpcId: string, SubnetIds: list<string>, SecurityGroupIds: list<string>>"
    describe-device: "record<Status: string, Model: string, Manufacturer: string, OperatingSystem: string, OperatingSystemVersion: string, PatchLevel: string, FirstAccessedTime: string, LastAccessedTime: string, Username: string>"
    describe-device-policy-configuration: "record<DeviceCaCertificate: string>"
    describe-domain: "record<DomainName: string, DisplayName: string, CreatedTime: string, DomainStatus: string, AcmCertificateArn: string>"
    describe-fleet-metadata: "record<CreatedTime: string, LastUpdatedTime: string, FleetName: string, DisplayName: string, OptimizeForEndUserLocation: bool, CompanyCode: string, FleetStatus: string, Tags: record>"
    describe-identity-provider-configuration: "record<IdentityProviderType: string, ServiceProviderSamlMetadata: string, IdentityProviderSamlMetadata: string>"
    describe-website-certificate-authority: "record<Certificate: string, CreatedTime: string, DisplayName: string>"
    disassociate-domain: "record"
    disassociate-website-authorization-provider: "record"
    disassociate-website-certificate-authority: "record"
    list-devices: "record<Devices: table<DeviceId: string, DeviceStatus: string>, NextToken: string>"
    list-domains: "record<Domains: table<DomainName: string, DisplayName: string, CreatedTime: string, DomainStatus: string>, NextToken: string>"
    list-fleets: "record<FleetSummaryList: table<FleetArn: string, CreatedTime: string, LastUpdatedTime: string, FleetName: string, DisplayName: string, CompanyCode: string, FleetStatus: string, Tags: record>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
    tag-resource: "record"
    list-website-authorization-providers: "record<WebsiteAuthorizationProviders: table<AuthorizationProviderId: string, AuthorizationProviderType: string, DomainName: string, CreatedTime: string>, NextToken: string>"
    list-website-certificate-authorities: "record<WebsiteCertificateAuthorities: table<WebsiteCaId: string, CreatedTime: string, DisplayName: string>, NextToken: string>"
    restore-domain-access: "record"
    revoke-domain-access: "record"
    sign-out-user: "record"
    untag-resource: "record"
    update-audit-stream-configuration: "record"
    update-company-network-configuration: "record"
    update-device-policy-configuration: "record"
    update-domain-metadata: "record"
    update-fleet-metadata: "record"
    update-identity-provider-configuration: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-domain" "associate-website-authorization-provider" "associate-website-certificate-authority" "create-fleet" "delete-fleet" "describe-audit-stream-configuration" "describe-company-network-configuration" "describe-device" "describe-device-policy-configuration" "describe-domain" "describe-fleet-metadata" "describe-identity-provider-configuration" "describe-website-certificate-authority" "disassociate-domain" "disassociate-website-authorization-provider" "disassociate-website-certificate-authority" "list-devices" "list-domains" "list-fleets" "list-tags-for-resource" "tag-resource" "list-website-authorization-providers" "list-website-certificate-authorities" "restore-domain-access" "revoke-domain-access" "sign-out-user" "untag-resource" "update-audit-stream-configuration" "update-company-network-configuration" "update-device-policy-configuration" "update-domain-metadata" "update-fleet-metadata" "update-identity-provider-configuration" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

