# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    activate-pipeline: "record"
    add-tags: "record"
    create-pipeline: "record<pipelineId: string>"
    deactivate-pipeline: "record"
    describe-objects: "record<pipelineObjects: table<id: string, name: string, fields: list>, marker: string, hasMoreResults: bool>"
    describe-pipelines: "record<pipelineDescriptionList: table<pipelineId: string, name: string, fields: list, description: string, tags: list>>"
    evaluate-expression: "record<evaluatedExpression: string>"
    get-pipeline-definition: "record<pipelineObjects: table<id: string, name: string, fields: list>, parameterObjects: table<id: string, attributes: list>, parameterValues: table<id: string, stringValue: string>>"
    list-pipelines: "record<pipelineIdList: table<id: string, name: string>, marker: string, hasMoreResults: bool>"
    poll-for-task: "record<taskObject: record<taskId: string, pipelineId: string, attemptId: string, objects: record>>"
    put-pipeline-definition: "record<validationErrors: table<id: string, errors: list>, validationWarnings: table<id: string, warnings: list>, errored: bool>"
    query-objects: "record<ids: list<string>, marker: string, hasMoreResults: bool>"
    remove-tags: "record"
    report-task-progress: "record<canceled: bool>"
    report-task-runner-heartbeat: "record<terminate: bool>"
    set-task-status: "record"
    validate-pipeline-definition: "record<validationErrors: table<id: string, errors: list>, validationWarnings: table<id: string, warnings: list>, errored: bool>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["activate-pipeline" "add-tags" "create-pipeline" "deactivate-pipeline" "delete-pipeline" "describe-objects" "describe-pipelines" "evaluate-expression" "get-pipeline-definition" "list-pipelines" "poll-for-task" "put-pipeline-definition" "query-objects" "remove-tags" "report-task-progress" "report-task-runner-heartbeat" "set-status" "set-task-status" "validate-pipeline-definition" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Validates the specified pipeline and starts processing pipeline tasks. If the pipeline does not pass validation, activation fails. If you need to pause the pipeline to investigate an issue with a component, such as a data source or script, call DeactivatePipeline. To activate a finished pipeline, modify the end date for the pipeline and then activate it.
#
# POST /
# Returns: record
# operationId: ActivatePipeline
export def "activate-pipeline" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  pipeline_id: string # The ID of the pipeline.
  --parameter-values: list # A list of parameter values to pass to the pipeline at activation. — item shape: {id: string, stringValue: string}
  --start-timestamp: string # The date and time to resume the pipeline. By default, the pipeline resumes from the last completed execution. (format: date-time)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "DataPipeline.ActivatePipeline"}]
    body: {content_type: "application/json", kind: json, fields: [{name: pipelineId, var: pipeline_id}, {name: parameterValues, var: parameter_values}, {name: startTimestamp, var: start_timestamp}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, pipeline_id: $pipeline_id, parameter_values: $parameter_values, start_timestamp: $start_timestamp
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

