# Returns a collections of beans
#
# GET /module/{module}
export def "module list" [
  module: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --fieldsContacts: string # Filtering attributes of each bean (e.g. name,account_type)
  --pagesize: int # Number of beans showed in a page (e.g. 4)
  --pagenumber: int # Number of a page (e.g. 4)
  --qp-sort: string # Sorting the bean list based on this parameter. Ascending by default, but if sort is prefixed with a minus (U+002D HYPHEN-MINUS, '-'), sort will be descending (e.g. -name)
  --filteroperator: string # Filtering the bean collection and using it between two or more conditions as logical operator. Only one level conditions are supported so far. Supported operators: AND, OR (e.g. AND)
  --filternameeq: string # Filtering the bean collections by conditions. The [name] is the  bean's property, the [eq] is a comparison operator. Supported operators: EQ, NEQ, GT, GTE, LT, LTE (e.g. John Doe)
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "fields[Contacts]" $fieldsContacts "scalar") (serialize-qp "page[size]" $pagesize "scalar") (serialize-qp "page[number]" $pagenumber "scalar") (serialize-qp "sort" $qp_sort "scalar") (serialize-qp "filter[operator]" $filteroperator "scalar") (serialize-qp "filter[name][eq]" $filternameeq "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/module/($module)" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

