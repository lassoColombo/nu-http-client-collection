  --page: int # Current page number (format: int32)
  --per-page: int # Number of records per page (format: int32)
  --type-s: string@type-s-completer # type
]: nothing -> record<users: table<_current_shift: any, _next_shift: any, Current_Shift__s: any, _shift_effective_from: any, confirm: bool, date_format: string, decimal_separator: string, email: string, first_name: string, full_name: string, id: string, last_name: any, type__s: string, profile: record, role: record, status: any, zuid: any, alias: any, created_by: any, created_time: any, locale: string, microsoft: bool, Modified_By: any, Modified_Time: any, phone: string, mobile: string, city: any, country: any, dob: any, fax: any, number_separator: string, state: any, street: any, time_format: string, website: any, zip: any, sandboxDeveloper: bool, name_format__s: string, language: string, status_reason__s: any, country_locale: string, ezuid: string, image_link: string, sort_order_preference__s: string, Reporting_To: any, share_among_subordinates: bool, imap_status: bool, time_zone: string, distance_preference__s: string, default_tab_group: string, signature: string, personal_account: bool, customize_info: record, theme: record>, info: record<per_page: int, count: int, page: int, more_records: bool>> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "type" $type "scalar") (serialize-qp "page" $page "scalar") (serialize-qp "per_page" $per_page "scalar") (serialize-qp "type__s" $type_s "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/users" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

