  --contentFiltering: record # The content filtering settings for your group policy — shape: {allowedUrlPatterns?: record, blockedUrlCategories?: record, blockedUrlPatterns?: record}
  --firewallAndTrafficShaping: record #     The firewall and traffic shaping rules and settings for your policy. — shape: {l3FirewallRules?: list, l7FirewallRules?: list, settings?: "custom"|"ignore"|"network default", trafficShapingRules?: list}
  name: string # The name for your group policy. Required.
  --scheduling: record #     The schedule for the group policy. Schedules are applied to days of the week. — shape: {enabled?: bool, friday?: record, monday?: record, saturday?: record, sunday?: record, thursday?: record, tuesday?: record, wednesday?: record}
  --splashAuthSettings: string@splashAuthSettings-completer # Whether clients bound to your policy will bypass splash authorization or behave according to the network's rules. Can be one of 'network default' or 'bypass'. Only available if your network has a wireless configuration.
