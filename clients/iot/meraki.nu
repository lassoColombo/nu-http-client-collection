  --t0: string # The beginning of the timespan for the data. The maximum lookback period is 7 days from today.
  --t1: string # The end of the timespan for the data. t1 can be a maximum of 7 days after t0.
  --timespan: float # The timespan for which the information will be fetched. If specifying timespan, do not specify parameters t0 and t1. The value must be in seconds and be less than or equal to 7 days. The default is 2 hours. (format: float)
