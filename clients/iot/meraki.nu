# Update custom analytics settings for a camera
#
# PUT /devices/{serial}/camera/customAnalytics
# operationId: updateDeviceCameraCustomAnalytics
# --parameters item shape: {name: string, value: string}
export def "devices-camera-custom-analytics updateDeviceCameraCustomAnalytics" [
  serial: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --artifactId: string # The ID of the custom analytics artifact
  --enabled: oneof<nothing, bool> # Enable custom analytics
  --parameters: list # Parameters for the custom analytics workload — item shape: {name: string, value: string}
]: any -> record {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "x-cisco-meraki-api-key"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/devices/($serial)/camera/customAnalytics")
  let body = {artifactId: $artifactId, enabled: $enabled, parameters: $parameters} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $dry_run $max_time $allow_errors "application/json" $body
}

# Generate a snapshot of what the camera sees at the specified time and return a link to that image.
#
# POST /devices/{serial}/camera/generateSnapshot
# operationId: generateDeviceCameraSnapshot
export def "devices-camera-generate-snapshot generateDeviceCameraSnapshot" [
  serial: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
