  --packages: list # The packages to analyze. — item shape: {architecture?: string, binary?: record, cpeUri?: string, dependencyChain?: list, fileLocation?: list, hashDigest?: string, maintainer?: record, os?: string, osVersion?: string, package?: string, packageType?: "PACKAGE_TYPE_UNSPECIFIED"|"OS"|"MAVEN"|"GO"|"GO_STDLIB"|"PYPI"|"NPM", patchedCve?: list<string>, unused?: string, version?: string}
  --resource-uri: string # Required. The resource URI of the container image being scanned.
]: any -> record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record> {
  let input = $in
  let auth = (merge-auth [(build-auth ($token_oauth2 | default ($env | get -o ON_DEMAND_SCANNING_API_OAUTH2_TOKEN | default "")) "bearer") (build-auth ($token_oauth2c | default ($env | get -o ON_DEMAND_SCANNING_API_OAUTH2C_TOKEN | default "")) "bearer")])
