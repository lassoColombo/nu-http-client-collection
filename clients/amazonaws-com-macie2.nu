    get-usage-totals: "record<timeRange: string, usageTotals: table<currency: string, estimatedCost: string, type: string>>"
    list-classification-jobs: "record<items: table<bucketCriteria: record, bucketDefinitions: list, createdAt: string, jobId: string, jobStatus: string, jobType: string, lastRunErrorStatus: record, name: string, userPausedDetails: record>, nextToken: string>"
    list-classification-scopes: "record<classificationScopes: table<id: string, name: string>, nextToken: string>"
    list-custom-data-identifiers: "record<items: table<arn: string, createdAt: string, description: string, id: string, name: string>, nextToken: string>"
    list-findings: "record<findingIds: list<string>, nextToken: string>"
    list-managed-data-identifiers: "record<items: table<category: string, id: string>, nextToken: string>"
    list-resource-profile-artifacts: "record<artifacts: table<arn: string, classificationResultStatus: string, sensitive: bool>, nextToken: string>"
    list-resource-profile-detections: "record<detections: table<arn: string, count: int, id: string, name: string, suppressed: bool, type: string>, nextToken: string>"
    update-resource-profile-detections: "record"
