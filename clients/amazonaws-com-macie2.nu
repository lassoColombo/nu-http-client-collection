    get-sensitivity-inspection-template: "record<description: string, excludes: record<managedDataIdentifierIds: list<string>>, includes: record<allowListIds: list<string>, customDataIdentifierIds: list<string>, managedDataIdentifierIds: list<string>>, name: string, sensitivityInspectionTemplateId: string>"
    update-sensitivity-inspection-template: "record"
