  let auth = (build-auth $token ($auth_scheme | default "x-auth-email"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "dateStart" $dateStart "scalar") (serialize-qp "dateEnd" $dateEnd "scalar") (serialize-qp "metric" $metric "scalar") (serialize-qp "asn" $asn "multi") (serialize-qp "location" $location "multi") (serialize-qp "name" $name "multi") (serialize-qp "format" $format "scalar")] | flatten | str join "&"
  let full_url = (build-url $base "/radar/bgp/rpki/roas/timeseries" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

