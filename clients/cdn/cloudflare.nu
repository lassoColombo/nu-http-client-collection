  --policy-uri: string # URL that points to a privacy policy document. (e.g. https://example.com/privacy)
  --post-logout-redirect-uris: list # Array of allowed post-logout redirect URIs. (e.g. [https://example.com/logout])
  redirect_uris: list # Array of allowed redirect URIs for the client. (e.g. [https://example.com/callback])
  response_types: list # Array of OAuth response types the client is allowed to use. (e.g. [code])
  scopes: list # Array of OAuth scopes the client is allowed to request. Colon-delimited scopes are not accepted. Dot-delimited scopes are validated against available OAuth API scopes; simple identity scopes are allowed. Protocol scopes `offline_access` and `openid` are added or removed automatically based on `grant_types` and `response_types`. (e.g. [account.read])
  token_endpoint_auth_method: string@token-endpoint-auth-method-completer # The authentication method the client uses at the token endpoint. (e.g. client_secret_post)
  --tos-uri: string # URL that points to a terms of service document. (e.g. https://example.com/tos)
]: any -> record<result: record<client_secret: string>> {
