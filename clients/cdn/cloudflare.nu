  --nat: record # shape: {static_prefix?: string}
  --physport: int # e.g. 1
  --routed-subnets: list # item shape: {nat?: record, next_hop: string, prefix: string}
  --static-addressing: record # If the site is not configured in high availability mode, this configuration is optional (if omitted, use DHCP). However, if in high availability mode, static_address is required along with secondary and virtual address. — shape: {address: string, dhcp_relay?: record, dhcp_server?: record, secondary_address?: string, virtual_address?: string}
  --vlan-tag: int # VLAN ID. Use zero for untagged. (e.g. 42)
]: any -> record<result: table<bond_id: int, ha_link: bool, id: string, is_breakout: bool, is_prioritized: bool, name: string, nat: record, physport: int, routed_subnets: list, site_id: string, static_addressing: record, vlan_tag: int>> {
