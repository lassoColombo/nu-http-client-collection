# Create or replace an origin cloud region mapping
#
# PUT /zones/{zone_id}/origin/cloud_regions/{origin_ip}
# operationId: origin-cloud-regions-v2-upsert
export def "zones-origin-cloud-regions origin-cloud-regions-v2-upsert" [
  zone_id: string
  origin_ip: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --body-origin-ip: string # Origin IP address (IPv4 or IPv6). For the single PUT endpoint (`PUT /origin/cloud_regions/{origin_ip}`), this field must match the path parameter or the request will be rejected with a 400 error. For the batch PUT endpoint, this field identifies which mapping to upsert. (e.g. 192.0.2.1)
  region: string # Cloud vendor region identifier. Must be a valid region for the specified vendor as returned by the supported_regions endpoint. (e.g. us-east-1)
  vendor: string@vendor-completer-2 # Cloud vendor hosting the origin. Must be one of the supported vendors. (e.g. aws)
]: any -> record<errors: table<code: int, message: string>, messages: table<code: int, message: string>, success: bool, result: record<modified_on: string, origin_ip: string, region: string, vendor: string>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/zones/($zone_id)/origin/cloud_regions/($origin_ip)")
  let body = {origin_ip: $body_origin_ip, region: $region, vendor: $vendor} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "put" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

