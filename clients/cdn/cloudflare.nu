  let qp = [(serialize-qp "created_before" $created_before "scalar") (serialize-qp "created_after" $created_after "scalar") (serialize-qp "per_page" $per_page "scalar") (serialize-qp "asc" $asc "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/accounts/($account_id)/moq/relays" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

