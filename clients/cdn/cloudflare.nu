# operationId: magic-site-lans-create-lan
# --nat shape: {static_prefix?: string}
# --routed_subnets item shape: {nat?: record, next_hop: string, prefix: string}
# --static_addressing shape: {address: string, dhcp_relay?: record, dhcp_server?: record, secondary_address?: string, virtual_address?: string}
