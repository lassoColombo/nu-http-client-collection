# operationId: get-zones-zone_id-logs-received
export def "zones-logs-received id-logs-received" [
  zone_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --start: string
  --end: string
  --qp-fields: string
  --sample: string
  --count: string
  --timestamps: string
]: nothing -> any {
  let auth = (build-auth $token ($auth_scheme | default "x-auth-email"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "start" $start "scalar") (serialize-qp "end" $end "scalar") (serialize-qp "fields" $qp_fields "scalar") (serialize-qp "sample" $sample "scalar") (serialize-qp "count" $count "scalar") (serialize-qp "timestamps" $timestamps "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/zones/($zone_id)/logs/received" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

