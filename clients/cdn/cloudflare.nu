  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/accounts/($account_id)/containers/applications/($application_id)/rollouts")
  let body = {description: $description, kind: $kind, percentage: $percentage, step_percentage: $step_percentage, steps: $steps, strategy: $strategy, target_configuration: $target_configuration} | compact
