# operationId: d1-export-database
# --dump_options shape: {no_data?: bool, no_schema?: bool, tables?: list}
export def "accounts-d1-database-export d1-export-database" [
  account_id: string
  database_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --current-bookmark: string # To poll an in-progress export, provide the current bookmark (returned by your first polling response)
  --dump-options: record # shape: {no_data?: bool, no_schema?: bool, tables?: list}
  output_format: string@output-format-completer # Specifies that you will poll this endpoint until the export completes
]: any -> record<errors: table<code: int, message: string>, messages: table<code: int, message: string>, result: record<at_bookmark: string, error: string, messages: list<string>, result: record<filename: string, signed_url: string>, status: string, success: bool, type: string>, success: bool> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/accounts/($account_id)/d1/database/($database_id)/export")
  let body = {current_bookmark: $current_bookmark, dump_options: $dump_options, output_format: $output_format} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

# Import SQL into your D1 Database
#
# POST /accounts/{account_id}/d1/database/{database_id}/import
# operationId: d1-import-database
