  let qp = [(serialize-qp "per_page" $per_page "scalar") (serialize-qp "cursor" $cursor "scalar") (serialize-qp "field_changed" $field_changed "scalar") (serialize-qp "changed_by" $changed_by "scalar") (serialize-qp "since" $since "scalar") (serialize-qp "before" $before "scalar") (serialize-qp "order" $order "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/zones/($zone_id)/security-center/insights/($issue_id)/audit-log" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

