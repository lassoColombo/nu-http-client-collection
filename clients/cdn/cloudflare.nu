  --allow-errors(-e) # Return full response without error handling
  ns_name: string # The FQDN of the name server. (format: hostname, e.g. ns1.example.com)
  --ns-set: float # The number of the set that this name server belongs to. (default: 1, e.g. 1)
]: any -> record {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/tenants/($tenant_tag)/custom_ns")
