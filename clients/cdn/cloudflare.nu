  let body = {auth_credentials: $auth_credentials, description: $description, is_shared_oauth_callback_enabled: $is_shared_oauth_callback_enabled, name: $name, secure_web_gateway: $secure_web_gateway, updated_prompts: $updated_prompts, updated_tools: $updated_tools} | compact
