# --static_addressing shape: {address: string, gateway_address: string, secondary_address?: string}
export def "accounts-magic-sites-wans magic-site-wans-patch-wan" [
  site_id: string
  account_id: string
  wan_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --name: string
  --physport: int # e.g. 1
  --priority: int
  --static-addressing: record # (optional) if omitted, use DHCP. Submit secondary_address when site is in high availability mode. — shape: {address: string, gateway_address: string, secondary_address?: string}
  --vlan-tag: int # VLAN ID. Use zero for untagged. (e.g. 42)
]: any -> record<result: record<health_check_rate: string, id: string, name: string, physport: int, priority: int, site_id: string, static_addressing: record<address: string, gateway_address: string, secondary_address: string>, vlan_tag: int>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "x-auth-email"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/accounts/($account_id)/magic/sites/($site_id)/wans/($wan_id)")
  let body = {name: $name, physport: $physport, priority: $priority, static_addressing: $static_addressing, vlan_tag: $vlan_tag} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "patch" $full_url $auth $insecure $raw $max_time $allow_errors "application/json" $body
}

