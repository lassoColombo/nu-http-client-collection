# Create Pool
#
# POST /user/load_balancers/pools
# operationId: load-balancer-pools-create-pool
# --load_shedding shape: {default_percent?: float, default_policy?: "random"|"hash", session_percent?: float, session_policy?: "hash"}
# --notification_filter shape: {origin?: record, pool?: record}
# --origin_steering shape: {policy?: "random"|"hash"|"least_outstanding_requests"|"least_connections"}
# --origins item shape: {address?: string, enabled?: bool, flatten_cname?: bool, header?: record, name?: string, port?: int, virtual_network_id?: string, weight?: float}
