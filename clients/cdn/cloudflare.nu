  let full_url = (build-url $base $"/accounts/($account_id)/ai/run/@cf/aisingapore/gemma-sea-lion-v4-27b-it" $qp)
  let body = {frequency_penalty: $frequency_penalty, lora: $lora, max_tokens: $max_tokens, presence_penalty: $presence_penalty, prompt: $prompt, raw: $body_raw, repetition_penalty: $repetition_penalty, response_format: $response_format, seed: $seed, stream: $stream, temperature: $temperature, top_k: $top_k, top_p: $top_p, functions: $functions, messages: $messages, tools: $tools, requests: $requests} | compact
