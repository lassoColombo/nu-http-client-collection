  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/zones/($zone_id)/healthchecks/($healthcheck_id)")
  let body = {address: $address, check_regions: $check_regions, consecutive_fails: $consecutive_fails, consecutive_successes: $consecutive_successes, description: $description, http_config: $http_config, interval: $interval, name: $name, retries: $retries, suspended: $suspended, tcp_config: $tcp_config, timeout: $timeout, type: $type} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let accept_val = "application/json"
