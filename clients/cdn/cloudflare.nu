export def "accounts-infrastructure-targets infra-targets-list" [
  account_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --hostname: string # Hostname of a target (nullable)
  --hostname-contains: string # Partial match to the hostname of a target (nullable)
  --virtual-network-id: string # Private virtual network identifier of the target (nullable, format: uuid)
  --ip-v4: string # IPv4 address of the target (nullable)
  --ip-v6: string # IPv6 address of the target (nullable)
  --created-before: string # Date and time at which the target was created before (inclusive) (nullable, format: date-time)
  --created-after: string # Date and time at which the target was created after (inclusive) (nullable, format: date-time)
  --modified-before: string # Date and time at which the target was modified before (inclusive) (nullable, format: date-time)
  --modified-after: string # Date and time at which the target was modified after (inclusive) (nullable, format: date-time)
  --ips: list # Filters for targets that have any of the following IP addresses. Specify `ips` multiple times in query parameter to build list of candidates.
  --target-ids: list # Filters for targets that have any of the following UUIDs. Specify `target_ids` multiple times in query parameter to build list of candidates.
  --ip-like: string # Filters for targets whose IP addresses look like the specified string. Supports `*` as a wildcard character (nullable)
  --ipv4-start: string # Defines an IPv4 filter range's starting value (inclusive). Requires `ipv4_end` to be specified as well. (nullable)
  --ipv4-end: string # Defines an IPv4 filter range's ending value (inclusive). Requires `ipv4_start` to be specified as well. (nullable)
  --ipv6-start: string # Defines an IPv6 filter range's starting value (inclusive). Requires `ipv6_end` to be specified as well. (nullable)
  --ipv6-end: string # Defines an IPv6 filter range's ending value (inclusive). Requires `ipv6_start` to be specified as well. (nullable)
  --page: int # Current page in the response (format: int32, default: 1)
  --per-page: int # Max amount of entries returned per page (format: int32, default: 1000)
  --order: string@order-completer-8 # The field to sort by.
  --direction: string # The sorting direction.
]: nothing -> record<result: table<created_at: string, hostname: string, id: string, ip: record, modified_at: string>> {
  let auth = (build-auth $token ($auth_scheme | default "x-auth-email"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "hostname" $hostname "scalar") (serialize-qp "hostname_contains" $hostname_contains "scalar") (serialize-qp "virtual_network_id" $virtual_network_id "scalar") (serialize-qp "ip_v4" $ip_v4 "scalar") (serialize-qp "ip_v6" $ip_v6 "scalar") (serialize-qp "created_before" $created_before "scalar") (serialize-qp "created_after" $created_after "scalar") (serialize-qp "modified_before" $modified_before "scalar") (serialize-qp "modified_after" $modified_after "scalar") (serialize-qp "ips" $ips "multi") (serialize-qp "target_ids" $target_ids "multi") (serialize-qp "ip_like" $ip_like "scalar") (serialize-qp "ipv4_start" $ipv4_start "scalar") (serialize-qp "ipv4_end" $ipv4_end "scalar") (serialize-qp "ipv6_start" $ipv6_start "scalar") (serialize-qp "ipv6_end" $ipv6_end "scalar") (serialize-qp "page" $page "scalar") (serialize-qp "per_page" $per_page "scalar") (serialize-qp "order" $order "scalar") (serialize-qp "direction" $direction "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/accounts/($account_id)/infrastructure/targets" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

