# Metadata on editorial programme versions: original, signed, audio-described, etc
#
# GET /versions
# operationId: listVersions
export def "versions listVersions" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --availability: list # filter for subset of versions that have availability
  --descendants-of: list # filter for subset of versions having given programme PID
  --media-set: list # filter for subset of versions with availability in the given media set
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list # filter for versions by partner ID
  --partner-pid: list # filter for versions by partner PID
  --payment-type: list # filter for a subset of versions that are of the given payment_type
  --pid: list # filter for subset of versions having given PID
  --embargoed: string@embargoed-completer # Control return of embargoed items (undocumented)
