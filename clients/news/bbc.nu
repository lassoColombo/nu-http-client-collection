  --page-size: int # number of results in each page (default: 10)
  --partner-id: list # filter for people by partner ID
  --partner-pid: list # filter for people by partner PID
  --pid: list # filter for subset of people having given PID
  --programme: string # filter for subset of people that have contributed to the given programme pid
  --q: string # filter for subset of people matching supplied keyword/phrase (boolean operators permitted)
