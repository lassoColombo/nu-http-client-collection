  --sort-direction: string@sort-direction-completer # Sort direction
  --mixin: list # Mixins: * ancestor_titles: return ancestor programme titles * images: mixin to add image information for broadcasts and webcasts * titles: return ancestor programme titles
  --authority: list # filter for subset of broadcasts and webcasts that have given authority
  --descendants-of: list # filter for subset of broadcasts and webcasts that are descendants of the given programme PID
  --end-from: string # filter for subset of broadcasts and webcasts that end on or later than the specified datetime (format: date-time)
  --end-to: string # filter for subset of broadcasts and webcasts that end on or earlier than the specified datetime (format: date-time)
  --format: list # filter for subset of broadcasts and webcasts that are classified in the given format ID
  --genre: list # filter for subset of broadcasts and webcasts that are classified in the given genre ID
  --group: string # filter for subset of broadcasts and webcasts that have programmes in the given group
  --id: list # filter for subset of broadcasts and webcasts that have given identifier
  --id-type: list # filter for subset of broadcasts and webcasts that have given id type
  --item: list # filter for subset of broadcasts and webcasts with the given item performed on it
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list # filter for broadcasts and webcasts by partner ID
  --partner-pid: list # filter for broadcasts and webcasts by partner PID
  --people: string # filter for subset of broadcasts and webcasts that have given contributor
  --pid: list # filter for subset of broadcasts and webcasts having given PID
  --q: string # filter for subset of broadcasts and webcasts matching supplied keyword/phrase (boolean operators permitted)
  --repeat: oneof<nothing, bool> # filter to show either only repeats or non-repeats
  --schedule-day: string # filter for subset of broadcasts and webcasts that start on the specified day (BBC time) (format: date)
  --schedule-day-from: string # filter for subset of broadcasts and webcasts that start on or after the specified day (BBC time) (format: date)
  --schedule-day-to: string # filter for subset of broadcasts and webcasts that start on or before the specified day (BBC time) (format: date)
  --service-master-brand: list # filter for subset of broadcasts and webcasts with given service master brand
  --sid: list # filter for subset of broadcasts and webcasts that are on the specified linear service
  --start-from: string # filter for subset of broadcasts and webcasts that start on or later than the specified datetime (format: date-time)
  --start-to: string # filter for subset of broadcasts and webcasts that start on or earlier than the specified datetime (format: date-time)
