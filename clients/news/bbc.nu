  --for-descendants-of: string # filter for groups related to given programme or its descendants
  --for-programme: string # filter for subset of groups directly related to a given programme
  --group: string # filter for subset of groups which belong to the given group pid
  --group-type: list # filter for subset of groups that have the given group type
  --member: string # filter for subset of groups which contain an entity with the given pid as a member
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list # filter for groups by partner ID
  --partner-pid: list # filter for groups by partner PID
  --pid: list # filter for subset of seasons, collections, galleries or franchises having given PID
  --q: string # filter for subset of groups matching supplied keyword/phrase (boolean operators permitted)
  --embargoed: string@embargoed-completer # Control return of embargoed items (undocumented)
