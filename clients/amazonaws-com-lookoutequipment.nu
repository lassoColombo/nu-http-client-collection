# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-dataset: "record<DatasetName: string, DatasetArn: string, Status: string>"
    create-inference-scheduler: "record<InferenceSchedulerArn: string, InferenceSchedulerName: string, Status: string>"
    create-label: "record<LabelId: string>"
    create-label-group: "record<LabelGroupName: string, LabelGroupArn: string>"
    create-model: "record<ModelArn: string, Status: string>"
    describe-data-ingestion-job: "record<JobId: string, DatasetArn: string, IngestionInputConfiguration: record<S3InputConfiguration: record<Bucket: string, Prefix: string, KeyPattern: string>>, RoleArn: string, CreatedAt: string, Status: string, FailedReason: string, DataQualitySummary: record<InsufficientSensorData: record<MissingCompleteSensorData: record, SensorsWithShortDateRange: record>, MissingSensorData: record<AffectedSensorCount: int, TotalNumberOfMissingValues: int>, InvalidSensorData: record<AffectedSensorCount: int, TotalNumberOfInvalidValues: int>, UnsupportedTimestamps: record<TotalNumberOfUnsupportedTimestamps: int>, DuplicateTimestamps: record<TotalNumberOfDuplicateTimestamps: int>>, IngestedFilesSummary: record<TotalNumberOfFiles: int, IngestedNumberOfFiles: int, DiscardedFiles: list<record>>, StatusDetail: string, IngestedDataSize: int, DataStartTime: string, DataEndTime: string>"
    describe-dataset: "record<DatasetName: string, DatasetArn: string, CreatedAt: string, LastUpdatedAt: string, Status: string, Schema: string, ServerSideKmsKeyId: string, IngestionInputConfiguration: record<S3InputConfiguration: record<Bucket: string, Prefix: string, KeyPattern: string>>, DataQualitySummary: record<InsufficientSensorData: record<MissingCompleteSensorData: record, SensorsWithShortDateRange: record>, MissingSensorData: record<AffectedSensorCount: int, TotalNumberOfMissingValues: int>, InvalidSensorData: record<AffectedSensorCount: int, TotalNumberOfInvalidValues: int>, UnsupportedTimestamps: record<TotalNumberOfUnsupportedTimestamps: int>, DuplicateTimestamps: record<TotalNumberOfDuplicateTimestamps: int>>, IngestedFilesSummary: record<TotalNumberOfFiles: int, IngestedNumberOfFiles: int, DiscardedFiles: list<record>>, RoleArn: string, DataStartTime: string, DataEndTime: string>"
    describe-inference-scheduler: "record<ModelArn: string, ModelName: string, InferenceSchedulerName: string, InferenceSchedulerArn: string, Status: string, DataDelayOffsetInMinutes: int, DataUploadFrequency: string, CreatedAt: string, UpdatedAt: string, DataInputConfiguration: record<S3InputConfiguration: record<Bucket: string, Prefix: string>, InputTimeZoneOffset: string, InferenceInputNameConfiguration: record<TimestampFormat: string, ComponentTimestampDelimiter: string>>, DataOutputConfiguration: record<S3OutputConfiguration: record<Bucket: string, Prefix: string>, KmsKeyId: string>, RoleArn: string, ServerSideKmsKeyId: string, LatestInferenceResult: string>"
    describe-label: "record<LabelGroupName: string, LabelGroupArn: string, LabelId: string, StartTime: string, EndTime: string, Rating: string, FaultCode: string, Notes: string, Equipment: string, CreatedAt: string>"
    describe-label-group: "record<LabelGroupName: string, LabelGroupArn: string, FaultCodes: list<string>, CreatedAt: string, UpdatedAt: string>"
    describe-model: "record<ModelName: string, ModelArn: string, DatasetName: string, DatasetArn: string, Schema: string, LabelsInputConfiguration: record<S3InputConfiguration: record<Bucket: string, Prefix: string>, LabelGroupName: string>, TrainingDataStartTime: string, TrainingDataEndTime: string, EvaluationDataStartTime: string, EvaluationDataEndTime: string, RoleArn: string, DataPreProcessingConfiguration: record<TargetSamplingRate: string>, Status: string, TrainingExecutionStartTime: string, TrainingExecutionEndTime: string, FailedReason: string, ModelMetrics: string, LastUpdatedTime: string, CreatedAt: string, ServerSideKmsKeyId: string, OffCondition: string>"
    list-data-ingestion-jobs: "record<NextToken: string, DataIngestionJobSummaries: table<JobId: string, DatasetName: string, DatasetArn: string, IngestionInputConfiguration: record, Status: string>>"
    list-datasets: "record<NextToken: string, DatasetSummaries: table<DatasetName: string, DatasetArn: string, Status: string, CreatedAt: string>>"
    list-inference-events: "record<NextToken: string, InferenceEventSummaries: table<InferenceSchedulerArn: string, InferenceSchedulerName: string, EventStartTime: string, EventEndTime: string, Diagnostics: string, EventDurationInSeconds: int>>"
    list-inference-executions: "record<NextToken: string, InferenceExecutionSummaries: table<ModelName: string, ModelArn: string, InferenceSchedulerName: string, InferenceSchedulerArn: string, ScheduledStartTime: string, DataStartTime: string, DataEndTime: string, DataInputConfiguration: record, DataOutputConfiguration: record, CustomerResultObject: record, Status: string, FailedReason: string>>"
    list-inference-schedulers: "record<NextToken: string, InferenceSchedulerSummaries: table<ModelName: string, ModelArn: string, InferenceSchedulerName: string, InferenceSchedulerArn: string, Status: string, DataDelayOffsetInMinutes: int, DataUploadFrequency: string, LatestInferenceResult: string>>"
    list-label-groups: "record<NextToken: string, LabelGroupSummaries: table<LabelGroupName: string, LabelGroupArn: string, CreatedAt: string, UpdatedAt: string>>"
    list-labels: "record<NextToken: string, LabelSummaries: table<LabelGroupName: string, LabelId: string, LabelGroupArn: string, StartTime: string, EndTime: string, Rating: string, FaultCode: string, Equipment: string, CreatedAt: string>>"
    list-models: "record<NextToken: string, ModelSummaries: table<ModelName: string, ModelArn: string, DatasetName: string, DatasetArn: string, Status: string, CreatedAt: string>>"
    list-sensor-statistics: "record<SensorStatisticsSummaries: table<ComponentName: string, SensorName: string, DataExists: bool, MissingValues: record, InvalidValues: record, InvalidDateEntries: record, DuplicateTimestamps: record, CategoricalValues: record, MultipleOperatingModes: record, LargeTimestampGaps: record, MonotonicValues: record, DataStartTime: string, DataEndTime: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    start-data-ingestion-job: "record<JobId: string, Status: string>"
    start-inference-scheduler: "record<ModelArn: string, ModelName: string, InferenceSchedulerName: string, InferenceSchedulerArn: string, Status: string>"
    stop-inference-scheduler: "record<ModelArn: string, ModelName: string, InferenceSchedulerName: string, InferenceSchedulerArn: string, Status: string>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-dataset" "create-inference-scheduler" "create-label" "create-label-group" "create-model" "delete-dataset" "delete-inference-scheduler" "delete-label" "delete-label-group" "delete-model" "describe-data-ingestion-job" "describe-dataset" "describe-inference-scheduler" "describe-label" "describe-label-group" "describe-model" "list-data-ingestion-jobs" "list-datasets" "list-inference-events" "list-inference-executions" "list-inference-schedulers" "list-label-groups" "list-labels" "list-models" "list-sensor-statistics" "list-tags-for-resource" "start-data-ingestion-job" "start-inference-scheduler" "stop-inference-scheduler" "tag-resource" "untag-resource" "update-inference-scheduler" "update-label-group" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Creates a container for a collection of data being ingested for analysis. The dataset contains the metadata describing where the data is and what the data actually looks like. In other words, it contains the location of the data source, the data schema, and other information. A dataset also contains any tags associated with the ingested data.
#
# POST /
# Returns: record<DatasetName: string, DatasetArn: string, Status: string>
# operationId: CreateDataset
export def "create-dataset" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer # required
  dataset_name: string # The name of the dataset being created.
  --dataset-schema: record # Provides information about the data schema used with the given dataset. — shape: {InlineDataSchema?: string}
  --server-side-kms-key-id: string # Provides the identifier of the KMS key used to encrypt dataset data by Amazon Lookout for Equipment.
  client_token: string # A unique identifier for the request. If you do not set the client request token, Amazon Lookout for Equipment generates one.
  --tags: list # Any tags associated with the ingested data described in the dataset. — item shape: {Key: string, Value: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "AWSLookoutEquipmentFrontendService.CreateDataset"}]
    body: {content_type: "application/json", kind: json, fields: [{name: DatasetName, var: dataset_name}, {name: DatasetSchema, var: dataset_schema}, {name: ServerSideKmsKeyId, var: server_side_kms_key_id}, {name: ClientToken, var: client_token}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, dataset_name: $dataset_name, dataset_schema: $dataset_schema, server_side_kms_key_id: $server_side_kms_key_id, client_token: $client_token, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Creates a scheduled inference. Scheduling an inference is setting up a continuous real-time inference plan to analyze new measurement data. When setting up the schedule, you provide an S3 bucket location for the input data, assign it a delimiter between separate entries in the data, set an offset delay if desired, and set the frequency of inferencing. You must also provide an S3 bucket location for the output data.
#
# POST /
# Returns: record<InferenceSchedulerArn: string, InferenceSchedulerName: string, Status: string>
# operationId: CreateInferenceScheduler
export def "create-inference-scheduler" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-1 # required
  model_name: string # The name of the previously trained ML model being used to create the inference scheduler.
  inference_scheduler_name: string # The name of the inference scheduler being created.
  --data-delay-offset-in-minutes: int # The interval (in minutes) of planned delay at the start of each inference segment. For example, if inference is set to run every ten minutes, the delay is set to five minutes and the time is 09:08. The inference scheduler will wake up at the configured interval (which, without a delay configured, would be 09:10) plus the additional five minute delay time (so 09:15) to check your Amazon S3 bucket. The delay provides a buffer for you to upload data at the same frequency, so that you don't have to stop and restart the scheduler when uploading new data. For more information, see Understanding the inference process (https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/understanding-inference-process.html).
  data_upload_frequency: string@data-upload-frequency-completer # How often data is uploaded to the source Amazon S3 bucket for the input data. The value chosen is the length of time between data uploads. For instance, if you select 5 minutes, Amazon Lookout for Equipment will upload the real-time data to the source bucket once every 5 minutes. This frequency also determines how often Amazon Lookout for Equipment runs inference on your data. For more information, see Understanding the inference process (https://docs.aws.amazon.com/lookout-for-equipment/latest/ug/understanding-inference-process.html).
  data_input_configuration: record # Specifies configuration information for the input data for the inference, including Amazon S3 location of input data.. — shape: {S3InputConfiguration?: record, InputTimeZoneOffset?: string, InferenceInputNameConfiguration?: record}
  data_output_configuration: record # Specifies configuration information for the output results from for the inference, including KMS key ID and output S3 location. — shape: {S3OutputConfiguration: record, KmsKeyId?: string}
  role_arn: string # The Amazon Resource Name (ARN) of a role with permission to access the data source being used for the inference.
  --server-side-kms-key-id: string # Provides the identifier of the KMS key used to encrypt inference scheduler data by Amazon Lookout for Equipment.
  client_token: string # A unique identifier for the request. If you do not set the client request token, Amazon Lookout for Equipment generates one.
  --tags: list # Any tags associated with the inference scheduler. — item shape: {Key: string, Value: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "AWSLookoutEquipmentFrontendService.CreateInferenceScheduler"}]
    body: {content_type: "application/json", kind: json, fields: [{name: ModelName, var: model_name}, {name: InferenceSchedulerName, var: inference_scheduler_name}, {name: DataDelayOffsetInMinutes, var: data_delay_offset_in_minutes}, {name: DataUploadFrequency, var: data_upload_frequency}, {name: DataInputConfiguration, var: data_input_configuration}, {name: DataOutputConfiguration, var: data_output_configuration}, {name: RoleArn, var: role_arn}, {name: ServerSideKmsKeyId, var: server_side_kms_key_id}, {name: ClientToken, var: client_token}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
