    body: {content_type: "application/json", kind: json, fields: [{name: InferenceSchedulerName, var: inference_scheduler_name}, {name: DataDelayOffsetInMinutes, var: data_delay_offset_in_minutes}, {name: DataUploadFrequency, var: data_upload_frequency}, {name: DataInputConfiguration, var: data_input_configuration}, {name: DataOutputConfiguration, var: data_output_configuration}, {name: RoleArn, var: role_arn}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
