# --RecipeStep shape: {Action?: any, ConditionExpressions?: any}
# --ViewFrame shape: {StartColumnIndex?: any, ColumnRange?: any, HiddenColumns?: any, StartRowIndex?: any, RowRange?: any, Analytics?: any}
