    method: put
    path: "/repos/{owner}/{repo}/branches/{branch}/protection"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: branch, var: branch}]
    body: {content_type: "application/json", kind: json, fields: [{name: allow_deletions, var: allow_deletions}, {name: allow_force_pushes, var: allow_force_pushes}, {name: enforce_admins, var: enforce_admins}, {name: required_conversation_resolution, var: required_conversation_resolution}, {name: required_linear_history, var: required_linear_history}, {name: required_pull_request_reviews, var: required_pull_request_reviews}, {name: required_status_checks, var: required_status_checks}, {name: restrictions, var: restrictions}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
