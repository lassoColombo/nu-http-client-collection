  --assignees: list<string> # Logins for Users to assign to this issue. _NOTE: Only users with push access can set assignees for new issues. Assignees are silently dropped otherwise._
  --body: string # The contents of the issue.
  --labels: list # Labels to associate with this issue. _NOTE: Only users with push access can set labels for new issues. Labels are silently dropped otherwise._
  --milestone: any # nullable
  title: any # The title of the issue.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/repos/{owner}/{repo}/issues"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}]
    body: {content_type: "application/json", kind: json, fields: [{name: assignee, var: assignee}, {name: assignees, var: assignees}, {name: body, var: body}, {name: labels, var: labels}, {name: milestone, var: milestone}, {name: title, var: title}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    owner: $owner, repo: $repo, assignee: $assignee, assignees: $assignees, body: $body, labels: $labels, milestone: $milestone, title: $title
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

