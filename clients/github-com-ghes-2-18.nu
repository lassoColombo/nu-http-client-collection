# Create a reference
#
# POST /repos/{owner}/{repo}/git/refs
# Docs: https://docs.github.com/enterprise-server@2.18/rest/reference/git#create-a-reference — API method documentation
# Returns: record<node_id: string, object: record<sha: string, type: string, url: string>, ref: string, url: string>
# operationId: git/create-ref
export def "git-create-ref" [
