# Docs: https://docs.github.com/enterprise-server@2.18/rest/reference/pulls#list-review-comments-on-a-pull-request — API method documentation
# Returns: table<_links: record<html: record, pull_request: record, self: record>, author_association: string, body: string, body_html: string, body_text: string, commit_id: string, created_at: string, diff_hunk: string, html_url: string, id: int, in_reply_to_id: int, node_id: string, original_commit_id: string, original_position: int, path: string, position: int, pull_request_review_id: int, pull_request_url: string, reactions: record<"+1": int, "-1": int, confused: int, eyes: int, heart: int, hooray: int, laugh: int, rocket: int, total_count: int, url: string>, updated_at: string, url: string, user: record<avatar_url: string, email: string, events_url: string, followers_url: string, following_url: string, gists_url: string, gravatar_id: string, html_url: string, id: int, login: string, name: string, node_id: string, organizations_url: string, received_events_url: string, repos_url: string, site_admin: bool, starred_at: string, starred_url: string, subscriptions_url: string, type: string, url: string>>
# operationId: pulls/list-review-comments
export def "pulls-list-review-comments" [
  owner: string
  repo: string
  pull_number: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --sort: string@sort-completer-5 # One of `created` (when the repository was starred) or `updated` (when it was last pushed to). (default: created)
  --direction: string@direction-completer # Can be either `asc` or `desc`. Ignored without `sort` parameter.
  --since: string # Only show notifications updated after the given time. This is a timestamp in [ISO 8601](https://en.wikipedia.org/wiki/ISO_8601) format: `YYYY-MM-DDTHH:MM:SSZ`. (format: date-time)
  --per-page: int # Results per page (max 100) (default: 30)
  --page: int # Page number of the results to fetch. (default: 1)
]: nothing -> oneof<list<any>, record, string, nothing> {
  http-request {
    method: get
    path: "/repos/{owner}/{repo}/pulls/{pull_number}/comments"
    path_params: [{name: owner, var: owner}, {name: repo, var: repo}, {name: pull_number, var: pull_number}]
    query: [{name: sort, var: sort}, {name: direction, var: direction}, {name: since, var: since}, {name: per_page, var: per_page}, {name: page, var: page}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    owner: $owner, repo: $repo, pull_number: $pull_number, sort: $sort, direction: $direction, since: $since, per_page: $per_page, page: $page
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

