    body: {content_type: "application/json", kind: json, fields: [{name: VolumeSize, var: volume_size}, {name: ParentSnapshotId, var: parent_snapshot_id}, {name: Tags, var: tags}, {name: Description, var: description}, {name: ClientToken, var: client_token}, {name: Encrypted, var: encrypted}, {name: KmsKeyArn, var: kms_key_arn}, {name: Timeout, var: timeout}]}
    accept: ["application/json"]
