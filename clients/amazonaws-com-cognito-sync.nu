  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --x-amz-client-context: string # Intended to supply a device ID that will populate the lastModifiedBy field referenced in other methods. The ClientContext field is not yet implemented.
  --device-id: string # The unique ID generated for this device by Cognito.
  --record-patches: list # A list of patch operations. — item shape: {Op: "replace"|"remove", Key: string, Value?: string, SyncCount: int, DeviceLastModifiedDate?: string}
  sync_session_token: string # The SyncSessionToken returned by a previous call to ListRecords for this dataset and identity.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/identitypools/{IdentityPoolId}/identities/{IdentityId}/datasets/{DatasetName}"
    path_params: [{name: IdentityPoolId, var: identity_pool_id}, {name: IdentityId, var: identity_id}, {name: DatasetName, var: dataset_name}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: x-amz-Client-Context, var: x_amz_client_context}]
    body: {content_type: "application/json", kind: json, fields: [{name: DeviceId, var: device_id}, {name: RecordPatches, var: record_patches}, {name: SyncSessionToken, var: sync_session_token}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    identity_pool_id: $identity_pool_id, identity_id: $identity_id, dataset_name: $dataset_name, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_client_context: $x_amz_client_context, device_id: $device_id, record_patches: $record_patches, sync_session_token: $sync_session_token
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
