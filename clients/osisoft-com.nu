# Returns: record<Items: table<Annotated: bool, Errors: list, Good: bool, Questionable: bool, Substituted: bool, Timestamp: string, UnitsAbbreviation: string, Value: record, WebException: record>, UnitsAbbreviation: string, WebException: record<Errors: list<string>, StatusCode: int>>
