    body: {content_type: "application/json", kind: json, fields: [{name: Abbreviation, var: abbreviation}, {name: Description, var: description}, {name: Factor, var: factor}, {name: Id, var: id}, {name: Links, var: links}, {name: Name, var: name}, {name: Offset, var: offset}, {name: Path, var: path}, {name: ReferenceFactor, var: reference_factor}, {name: ReferenceOffset, var: reference_offset}, {name: ReferenceUnitAbbreviation, var: reference_unit_abbreviation}, {name: WebException, var: web_exception}, {name: WebId, var: body_web_id}]}
    accept: ["application/json", "text/json", "text/html", "application/x-ms-application"]
    ok: [204]
    auth: bearer
  } {
    web_id: $web_id, abbreviation: $abbreviation, description: $description, factor: $factor, id: $id, links: $links, name: $name, offset: $offset, path: $path, reference_factor: $reference_factor, reference_offset: $reference_offset, reference_unit_abbreviation: $reference_unit_abbreviation, web_exception: $web_exception, body_web_id: $body_web_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}
