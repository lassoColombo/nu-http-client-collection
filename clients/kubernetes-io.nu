    namespace: $namespace, name: $name, allow_watch_bookmarks: $allow_watch_bookmarks, continue: $continue, field_selector: $field_selector, label_selector: $label_selector, limit: $limit, pretty: $pretty, resource_version: $resource_version, resource_version_match: $resource_version_match, send_initial_events: $send_initial_events, timeout_seconds: $timeout_seconds, watch: $watch
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

