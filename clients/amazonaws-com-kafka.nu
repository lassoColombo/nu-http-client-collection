# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    batch-associate-scram-secret: "record<ClusterArn: string, UnprocessedScramSecrets: table<ErrorCode: string, ErrorMessage: string, SecretArn: string>>"
    batch-disassociate-scram-secret: "record<ClusterArn: string, UnprocessedScramSecrets: table<ErrorCode: string, ErrorMessage: string, SecretArn: string>>"
    list-scram-secrets: "record<NextToken: string, SecretArnList: list<string>>"
    create-cluster: "record<ClusterArn: string, ClusterName: string, State: string>"
    list-clusters: "record<ClusterInfoList: table<ActiveOperationArn: string, BrokerNodeGroupInfo: record, ClientAuthentication: record, ClusterArn: string, ClusterName: string, CreationTime: string, CurrentBrokerSoftwareInfo: record, CurrentVersion: string, EncryptionInfo: record, EnhancedMonitoring: string, OpenMonitoring: record, LoggingInfo: record, NumberOfBrokerNodes: int, State: string, StateInfo: record, Tags: record, ZookeeperConnectString: string, ZookeeperConnectStringTls: string, StorageMode: string>, NextToken: string>"
    create-cluster-v2: "record<ClusterArn: string, ClusterName: string, State: string, ClusterType: string>"
    list-clusters-v2: "record<ClusterInfoList: table<ActiveOperationArn: string, ClusterType: string, ClusterArn: string, ClusterName: string, CreationTime: string, CurrentVersion: string, State: string, StateInfo: record, Tags: record, Provisioned: record, Serverless: record>, NextToken: string>"
    create-configuration: "record<Arn: string, CreationTime: string, LatestRevision: record<CreationTime: string, Description: string, Revision: int>, Name: string, State: string>"
    list-configurations: "record<Configurations: table<Arn: string, CreationTime: string, Description: string, KafkaVersions: list, LatestRevision: record, Name: string, State: string>, NextToken: string>"
    delete-cluster: "record<ClusterArn: string, State: string>"
    describe-cluster: "record<ClusterInfo: record<ActiveOperationArn: string, BrokerNodeGroupInfo: record<BrokerAZDistribution: string, ClientSubnets: list, InstanceType: string, SecurityGroups: list, StorageInfo: record, ConnectivityInfo: record>, ClientAuthentication: record<Sasl: record, Tls: record, Unauthenticated: record>, ClusterArn: string, ClusterName: string, CreationTime: string, CurrentBrokerSoftwareInfo: record<ConfigurationArn: string, ConfigurationRevision: int, KafkaVersion: string>, CurrentVersion: string, EncryptionInfo: record<EncryptionAtRest: record, EncryptionInTransit: record>, EnhancedMonitoring: string, OpenMonitoring: record<Prometheus: record>, LoggingInfo: record<BrokerLogs: record>, NumberOfBrokerNodes: int, State: string, StateInfo: record<Code: string, Message: string>, Tags: record, ZookeeperConnectString: string, ZookeeperConnectStringTls: string, StorageMode: string>>"
    delete-configuration: "record<Arn: string, State: string>"
    describe-configuration: "record<Arn: string, CreationTime: string, Description: string, KafkaVersions: list<string>, LatestRevision: record<CreationTime: string, Description: string, Revision: int>, Name: string, State: string>"
    update-configuration: "record<Arn: string, LatestRevision: record<CreationTime: string, Description: string, Revision: int>>"
    describe-cluster-v2: "record<ClusterInfo: record<ActiveOperationArn: string, ClusterType: string, ClusterArn: string, ClusterName: string, CreationTime: string, CurrentVersion: string, State: string, StateInfo: record<Code: string, Message: string>, Tags: record, Provisioned: record<BrokerNodeGroupInfo: record, CurrentBrokerSoftwareInfo: record, ClientAuthentication: record, EncryptionInfo: record, EnhancedMonitoring: string, OpenMonitoring: record, LoggingInfo: record, NumberOfBrokerNodes: int, ZookeeperConnectString: string, ZookeeperConnectStringTls: string, StorageMode: string>, Serverless: record<VpcConfigs: list, ClientAuthentication: record>>>"
    describe-cluster-operation: "record<ClusterOperationInfo: record<ClientRequestId: string, ClusterArn: string, CreationTime: string, EndTime: string, ErrorInfo: record<ErrorCode: string, ErrorString: string>, OperationArn: string, OperationState: string, OperationSteps: list<record>, OperationType: string, SourceClusterInfo: record<BrokerEBSVolumeInfo: list, ConfigurationInfo: record, NumberOfBrokerNodes: int, EnhancedMonitoring: string, OpenMonitoring: record, KafkaVersion: string, LoggingInfo: record, InstanceType: string, ClientAuthentication: record, EncryptionInfo: record, ConnectivityInfo: record, StorageMode: string>, TargetClusterInfo: record<BrokerEBSVolumeInfo: list, ConfigurationInfo: record, NumberOfBrokerNodes: int, EnhancedMonitoring: string, OpenMonitoring: record, KafkaVersion: string, LoggingInfo: record, InstanceType: string, ClientAuthentication: record, EncryptionInfo: record, ConnectivityInfo: record, StorageMode: string>>>"
    describe-configuration-revision: "record<Arn: string, CreationTime: string, Description: string, Revision: int, ServerProperties: string>"
    get-bootstrap-brokers: "record<BootstrapBrokerString: string, BootstrapBrokerStringTls: string, BootstrapBrokerStringSaslScram: string, BootstrapBrokerStringSaslIam: string, BootstrapBrokerStringPublicTls: string, BootstrapBrokerStringPublicSaslScram: string, BootstrapBrokerStringPublicSaslIam: string>"
    get-compatible-kafka-versions: "record<CompatibleKafkaVersions: table<SourceVersion: string, TargetVersions: list>>"
    list-cluster-operations: "record<ClusterOperationInfoList: table<ClientRequestId: string, ClusterArn: string, CreationTime: string, EndTime: string, ErrorInfo: record, OperationArn: string, OperationState: string, OperationSteps: list, OperationType: string, SourceClusterInfo: record, TargetClusterInfo: record>, NextToken: string>"
    list-configuration-revisions: "record<NextToken: string, Revisions: table<CreationTime: string, Description: string, Revision: int>>"
    list-kafka-versions: "record<KafkaVersions: table<Version: string, Status: string>, NextToken: string>"
    list-nodes: "record<NextToken: string, NodeInfoList: table<AddedToClusterTime: string, BrokerNodeInfo: record, InstanceType: string, NodeARN: string, NodeType: string, ZookeeperNodeInfo: record>>"
    list-tags-for-resource: "record<Tags: record>"
    reboot-broker: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-broker-count: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-broker-type: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-broker-storage: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-connectivity: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-cluster-configuration: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-cluster-kafka-version: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-monitoring: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-security: "record<ClusterArn: string, ClusterOperationArn: string>"
    update-storage: "record<ClusterArn: string, ClusterOperationArn: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["batch-associate-scram-secret" "batch-disassociate-scram-secret" "list-scram-secrets" "create-cluster" "list-clusters" "create-cluster-v2" "list-clusters-v2" "create-configuration" "list-configurations" "delete-cluster" "describe-cluster" "delete-configuration" "describe-configuration" "update-configuration" "describe-cluster-v2" "describe-cluster-operation" "describe-configuration-revision" "get-bootstrap-brokers" "get-compatible-kafka-versions" "list-cluster-operations" "list-configuration-revisions" "list-kafka-versions" "list-nodes" "list-tags-for-resource" "tag-resource" "reboot-broker" "untag-resource" "update-broker-count" "update-broker-type" "update-broker-storage" "update-connectivity" "update-cluster-configuration" "update-cluster-kafka-version" "update-monitoring" "update-security" "update-storage" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Associates one or more Scram Secrets with an Amazon MSK cluster.
