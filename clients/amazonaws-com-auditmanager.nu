    update-assessment-control-set-status: "record<controlSet: record<id: string, description: string, status: string, roles: list<record>, controls: list<record>, delegations: list<record>, systemEvidenceCount: int, manualEvidenceCount: int>>"
    update-assessment-framework-share: "record<assessmentFrameworkShareRequest: record<id: string, frameworkId: string, frameworkName: string, frameworkDescription: string, status: string, sourceAccount: string, destinationAccount: string, destinationRegion: string, expirationTime: string, creationTime: string, lastUpdated: string, comment: string, standardControlsCount: int, customControlsCount: int, complianceType: string>>"
    update-assessment-status: "record<assessment: record<arn: string, awsAccount: record<id: string, emailAddress: string, name: string>, metadata: record<name: string, id: string, description: string, complianceType: string, status: string, assessmentReportsDestination: record, scope: record, roles: list, delegations: list, creationTime: string, lastUpdated: string>, framework: record<id: string, arn: string, metadata: record, controlSets: list>, tags: record>>"
    update-settings: "record<settings: record<isAwsOrgEnabled: bool, snsTopic: string, defaultAssessmentReportsDestination: record<destinationType: string, destination: string>, defaultProcessOwners: list<record>, kmsKey: string, evidenceFinderEnablement: record<eventDataStoreArn: string, enablementStatus: string, backfillStatus: string, error: string>, deregistrationPolicy: record<deleteResources: string>>>"
    validate-assessment-report-integrity: "record<signatureValid: bool, signatureAlgorithm: string, signatureDateTime: string, signatureKeyId: string, validationErrors: list<string>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["associate-assessment-report-evidence-folder" "batch-associate-assessment-report-evidence" "batch-create-delegation-by-assessment" "batch-delete-delegation-by-assessment" "batch-disassociate-assessment-report-evidence" "batch-import-evidence-to-assessment-control" "create-assessment" "list-assessments" "create-assessment-framework" "create-assessment-report" "create-control" "delete-assessment" "get-assessment" "update-assessment" "delete-assessment-framework" "get-assessment-framework" "update-assessment-framework" "delete-assessment-framework-share" "delete-assessment-report" "delete-control" "get-control" "update-control" "deregister-account" "deregister-organization-admin-account" "disassociate-assessment-report-evidence-folder" "get-account-status" "get-assessment-report-url" "get-change-logs" "get-delegations" "get-evidence" "get-evidence-by-evidence-folder" "get-evidence-folder" "get-evidence-folders-by-assessment" "get-evidence-folders-by-assessment-control" "get-insights" "get-insights-by-assessment" "get-organization-admin-account" "get-services-in-scope" "get-settings" "list-assessment-control-insights-by-control-domain" "list-assessment-framework-share-requests" "list-assessment-frameworks" "list-assessment-reports" "list-control-domain-insights" "list-control-domain-insights-by-assessment" "list-control-insights-by-control-domain" "list-controls" "list-keywords-for-data-source" "list-notifications" "list-tags-for-resource" "tag-resource" "register-account" "register-organization-admin-account" "start-assessment-framework-share" "untag-resource" "update-assessment-control" "update-assessment-control-set-status" "update-assessment-framework-share" "update-assessment-status" "update-settings" "validate-assessment-report-integrity" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Associates an evidence folder to an assessment report in an Audit Manager assessment.
#
# PUT /assessments/{assessmentId}/associateToAssessmentReport
# Returns: record
# operationId: AssociateAssessmentReportEvidenceFolder
export def "associate-assessment-report-evidence-folder" [
  assessment_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  evidence_folder_id: string # The identifier for the folder that the evidence is stored in.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/assessments/{assessmentId}/associateToAssessmentReport"
    path_params: [{name: assessmentId, var: assessment_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: evidenceFolderId, var: evidence_folder_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    assessment_id: $assessment_id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, evidence_folder_id: $evidence_folder_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Associates a list of evidence to an assessment report in an Audit Manager assessment.
#
# PUT /assessments/{assessmentId}/batchAssociateToAssessmentReport
# Returns: record<evidenceIds: list<string>, errors: table<evidenceId: string, errorCode: string, errorMessage: string>>
# operationId: BatchAssociateAssessmentReportEvidence
export def "batch-associate-assessment-report-evidence" [
  assessment_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  evidence_folder_id: string # The identifier for the folder that the evidence is stored in.
  evidence_ids: list<string> # The list of evidence identifiers.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/assessments/{assessmentId}/batchAssociateToAssessmentReport"
    path_params: [{name: assessmentId, var: assessment_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: evidenceFolderId, var: evidence_folder_id}, {name: evidenceIds, var: evidence_ids}]}
    accept: ["application/json"]
    ok: [200]
