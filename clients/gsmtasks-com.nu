    accept: ["application/json; version=2.4.13"]
    ok: [201]
    auth: bearer
  } {
    account: $account, assignee: $assignee, code: $code, description: $description, end_location: $end_location, end_time: $end_time, external_id: $external_id, start_location: $start_location, start_time: $start_time
