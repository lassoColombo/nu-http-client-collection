    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "AWSWAF_20190729.UpdateWebACL"}]
    body: {content_type: "application/json", kind: json, fields: [{name: Name, var: name}, {name: Scope, var: scope}, {name: Id, var: id}, {name: DefaultAction, var: default_action}, {name: Description, var: description}, {name: Rules, var: rules}, {name: VisibilityConfig, var: visibility_config}, {name: LockToken, var: lock_token}, {name: CustomResponseBodies, var: custom_response_bodies}, {name: CaptchaConfig, var: captcha_config}, {name: ChallengeConfig, var: challenge_config}, {name: TokenDomains, var: token_domains}, {name: AssociationConfig, var: association_config}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, x_amz_target: $x_amz_target, name: $name, scope: $scope, id: $id, default_action: $default_action, description: $description, rules: $rules, visibility_config: $visibility_config, lock_token: $lock_token, custom_response_bodies: $custom_response_bodies, captcha_config: $captcha_config, challenge_config: $challenge_config, token_domains: $token_domains, association_config: $association_config
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}
