# operationId: Status
export def "status" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --msg-id: string # The ID from the SMS. (required)
]: nothing -> any {
  http-request {
    method: get
    path: "/status"
    query: [{name: msg_id, var: msg_id, required: true}]
    accept: ["text/plain"]
    ok: [200]
    auth: x-api-key
  } {
    msg_id: $msg_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# POST /validate_for_voice
#
# Returns: record<code: string, error: string, success: bool>
# operationId: ValidateForVoice
export def "validate-for-voice" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --number: string # Determines the recipient. Can only be a number, not a contact from your address book. (required)
  --callback: string # The callback URL which gets queried right after validation. (format: uri)
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: post
    path: "/validate_for_voice"
    query: [{name: number, var: number, required: true}, {name: callback, var: callback}]
    accept: ["application/json"]
    ok: [200]
    auth: x-api-key
  } {
    number: $number, callback: $callback
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# POST /voice
#
# Returns: string
# operationId: Voice
export def "voice" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --to: string # Determines the receiver. Must be a valid phone number or contact from the address book. (required)
  --text: string # The text to convert to a voice message. Accepts valid XML too. (required)
  --xml: float@xml-completer # Decides whether the parameter "text" is plain text or XML. The default value is 0.
  --from: string # Sets the sender. Must be a verified sender. Use an inbound number of yours or one of ours.
]: nothing -> any {
  http-request {
    method: post
    path: "/voice"
    query: [{name: to, var: to, required: true}, {name: text, var: text, required: true}, {name: xml, var: xml}, {name: from, var: from}]
    accept: ["text/plain"]
    ok: [200]
    auth: x-api-key
  } {
    to: $to, text: $text, xml: $xml, from: $from
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}
