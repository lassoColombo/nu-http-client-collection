# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    add-notification-channel: "record<Id: string>"
    list-notification-channels: "record<Channels: table<Id: string, Config: record>, NextToken: string>"
    delete-insight: "record"
    describe-insight: "record<ProactiveInsight: record<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record<StartTime: string, EndTime: string>, PredictionTimeRange: record<StartTime: string, EndTime: string>, ResourceCollection: record<CloudFormation: record, Tags: list>, SsmOpsItemId: string, Description: string>, ReactiveInsight: record<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record<StartTime: string, EndTime: string>, ResourceCollection: record<CloudFormation: record, Tags: list>, SsmOpsItemId: string, Description: string>>"
    describe-account-health: "record<OpenReactiveInsights: int, OpenProactiveInsights: int, MetricsAnalyzed: int, ResourceHours: int, AnalyzedResourceCount: int>"
    describe-account-overview: "record<ReactiveInsights: int, ProactiveInsights: int, MeanTimeToRecoverInMilliseconds: int>"
    describe-anomaly: "record<ProactiveAnomaly: record<Id: string, Severity: string, Status: string, UpdateTime: string, AnomalyTimeRange: record<StartTime: string, EndTime: string>, AnomalyReportedTimeRange: record<OpenTime: string, CloseTime: string>, PredictionTimeRange: record<StartTime: string, EndTime: string>, SourceDetails: record<CloudWatchMetrics: list, PerformanceInsightsMetrics: list>, AssociatedInsightId: string, ResourceCollection: record<CloudFormation: record, Tags: list>, Limit: float, SourceMetadata: record<Source: string, SourceResourceName: string, SourceResourceType: string>, AnomalyResources: list<record>, Description: string>, ReactiveAnomaly: record<Id: string, Severity: string, Status: string, AnomalyTimeRange: record<StartTime: string, EndTime: string>, AnomalyReportedTimeRange: record<OpenTime: string, CloseTime: string>, SourceDetails: record<CloudWatchMetrics: list, PerformanceInsightsMetrics: list>, AssociatedInsightId: string, ResourceCollection: record<CloudFormation: record, Tags: list>, Type: string, Name: string, Description: string, CausalAnomalyId: string, AnomalyResources: list<record>>>"
    describe-event-sources-config: "record<EventSources: record<AmazonCodeGuruProfiler: record<Status: string>>>"
    update-event-sources-config: "record"
    describe-feedback: "record<InsightFeedback: record<Id: string, Feedback: string>>"
    put-feedback: "record"
    describe-organization-health: "record<OpenReactiveInsights: int, OpenProactiveInsights: int, MetricsAnalyzed: int, ResourceHours: int>"
    describe-organization-overview: "record<ReactiveInsights: int, ProactiveInsights: int>"
    describe-organization-resource-collection-health: "record<CloudFormation: table<StackName: string, Insight: record, AnalyzedResourceCount: int>, Service: table<ServiceName: string, Insight: record, AnalyzedResourceCount: int>, Account: table<AccountId: string, Insight: record>, NextToken: string, Tags: table<AppBoundaryKey: string, TagValue: string, Insight: record, AnalyzedResourceCount: int>>"
    describe-resource-collection-health: "record<CloudFormation: table<StackName: string, Insight: record, AnalyzedResourceCount: int>, Service: table<ServiceName: string, Insight: record, AnalyzedResourceCount: int>, NextToken: string, Tags: table<AppBoundaryKey: string, TagValue: string, Insight: record, AnalyzedResourceCount: int>>"
    describe-service-integration: "record<ServiceIntegration: record<OpsCenter: record<OptInStatus: string>, LogsAnomalyDetection: record<OptInStatus: string>>>"
    update-service-integration: "record"
    get-cost-estimation: "record<ResourceCollection: record<CloudFormation: record<StackNames: list>, Tags: list<record>>, Status: string, Costs: table<Type: string, State: string, Count: int, UnitCost: float, Cost: float>, TimeRange: record<StartTime: string, EndTime: string>, TotalCost: float, NextToken: string>"
    start-cost-estimation: "record"
    get-resource-collection: "record<ResourceCollection: record<CloudFormation: record<StackNames: list>, Tags: list<record>>, NextToken: string>"
    list-anomalies-for-insight: "record<ProactiveAnomalies: table<Id: string, Severity: string, Status: string, UpdateTime: string, AnomalyTimeRange: record, AnomalyReportedTimeRange: record, PredictionTimeRange: record, SourceDetails: record, AssociatedInsightId: string, ResourceCollection: record, Limit: float, SourceMetadata: record, AnomalyResources: list, Description: string>, ReactiveAnomalies: table<Id: string, Severity: string, Status: string, AnomalyTimeRange: record, AnomalyReportedTimeRange: record, SourceDetails: record, AssociatedInsightId: string, ResourceCollection: record, Type: string, Name: string, Description: string, CausalAnomalyId: string, AnomalyResources: list>, NextToken: string>"
    list-anomalous-log-groups: "record<InsightId: string, AnomalousLogGroups: table<LogGroupName: string, ImpactStartTime: string, ImpactEndTime: string, NumberOfLogLinesScanned: int, LogAnomalyShowcases: list>, NextToken: string>"
    list-events: "record<Events: table<ResourceCollection: record, Id: string, Time: string, EventSource: string, Name: string, DataSource: string, EventClass: string, Resources: list>, NextToken: string>"
    list-insights: "record<ProactiveInsights: table<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, PredictionTimeRange: record, ResourceCollection: record, ServiceCollection: record, AssociatedResourceArns: list>, ReactiveInsights: table<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, ResourceCollection: record, ServiceCollection: record, AssociatedResourceArns: list>, NextToken: string>"
    list-monitored-resources: "record<MonitoredResourceIdentifiers: table<MonitoredResourceName: string, Type: string, ResourcePermission: string, LastUpdated: string, ResourceCollection: record>, NextToken: string>"
    list-organization-insights: "record<ProactiveInsights: table<Id: string, AccountId: string, OrganizationalUnitId: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, PredictionTimeRange: record, ResourceCollection: record, ServiceCollection: record>, ReactiveInsights: table<Id: string, AccountId: string, OrganizationalUnitId: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, ResourceCollection: record, ServiceCollection: record>, NextToken: string>"
    list-recommendations: "record<Recommendations: table<Description: string, Link: string, Name: string, Reason: string, RelatedEvents: list, RelatedAnomalies: list, Category: string>, NextToken: string>"
    remove-notification-channel: "record"
    search-insights: "record<ProactiveInsights: table<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, PredictionTimeRange: record, ResourceCollection: record, ServiceCollection: record, AssociatedResourceArns: list>, ReactiveInsights: table<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, ResourceCollection: record, ServiceCollection: record, AssociatedResourceArns: list>, NextToken: string>"
    search-organization-insights: "record<ProactiveInsights: table<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, PredictionTimeRange: record, ResourceCollection: record, ServiceCollection: record, AssociatedResourceArns: list>, ReactiveInsights: table<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record, ResourceCollection: record, ServiceCollection: record, AssociatedResourceArns: list>, NextToken: string>"
    update-resource-collection: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["add-notification-channel" "list-notification-channels" "delete-insight" "describe-insight" "describe-account-health" "describe-account-overview" "describe-anomaly" "describe-event-sources-config" "update-event-sources-config" "describe-feedback" "put-feedback" "describe-organization-health" "describe-organization-overview" "describe-organization-resource-collection-health" "describe-resource-collection-health" "describe-service-integration" "update-service-integration" "get-cost-estimation" "start-cost-estimation" "get-resource-collection" "list-anomalies-for-insight" "list-anomalous-log-groups" "list-events" "list-insights" "list-monitored-resources" "list-organization-insights" "list-recommendations" "remove-notification-channel" "search-insights" "search-organization-insights" "update-resource-collection" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Adds a notification channel to DevOps Guru. A notification channel is used to notify you about important DevOps Guru events, such as when an insight is generated. If you use an Amazon SNS topic in another account, you must attach a policy to it that grants DevOps Guru permission to it notifications. DevOps Guru adds the required policy on your behalf to send notifications using Amazon SNS in your account. DevOps Guru only supports standard SNS topics. For more information, see Permissions for cross account Amazon SNS topics (https://docs.aws.amazon.com/devops-guru/latest/userguide/sns-required-permissions.html). If you use an Amazon SNS topic in another account, you must attach a policy to it that grants DevOps Guru permission to it notifications. DevOps Guru adds the required policy on your behalf to send notifications using Amazon SNS in your account. For more information, see Permissions for cross account Amazon SNS topics. If you use an Amazon SNS topic that is encrypted by an Amazon Web Services Key Management Service customer-managed key (CMK), then you must add permissions to the CMK. For more information, see Permissions for Amazon Web Services KMS–encrypted Amazon SNS topics (https://docs.aws.amazon.com/devops-guru/latest/userguide/sns-kms-permissions.html).
#
# PUT /channels
# Returns: record<Id: string>
# operationId: AddNotificationChannel
export def "add-notification-channel" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  config: record # Information about notification channels you have configured with DevOps Guru. The one supported notification channel is Amazon Simple Notification Service (Amazon SNS). — shape: {Sns?: record, Filters?: record}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: put
    path: "/channels"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: Config, var: config}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, config: $config
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Returns a list of notification channels configured for DevOps Guru. Each notification channel is used to notify you when DevOps Guru generates an insight that contains information about how to improve your operations. The one supported notification channel is Amazon Simple Notification Service (Amazon SNS).
#
# POST /channels
# Returns: record<Channels: table<Id: string, Config: record>, NextToken: string>
# operationId: ListNotificationChannels
export def "list-notification-channels" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --next-token: string # Pagination token
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --body-next-token: string # The pagination token to use to retrieve the next page of results for this operation. If this value is null, it retrieves the first page. (spec name: NextToken)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/channels"
    query: [{name: NextToken, var: next_token}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: NextToken, var: body_next_token}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    next_token: $next_token, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, body_next_token: $body_next_token
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

