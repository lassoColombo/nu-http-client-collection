# Returns details about an insight that you specify using its ID.
#
# GET /insights/{Id}
# Returns: record<ProactiveInsight: record<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record<StartTime: string, EndTime: string>, PredictionTimeRange: record<StartTime: string, EndTime: string>, ResourceCollection: record<CloudFormation: record, Tags: list>, SsmOpsItemId: string, Description: string>, ReactiveInsight: record<Id: string, Name: string, Severity: string, Status: string, InsightTimeRange: record<StartTime: string, EndTime: string>, ResourceCollection: record<CloudFormation: record, Tags: list>, SsmOpsItemId: string, Description: string>>
# operationId: DescribeInsight
export def "describe-insight" [
  id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --account-id: string # The ID of the member account in the organization.
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/insights/{Id}"
    path_params: [{name: Id, var: id}]
    query: [{name: AccountId, var: account_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
