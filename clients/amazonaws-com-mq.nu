    body: {content_type: "application/json", kind: json, fields: [{name: authenticationStrategy, var: authentication_strategy}, {name: autoMinorVersionUpgrade, var: auto_minor_version_upgrade, required: true}, {name: brokerName, var: broker_name}, {name: configuration, var: configuration}, {name: creatorRequestId, var: creator_request_id}, {name: deploymentMode, var: deployment_mode}, {name: encryptionOptions, var: encryption_options}, {name: engineType, var: engine_type}, {name: engineVersion, var: engine_version}, {name: hostInstanceType, var: host_instance_type}, {name: ldapServerMetadata, var: ldap_server_metadata}, {name: logs, var: logs}, {name: maintenanceWindowStartTime, var: maintenance_window_start_time}, {name: publiclyAccessible, var: publicly_accessible, required: true}, {name: securityGroups, var: security_groups}, {name: storageType, var: storage_type}, {name: subnetIds, var: subnet_ids}, {name: tags, var: tags}, {name: users, var: users}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, authentication_strategy: $authentication_strategy, auto_minor_version_upgrade: $auto_minor_version_upgrade, broker_name: $broker_name, configuration: $configuration, creator_request_id: $creator_request_id, deployment_mode: $deployment_mode, encryption_options: $encryption_options, engine_type: $engine_type, engine_version: $engine_version, host_instance_type: $host_instance_type, ldap_server_metadata: $ldap_server_metadata, logs: $logs, maintenance_window_start_time: $maintenance_window_start_time, publicly_accessible: $publicly_accessible, security_groups: $security_groups, storage_type: $storage_type, subnet_ids: $subnet_ids, tags: $tags, users: $users
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
