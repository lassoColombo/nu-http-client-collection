# operationId: GetYear
export def "get-year" [
  year: int
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --user-id: string # Optional. Filter by user id, and attach user data. (nullable, format: uuid)
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/Years/{year}"
    path_params: [{name: year, var: year}]
    query: [{name: userId, var: user_id}]
    accept: ["application/json", "application/json; profile=\"CamelCase\"", "application/json; profile=\"PascalCase\""]
    ok: [200]
    auth: x-emby-authorization
  } {
    year: $year, user_id: $user_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

# Gets a dashboard configuration page.
#
# GET /web/ConfigurationPage
# Returns: binary
# operationId: GetDashboardConfigurationPage
export def "get-dashboard-configuration-page" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer-3 # Response content type
  --name: string # The name of the page. (nullable)
]: nothing -> any {
  http-request {
    method: get
    path: "/web/ConfigurationPage"
    query: [{name: name, var: name}]
    accept: ["application/x-javascript", "text/html"]
    ok: [200]
    auth: x-emby-authorization
  } {
    name: $name
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

# Gets the configuration pages.
#
# GET /web/ConfigurationPages
# Returns: table<ConfigurationPageType: string, DisplayName: string, EnableInMainMenu: bool, MenuIcon: string, MenuSection: string, Name: string, PluginId: string>
# operationId: GetConfigurationPages
export def "get-configuration-pages" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --enable-in-main-menu: oneof<nothing, bool> # Whether to enable in the main menu. (nullable)
  --page-type: string@page-type-completer # The Jellyfin.Api.Models.ConfigurationPageInfo.
]: nothing -> oneof<list<any>, record, string, nothing> {
  http-request {
    method: get
    path: "/web/ConfigurationPages"
    query: [{name: enableInMainMenu, var: enable_in_main_menu}, {name: pageType, var: page_type}]
    accept: ["application/json", "application/json; profile=\"CamelCase\"", "application/json; profile=\"PascalCase\""]
    ok: [200]
    auth: x-emby-authorization
  } {
    enable_in_main_menu: $enable_in_main_menu, page_type: $page_type
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}
