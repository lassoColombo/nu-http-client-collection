  --SortRemoveWords: list # Gets or sets words to be removed from strings to create a sort name. (nullable)
  --SortReplaceCharacters: list # Gets or sets characters to be replaced with a ' ' in strings to create a sort name. (nullable)
  --TrustAllIP6Interfaces: oneof<nothing, bool> # Gets or sets a value indicating whether all IPv6 interfaces should be treated as on the internal network. Depending on the address range implemented ULA ranges might not be used.
  --UDPPortRange: string # Gets or sets client udp port range. (nullable)
  --UDPSendCount: int # Gets or sets the number of times SSDP UDP messages are sent. (format: int32)
