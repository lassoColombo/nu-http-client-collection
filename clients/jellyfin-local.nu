]: any -> record<ChannelMappings: table<Name: string, Value: string>, Country: string, EnableAllTuners: bool, EnabledTuners: list<string>, Id: string, KidsCategories: list<string>, ListingsId: string, MovieCategories: list<string>, MoviePrefix: string, NewsCategories: list<string>, Password: string, Path: string, PreferredLanguage: string, SportsCategories: list<string>, Type: string, UserAgent: string, Username: string, ZipCode: string> {
