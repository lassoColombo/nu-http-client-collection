te-maintenance-event" "compute-node-groups-get-iam-policy" "compute-node-groups-set-iam-policy" "compute-node-groups-test-iam-permissions" "compute-node-types-list" "compute-node-types-get" "compute-zone-operations-list" "compute-zone-operations-delete" "compute-zone-operations-get" "compute-zone-operations-wait" "compute-reservations-list" "compute-reservations-insert" "compute-reservations-delete" "compute-reservations-get" "compute-reservations-update" "compute-reservations-resize" "compute-reservations-get-iam-policy" "compute-reservations-set-iam-policy" "compute-reservations-test-iam-permissions" "compute-target-instances-list" "compute-target-instances-insert" "compute-target-instances-delete" "compute-target-instances-get" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
