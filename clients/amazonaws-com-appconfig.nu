# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-application: "record<Id: string, Name: string, Description: string>"
    list-applications: "record<Items: table<Id: string, Name: string, Description: string>, NextToken: string>"
    create-configuration-profile: "record<ApplicationId: string, Id: string, Name: string, Description: string, LocationUri: string, RetrievalRoleArn: string, Validators: table<Type: string, Content: string>, Type: string>"
    list-configuration-profiles: "record<Items: table<ApplicationId: string, Id: string, Name: string, LocationUri: string, ValidatorTypes: list, Type: string>, NextToken: string>"
    create-deployment-strategy: "record<Id: string, Name: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, ReplicateTo: string>"
    list-deployment-strategies: "record<Items: table<Id: string, Name: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, ReplicateTo: string>, NextToken: string>"
    create-environment: "record<ApplicationId: string, Id: string, Name: string, Description: string, State: string, Monitors: table<AlarmArn: string, AlarmRoleArn: string>>"
    list-environments: "record<Items: table<ApplicationId: string, Id: string, Name: string, Description: string, State: string, Monitors: list>, NextToken: string>"
    create-extension: "record<Id: string, Name: string, VersionNumber: int, Arn: string, Description: string, Actions: record, Parameters: record>"
    list-extensions: "record<Items: table<Id: string, Name: string, VersionNumber: int, Arn: string, Description: string>, NextToken: string>"
    create-extension-association: "record<Id: string, ExtensionArn: string, ResourceArn: string, Arn: string, Parameters: record, ExtensionVersionNumber: int>"
    list-extension-associations: "record<Items: table<Id: string, ExtensionArn: string, ResourceArn: string>, NextToken: string>"
    create-hosted-configuration-version: "record<Content: string>"
    get-application: "record<Id: string, Name: string, Description: string>"
    update-application: "record<Id: string, Name: string, Description: string>"
    get-configuration-profile: "record<ApplicationId: string, Id: string, Name: string, Description: string, LocationUri: string, RetrievalRoleArn: string, Validators: table<Type: string, Content: string>, Type: string>"
    update-configuration-profile: "record<ApplicationId: string, Id: string, Name: string, Description: string, LocationUri: string, RetrievalRoleArn: string, Validators: table<Type: string, Content: string>, Type: string>"
    get-environment: "record<ApplicationId: string, Id: string, Name: string, Description: string, State: string, Monitors: table<AlarmArn: string, AlarmRoleArn: string>>"
    update-environment: "record<ApplicationId: string, Id: string, Name: string, Description: string, State: string, Monitors: table<AlarmArn: string, AlarmRoleArn: string>>"
    get-extension: "record<Id: string, Name: string, VersionNumber: int, Arn: string, Description: string, Actions: record, Parameters: record>"
    update-extension: "record<Id: string, Name: string, VersionNumber: int, Arn: string, Description: string, Actions: record, Parameters: record>"
    get-extension-association: "record<Id: string, ExtensionArn: string, ResourceArn: string, Arn: string, Parameters: record, ExtensionVersionNumber: int>"
    update-extension-association: "record<Id: string, ExtensionArn: string, ResourceArn: string, Arn: string, Parameters: record, ExtensionVersionNumber: int>"
    get-hosted-configuration-version: "record<Content: string>"
    get-configuration: "record<Content: string>"
    get-deployment: "record<ApplicationId: string, EnvironmentId: string, DeploymentStrategyId: string, ConfigurationProfileId: string, DeploymentNumber: int, ConfigurationName: string, ConfigurationLocationUri: string, ConfigurationVersion: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, State: string, EventLog: table<EventType: string, TriggeredBy: string, Description: string, ActionInvocations: list, OccurredAt: string>, PercentageComplete: float, StartedAt: string, CompletedAt: string, AppliedExtensions: table<ExtensionId: string, ExtensionAssociationId: string, VersionNumber: int, Parameters: record>, KmsKeyArn: string, KmsKeyIdentifier: string>"
    stop-deployment: "record<ApplicationId: string, EnvironmentId: string, DeploymentStrategyId: string, ConfigurationProfileId: string, DeploymentNumber: int, ConfigurationName: string, ConfigurationLocationUri: string, ConfigurationVersion: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, State: string, EventLog: table<EventType: string, TriggeredBy: string, Description: string, ActionInvocations: list, OccurredAt: string>, PercentageComplete: float, StartedAt: string, CompletedAt: string, AppliedExtensions: table<ExtensionId: string, ExtensionAssociationId: string, VersionNumber: int, Parameters: record>, KmsKeyArn: string, KmsKeyIdentifier: string>"
    get-deployment-strategy: "record<Id: string, Name: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, ReplicateTo: string>"
    update-deployment-strategy: "record<Id: string, Name: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, ReplicateTo: string>"
    list-deployments: "record<Items: table<DeploymentNumber: int, ConfigurationName: string, ConfigurationVersion: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, State: string, PercentageComplete: float, StartedAt: string, CompletedAt: string>, NextToken: string>"
    start-deployment: "record<ApplicationId: string, EnvironmentId: string, DeploymentStrategyId: string, ConfigurationProfileId: string, DeploymentNumber: int, ConfigurationName: string, ConfigurationLocationUri: string, ConfigurationVersion: string, Description: string, DeploymentDurationInMinutes: int, GrowthType: string, GrowthFactor: float, FinalBakeTimeInMinutes: int, State: string, EventLog: table<EventType: string, TriggeredBy: string, Description: string, ActionInvocations: list, OccurredAt: string>, PercentageComplete: float, StartedAt: string, CompletedAt: string, AppliedExtensions: table<ExtensionId: string, ExtensionAssociationId: string, VersionNumber: int, Parameters: record>, KmsKeyArn: string, KmsKeyIdentifier: string>"
    list-hosted-configuration-versions: "record<Items: table<ApplicationId: string, ConfigurationProfileId: string, VersionNumber: int, Description: string, ContentType: string, VersionLabel: string>, NextToken: string>"
    list-tags-for-resource: "record<Tags: record>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-application" "list-applications" "create-configuration-profile" "list-configuration-profiles" "create-deployment-strategy" "list-deployment-strategies" "create-environment" "list-environments" "create-extension" "list-extensions" "create-extension-association" "list-extension-associations" "create-hosted-configuration-version" "delete-application" "get-application" "update-application" "delete-configuration-profile" "get-configuration-profile" "update-configuration-profile" "delete-deployment-strategy" "delete-environment" "get-environment" "update-environment" "delete-extension" "get-extension" "update-extension" "delete-extension-association" "get-extension-association" "update-extension-association" "delete-hosted-configuration-version" "get-hosted-configuration-version" "get-configuration" "get-deployment" "stop-deployment" "get-deployment-strategy" "update-deployment-strategy" "list-deployments" "start-deployment" "list-hosted-configuration-versions" "list-tags-for-resource" "tag-resource" "untag-resource" "validate-configuration" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Creates an application. In AppConfig, an application is simply an organizational construct like a folder. This organizational construct has a relationship with some unit of executable code. For example, you could create an application called MyMobileApp to organize and manage configuration data for a mobile application installed by your users.
#
# POST /applications
# Returns: record<Id: string, Name: string, Description: string>
# operationId: CreateApplication
export def "create-application" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  name: string # A name for the application.
  --description: string # A description of the application.
  --tags: record # Metadata to assign to the application. Tags help organize and categorize your AppConfig resources. Each tag consists of a key and an optional value, both of which you define.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/applications"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: Name, var: name}, {name: Description, var: description}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, name: $name, description: $description, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Lists all applications in your Amazon Web Services account.
#
# GET /applications
# Returns: record<Items: table<Id: string, Name: string, Description: string>, NextToken: string>
# operationId: ListApplications
export def "list-applications" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --max-results: int # The maximum number of items to return for this call. The call also returns a token that you can specify in a subsequent call to get the next set of results.
  --next-token: string # A token to start the list. Next token is a pagination token generated by AppConfig to describe what page the previous List call ended on. For the first List request, the nextToken should not be set. On subsequent calls, the nextToken parameter should be set to the previous responses nextToken value. Use this token to get the next set of results.
  --qp-max-results: string # Pagination limit (spec name: MaxResults)
  --qp-next-token: string # Pagination token (spec name: NextToken)
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/applications"
    query: [{name: max_results, var: max_results}, {name: next_token, var: next_token}, {name: MaxResults, var: qp_max_results}, {name: NextToken, var: qp_next_token}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    max_results: $max_results, next_token: $next_token, qp_max_results: $qp_max_results, qp_next_token: $qp_next_token, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Creates a configuration profile, which is information that enables AppConfig to access the configuration source. Valid configuration sources include the following: Configuration data in YAML, JSON, and other formats stored in the AppConfig hosted configuration store Configuration data stored as objects in an Amazon Simple Storage Service (Amazon S3) bucket Pipelines stored in CodePipeline Secrets stored in Secrets Manager Standard and secure string parameters stored in Amazon Web Services Systems Manager Parameter Store Configuration data in SSM documents stored in the Systems Manager document store A configuration profile includes the following information: The URI location of the configuration data. The Identity and Access Management (IAM) role that provides access to the configuration data. A validator for the configuration data. Available validators include either a JSON Schema or an Amazon Web Services Lambda function. For more information, see Create a Configuration and a Configuration Profile (http://docs.aws.amazon.com/appconfig/latest/userguide/appconfig-creating-configuration-and-profile.html) in the AppConfig User Guide.
#
# POST /applications/{ApplicationId}/configurationprofiles
# Returns: record<ApplicationId: string, Id: string, Name: string, Description: string, LocationUri: string, RetrievalRoleArn: string, Validators: table<Type: string, Content: string>, Type: string>
# operationId: CreateConfigurationProfile
export def "create-configuration-profile" [
  application_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  name: string # A name for the configuration profile.
  --description: string # A description of the configuration profile.
  location_uri: string # A URI to locate the configuration. You can specify the following: For the AppConfig hosted configuration store and for feature flags, specify hosted. For an Amazon Web Services Systems Manager Parameter Store parameter, specify either the parameter name in the format ssm-parameter://<parameter name> or the ARN. For an Secrets Manager secret, specify the URI in the following format: secrets-manager://<secret name>. For an Amazon S3 object, specify the URI in the following format: s3://<bucket>/<objectKey> . Here is an example: s3://my-bucket/my-app/us-east-1/my-config.json For an SSM document, specify either the document name in the format ssm-document://<document name> or the Amazon Resource Name (ARN).
  --retrieval-role-arn: string # The ARN of an IAM role with permission to access the configuration at the specified LocationUri. A retrieval role ARN is not required for configurations stored in the AppConfig hosted configuration store. It is required for all other sources that store your configuration.
  --validators: list # A list of methods for validating the configuration. — item shape: {Type: "JSON_SCHEMA"|"LAMBDA", Content: string}
  --tags: record # Metadata to assign to the configuration profile. Tags help organize and categorize your AppConfig resources. Each tag consists of a key and an optional value, both of which you define.
  --type: string # The type of configurations contained in the profile. AppConfig supports feature flags and freeform configurations. We recommend you create feature flag configurations to enable or disable new features and freeform configurations to distribute configurations to an application. When calling this API, enter one of the following values for Type: AWS.AppConfig.FeatureFlags AWS.Freeform
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/applications/{ApplicationId}/configurationprofiles"
    path_params: [{name: ApplicationId, var: application_id}]
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: Name, var: name}, {name: Description, var: description}, {name: LocationUri, var: location_uri}, {name: RetrievalRoleArn, var: retrieval_role_arn}, {name: Validators, var: validators}, {name: Tags, var: tags}, {name: Type, var: type}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    application_id: $application_id, x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, name: $name, description: $description, location_uri: $location_uri, retrieval_role_arn: $retrieval_role_arn, validators: $validators, tags: $tags, type: $type
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Lists the configuration profiles for an application.
#
# GET /applications/{ApplicationId}/configurationprofiles
# Returns: record<Items: table<ApplicationId: string, Id: string, Name: string, LocationUri: string, ValidatorTypes: list, Type: string>, NextToken: string>
# operationId: ListConfigurationProfiles
export def "list-configuration-profiles" [
  application_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --max-results: int # The maximum number of items to return for this call. The call also returns a token that you can specify in a subsequent call to get the next set of results.
  --next-token: string # A token to start the list. Use this token to get the next set of results.
  --type: string # A filter based on the type of configurations that the configuration profile contains. A configuration can be a feature flag or a freeform configuration.
  --qp-max-results: string # Pagination limit (spec name: MaxResults)
  --qp-next-token: string # Pagination token (spec name: NextToken)
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/applications/{ApplicationId}/configurationprofiles"
