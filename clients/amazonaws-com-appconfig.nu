    method: post
    path: "/deploymentstrategies"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: Name, var: name}, {name: Description, var: description}, {name: DeploymentDurationInMinutes, var: deployment_duration_in_minutes}, {name: FinalBakeTimeInMinutes, var: final_bake_time_in_minutes}, {name: GrowthFactor, var: growth_factor}, {name: GrowthType, var: growth_type}, {name: ReplicateTo, var: replicate_to}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, name: $name, description: $description, deployment_duration_in_minutes: $deployment_duration_in_minutes, final_bake_time_in_minutes: $final_bake_time_in_minutes, growth_factor: $growth_factor, growth_type: $growth_type, replicate_to: $replicate_to, tags: $tags
