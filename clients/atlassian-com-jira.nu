    method: get
    path: "/rest/api/3/issuetypescheme"
    query: [{name: startAt, var: start_at}, {name: maxResults, var: max_results}, {name: id, var: id, style: multi}, {name: orderBy, var: order_by}, {name: expand, var: expand}, {name: queryString, var: query_string}]
