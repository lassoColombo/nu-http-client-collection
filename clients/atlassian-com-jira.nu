# Get workflow transition rule configurations
#
# POST /rest/atlassian-connect/1/migration/workflow/rule/search
# Returns: record<invalidRules: list<string>, validRules: table<conditions: list, postFunctions: list, validators: list, workflowId: record>, workflowEntityId: string>
# operationId: MigrationResource.workflowRuleSearch_post
export def "migration-resource-workflow-rule-search-post" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --atlassian-transfer-id: string # The app migration transfer ID. (required, format: uuid)
  --expand: string # Use expand to include additional information in the response. This parameter accepts `transition` which, for each rule, returns information about the transition the rule is assigned to. (e.g. transition)
  rule_ids: list<string> # The list of workflow rule IDs.
  workflow_entity_id: string # The workflow ID. (format: uuid, e.g. a498d711-685d-428d-8c3e-bc03bb450ea7)
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/rest/atlassian-connect/1/migration/workflow/rule/search"
    header: [{name: Atlassian-Transfer-Id, var: atlassian_transfer_id, required: true}]
    body: {content_type: "application/json", kind: json, fields: [{name: expand, var: expand}, {name: ruleIds, var: rule_ids}, {name: workflowEntityId, var: workflow_entity_id}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    atlassian_transfer_id: $atlassian_transfer_id, expand: $expand, rule_ids: $rule_ids, workflow_entity_id: $workflow_entity_id
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}
