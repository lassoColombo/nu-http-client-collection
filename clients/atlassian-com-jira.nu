    query: [{name: id, var: id, style: multi}, {name: fieldContextId, var: field_context_id, style: multi}, {name: issueId, var: issue_id}, {name: projectKeyOrId, var: project_key_or_id}, {name: issueTypeId, var: issue_type_id}, {name: startAt, var: start_at}, {name: maxResults, var: max_results}]
    accept: ["application/json"]
    ok: [200]
    auth: basic
  } {
    field_id_or_key: $field_id_or_key, id: $id, field_context_id: $field_context_id, issue_id: $issue_id, project_key_or_id: $project_key_or_id, issue_type_id: $issue_type_id, start_at: $start_at, max_results: $max_results
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
