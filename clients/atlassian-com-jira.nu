  --dry-run(-n) # Return the request that would be sent without executing it
  --color: string # The color of the gadget. Should be one of `blue`, `red`, `yellow`, `green`, `cyan`, `purple`, `gray`, or `white`.
  --ignore-uri-and-module-key-validation: oneof<nothing, bool> # Whether to ignore the validation of module key and URI. For example, when a gadget is created that is a part of an application that isn't installed.
  --module-key: string # The module key of the gadget type. Can't be provided with `uri`.
  --position: record # The position of the gadget. When the gadget is placed into the position, other gadgets in the same column are moved down to accommodate it. — shape: {The column position of the gadget.: int, The row position of the gadget.: int}
  --title: string # The title of the gadget.
  --uri: string # The URI of the gadget type. Can't be provided with `moduleKey`.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/rest/api/3/dashboard/{dashboardId}/gadget"
    path_params: [{name: dashboardId, var: dashboard_id}]
    body: {content_type: "application/json", kind: json, fields: [{name: color, var: color}, {name: ignoreUriAndModuleKeyValidation, var: ignore_uri_and_module_key_validation}, {name: moduleKey, var: module_key}, {name: position, var: position}, {name: title, var: title}, {name: uri, var: uri}]}
    accept: ["application/json"]
    ok: [200]
    auth: basic
  } {
    dashboard_id: $dashboard_id, color: $color, ignore_uri_and_module_key_validation: $ignore_uri_and_module_key_validation, module_key: $module_key, position: $position, title: $title, uri: $uri
