  --dry-run(-n) # Return the request that would be sent without executing it
  --atlassian-transfer-id: string # The ID of the transfer. (required, format: uuid)
  --update-value-list: list # The list of custom field update details. — item shape: {_type: "StringIssueField"|"NumberIssueField"|"RichTextIssueField"|"SingleSelectIssueField"|"MultiSelectIssueField"|"TextIssueField", fieldID: int, issueID: int, number?: float, optionID?: string, richText?: string, string?: string, text?: string}
]: any -> any {
  $in | http-request {
    method: put
    path: "/rest/atlassian-connect/1/migration/field"
    header: [{name: Atlassian-Transfer-Id, var: atlassian_transfer_id, required: true}]
    body: {content_type: "application/json", kind: json, fields: [{name: updateValueList, var: update_value_list}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    atlassian_transfer_id: $atlassian_transfer_id, update_value_list: $update_value_list
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
