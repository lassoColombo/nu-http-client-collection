    body: {content_type: "application/json", kind: json, fields: [{name: comment, var: comment}, {name: properties, var: properties}, {name: started, var: started}, {name: timeSpent, var: time_spent}, {name: timeSpentSeconds, var: time_spent_seconds}, {name: visibility, var: visibility}]}
