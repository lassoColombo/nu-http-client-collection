  --spot-options: record # Describes the configuration of Spot Instances in an EC2 Fleet.
  --on-demand-options: record # Describes the configuration of On-Demand Instances in an EC2 Fleet.
  --excess-capacity-termination-policy: string@excess-capacity-termination-policy-completer # Indicates whether running instances should be terminated if the total target capacity of the EC2 Fleet is decreased below the current size of the EC2 Fleet. Supported only for fleets of type maintain.
  --launch-template-configs: list # The configuration for the EC2 Fleet.
  --target-capacity-specification: record # The number of units to request.
