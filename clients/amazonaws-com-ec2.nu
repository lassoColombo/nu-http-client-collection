  --excess-capacity-termination-policy: string@excess-capacity-termination-policy-completer # Indicates whether running instances should be terminated if the total target capacity of the EC2 Fleet is decreased below the current size of the EC2 Fleet. Supported only for fleets of type maintain.
  --launch-template-config: list # The launch template and overrides.
  --fleet-id: string # The ID of the EC2 Fleet.
  --target-capacity-specification: record # The size of the EC2 Fleet.
  --context: string # Reserved.
  --action: string@action-completer-467
