# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-configuration-set: "record"
    list-configuration-sets: "record<ConfigurationSets: list<string>, NextToken: string>"
    create-configuration-set-event-destination: "record"
    get-configuration-set-event-destinations: "record<EventDestinations: table<Name: string, Enabled: bool, MatchingEventTypes: list, KinesisFirehoseDestination: record, CloudWatchDestination: record, SnsDestination: record, PinpointDestination: record>>"
    create-dedicated-ip-pool: "record"
    list-dedicated-ip-pools: "record<DedicatedIpPools: list<string>, NextToken: string>"
    create-deliverability-test-report: "record<ReportId: string, DeliverabilityTestStatus: string>"
    create-email-identity: "record<IdentityType: string, VerifiedForSendingStatus: bool, DkimAttributes: record<SigningEnabled: bool, Status: string, Tokens: list<string>>>"
    list-email-identities: "record<EmailIdentities: table<IdentityType: string, IdentityName: string, SendingEnabled: bool>, NextToken: string>"
    delete-configuration-set: "record"
    get-configuration-set: "record<ConfigurationSetName: string, TrackingOptions: record<CustomRedirectDomain: string>, DeliveryOptions: record<TlsPolicy: string, SendingPoolName: string>, ReputationOptions: record<ReputationMetricsEnabled: bool, LastFreshStart: string>, SendingOptions: record<SendingEnabled: bool>, Tags: table<Key: string, Value: string>>"
    delete-configuration-set-event-destination: "record"
    update-configuration-set-event-destination: "record"
    delete-dedicated-ip-pool: "record"
    delete-email-identity: "record"
    get-email-identity: "record<IdentityType: string, FeedbackForwardingStatus: bool, VerifiedForSendingStatus: bool, DkimAttributes: record<SigningEnabled: bool, Status: string, Tokens: list<string>>, MailFromAttributes: record<MailFromDomain: string, MailFromDomainStatus: string, BehaviorOnMxFailure: string>, Tags: table<Key: string, Value: string>>"
    get-account: "record<SendQuota: record<Max24HourSend: float, MaxSendRate: float, SentLast24Hours: float>, SendingEnabled: bool, DedicatedIpAutoWarmupEnabled: bool, EnforcementStatus: string, ProductionAccessEnabled: bool>"
    get-blacklist-reports: "record<BlacklistReport: record>"
    get-dedicated-ip: "record<DedicatedIp: record<Ip: string, WarmupStatus: string, WarmupPercentage: int, PoolName: string>>"
    get-dedicated-ips: "record<DedicatedIps: table<Ip: string, WarmupStatus: string, WarmupPercentage: int, PoolName: string>, NextToken: string>"
    get-deliverability-dashboard-options: "record<DashboardEnabled: bool, SubscriptionExpiryDate: string, AccountStatus: string, ActiveSubscribedDomains: table<Domain: string, SubscriptionStartDate: string, InboxPlacementTrackingOption: record>, PendingExpirationSubscribedDomains: table<Domain: string, SubscriptionStartDate: string, InboxPlacementTrackingOption: record>>"
    put-deliverability-dashboard-option: "record"
    get-deliverability-test-report: "record<DeliverabilityTestReport: record<ReportId: string, ReportName: string, Subject: string, FromEmailAddress: string, CreateDate: string, DeliverabilityTestStatus: string>, OverallPlacement: record<InboxPercentage: float, SpamPercentage: float, MissingPercentage: float, SpfPercentage: float, DkimPercentage: float>, IspPlacements: table<IspName: string, PlacementStatistics: record>, Message: string, Tags: table<Key: string, Value: string>>"
    get-domain-deliverability-campaign: "record<DomainDeliverabilityCampaign: record<CampaignId: string, ImageUrl: string, Subject: string, FromAddress: string, SendingIps: list<string>, FirstSeenDateTime: string, LastSeenDateTime: string, InboxCount: int, SpamCount: int, ReadRate: float, DeleteRate: float, ReadDeleteRate: float, ProjectedVolume: int, Esps: list<string>>>"
    get-domain-statistics-report: "record<OverallVolume: record<VolumeStatistics: record<InboxRawCount: int, SpamRawCount: int, ProjectedInbox: int, ProjectedSpam: int>, ReadRatePercent: float, DomainIspPlacements: list<record>>, DailyVolumes: table<StartDate: string, VolumeStatistics: record, DomainIspPlacements: list>>"
    list-deliverability-test-reports: "record<DeliverabilityTestReports: table<ReportId: string, ReportName: string, Subject: string, FromEmailAddress: string, CreateDate: string, DeliverabilityTestStatus: string>, NextToken: string>"
    list-domain-deliverability-campaigns: "record<DomainDeliverabilityCampaigns: table<CampaignId: string, ImageUrl: string, Subject: string, FromAddress: string, SendingIps: list, FirstSeenDateTime: string, LastSeenDateTime: string, InboxCount: int, SpamCount: int, ReadRate: float, DeleteRate: float, ReadDeleteRate: float, ProjectedVolume: int, Esps: list>, NextToken: string>"
    list-tags-for-resource: "record<Tags: table<Key: string, Value: string>>"
    put-account-dedicated-ip-warmup-attributes: "record"
    put-account-sending-attributes: "record"
    put-configuration-set-delivery-options: "record"
    put-configuration-set-reputation-options: "record"
    put-configuration-set-sending-options: "record"
    put-configuration-set-tracking-options: "record"
    put-dedicated-ip-in-pool: "record"
    put-dedicated-ip-warmup-attributes: "record"
    put-email-identity-dkim-attributes: "record"
    put-email-identity-feedback-attributes: "record"
    put-email-identity-mail-from-attributes: "record"
    send-email: "record<MessageId: string>"
    tag-resource: "record"
    untag-resource: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-configuration-set" "list-configuration-sets" "create-configuration-set-event-destination" "get-configuration-set-event-destinations" "create-dedicated-ip-pool" "list-dedicated-ip-pools" "create-deliverability-test-report" "create-email-identity" "list-email-identities" "delete-configuration-set" "get-configuration-set" "delete-configuration-set-event-destination" "update-configuration-set-event-destination" "delete-dedicated-ip-pool" "delete-email-identity" "get-email-identity" "get-account" "get-blacklist-reports" "get-dedicated-ip" "get-dedicated-ips" "get-deliverability-dashboard-options" "put-deliverability-dashboard-option" "get-deliverability-test-report" "get-domain-deliverability-campaign" "get-domain-statistics-report" "list-deliverability-test-reports" "list-domain-deliverability-campaigns" "list-tags-for-resource" "put-account-dedicated-ip-warmup-attributes" "put-account-sending-attributes" "put-configuration-set-delivery-options" "put-configuration-set-reputation-options" "put-configuration-set-sending-options" "put-configuration-set-tracking-options" "put-dedicated-ip-in-pool" "put-dedicated-ip-warmup-attributes" "put-email-identity-dkim-attributes" "put-email-identity-feedback-attributes" "put-email-identity-mail-from-attributes" "send-email" "tag-resource" "untag-resource" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# Create a configuration set. Configuration sets are groups of rules that you can apply to the emails you send using Amazon Pinpoint. You apply a configuration set to an email by including a reference to the configuration set in the headers of the email. When you apply a configuration set to an email, all of the rules in that configuration set are applied to the email.
#
# POST /v1/email/configuration-sets
# Returns: record
# operationId: CreateConfigurationSet
export def "create-configuration-set" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  configuration_set_name: string # The name of a configuration set. In Amazon Pinpoint, configuration sets are groups of rules that you can apply to the emails you send. You apply a configuration set to an email by including a reference to the configuration set in the headers of the email. When you apply a configuration set to an email, all of the rules in that configuration set are applied to the email.
  --tracking-options: record # An object that defines the tracking options for a configuration set. When you use Amazon Pinpoint to send an email, it contains an invisible image that's used to track when recipients open your email. If your email contains links, those links are changed slightly in order to track when recipients click them. These images and links include references to a domain operated by AWS. You can optionally configure Amazon Pinpoint to use a domain that you operate for these images and links. — shape: {CustomRedirectDomain?: string}
  --delivery-options: record # Used to associate a configuration set with a dedicated IP pool. — shape: {TlsPolicy?: "REQUIRE"|"OPTIONAL", SendingPoolName?: string}
  --reputation-options: record # Enable or disable collection of reputation metrics for emails that you send using this configuration set in the current AWS Region. — shape: {ReputationMetricsEnabled?: bool, LastFreshStart?: string}
  --sending-options: record # Used to enable or disable email sending for messages that use this configuration set in the current AWS Region. — shape: {SendingEnabled?: bool}
  --tags: list # An array of objects that define the tags (keys and values) that you want to associate with the configuration set. — item shape: {Key: string, Value: string}
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/v1/email/configuration-sets"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: ConfigurationSetName, var: configuration_set_name}, {name: TrackingOptions, var: tracking_options}, {name: DeliveryOptions, var: delivery_options}, {name: ReputationOptions, var: reputation_options}, {name: SendingOptions, var: sending_options}, {name: Tags, var: tags}]}
    accept: ["application/json"]
    ok: [200]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, configuration_set_name: $configuration_set_name, tracking_options: $tracking_options, delivery_options: $delivery_options, reputation_options: $reputation_options, sending_options: $sending_options, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# List all of the configuration sets associated with your Amazon Pinpoint account in the current region. In Amazon Pinpoint, configuration sets are groups of rules that you can apply to the emails you send. You apply a configuration set to an email by including a reference to the configuration set in the headers of the email. When you apply a configuration set to an email, all of the rules in that configuration set are applied to the email.
