# Completers for enum parameters
def sort-by-completer [] { ["EVENT_TIME"] }
def sort-order-completer [] { ["ASCENDING" "DESCENDING"] }
def status-completer [] { ["OPEN" "RESOLVED"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    create-replication-set: "record<arn: string>"
    create-response-plan: "record<arn: string>"
    create-timeline-event: "record<eventId: string, incidentRecordArn: string>"
    delete-incident-record: "record"
    delete-replication-set: "record"
    delete-resource-policy: "record"
    delete-response-plan: "record"
    delete-timeline-event: "record"
    get-incident-record: "record<incidentRecord: record<arn: string, automationExecutions: list<record>, chatChannel: record<chatbotSns: list, empty: record>, creationTime: string, dedupeString: string, impact: int, incidentRecordSource: record<createdBy: string, invokedBy: string, resourceArn: string, source: string>, lastModifiedBy: string, lastModifiedTime: string, notificationTargets: list<record>, resolvedTime: string, status: string, summary: string, title: string>>"
    get-replication-set: "record<replicationSet: record<arn: string, createdBy: string, createdTime: string, deletionProtected: bool, lastModifiedBy: string, lastModifiedTime: string, regionMap: record, status: string>>"
    get-resource-policies: "record<nextToken: string, resourcePolicies: table<policyDocument: string, policyId: string, ramResourceShareRegion: string>>"
    get-response-plan: "record<actions: table<ssmAutomation: record>, arn: string, chatChannel: record<chatbotSns: list<string>, empty: record>, displayName: string, engagements: list<string>, incidentTemplate: record<dedupeString: string, impact: int, incidentTags: record, notificationTargets: list<record>, summary: string, title: string>, integrations: table<pagerDutyConfiguration: record>, name: string>"
    get-timeline-event: "record<event: record<eventData: string, eventId: string, eventReferences: list<record>, eventTime: string, eventType: string, eventUpdatedTime: string, incidentRecordArn: string>>"
    list-incident-records: "record<incidentRecordSummaries: table<arn: string, creationTime: string, impact: int, incidentRecordSource: record, resolvedTime: string, status: string, title: string>, nextToken: string>"
    list-related-items: "record<nextToken: string, relatedItems: table<generatedId: string, identifier: record, title: string>>"
    list-replication-sets: "record<nextToken: string, replicationSetArns: list<string>>"
    list-response-plans: "record<nextToken: string, responsePlanSummaries: table<arn: string, displayName: string, name: string>>"
    list-tags-for-resource: "record<tags: record>"
    tag-resource: "record"
    list-timeline-events: "record<eventSummaries: table<eventId: string, eventReferences: list, eventTime: string, eventType: string, eventUpdatedTime: string, incidentRecordArn: string>, nextToken: string>"
    put-resource-policy: "record<policyId: string>"
    start-incident: "record<incidentRecordArn: string>"
    untag-resource: "record"
    update-deletion-protection: "record"
    update-incident-record: "record"
    update-related-items: "record"
    update-replication-set: "record"
    update-response-plan: "record"
    update-timeline-event: "record"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["create-replication-set" "create-response-plan" "create-timeline-event" "delete-incident-record" "delete-replication-set" "delete-resource-policy" "delete-response-plan" "delete-timeline-event" "get-incident-record" "get-replication-set" "get-resource-policies" "get-response-plan" "get-timeline-event" "list-incident-records" "list-related-items" "list-replication-sets" "list-response-plans" "list-tags-for-resource" "tag-resource" "list-timeline-events" "put-resource-policy" "start-incident" "untag-resource" "update-deletion-protection" "update-incident-record" "update-related-items" "update-replication-set" "update-response-plan" "update-timeline-event" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

# A replication set replicates and encrypts your data to the provided Regions with the provided KMS key.
#
# POST /createReplicationSet
# Returns: record<arn: string>
# operationId: CreateReplicationSet
export def "create-replication-set" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --client-token: string # A token that ensures that the operation is called only once with the specified details.
  regions: record # The Regions that Incident Manager replicates your data to. You can have up to three Regions in your replication set.
  --tags: record # A list of tags to add to the replication set.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/createReplicationSet"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: clientToken, var: client_token}, {name: regions, var: regions}, {name: tags, var: tags}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, client_token: $client_token, regions: $regions, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Creates a response plan that automates the initial response to incidents. A response plan engages contacts, starts chat channel collaboration, and initiates runbooks at the beginning of an incident.
#
# POST /createResponsePlan
# Returns: record<arn: string>
# operationId: CreateResponsePlan
export def "create-response-plan" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --x-amz-content-sha256: string
  --x-amz-date: string
  --x-amz-algorithm: string
  --x-amz-credential: string
  --x-amz-security-token: string
  --x-amz-signature: string
  --x-amz-signed-headers: string
  --actions: list # The actions that the response plan starts at the beginning of an incident. — item shape: {ssmAutomation?: record}
  --chat-channel: record # The Chatbot chat channel used for collaboration during an incident. — shape: {chatbotSns?: list<string>, empty?: record}
  --client-token: string # A token ensuring that the operation is called only once with the specified details.
  --display-name: string # The long format of the response plan name. This field can contain spaces.
  --engagements: list<string> # The Amazon Resource Name (ARN) for the contacts and escalation plans that the response plan engages during an incident.
  incident_template: record # Basic details used in creating a response plan. The response plan is then used to create an incident record. — shape: {dedupeString?: string, impact?: int, incidentTags?: record, notificationTargets?: list, summary?: string, title?: string}
  --integrations: list # Information about third-party services integrated into the response plan. — item shape: {pagerDutyConfiguration?: record}
  name: string # The short format name of the response plan. Can't include spaces.
  --tags: record # A list of tags that you are adding to the response plan.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/createResponsePlan"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}]
    body: {content_type: "application/json", kind: json, fields: [{name: actions, var: actions}, {name: chatChannel, var: chat_channel}, {name: clientToken, var: client_token}, {name: displayName, var: display_name}, {name: engagements, var: engagements}, {name: incidentTemplate, var: incident_template}, {name: integrations, var: integrations}, {name: name, var: name}, {name: tags, var: tags}]}
    accept: ["application/json"]
    ok: [201]
    auth: bearer
  } {
    x_amz_content_sha256: $x_amz_content_sha256, x_amz_date: $x_amz_date, x_amz_algorithm: $x_amz_algorithm, x_amz_credential: $x_amz_credential, x_amz_security_token: $x_amz_security_token, x_amz_signature: $x_amz_signature, x_amz_signed_headers: $x_amz_signed_headers, actions: $actions, chat_channel: $chat_channel, client_token: $client_token, display_name: $display_name, engagements: $engagements, incident_template: $incident_template, integrations: $integrations, name: $name, tags: $tags
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run
  }
}

# Creates a custom timeline event on the incident details page of an incident record. Incident Manager automatically creates timeline events that mark key moments during an incident. You can create custom timeline events to mark important events that Incident Manager can detect automatically.
#
# POST /createTimelineEvent
# Returns: record<eventId: string, incidentRecordArn: string>
# operationId: CreateTimelineEvent
export def "create-timeline-event" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
