}

# Import unbilled charges
#
# POST /subscriptions/{subscription-id}/import_unbilled_charges
# operationId: import_unbilled_charges
# --unbilled_charges shape: {id?: list, date_from: list, date_to: list, entity_type: list, entity_id?: list, description?: list, unit_amount?: list, quantity?: list, amount?: list, unit_amount_in_decimal?: list, quantity_in_decimal?: list, amount_in_decimal?: list, discount_amount?: list, use_for_proration?: list, is_advance_charge?: list}
# --discounts shape: {unbilled_charge_id?: list, entity_type?: list, entity_id?: list, description?: list, amount: list}
# --tiers shape: {unbilled_charge_id: list, starting_unit?: list, ending_unit?: list, quantity_used?: list, unit_amount?: list, starting_unit_in_decimal?: list, ending_unit_in_decimal?: list, quantity_used_in_decimal?: list, unit_amount_in_decimal?: list}
export def "subscriptions-import-unbilled-charges charges" [
  subscription_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --chargebee-request-origin-device: string # The device from which the customer has made the request (e.g. Android)
  --chargebee-request-origin-user: string # The email address of your customer/user. Use this when the email address has only ASCII characters. (e.g. user@example.com)
  --chargebee-request-origin-user-encoded: string # The Base64-encoded email address of your customer/user. Use this if the email address has UTF-8 characters. When this header is provided, the header chargebee-request-origin-user is ignored. (e.g. dXNlci7QutCy0ZbRgtC+0YfQutCwQGV4YW1wbGUuY29t)
  --chargebee-request-origin-ip: string # The IP address of the customer where the request originated (e.g. 192.168.1.2)
  --chargebee-event-actions: string@chargebee-event-actions-completer # skip all actions to be done on the events
  --chargebee-event-email: string@chargebee-event-email-completer # skip only emails
  --chargebee-event-webhook: string@chargebee-event-webhook-completer #  skip only webhooks
  --chargebee-business-entity-id: string # If the site has multiple business entities, you can use this custom HTTP header to specify the business entity for which Chargebee should perform the operation.
  --unbilled-charges: record # Parameters for unbilled_charges — shape: {id?: list, date_from: list, date_to: list, entity_type: list, entity_id?: list, description?: list, unit_amount?: list, quantity?: list, amount?: list, unit_amount_in_decimal?: list, quantity_in_decimal?: list, amount_in_decimal?: list, discount_amount?: list, use_for_proration?: list, is_advance_charge?: list}
  --discounts: record # Parameters for discounts — shape: {unbilled_charge_id?: list, entity_type?: list, entity_id?: list, description?: list, amount: list}
  --tiers: record # Parameters for tiers — shape: {unbilled_charge_id: list, starting_unit?: list, ending_unit?: list, quantity_used?: list, unit_amount?: list, starting_unit_in_decimal?: list, ending_unit_in_decimal?: list, quantity_used_in_decimal?: list, unit_amount_in_decimal?: list}
]: any -> record<unbilled_charges: table<id: string, customer_id: string, subscription_id: string, date_from: int, date_to: int, unit_amount: int, pricing_model: string, quantity: int, amount: int, currency_code: string, discount_amount: int, description: string, entity_type: string, entity_id: string, is_voided: bool, voided_at: int, unit_amount_in_decimal: string, quantity_in_decimal: string, amount_in_decimal: string, created_at: int, updated_at: int, is_advance_charge: bool, business_entity_id: string, deleted: bool, tiers: list>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "basic"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/subscriptions/($subscription_id)/import_unbilled_charges")
  let body = {unbilled_charges: $unbilled_charges, discounts: $discounts, tiers: $tiers} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
