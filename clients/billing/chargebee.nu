  --chargebee-event-webhook: string@chargebee-event-webhook-completer #  skip only webhooks
  --chargebee-business-entity-id: string # If the site has multiple business entities, you can use this custom HTTP header to specify the business entity for which Chargebee should perform the operation.
  name: string # A name to identify the webhook endpoint.
  --api-version: string@api-version-completer # The API version used to format the webhook payload. Ensure this version matches the client library used by your webhook server \* v1 -  If selected, the payload includes only attributes from API v1 resources. \* v2 -  If selected, the payload includes only attributes from API v2 resources.  (default: v2)
  --body-url: string # <p class="mb-2">The target URL where webhook notifications will be sent.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Note</strong> Only URL ports <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">80</code>, <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">443</code>, <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">8080</code>, or <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">8443</code> are allowed.</p></div>
  --primary-url: oneof<nothing, bool> # Indicates whether this webhook is marked as the primary endpoint. If only one exists, it is primary by default.  (default: false)
  --disabled: oneof<nothing, bool> # <p class="mb-2">Indicates whether the webhook endpoint is disabled. Set to <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">true</code> to disable the endpoint, set to <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">false</code> to enable the endpoint.</p> (default: false)
  --basic-auth-password: string # The password used for basic authentication to secure webhook delivery.
  --basic-auth-username: string # Username for basic authentication used to secure webhook delivery.
  --send-card-resource: oneof<nothing, bool> # Controls whether card-related resources are included in the webhook payload. Card details are always masked.  (default: false)
  --chargebee-response-schema-type: string@chargebee-response-schema-type-completer # <p class="mb-2">Indicates the response schema used in the webhook payload,  based on the product catalog version configured for the site.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Note</strong> This field is only applicable if the site is in <a href="https://www.chargebee.com/docs/billing/1.0/product-catalog/product-catalog-coexistence-ui-changes"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">compat</code></a> mode.</p></div> * compat - <p class="mb-2">The webhook payload uses a schema compatible with both Product Catalog 1.0 and 2.0. This is applicable only to sites automatically upgraded to Product Catalog 2.0.</p> * plans_addons - <p class="mb-2">The webhook payload follows the <a href="https://www.chargebee.com/docs/billing/1.0/product-catalog/product-catalog">Product Catalog 1.0</a> schema and uses the <a href="/docs/api/v2/pcv-1/plans">Plans</a> and <a href="/docs/api/v2/pcv-1/addons">Addons</a> model.</p> * items - <p class="mb-2">The webhook payload follows the <a href="https://www.chargebee.com/docs/billing/2.0/product-catalog/product-catalog" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">Product Catalog 2.0</a> schema and uses the <a href="/docs/api/items">Items API model</a> .</p>
  --enabled-events: list # A list of event types that trigger this webhook.   **Note** If this field is left empty, the webhook will enable [all event types](/docs/api/webhook_endpoints) by default.
]: any -> record<webhook_endpoint: record<id: string, name: string, url: string, send_card_resource: bool, disabled: bool, primary_url: bool, api_version: string, chargebee_response_schema_type: string, enabled_events: list<string>>> {
