# Delete a quote
#
# POST /quotes/{quote-id}/delete
# operationId: delete_a_quote
export def "quotes-delete quote" [
  quote_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --chargebee-request-origin-device: string # The device from which the customer has made the request (e.g. Android)
  --chargebee-request-origin-user: string # The email address of your customer/user. Use this when the email address has only ASCII characters. (e.g. user@example.com)
  --chargebee-request-origin-user-encoded: string # The Base64-encoded email address of your customer/user. Use this if the email address has UTF-8 characters. When this header is provided, the header chargebee-request-origin-user is ignored. (e.g. dXNlci7QutCy0ZbRgtC+0YfQutCwQGV4YW1wbGUuY29t)
  --chargebee-request-origin-ip: string # The IP address of the customer where the request originated (e.g. 192.168.1.2)
  --chargebee-event-actions: string@chargebee-event-actions-completer # skip all actions to be done on the events
  --chargebee-event-email: string@chargebee-event-email-completer # skip only emails
  --chargebee-event-webhook: string@chargebee-event-webhook-completer #  skip only webhooks
  --chargebee-business-entity-id: string # If the site has multiple business entities, you can use this custom HTTP header to specify the business entity for which Chargebee should perform the operation.
  --comment: string # Reason for deleting this transaction. This comment will be added to the associated entity.
]: any -> record<quote: record<id: string, name: string, po_number: string, customer_id: string, subscription_id: string, invoice_id: string, status: string, operation_type: string, vat_number: string, price_type: string, valid_till: int, date: int, total_payable: int, charge_on_acceptance: int, sub_total: int, total: int, credits_applied: int, amount_paid: int, amount_due: int, version: int, resource_version: int, updated_at: int, vat_number_prefix: string, tax_category: string, currency_code: string, notes: list<any>, contract_term_start: int, contract_term_end: int, contract_term_termination_fee: int, business_entity_id: string, deleted: bool, total_contract_value: int, total_discount: int, line_items: list<record>, line_item_tiers: list<record>, line_item_discounts: list<record>, line_item_taxes: list<record>, discounts: list<record>, taxes: list<record>, shipping_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, billing_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>>, quoted_subscription: record<id: string, billing_period: int, billing_period_unit: string, start_date: int, trial_end: int, remaining_billing_cycles: int, po_number: string, auto_collection: string, plan_quantity_in_decimal: string, plan_unit_price_in_decimal: string, changes_scheduled_at: int, change_option: string, free_period: int, free_period_unit: string, contract_term_billing_cycle_on_renewal: int, coupons: list<record>, discounts: list<record>, subscription_items: list<record>, item_tiers: list<record>, quoted_contract_term: record<contract_start: int, contract_end: int, billing_cycle: int, action_at_term_end: string, total_contract_value: int, cancellation_cutoff_period: int>>, quoted_charge: record<charges: list<record>, invoice_items: list<record>, item_tiers: list<record>, coupons: list<record>, discounts: list<record>, coupon_applicability_mappings: list<record>>, quoted_ramp: record<id: string, line_items: list<record>, discounts: list<record>, item_tiers: list<record>, coupon_applicability_mappings: list<record>>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "basic"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/quotes/($quote_id)/delete")
  let body = {comment: $comment} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
