# --bank_account shape: {gateway_account_id?: string, iban?: string, first_name?: string, last_name?: string, company?: string, email?: string, phone?: string, bank_name?: string, account_number?: string, routing_number?: string, bank_code?: string, account_type?: "checking"|"savings"|"business_checking"|"current", account_holder_type?: "individual"|"company", echeck_type?: "web"|"ppd"|"ccd", issuing_country?: string, swedish_identity_number?: string, billing_address?: record}
