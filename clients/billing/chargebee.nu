# Import invoice
#
# POST /invoices/import_invoice
# operationId: import_invoice
# --credit_note shape: {id?: string}
# --billing_address shape: {first_name?: string, last_name?: string, email?: string, company?: string, phone?: string, line1?: string, line2?: string, line3?: string, city?: string, state_code?: string, state?: string, zip?: string, country?: string, validation_status?: "not_validated"|"valid"|"partially_valid"|"invalid"}
# --shipping_address shape: {first_name?: string, last_name?: string, email?: string, company?: string, phone?: string, line1?: string, line2?: string, line3?: string, city?: string, state_code?: string, state?: string, zip?: string, country?: string, validation_status?: "not_validated"|"valid"|"partially_valid"|"invalid"}
# --line_items shape: {id?: list, date_from?: list, date_to?: list, subscription_id?: list, description: list, unit_amount?: list, quantity?: list, amount?: list, unit_amount_in_decimal?: list, quantity_in_decimal?: list, amount_in_decimal?: list, entity_type?: list, entity_id?: list, item_level_discount1_entity_id?: list, item_level_discount1_amount?: list, item_level_discount2_entity_id?: list, item_level_discount2_amount?: list, tax1_name?: list, tax1_amount?: list, tax2_name?: list, tax2_amount?: list, tax3_name?: list, tax3_amount?: list, tax4_name?: list, tax4_amount?: list, tax5_name?: list, tax5_amount?: list, tax6_name?: list, tax6_amount?: list, tax7_name?: list, tax7_amount?: list, tax8_name?: list, tax8_amount?: list, tax9_name?: list, tax9_amount?: list, tax10_name?: list, tax10_amount?: list, created_at?: list}
# --payment_reference_numbers shape: {id?: list, type: list, number: list}
# --line_item_tiers shape: {line_item_id: list, starting_unit?: list, ending_unit?: list, quantity_used?: list, unit_amount?: list, starting_unit_in_decimal?: list, ending_unit_in_decimal?: list, quantity_used_in_decimal?: list, unit_amount_in_decimal?: list}
# --discounts shape: {line_item_id?: list, entity_type: list, entity_id?: list, description?: list, amount: list}
# --taxes shape: {name: list, rate: list, amount?: list, description?: list, juris_type?: list, juris_name?: list, juris_code?: list}
# --payments shape: {id?: list, amount: list, payment_method: list, date?: list, reference_number?: list}
# --notes shape: {entity_type?: list, entity_id?: list, note?: list}
# --line_item_addresses shape: {line_item_id?: list, first_name?: list, last_name?: list, email?: list, company?: list, phone?: list, line1?: list, line2?: list, line3?: list, city?: list, state_code?: list, state?: list, zip?: list, country?: list, validation_status?: list}
export def "invoices-import-invoice invoice" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --chargebee-request-origin-device: string # The device from which the customer has made the request (e.g. Android)
  --chargebee-request-origin-user: string # The email address of your customer/user. Use this when the email address has only ASCII characters. (e.g. user@example.com)
  --chargebee-request-origin-user-encoded: string # The Base64-encoded email address of your customer/user. Use this if the email address has UTF-8 characters. When this header is provided, the header chargebee-request-origin-user is ignored. (e.g. dXNlci7QutCy0ZbRgtC+0YfQutCwQGV4YW1wbGUuY29t)
  --chargebee-request-origin-ip: string # The IP address of the customer where the request originated (e.g. 192.168.1.2)
  --chargebee-event-actions: string@chargebee-event-actions-completer # skip all actions to be done on the events
  --chargebee-event-email: string@chargebee-event-email-completer # skip only emails
  --chargebee-event-webhook: string@chargebee-event-webhook-completer #  skip only webhooks
  --chargebee-business-entity-id: string # If the site has multiple business entities, you can use this custom HTTP header to specify the business entity for which Chargebee should perform the operation.
  id: string # <p class="mb-2">The invoice ID (also known as the invoice number).</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Constraints</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">Must be unique so that it does not conflict with any existing <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">invoice.id</code>.</li> </ul></div>
  --currency-code: string # The currency code (ISO 4217 format) for the invoice.
  --customer-id: string # <p class="mb-2">Identifier of the <a href="/docs/api/customers" class="text-blue-600 hover:text-blue-800 underline">customer</a> resource to which this invoice belongs.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Required if</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">subscription_id</code> is not provided.</li> </ul></div> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Constraints</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">If <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">subscription_id</code> is provided: <ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">For regular subscriptions: <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">customer_id</code> must match the <a href="/docs/api/subscriptions/subscription-object#customer_id" class="text-blue-600 hover:text-blue-800 underline">subscription&#x27;s customer</a>.</li> <li class="text-base leading-relaxed">For gift subscriptions: <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">customer_id</code> must match the <a href="/docs/api/gifts/gift-object#gifter" class="text-blue-600 hover:text-blue-800 underline">gifter&#x27;s customer</a>.</li> </ul> </li> </ul></div>
  --subscription-id: string # <p class="mb-2">The ID of the <a href="/docs/api/subscriptions" class="text-blue-600 hover:text-blue-800 underline">subscription</a> resource to which this invoice belongs.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Required if</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">customer_id</code> is not provided. OR</li> <li class="text-base leading-relaxed">The invoice is a <a href="#recurring-invoice" class="text-blue-600 hover:text-blue-800 underline">recurring invoice</a> and <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">line_items.subscription_id[]</code> are not provided.</li> </ul></div>
  --po-number: string # Purchase Order Number for this invoice.
  --price-type: string@price-type-completer # The price type of the invoice. \* tax_inclusive -  All amounts in the document are inclusive of tax. \* tax_exclusive -  All amounts in the document are exclusive of tax.  (default: tax_exclusive)
  --tax-override-reason: string@tax-override-reason-completer # The reason for exempting the invoice from tax. (Applicable only for exempted invoices.). \* export -  The customer is from a non-taxable region or the billing address and shipping address are unavailable. \* customer_exempt -  The customer is [exempted](/docs/api/customers/customer-object#taxability) from tax. \* id_exempt -  The customer is from a different country than your business and they have a valid VAT number or, the customer is a business entity. (This reason is only applicable when [EU VAT](https://www.chargebee.com/docs/eu-vat.html) or [UK VAT](https://www.chargebee.com/docs/uk-vat.html) is enabled.)
  --vat-number: string # Vat Number. Required if this invoice is VAT exempted.
  --vat-number-prefix: string # <p class="mb-2">An overridden value for the first two characters of the <a href="https://en.wikipedia.org/wiki/VAT_identification_number" target="_blank">full VAT number</a>. Only applicable specifically for customers with <code><a href="/docs/api/customers/customer-object#billing_address">billing_address</a></code></p> <p class="mb-2"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">country</code> as <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">XI</code> (which is <strong class="font-semibold">United Kingdom - Northern Ireland</strong> ).</p> <p class="mb-2">When you have enabled <a href="https://www.chargebee.com/docs/eu-vat.html" target="_blank">EU VAT</a> in 2021 or have <a href="https://www.chargebee.com/docs/brexit.html#what-needs-to-be-done-in-chargebee" target="_blank">manually enabled</a> the Brexit configuration, you have the option of setting <code><a href="/docs/api/customers/customer-object#billing_address">billing_address</a></code></p> <p class="mb-2"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">country</code> as <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">XI</code>. That&#x27;s the code for <strong class="font-semibold">United Kingdom - Northern Ireland</strong>. The first two characters of the VAT number in such a case is <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">XI</code> by default. However, if the VAT number was registered in UK, the value should be <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">GB</code>. Set <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">vat_number_prefix</code> to <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">GB</code> for such cases.</p>
  date: int # Date when invoice raised.  (format: unix-time)
  total: int # <p class="mb-2">Invoice total amount.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Constraints</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">Must be equal to (sum of <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">line_items[amount][]</code>) - (sum of <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">discounts[amount][]</code>) + (sum of <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">taxes[amount][]</code>) + <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">round_off_amount</code>.</li> <li class="text-base leading-relaxed">Cannot be <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">0</code> if <a href="https://www.chargebee.com/docs/billing/2.0/invoices-credit-notes-and-quotes/invoice-overview#hiding-zero-value-line-items" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">hiding zero-value line items</a> is enabled.</li> </ul></div> (format: int64)
  --round-off: int # [Round off amount](/docs/api/invoices/invoice-object#round_off_amount).  (format: int64)
  --status: string@status-completer-1 # <p class="mb-2">Current status of this invoice.</p> * not_paid - <p class="mb-2">Indicates the payment is not made and all attempts to collect is failed.</p> * voided - <p class="mb-2">Indicates a voided invoice.</p> * paid - <p class="mb-2">Indicates a paid invoice.</p> * posted - <p class="mb-2">Indicates the payment is not yet collected and will be in this state till the due date to indicate the due period.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Prerequisites</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">For a <a href="#recurring-invoice" class="text-blue-600 hover:text-blue-800 underline">non-recurring invoice</a> the value of <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> can be <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">posted</code> only if <a href="https://www.chargebee.com/docs/billing/2.0/subscriptions/net_d" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">payment terms</a> for one-time invoices is enabled. <a href="https://www.chargebee.com/docs/billing/2.0/kb/getting-started/how-to-contact-chargebees-support-team?utm_source=docs_api&amp;utm_medium=content&amp;utm_campaign=support" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">Contact Support</a> to enable this feature.</li> </ul></div> * pending - <p class="mb-2">The <a href="/docs/api/invoices/invoice-object#status">invoice</a> is yet to be closed (sent for payment collection). An invoice is generated with this <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> when it has line items that belong to items that are <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">metered</code> or when the <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">subscription.create_pending_invoices</code>attribute is set to <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">true</code>. The <a href="/docs/api/v2/pcv-1/invoices/invoice-object#status">invoice</a> is yet to be closed (sent for payment collection). All invoices are generated with this <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> when <a href="https://www.chargebee.com/docs/1.0/metered_billing.html" target="_blank">Metered Billing</a> is enabled for the site.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Prerequisites</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">The value of <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> can be <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">pending</code> only if <a href="https://www.chargebee.com/docs/metered_billing.html" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">Metered Billing</a> is enabled for the site.</li> </ul></div> * payment_due - <p class="mb-2">Indicates the payment is not yet collected and is being retried as per retry settings.</p>
  --voided-at: int # Timestamp indicating the date \& time this invoice got voided.  (format: unix-time)
  --void-reason-code: string # Reason code for voiding the invoice. Select from a list of reason codes set in the Chargebee app in **Settings \> Configure Chargebee \> Reason Codes \> Invoices \> Void invoice**. Must be passed if set as mandatory in the app. The codes are case-sensitive.
  --is-written-off: oneof<nothing, bool> # If is_written_off is true then the invoice is written off.  (default: false)
  --write-off-amount: int # Amount written off against this invoice. If this value is not present then the due amount of the invoice will be written off.  (format: int64, default: 0)
  --write-off-date: int # The date on which the write_off invoice has occurred. This is a mandatory field if is_written_off is true. The same date reflects on the created credit note.  (format: unix-time)
  --due-date: int # <p class="mb-2">The due date of the invoice.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Prerequisites</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">For a <a href="#recurring-invoice" class="text-blue-600 hover:text-blue-800 underline">non-recurring invoice</a>, <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">due_date</code> can be provided only if <a href="https://www.chargebee.com/docs/billing/2.0/subscriptions/net_d" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">payment terms</a> for one-time invoices is enabled. <a href="https://www.chargebee.com/docs/billing/2.0/kb/getting-started/how-to-contact-chargebees-support-team?utm_source=docs_api&amp;utm_medium=content&amp;utm_campaign=support" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">Contact Support</a> to enable this feature.</li> </ul></div> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Required if</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> is <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">posted</code>.</li> </ul></div> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Constraints</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">Must be a date in the future if <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> is <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">posted</code>.</li> <li class="text-base leading-relaxed">Must be a date in the past if <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> is <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">payment_due</code>.</li> </ul></div> (format: unix-time)
  --net-term-days: int # <p class="mb-2">The number of days from <a href="/docs/api/invoices/invoice-object#date" class="text-blue-600 hover:text-blue-800 underline"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">invoice.date</code></a> until payment for the invoice is due.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Prerequisites</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">For a <a href="#recurring-invoice" class="text-blue-600 hover:text-blue-800 underline">non-recurring invoice</a>, <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">net_term_days</code> can be provided only if <a href="https://www.chargebee.com/docs/billing/2.0/subscriptions/net_d" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">payment terms</a> for one-time invoices is enabled. <a href="https://www.chargebee.com/docs/billing/2.0/kb/getting-started/how-to-contact-chargebees-support-team?utm_source=docs_api&amp;utm_medium=content&amp;utm_campaign=support" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">Contact Support</a> to enable this feature.</li> </ul></div> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Required if</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed"><code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">status</code> is <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">posted</code>.</li> </ul></div> (format: int32, default: 0)
  --has-advance-charges: oneof<nothing, bool> # <p class="mb-2">Boolean indicating any advance charge is present in this invoice.</p> <div class="alert alert-info"><p class="mb-2"><strong class="font-semibold">Contraints</strong></p><ul class="list-disc list-outside ml-6 my-4 space-y-2"> <li class="text-base leading-relaxed">Can be set to <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">true</code> only for a <a href="#recurring-invoice" class="text-blue-600 hover:text-blue-800 underline">recurring invoice</a>.</li> </ul></div> (default: false)
  --use-for-proration: oneof<nothing, bool> # If the invoice falls within the subscription current term will be used for proration.  (default: false)
  --credit-note: record # Parameters for credit_note — shape: {id?: string}
  --billing-address: record # Parameters for billing_address — shape: {first_name?: string, last_name?: string, email?: string, company?: string, phone?: string, line1?: string, line2?: string, line3?: string, city?: string, state_code?: string, state?: string, zip?: string, country?: string, validation_status?: "not_validated"|"valid"|"partially_valid"|"invalid"}
  --shipping-address: record # Parameters for shipping_address — shape: {first_name?: string, last_name?: string, email?: string, company?: string, phone?: string, line1?: string, line2?: string, line3?: string, city?: string, state_code?: string, state?: string, zip?: string, country?: string, validation_status?: "not_validated"|"valid"|"partially_valid"|"invalid"}
  --line-items: record # Parameters for line_items — shape: {id?: list, date_from?: list, date_to?: list, subscription_id?: list, description: list, unit_amount?: list, quantity?: list, amount?: list, unit_amount_in_decimal?: list, quantity_in_decimal?: list, amount_in_decimal?: list, entity_type?: list, entity_id?: list, item_level_discount1_entity_id?: list, item_level_discount1_amount?: list, item_level_discount2_entity_id?: list, item_level_discount2_amount?: list, tax1_name?: list, tax1_amount?: list, tax2_name?: list, tax2_amount?: list, tax3_name?: list, tax3_amount?: list, tax4_name?: list, tax4_amount?: list, tax5_name?: list, tax5_amount?: list, tax6_name?: list, tax6_amount?: list, tax7_name?: list, tax7_amount?: list, tax8_name?: list, tax8_amount?: list, tax9_name?: list, tax9_amount?: list, tax10_name?: list, tax10_amount?: list, created_at?: list}
  --payment-reference-numbers: record # Parameters for payment_reference_numbers — shape: {id?: list, type: list, number: list}
  --line-item-tiers: record # Parameters for line_item_tiers — shape: {line_item_id: list, starting_unit?: list, ending_unit?: list, quantity_used?: list, unit_amount?: list, starting_unit_in_decimal?: list, ending_unit_in_decimal?: list, quantity_used_in_decimal?: list, unit_amount_in_decimal?: list}
  --discounts: record # Parameters for discounts — shape: {line_item_id?: list, entity_type: list, entity_id?: list, description?: list, amount: list}
  --taxes: record # Parameters for taxes — shape: {name: list, rate: list, amount?: list, description?: list, juris_type?: list, juris_name?: list, juris_code?: list}
  --payments: record # Parameters for payments — shape: {id?: list, amount: list, payment_method: list, date?: list, reference_number?: list}
  --notes: record # Parameters for notes — shape: {entity_type?: list, entity_id?: list, note?: list}
  --line-item-addresses: record # The list of addresses used for tax calculation on line items. — shape: {line_item_id?: list, first_name?: list, last_name?: list, email?: list, company?: list, phone?: list, line1?: list, line2?: list, line3?: list, city?: list, state_code?: list, state?: list, zip?: list, country?: list, validation_status?: list}
]: any -> record<invoice: record<id: string, customer_id: string, payment_owner: string, subscription_id: string, recurring: bool, status: string, date: int, due_date: int, net_term_days: int, po_number: string, vat_number: string, price_type: string, exchange_rate: float, local_currency_exchange_rate: float, currency_code: string, local_currency_code: string, tax: int, sub_total: int, sub_total_in_local_currency: int, total: int, total_in_local_currency: int, amount_due: int, amount_adjusted: int, amount_paid: int, paid_at: int, write_off_amount: int, credits_applied: int, dunning_status: string, next_retry_at: int, voided_at: int, resource_version: int, updated_at: int, line_items_next_offset: string, first_invoice: bool, new_sales_amount: int, has_advance_charges: bool, term_finalized: bool, is_gifted: bool, generated_at: int, expected_payment_date: int, amount_to_collect: int, round_off_amount: int, void_reason_code: string, deleted: bool, tax_category: string, vat_number_prefix: string, channel: string, business_entity_id: string, line_items: list<record>, line_item_tiers: list<record>, line_item_discounts: list<record>, line_item_taxes: list<record>, line_item_credits: list<record>, line_item_addresses: list<record>, discounts: list<record>, taxes: list<record>, tax_origin: record<country: string, registration_number: string>, linked_taxes_withheld: list<record>, linked_payments: list<record>, reference_transactions: list<record>, dunning_attempts: list<record>, applied_credits: list<record>, adjustment_credit_notes: list<record>, issued_credit_notes: list<record>, linked_orders: list<record>, notes: list<record>, shipping_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, billing_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, statement_descriptor: record<id: string, descriptor: string>, einvoice: record<id: string, reference_id: string, reference_number: string, status: string, message: string, provider_references: list>, site_details_at_creation: record<timezone: string, organization_address: record>>, credit_note: record<id: string, customer_id: string, subscription_id: string, reference_invoice_id: string, type: string, reason_code: string, status: string, vat_number: string, date: int, price_type: string, currency_code: string, total: int, amount_allocated: int, amount_refunded: int, amount_available: int, refunded_at: int, voided_at: int, generated_at: int, resource_version: int, updated_at: int, channel: string, line_items_next_offset: string, sub_total: int, sub_total_in_local_currency: int, total_in_local_currency: int, local_currency_code: string, round_off_amount: int, fractional_correction: int, deleted: bool, tax_category: string, local_currency_exchange_rate: float, create_reason_code: string, vat_number_prefix: string, business_entity_id: string, line_items: list<record>, line_item_tiers: list<record>, line_item_discounts: list<record>, line_item_taxes: list<record>, line_item_addresses: list<record>, discounts: list<record>, taxes: list<record>, tax_origin: record<country: string, registration_number: string>, linked_refunds: list<record>, linked_tax_withheld_refunds: list<record>, allocations: list<record>, shipping_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, billing_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, einvoice: record<id: string, reference_id: string, reference_number: string, status: string, message: string, provider_references: list>, site_details_at_creation: record<timezone: string, organization_address: record>>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "basic"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base "/invoices/import_invoice")
  let body = {id: $id, currency_code: $currency_code, customer_id: $customer_id, subscription_id: $subscription_id, po_number: $po_number, price_type: $price_type, tax_override_reason: $tax_override_reason, vat_number: $vat_number, vat_number_prefix: $vat_number_prefix, date: $date, total: $total, round_off: $round_off, status: $status, voided_at: $voided_at, void_reason_code: $void_reason_code, is_written_off: $is_written_off, write_off_amount: $write_off_amount, write_off_date: $write_off_date, due_date: $due_date, net_term_days: $net_term_days, has_advance_charges: $has_advance_charges, use_for_proration: $use_for_proration, credit_note: $credit_note, billing_address: $billing_address, shipping_address: $shipping_address, line_items: $line_items, payment_reference_numbers: $payment_reference_numbers, line_item_tiers: $line_item_tiers, discounts: $discounts, taxes: $taxes, payments: $payments, notes: $notes, line_item_addresses: $line_item_addresses} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let extra_headers = {"chargebee-request-origin-device": $chargebee_request_origin_device, "chargebee-request-origin-user": $chargebee_request_origin_user, "chargebee-request-origin-user-encoded": $chargebee_request_origin_user_encoded, "chargebee-request-origin-ip": $chargebee_request_origin_ip, "chargebee-event-actions": $chargebee_event_actions, "chargebee-event-email": $chargebee_event_email, "chargebee-event-webhook": $chargebee_event_webhook, "chargebee-business-entity-id": $chargebee_business_entity_id} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/x-www-form-urlencoded" $body
}

# Resume dunning for invoice
#
# POST /invoices/{invoice-id}/resume_dunning
# operationId: resume_dunning_for_invoice
export def "invoices-resume-dunning invoice" [
  invoice_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
