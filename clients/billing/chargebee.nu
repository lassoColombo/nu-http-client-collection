# POST /purchases
# operationId: create_a_purchase
# --invoice_info shape: {po_number?: string, notes?: string}
# --payment_schedule shape: {scheme_id?: string, amount?: int}
# --statement_descriptor shape: {descriptor?: string}
# --payment_intent shape: {id?: string, gateway_account_id?: string, gw_token?: string, payment_method_type?: "card"|"ideal"|"sofort"|"bancontact"|"google_pay"|"dotpay"|"giropay"|"apple_pay"|"upi"|"netbanking_emandates"|"paypal_express_checkout"|"direct_debit"|"boleto"|"venmo"|"amazon_payments"|"pay_to"|"faster_payments"|"sepa_instant_transfer"|"klarna_pay_now"|"online_banking_poland"|"payconiq_by_bancontact"|"electronic_payment_standard"|"kbc_payment_button"|"pay_by_bank"|"trustly"|"stablecoin"|"kakao_pay"|"naver_pay"|"revolut_pay"|"cash_app_pay"|"wechat_pay"|"alipay"|"twint"|"go_pay"|"grab_pay"|"pay_co"|"after_pay"|"swish"|"payme"|"pix"|"klarna"|"alipay_hk"|"paypay"|"gcash"|"south_korean_cards", reference_id?: string, additional_information?: record}
# --purchase_items shape: {index: list, item_price_id: list, quantity?: list, unit_amount?: list, unit_amount_in_decimal?: list, quantity_in_decimal?: list}
# --item_tiers shape: {index: list, item_price_id?: list, starting_unit?: list, ending_unit?: list, price?: list, starting_unit_in_decimal?: list, ending_unit_in_decimal?: list, price_in_decimal?: list}
# --shipping_addresses shape: {first_name?: list, last_name?: list, email?: list, company?: list, phone?: list, line1?: list, line2?: list, line3?: list, city?: list, state?: list, state_code?: list, country?: list, zip?: list, validation_status?: list}
# --discounts shape: {index?: list, coupon_id?: list, percentage?: list, quantity?: list, amount?: list, included_in_mrr?: list}
# --subscription_info shape: {index: list, subscription_id?: list, billing_cycles?: list, contract_term_billing_cycle_on_renewal?: list, meta_data?: list}
# --contract_terms shape: {index: list, action_at_term_end?: list, cancellation_cutoff_period?: list}
export def "purchases purchase" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --chargebee-request-origin-device: string # The device from which the customer has made the request (e.g. Android)
  --chargebee-request-origin-user: string # The email address of your customer/user. Use this when the email address has only ASCII characters. (e.g. user@example.com)
  --chargebee-request-origin-user-encoded: string # The Base64-encoded email address of your customer/user. Use this if the email address has UTF-8 characters. When this header is provided, the header chargebee-request-origin-user is ignored. (e.g. dXNlci7QutCy0ZbRgtC+0YfQutCwQGV4YW1wbGUuY29t)
  --chargebee-request-origin-ip: string # The IP address of the customer where the request originated (e.g. 192.168.1.2)
  --chargebee-event-actions: string@chargebee-event-actions-completer # skip all actions to be done on the events
  --chargebee-event-email: string@chargebee-event-email-completer # skip only emails
  --chargebee-event-webhook: string@chargebee-event-webhook-completer #  skip only webhooks
  --chargebee-business-entity-id: string # If the site has multiple business entities, you can use this custom HTTP header to specify the business entity for which Chargebee should perform the operation.
  customer_id: string # The unique identifier of the [customer](/docs/api/customers) that made this purchase.
  --payment-source-id: string # Payment source attached to this purchase. If present, the customer's payment sources won't be used to collect any payment for this purchase.
  --replace-primary-payment-source: oneof<nothing, bool> # <p class="mb-2">Indicates whether the primary payment source is replaced with this payment source. If a <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">payment_intent</code> object is included in the request, <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">replace_primary</code> defaults to <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">true</code>. For all other cases, the default is <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">false</code> .</p> (default: true)
  --invoice-info: record # Parameters for invoice_info — shape: {po_number?: string, notes?: string}
  --payment-schedule: record # <p class="mb-2">Parameters for <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">payment_schedule</code></p> — shape: {scheme_id?: string, amount?: int}
  --statement-descriptor: record # Parameters for statement_descriptor — shape: {descriptor?: string}
  --payment-intent: record # Parameters for payment_intent — shape: {id?: string, gateway_account_id?: string, gw_token?: string, payment_method_type?: "card"|"ideal"|"sofort"|"bancontact"|"google_pay"|"dotpay"|"giropay"|"apple_pay"|"upi"|"netbanking_emandates"|"paypal_express_checkout"|"direct_debit"|"boleto"|"venmo"|"amazon_payments"|"pay_to"|"faster_payments"|"sepa_instant_transfer"|"klarna_pay_now"|"online_banking_poland"|"payconiq_by_bancontact"|"electronic_payment_standard"|"kbc_payment_button"|"pay_by_bank"|"trustly"|"stablecoin"|"kakao_pay"|"naver_pay"|"revolut_pay"|"cash_app_pay"|"wechat_pay"|"alipay"|"twint"|"go_pay"|"grab_pay"|"pay_co"|"after_pay"|"swish"|"payme"|"pix"|"klarna"|"alipay_hk"|"paypay"|"gcash"|"south_korean_cards", reference_id?: string, additional_information?: record}
  --purchase-items: record # Parameters for purchase_items — shape: {index: list, item_price_id: list, quantity?: list, unit_amount?: list, unit_amount_in_decimal?: list, quantity_in_decimal?: list}
  --item-tiers: record # Parameters for item_tiers — shape: {index: list, item_price_id?: list, starting_unit?: list, ending_unit?: list, price?: list, starting_unit_in_decimal?: list, ending_unit_in_decimal?: list, price_in_decimal?: list}
  --shipping-addresses: record # Parameters for shipping_addresses — shape: {first_name?: list, last_name?: list, email?: list, company?: list, phone?: list, line1?: list, line2?: list, line3?: list, city?: list, state?: list, state_code?: list, country?: list, zip?: list, validation_status?: list}
  --discounts: record # Parameters for discounts — shape: {index?: list, coupon_id?: list, percentage?: list, quantity?: list, amount?: list, included_in_mrr?: list}
  --subscription-info: record # Parameters for subscription_info — shape: {index: list, subscription_id?: list, billing_cycles?: list, contract_term_billing_cycle_on_renewal?: list, meta_data?: list}
  --contract-terms: record # Parameters for contract_terms — shape: {index: list, action_at_term_end?: list, cancellation_cutoff_period?: list}
]: any -> record<purchase: record<id: string, customer_id: string, created_at: int, modified_at: int, subscription_ids: list<string>, invoice_ids: list<string>>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "basic"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base "/purchases")
  let body = {customer_id: $customer_id, payment_source_id: $payment_source_id, replace_primary_payment_source: $replace_primary_payment_source, invoice_info: $invoice_info, payment_schedule: $payment_schedule, statement_descriptor: $statement_descriptor, payment_intent: $payment_intent, purchase_items: $purchase_items, item_tiers: $item_tiers, shipping_addresses: $shipping_addresses, discounts: $discounts, subscription_info: $subscription_info, contract_terms: $contract_terms} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let extra_headers = {"chargebee-request-origin-device": $chargebee_request_origin_device, "chargebee-request-origin-user": $chargebee_request_origin_user, "chargebee-request-origin-user-encoded": $chargebee_request_origin_user_encoded, "chargebee-request-origin-ip": $chargebee_request_origin_ip, "chargebee-event-actions": $chargebee_event_actions, "chargebee-event-email": $chargebee_event_email, "chargebee-event-webhook": $chargebee_event_webhook, "chargebee-business-entity-id": $chargebee_business_entity_id} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/x-www-form-urlencoded" $body
}

