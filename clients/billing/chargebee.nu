  let body = {amount: $amount, authorization_transaction_id: $authorization_transaction_id, payment_source_id: $payment_source_id, comment: $comment, payment_initiator: $payment_initiator} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
