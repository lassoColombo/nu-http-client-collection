# operationId: create_a_ramp
# --contract_term shape: {action_at_term_end?: "renew"|"evergreen"|"cancel"|"renew_once", cancellation_cutoff_period?: int, renewal_billing_cycles?: int}
# --items_to_add shape: {item_price_id: list, quantity?: list, quantity_in_decimal?: list, unit_price?: list, unit_price_in_decimal?: list, billing_cycles?: list, service_period_days?: list, charge_on_event?: list, charge_once?: list, charge_on_option?: list}
# --items_to_update shape: {item_price_id: list, quantity?: list, quantity_in_decimal?: list, unit_price?: list, unit_price_in_decimal?: list, billing_cycles?: list, service_period_days?: list, charge_on_event?: list, charge_once?: list, charge_on_option?: list}
