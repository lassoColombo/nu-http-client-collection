]: any -> record<coupon: record<id: string, name: string, invoice_name: string, discount_type: string, discount_percentage: float, discount_amount: int, discount_quantity: int, currency_code: string, duration_type: string, valid_from: int, valid_till: int, max_redemptions: int, status: string, apply_on: string, created_at: int, archived_at: int, resource_version: int, updated_at: int, period: int, period_unit: string, redemptions: int, invoice_notes: string, meta_data: record, deleted: bool, item_constraints: list<record>, item_constraint_criteria: list<record>, coupon_constraints: list<record>>> {
