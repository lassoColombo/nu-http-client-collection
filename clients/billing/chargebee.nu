  --comment: string # Comment, if any, on the refund.
  --customer-notes: string # The Customer Notes to be filled in the Credit Notes created to capture this refund detail.
  --credit-note: record # Parameters for credit_note — shape: {reason_code?: "product_unsatisfactory"|"service_unsatisfactory"|"order_change"|"order_cancellation"|"waiver"|"other", create_reason_code?: string}
