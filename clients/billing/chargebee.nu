me: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, referral_urls: list<record>, contacts: list<record>, payment_method: record<type: string, gateway: string, gateway_account_id: string, status: string, reference_id: string>, balances: list<record>, entity_identifiers: list<record>, tax_providers_fields: list<record>, relationship: record<parent_id: string, payment_owner_id: string, invoice_owner_id: string>, parent_account_access: record<portal_edit_child_subscriptions: string, portal_download_child_invoices: string, send_subscription_emails: bool, send_invoice_emails: bool, send_payment_emails: bool>, child_account_access: record<portal_edit_subscriptions: string, portal_download_invoices: string, send_subscription_emails: bool, send_invoice_emails: bool, send_payment_emails: bool>>, card: record<payment_source_id: string, status: string, gateway: string, gateway_account_id: string, ref_tx_id: string, first_name: string, last_name: string, iin: string, last4: string, card_type: string, funding_type: string, expiry_month: int, expiry_year: int, issuing_country: string, billing_addr1: string, billing_addr2: string, billing_city: string, billing_state_code: string, billing_state: string, billing_country: string, billing_zip: string, created_at: int, resource_version: int, updated_at: int, ip_address: string, powered_by: string, customer_id: string, masked_number: string>, invoice: record<id: string, customer_id: string, payment_owner: string, subscription_id: string, recurring: bool, status: string, date: int, due_date: int, net_term_days: int, po_number: string, vat_number: string, price_type: string, exchange_rate: float, local_currency_exchange_rate: float, currency_code: string, local_currency_code: string, tax: int, sub_total: int, sub_total_in_local_currency: int, total: int, total_in_local_currency: int, amount_due: int, amount_adjusted: int, amount_paid: int, paid_at: int, write_off_amount: int, credits_applied: int, dunning_status: string, next_retry_at: int, voided_at: int, resource_version: int, updated_at: int, line_items_next_offset: string, first_invoice: bool, new_sales_amount: int, has_advance_charges: bool, term_finalized: bool, is_gifted: bool, generated_at: int, expected_payment_date: int, amount_to_collect: int, round_off_amount: int, void_reason_code: string, deleted: bool, tax_category: string, vat_number_prefix: string, channel: string, business_entity_id: string, line_items: list<record>, line_item_tiers: list<record>, line_item_discounts: list<record>, line_item_taxes: list<record>, line_item_credits: list<record>, line_item_addresses: list<record>, discounts: list<record>, taxes: list<record>, tax_origin: record<country: string, registration_number: string>, linked_taxes_withheld: list<record>, linked_payments: list<record>, reference_transactions: list<record>, dunning_attempts: list<record>, applied_credits: list<record>, adjustment_credit_notes: list<record>, issued_credit_notes: list<record>, linked_orders: list<record>, notes: list<record>, shipping_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, billing_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, statement_descriptor: record<id: string, descriptor: string>, einvoice: record<id: string, reference_id: string, reference_number: string, status: string, message: string, provider_references: list>, site_details_at_creation: record<timezone: string, organization_address: record>>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "basic"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/customers/($customer_id)/import_for_items")
  let body = {exhausted_coupon_ids: $exhausted_coupon_ids, id: $id, trial_end: $trial_end, billing_cycles: $billing_cycles, net_term_days: $net_term_days, start_date: $start_date, auto_collection: $auto_collection, po_number: $po_number, coupon_ids: $coupon_ids, payment_source_id: $payment_source_id, status: $status, current_term_end: $current_term_end, current_term_start: $current_term_start, trial_start: $trial_start, cancelled_at: $cancelled_at, started_at: $started_at, activated_at: $activated_at, pause_date: $pause_date, resume_date: $resume_date, contract_term_billing_cycle_on_renewal: $contract_term_billing_cycle_on_renewal, create_current_term_invoice: $create_current_term_invoice, invoice_notes: $invoice_notes, meta_data: $meta_data, cancel_reason_code: $cancel_reason_code, create_pending_invoices: $create_pending_invoices, auto_close_invoices: $auto_close_invoices, contract_term: $contract_term, transaction: $transaction, shipping_address: $shipping_address, subscription_items: $subscription_items, discounts: $discounts, charged_items: $charged_items, item_tiers: $item_tiers} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let extra_headers = {"chargebee-request-origin-device": $chargebee_request_origin_device, "chargebee-request-origin-user": $chargebee_request_origin_user, "chargebee-request-origin-user-encoded": $chargebee_request_origin_user_encoded, "chargebee-request-origin-ip": $chargebee_request_origin_ip, "chargebee-event-actions": $chargebee_event_actions, "chargebee-event-email": $chargebee_event_email, "chargebee-event-webhook": $chargebee_event_webhook, "chargebee-business-entity-id": $chargebee_business_entity_id} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "post" $full_url $auth $insecure $raw $max_time $allow_errors "application/x-www-form-urlencoded" $body
}

# Retrieve advance invoice
#
# GET /subscriptions/{subscription-id}/retrieve_advance_invoice_schedule
# operationId: retrieve_advance_invoice
export def "subscriptions-retrieve-advance-invoice-schedule invoice" [
  subscription_id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --chargebee-request-origin-device: string # The device from which the customer has made the request (e.g. Android)
  --chargebee-request-origin-user: string # The email address of your customer/user. Use this when the email address has only ASCII characters. (e.g. user@example.com)
