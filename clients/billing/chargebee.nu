ring, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, statement_descriptor: record<id: string, descriptor: string>, einvoice: record<id: string, reference_id: string, reference_number: string, status: string, message: string, provider_references: list>, site_details_at_creation: record<timezone: string, organization_address: record>>> {
  let input = $in
