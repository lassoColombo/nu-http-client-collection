# Advance invoice estimate
#
# POST /subscriptions/{subscription-id}/advance_invoice_estimate
# operationId: advance_invoice_estimate
# --fixed_interval_schedule shape: {number_of_occurrences?: int, days_before_renewal?: int, end_schedule_on?: "after_number_of_intervals"|"specific_date"|"subscription_end", end_date?: int}
