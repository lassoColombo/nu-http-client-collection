  let full_url = (build-url $base "/invoices/create_for_charge_items_and_charges")
  let body = {customer_id: $customer_id, subscription_id: $subscription_id, currency_code: $currency_code, invoice_note: $invoice_note, remove_general_note: $remove_general_note, po_number: $po_number, coupon_ids: $coupon_ids, authorization_transaction_id: $authorization_transaction_id, payment_source_id: $payment_source_id, auto_collection: $auto_collection, net_term_days: $net_term_days, invoice_date: $invoice_date, token_id: $token_id, replace_primary_payment_source: $replace_primary_payment_source, retain_payment_source: $retain_payment_source, payment_initiator: $payment_initiator, shipping_address: $shipping_address, statement_descriptor: $statement_descriptor, card: $card, bank_account: $bank_account, payment_method: $payment_method, payment_intent: $payment_intent, item_prices: $item_prices, item_tiers: $item_tiers, charges: $charges, notes_to_remove: $notes_to_remove, tax_providers_fields: $tax_providers_fields, discounts: $discounts} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
