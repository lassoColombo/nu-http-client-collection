  --description: string # Description of the price variant.
  --variant-group: string # <p class="mb-2">The <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">variant_group</code> organizes similar <code><a href="/docs/api/price_variants">price_variants</a></code> to optimize strategies such as bundling, geo-based pricing experiments, and campaign-specific pricing like <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">cb-atomic-pricing-</code> for effective grouping. The <code class="bg-gray-100 text-gray-800 font-medium border border-gray-300 rounded px-1.5 py-0.5 mx-1 text-sm font-mono whitespace-nowrap">variant_group</code> provides greater flexibility and precision in your pricing models.</p>
