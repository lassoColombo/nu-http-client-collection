 amount_due: int, amount_adjusted: int, amount_paid: int, paid_at: int, write_off_amount: int, credits_applied: int, dunning_status: string, next_retry_at: int, voided_at: int, resource_version: int, updated_at: int, line_items_next_offset: string, first_invoice: bool, new_sales_amount: int, has_advance_charges: bool, term_finalized: bool, is_gifted: bool, generated_at: int, expected_payment_date: int, amount_to_collect: int, round_off_amount: int, void_reason_code: string, deleted: bool, tax_category: string, vat_number_prefix: string, channel: string, business_entity_id: string, line_items: list<record>, line_item_tiers: list<record>, line_item_discounts: list<record>, line_item_taxes: list<record>, line_item_credits: list<record>, line_item_addresses: list<record>, discounts: list<record>, taxes: list<record>, tax_origin: record<country: string, registration_number: string>, linked_taxes_withheld: list<record>, linked_payments: list<record>, reference_transactions: list<record>, dunning_attempts: list<record>, applied_credits: list<record>, adjustment_credit_notes: list<record>, issued_credit_notes: list<record>, linked_orders: list<record>, notes: list<record>, shipping_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, billing_address: record<first_name: string, last_name: string, email: string, company: string, phone: string, line1: string, line2: string, line3: string, city: string, state_code: string, state: string, country: string, zip: string, validation_status: string>, statement_descriptor: record<id: string, descriptor: string>, einvoice: record<id: string, reference_id: string, reference_number: string, status: string, message: string, provider_references: list>, site_details_at_creation: record<timezone: string, organization_address: record>>, unbilled_charges: table<id: string, customer_id: string, subscription_id: string, date_from: int, date_to: int, unit_amount: int, pricing_model: string, quantity: int, amount: int, currency_code: string, discount_amount: int, description: string, entity_type: string, entity_id: string, is_voided: bool, voided_at: int, unit_amount_in_decimal: string, quantity_in_decimal: string, amount_in_decimal: string, created_at: int, updated_at: int, is_advance_charge: bool, business_entity_id: string, deleted: bool, tiers: list>> {
  let input = $in
  let auth = (build-auth $token ($auth_scheme | default "basic"))
  let base = ($base_url | default $BASE_URL)
  let full_url = (build-url $base $"/customers/($customer_id)/subscription_for_items")
  let body = {id: $id, business_entity_id: $business_entity_id, trial_end: $trial_end, billing_cycles: $billing_cycles, mandatory_items_to_remove: $mandatory_items_to_remove, net_term_days: $net_term_days, start_date: $start_date, auto_collection: $auto_collection, terms_to_charge: $terms_to_charge, billing_alignment_mode: $billing_alignment_mode, offline_payment_method: $offline_payment_method, po_number: $po_number, coupon_ids: $coupon_ids, payment_source_id: $payment_source_id, override_relationship: $override_relationship, invoice_notes: $invoice_notes, invoice_date: $invoice_date, meta_data: $meta_data, invoice_immediately: $invoice_immediately, replace_primary_payment_source: $replace_primary_payment_source, free_period: $free_period, free_period_unit: $free_period_unit, contract_term_billing_cycle_on_renewal: $contract_term_billing_cycle_on_renewal, create_pending_invoices: $create_pending_invoices, auto_close_invoices: $auto_close_invoices, first_invoice_pending: $first_invoice_pending, trial_end_action: $trial_end_action, payment_initiator: $payment_initiator, shipping_address: $shipping_address, statement_descriptor: $statement_descriptor, payment_intent: $payment_intent, contract_term: $contract_term, billing_override: $billing_override, subscription_items: $subscription_items, discounts: $discounts, item_tiers: $item_tiers} | compact
  let body = if ($input | describe | str starts-with "record") { $input | merge deep ($body | default {}) } else { $body }
  let extra_headers = {"chargebee-request-origin-device": $chargebee_request_origin_device, "chargebee-request-origin-user": $chargebee_request_origin_user, "chargebee-request-origin-user-encoded": $chargebee_request_origin_user_encoded, "chargebee-request-origin-ip": $chargebee_request_origin_ip, "chargebee-event-actions": $chargebee_event_actions, "chargebee-event-email": $chargebee_event_email, "chargebee-event-webhook": $chargebee_event_webhook, "chargebee-business-entity-id": $chargebee_business_entity_id} | compact
  let auth = ($auth | update headers ($auth.headers | merge $extra_headers))
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
