  --id: string # This parameter filters the response based on the `id` field.
  --serviceEndDate: string # This parameter filters the response based on the `serviceEndDate` field.  (format: date)
  --serviceStartDate: string # This parameter filters the response based on the `serviceStartDate` field.  (format: date)
  --sku: string # This parameter filters the response based on the `sku` field.
