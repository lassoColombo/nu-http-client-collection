    logging-projects-sinks-patch: "record<bigqueryOptions: record<usePartitionedTables: bool, usesTimestampColumnPartitioning: bool>, createTime: string, description: string, destination: string, disabled: bool, exclusions: table<createTime: string, description: string, disabled: bool, filter: string, name: string, updateTime: string>, filter: string, includeChildren: bool, name: string, outputVersionFormat: string, updateTime: string, writerIdentity: string>"
    logging-sinks-update: "record<bigqueryOptions: record<usePartitionedTables: bool, usesTimestampColumnPartitioning: bool>, createTime: string, description: string, destination: string, disabled: bool, exclusions: table<createTime: string, description: string, disabled: bool, filter: string, name: string, updateTime: string>, filter: string, includeChildren: bool, name: string, outputVersionFormat: string, updateTime: string, writerIdentity: string>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["logging-entries-copy" "logging-entries-list" "logging-entries-tail" "logging-entries-write" "logging-monitored-resource-descriptors-list" "logging-projects-logs-delete" "logging-projects-metrics-delete" "logging-projects-metrics-get" "logging-projects-metrics-update" "logging-projects-locations-buckets-views-delete" "logging-projects-locations-operations-get" "logging-projects-locations-buckets-views-patch" "logging-get-cmek-settings" "logging-update-cmek-settings" "logging-projects-locations-list" "logging-projects-locations-operations-list" "logging-get-settings" "logging-update-settings" "logging-projects-locations-operations-cancel" "logging-projects-locations-buckets-undelete" "logging-projects-locations-buckets-update-async" "logging-projects-locations-buckets-list" "logging-projects-locations-buckets-create" "logging-projects-locations-buckets-create-async" "logging-projects-exclusions-list" "logging-projects-exclusions-create" "logging-projects-locations-buckets-links-list" "logging-projects-locations-buckets-links-create" "logging-projects-logs-list" "logging-projects-metrics-list" "logging-projects-metrics-create" "logging-sinks-list" "logging-sinks-create" "logging-projects-locations-buckets-views-list" "logging-projects-locations-buckets-views-create" "logging-sinks-delete" "logging-sinks-get" "logging-projects-sinks-patch" "logging-sinks-update" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

