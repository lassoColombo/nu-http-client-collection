  --containers: list # Specifies the containers in the inference pipeline. — item shape: {ContainerHostname?: string, Image?: string, ImageConfig?: record, Mode?: "SingleModel"|"MultiModel", ModelDataUrl?: string, Environment?: record, ModelPackageName?: string, InferenceSpecificationName?: string, MultiModelConfig?: record}
