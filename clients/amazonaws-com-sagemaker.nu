  --x-amz-signed-headers: string
  --x-amz-target: string@x-amz-target-completer-265 # required
  pipeline_execution_arn: string # The Amazon Resource Name (ARN) of the pipeline execution.
  client_request_token: string # A unique, case-sensitive identifier that you provide to ensure the idempotency of the operation. An idempotent operation completes no more than once.
]: any -> oneof<record, string, nothing> {
  $in | http-request {
    method: post
    path: "/"
    header: [{name: X-Amz-Content-Sha256, var: x_amz_content_sha256}, {name: X-Amz-Date, var: x_amz_date}, {name: X-Amz-Algorithm, var: x_amz_algorithm}, {name: X-Amz-Credential, var: x_amz_credential}, {name: X-Amz-Security-Token, var: x_amz_security_token}, {name: X-Amz-Signature, var: x_amz_signature}, {name: X-Amz-SignedHeaders, var: x_amz_signed_headers}, {name: X-Amz-Target, var: x_amz_target, required: true, default: "SageMaker.StopPipelineExecution"}]
    body: {content_type: "application/json", kind: json, fields: [{name: PipelineExecutionArn, var: pipeline_execution_arn}, {name: ClientRequestToken, var: client_request_token}]}
    accept: ["application/json"]
