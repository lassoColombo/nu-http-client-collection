  resource_arn: string # The Amazon Resource Name (ARN) of the resource that you want to tag.
  tags: list # An array of key-value pairs. You can use tags to categorize your Amazon Web Services resources in different ways, for example, by purpose, owner, or environment. For more information, see Tagging Amazon Web Services Resources (https://docs.aws.amazon.com/general/latest/gr/aws_tagging.html). — item shape: {Key: string, Value: string}
]: any -> oneof<record, string, nothing> {
