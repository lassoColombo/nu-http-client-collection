def xgafv-completer [] { ["1" "2"] }
def alt-completer [] { ["json" "media" "proto"] }

# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    firebaseappdistribution-media-upload: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebaseappdistribution-projects-groups-batch-join: "record"
    firebaseappdistribution-projects-groups-batch-leave: "record"
    firebaseappdistribution-projects-groups-delete: "record"
    firebaseappdistribution-projects-groups-get: "record<displayName: string, inviteLinkCount: int, name: string, releaseCount: int, testerCount: int>"
    firebaseappdistribution-projects-testers-patch: "record<displayName: string, groups: list<string>, lastActivityTime: string, name: string>"
    firebaseappdistribution-projects-apps-releases-operations-list: "record<nextPageToken: string, operations: table<done: bool, error: record, metadata: record, name: string, response: record>>"
    firebaseappdistribution-projects-apps-releases-operations-cancel: "record"
    firebaseappdistribution-projects-apps-releases-distribute: "record"
    firebaseappdistribution-projects-apps-releases-operations-wait: "record<done: bool, error: record<code: int, details: list<record>, message: string>, metadata: record, name: string, response: record>"
    firebaseappdistribution-projects-apps-releases-feedback-reports-list: "record<feedbackReports: table<createTime: string, firebaseConsoleUri: string, name: string, screenshotUri: string, tester: string, text: string>, nextPageToken: string>"
    firebaseappdistribution-projects-groups-list: "record<groups: table<displayName: string, inviteLinkCount: int, name: string, releaseCount: int, testerCount: int>, nextPageToken: string>"
    firebaseappdistribution-projects-groups-create: "record<displayName: string, inviteLinkCount: int, name: string, releaseCount: int, testerCount: int>"
    firebaseappdistribution-projects-apps-releases-list: "record<nextPageToken: string, releases: table<binaryDownloadUri: string, buildVersion: string, createTime: string, displayVersion: string, firebaseConsoleUri: string, name: string, releaseNotes: record, testingUri: string>>"
    firebaseappdistribution-projects-apps-releases-batch-delete: "record"
    firebaseappdistribution-projects-testers-list: "record<nextPageToken: string, testers: table<displayName: string, groups: list, lastActivityTime: string, name: string>>"
    firebaseappdistribution-projects-testers-batch-add: "record<testers: table<displayName: string, groups: list, lastActivityTime: string, name: string>>"
    firebaseappdistribution-projects-testers-batch-remove: "record<emails: list<string>>"
  }
  let mod_name = (scope modules | where { ($in.commands | get name | sort) == (["firebaseappdistribution-media-upload" "firebaseappdistribution-projects-groups-batch-join" "firebaseappdistribution-projects-groups-batch-leave" "firebaseappdistribution-projects-groups-delete" "firebaseappdistribution-projects-groups-get" "firebaseappdistribution-projects-testers-patch" "firebaseappdistribution-projects-apps-releases-operations-list" "firebaseappdistribution-projects-apps-releases-operations-cancel" "firebaseappdistribution-projects-apps-releases-distribute" "firebaseappdistribution-projects-apps-releases-operations-wait" "firebaseappdistribution-projects-apps-releases-feedback-reports-list" "firebaseappdistribution-projects-groups-list" "firebaseappdistribution-projects-groups-create" "firebaseappdistribution-projects-apps-releases-list" "firebaseappdistribution-projects-apps-releases-batch-delete" "firebaseappdistribution-projects-testers-list" "firebaseappdistribution-projects-testers-batch-add" "firebaseappdistribution-projects-testers-batch-remove" "commands"] | sort) } | get name | first)
  let mod_cmds = (scope modules | where name == $mod_name | get commands | first)
  let cmd_ids = ($mod_cmds | where name != "commands" | get decl_id)
  scope commands | where decl_id in $cmd_ids | each {|cmd|
    let sig = $cmd.signatures | values | first
    let params = $sig
      | where parameter_type not-in ["input" "output"]
      | where parameter_name not-in $builtin_flags
      | select parameter_name parameter_type syntax_shape is_optional description
    let name = ($cmd.name | str replace $"($mod_name) " "")
    {
      name: $name
      description: $cmd.description
      extra_description: $cmd.extra_description
      return_type: ($return_types | get -o $name | default "any")
      params: $params
    }
  }
}

