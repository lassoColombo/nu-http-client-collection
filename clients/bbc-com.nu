def sort-completer-3 [] { ["group_position" "pid"] }
def sort-completer-4 [] { ["mid"] }
def sort-direction-completer-2 [] { ["ascending"] }
def sort-completer-5 [] { ["group_position" "pid" "position" "promotion" "release_date" "relevance" "scheduled_start" "strict_title" "title" "tree"] }

