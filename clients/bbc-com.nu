# operationId: listServices
export def "list-services" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --end-from: string # Return services that end on or later than the specified datetime (format: date-time)
  --end-to: string # filter for subset of broadcasts that end on or earlier than the specified datetime (format: date-time)
  --mid: list<string> # filter for services by masterbrand MID
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list<string> # filter for services by partner ID
  --partner-pid: list<string> # filter for services by partner PID
  --q: string # filter for subset of services matching supplied keyword/phrase (boolean operators permitted)
  --service-type: list<string> # filter for specified type of linear services
  --sid: list<string> # filter for specified linear service
  --start-from: string # Return services that start on or later than the specified datetime (format: date-time)
  --start-to: string # Return services that start earlier than the specified datetime (format: date-time)
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/services"
    query: [{name: end_from, var: end_from}, {name: end_to, var: end_to}, {name: mid, var: mid, style: multi}, {name: page, var: page}, {name: page_size, var: page_size}, {name: partner_id, var: partner_id, style: multi}, {name: partner_pid, var: partner_pid, style: multi}, {name: q, var: q}, {name: service_type, var: service_type, style: multi}, {name: sid, var: sid, style: multi}, {name: start_from, var: start_from}, {name: start_to, var: start_to}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    end_from: $end_from, end_to: $end_to, mid: $mid, page: $page, page_size: $page_size, partner_id: $partner_id, partner_pid: $partner_pid, q: $q, service_type: $service_type, sid: $sid, start_from: $start_from, start_to: $start_to
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

