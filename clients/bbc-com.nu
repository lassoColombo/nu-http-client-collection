# operationId: listProgrammeDetails
export def "list-programme-details" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-pid: string # Filter for programme information by partner PID
  --pid: string # Filter for programme information for the provided PID
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/programme_details"
    query: [{name: page, var: page}, {name: page_size, var: page_size}, {name: partner_pid, var: partner_pid}, {name: pid, var: pid}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    page: $page, page_size: $page_size, partner_pid: $partner_pid, pid: $pid
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

