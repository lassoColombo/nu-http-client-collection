# operationId: listPeople
export def "list-people" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --authority: string # filter for subset of people that have an ID issued by the given authority
  --has-external-id: list<string> # filter for people who have an external identifier
  --id: list<string> # filter for subset of people having given ID
  --id-type: string # filter for subset of people that have given an ID of the given type
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list<string> # filter for people by partner ID
  --partner-pid: list<string> # filter for people by partner PID
  --pid: list<string> # filter for subset of people having given PID
  --programme: string # filter for subset of people that have contributed to the given programme pid
  --q: string # filter for subset of people matching supplied keyword/phrase (boolean operators permitted)
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/people"
    query: [{name: authority, var: authority}, {name: has_external_id, var: has_external_id, style: multi}, {name: id, var: id, style: multi}, {name: id_type, var: id_type}, {name: page, var: page}, {name: page_size, var: page_size}, {name: partner_id, var: partner_id, style: multi}, {name: partner_pid, var: partner_pid, style: multi}, {name: pid, var: pid, style: multi}, {name: programme, var: programme}, {name: q, var: q}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    authority: $authority, has_external_id: $has_external_id, id: $id, id_type: $id_type, page: $page, page_size: $page_size, partner_id: $partner_id, partner_pid: $partner_pid, pid: $pid, programme: $programme, q: $q
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

