# operationId: listSchedules
export def "list-schedules" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --sort: string@sort-completer-1 # Sorts: * start_date: sort chronologically by scheduled start time/date, ascending
  --sort-direction: string@sort-direction-completer # Sort direction
  --mixin: list<string> # Mixins: * ancestor_titles: return ancestor programme titles * images: mixin to add image information for broadcasts and webcasts * titles: return ancestor programme titles
  --authority: list<string> # filter for subset of broadcasts and webcasts that have given authority
  --descendants-of: list<string> # filter for subset of broadcasts and webcasts that are descendants of the given programme PID
  --end-from: string # filter for subset of broadcasts and webcasts that end on or later than the specified datetime (format: date-time)
  --end-to: string # filter for subset of broadcasts and webcasts that end on or earlier than the specified datetime (format: date-time)
  --format: list<string> # filter for subset of broadcasts and webcasts that are classified in the given format ID
  --genre: list<string> # filter for subset of broadcasts and webcasts that are classified in the given genre ID
  --group: string # filter for subset of broadcasts and webcasts that have programmes in the given group
  --id: list<string> # filter for subset of broadcasts and webcasts that have given identifier
  --id-type: list<string> # filter for subset of broadcasts and webcasts that have given id type
  --item: list<string> # filter for subset of broadcasts and webcasts with the given item performed on it
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list<string> # filter for broadcasts and webcasts by partner ID
  --partner-pid: list<string> # filter for broadcasts and webcasts by partner PID
  --people: string # filter for subset of broadcasts and webcasts that have given contributor
  --pid: list<string> # filter for subset of broadcasts and webcasts having given PID
  --q: string # filter for subset of broadcasts and webcasts matching supplied keyword/phrase (boolean operators permitted)
  --repeat: oneof<nothing, bool> # filter to show either only repeats or non-repeats
  --schedule-day: string # filter for subset of broadcasts and webcasts that start on the specified day (BBC time) (format: date)
  --schedule-day-from: string # filter for subset of broadcasts and webcasts that start on or after the specified day (BBC time) (format: date)
  --schedule-day-to: string # filter for subset of broadcasts and webcasts that start on or before the specified day (BBC time) (format: date)
  --service-master-brand: list<string> # filter for subset of broadcasts and webcasts with given service master brand
  --sid: list<string> # filter for subset of broadcasts and webcasts that are on the specified linear service
  --start-from: string # filter for subset of broadcasts and webcasts that start on or later than the specified datetime (format: date-time)
  --start-to: string # filter for subset of broadcasts and webcasts that start on or earlier than the specified datetime (format: date-time)
  --version: list<string> # filter for subset of broadcasts and webcasts with given PID as their parent version
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/schedules"
    query: [{name: sort, var: sort}, {name: sort_direction, var: sort_direction}, {name: mixin, var: mixin, style: multi}, {name: authority, var: authority, style: multi}, {name: descendants_of, var: descendants_of, style: multi}, {name: end_from, var: end_from}, {name: end_to, var: end_to}, {name: format, var: format, style: multi}, {name: genre, var: genre, style: multi}, {name: group, var: group}, {name: id, var: id, style: multi}, {name: id_type, var: id_type, style: multi}, {name: item, var: item, style: multi}, {name: page, var: page}, {name: page_size, var: page_size}, {name: partner_id, var: partner_id, style: multi}, {name: partner_pid, var: partner_pid, style: multi}, {name: people, var: people}, {name: pid, var: pid, style: multi}, {name: q, var: q}, {name: repeat, var: repeat}, {name: schedule_day, var: schedule_day}, {name: schedule_day_from, var: schedule_day_from}, {name: schedule_day_to, var: schedule_day_to}, {name: service_master_brand, var: service_master_brand, style: multi}, {name: sid, var: sid, style: multi}, {name: start_from, var: start_from}, {name: start_to, var: start_to}, {name: version, var: version, style: multi}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    sort: $sort, sort_direction: $sort_direction, mixin: $mixin, authority: $authority, descendants_of: $descendants_of, end_from: $end_from, end_to: $end_to, format: $format, genre: $genre, group: $group, id: $id, id_type: $id_type, item: $item, page: $page, page_size: $page_size, partner_id: $partner_id, partner_pid: $partner_pid, people: $people, pid: $pid, q: $q, repeat: $repeat, schedule_day: $schedule_day, schedule_day_from: $schedule_day_from, schedule_day_to: $schedule_day_to, service_master_brand: $service_master_brand, sid: $sid, start_from: $start_from, start_to: $start_to, version: $version
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

