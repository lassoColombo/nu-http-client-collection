# operationId: listPromotions
export def "list-promotions" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --mixin: list<string> # Mixins: * related_links: mixin to return information about related links to a promotion
  --context: string # filter for subset of promotions belonging to a given context
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list<string> # filter for promotions by partner ID
  --partner-pid: list<string> # filter for promotions by partner PID
  --pid: list<string> # filter for subset of promotions having given PID
  --promoted-by: list<string> # filter for subset of promotions having given promoted by
  --promoted-for: list<string> # filter for subset of promotions having given promoted for
  --q: string # filter for subset of promotions matching supplied keyword/phrase (boolean operators permitted)
  --status: list<string> # filter for subset of promotions with status
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/promotions"
    query: [{name: mixin, var: mixin, style: multi}, {name: context, var: context}, {name: page, var: page}, {name: page_size, var: page_size}, {name: partner_id, var: partner_id, style: multi}, {name: partner_pid, var: partner_pid, style: multi}, {name: pid, var: pid, style: multi}, {name: promoted_by, var: promoted_by, style: multi}, {name: promoted_for, var: promoted_for, style: multi}, {name: q, var: q}, {name: status, var: status, style: multi}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    mixin: $mixin, context: $context, page: $page, page_size: $page_size, partner_id: $partner_id, partner_pid: $partner_pid, pid: $pid, promoted_by: $promoted_by, promoted_for: $promoted_for, q: $q, status: $status
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

