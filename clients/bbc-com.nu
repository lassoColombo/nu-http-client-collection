# operationId: listAvailability
export def "list-availability" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --sort: string@sort-completer # Sorts: * scheduled_start: sort chronologically by scheduled start time/date, ascending
  --sort-direction: string@sort-direction-completer # Sort direction
  --availability: list<string> # filter for subset of availabilities
  --descendants-of: list<string> # filter for subset of availabilities that have PID as ancestor
  --media-set: list<string> # filter for subset of availabilities with media set
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --territory: list<string> # filter for availabilities in given territory
  --debug: oneof<nothing, bool> # Turn on debug information (undocumented)
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/availabilities"
    query: [{name: sort, var: sort}, {name: sort_direction, var: sort_direction}, {name: availability, var: availability, style: multi}, {name: descendants_of, var: descendants_of, style: multi}, {name: media_set, var: media_set, style: multi}, {name: page, var: page}, {name: page_size, var: page_size}, {name: territory, var: territory, style: multi}, {name: debug, var: debug}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    sort: $sort, sort_direction: $sort_direction, availability: $availability, descendants_of: $descendants_of, media_set: $media_set, page: $page, page_size: $page_size, territory: $territory, debug: $debug
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}

