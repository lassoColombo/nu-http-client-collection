# operationId: listVersions
export def "list-versions" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --full(-F) # Return full response record {status, headers, body} while still raising on 4xx/5xx
  --dry-run(-n) # Return the request that would be sent without executing it
  --accept: string@accept-completer # Response content type
  --availability: list<string> # filter for subset of versions that have availability
  --descendants-of: list<string> # filter for subset of versions having given programme PID
  --media-set: list<string> # filter for subset of versions with availability in the given media set
  --page: int # which page of results to return (default: 1)
  --page-size: int # number of results in each page (default: 10)
  --partner-id: list<string> # filter for versions by partner ID
  --partner-pid: list<string> # filter for versions by partner PID
  --payment-type: list<string> # filter for a subset of versions that are of the given payment_type
  --pid: list<string> # filter for subset of versions having given PID
  --embargoed: string@embargoed-completer # Control return of embargoed items (undocumented)
]: nothing -> oneof<record, string, nothing> {
  http-request {
    method: get
    path: "/versions"
    query: [{name: availability, var: availability, style: multi}, {name: descendants_of, var: descendants_of, style: multi}, {name: media_set, var: media_set, style: multi}, {name: page, var: page}, {name: page_size, var: page_size}, {name: partner_id, var: partner_id, style: multi}, {name: partner_pid, var: partner_pid, style: multi}, {name: payment_type, var: payment_type, style: multi}, {name: pid, var: pid, style: multi}, {name: embargoed, var: embargoed}]
    accept: ["application/json", "application/xml"]
    ok: [200]
    auth: query-api_key
  } {
    availability: $availability, descendants_of: $descendants_of, media_set: $media_set, page: $page, page_size: $page_size, partner_id: $partner_id, partner_pid: $partner_pid, payment_type: $payment_type, pid: $pid, embargoed: $embargoed
    base_url: $base_url, token: $token, auth_scheme: $auth_scheme, insecure: $insecure, max_time: $max_time, raw: $raw, allow_errors: $allow_errors, full: $full, dry_run: $dry_run, accept: $accept
  }
}
