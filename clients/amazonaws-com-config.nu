# List all available API commands with their parameters
export def commands []: nothing -> table {
  let builtin_flags = ["base-url" "token" "auth-scheme" "insecure" "max-time" "raw" "allow-errors" "full" "dry-run" "accept" "help"]
  let return_types = {
    batch-get-aggregate-resource-config: "record<BaseConfigurationItems: table<version: string, accountId: string, configurationItemCaptureTime: string, configurationItemStatus: string, configurationStateId: string, arn: string, resourceType: string, resourceId: string, resourceName: string, awsRegion: string, availabilityZone: string, resourceCreationTime: string, configuration: string, supplementaryConfiguration: record>, UnprocessedResourceIdentifiers: table<SourceAccountId: string, SourceRegion: string, ResourceId: string, ResourceType: string, ResourceName: string>>"
    batch-get-resource-config: "record<baseConfigurationItems: table<version: string, accountId: string, configurationItemCaptureTime: string, configurationItemStatus: string, configurationStateId: string, arn: string, resourceType: string, resourceId: string, resourceName: string, awsRegion: string, availabilityZone: string, resourceCreationTime: string, configuration: string, supplementaryConfiguration: record>, unprocessedResourceKeys: table<resourceType: string, resourceId: string>>"
    delete-evaluation-results: "record"
    delete-remediation-configuration: "record"
    delete-remediation-exceptions: "record<FailedBatches: table<FailureMessage: string, FailedItems: list>>"
    delete-stored-query: "record"
    deliver-config-snapshot: "record<configSnapshotId: string>"
    describe-aggregate-compliance-by-config-rules: "record<AggregateComplianceByConfigRules: table<ConfigRuleName: string, Compliance: record, AccountId: string, AwsRegion: string>, NextToken: string>"
    describe-aggregate-compliance-by-conformance-packs: "record<AggregateComplianceByConformancePacks: table<ConformancePackName: string, Compliance: record, AccountId: string, AwsRegion: string>, NextToken: string>"
    describe-aggregation-authorizations: "record<AggregationAuthorizations: table<AggregationAuthorizationArn: string, AuthorizedAccountId: string, AuthorizedAwsRegion: string, CreationTime: string>, NextToken: string>"
