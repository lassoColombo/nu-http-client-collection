  --cancelledgte: string # Filters events that were cancelled on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01`  (format: date-time)
  --cancelledgt: string # Filters events that were cancelled after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  (format: date-time)
  --cancelledlte: string # Filters events that were cancelled on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01`  (format: date-time)
