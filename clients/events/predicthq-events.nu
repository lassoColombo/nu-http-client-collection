  --predicted-endlte: string # Filters events that are predicted to end on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --predicted-endlt: string # Filters events that are predicted to end before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --predicted-endtz: string # Specifies the timezone for the `predicted_end.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --predicted-event-spendgte: int # Filters events with a Predicted Event Spend (USD) greater or equal to the specified value.  Note: When using this filter events that do not have a  predicted_event_spend  will not be returned.  Example: `80000`
  --predicted-event-spendgt: int # Filters events with a Predicted Event Spend greater than the specified value (exclusive).
  --predicted-event-spendlte: int # Filters events with a Predicted Event Spend less than or equal to the specified value.  Example: `200000`
  --predicted-event-spendlt: int # Filters events with a Predicted Event Spend less than the specified value (exclusive).
  --predicted-event-spend-industry<industry><suffix>: int # The Predicted Event Spend for a given industry in USD.  Supported industries: - accommodation - hospitality - transportation  The format of this parameter name is: `predicted_event_spend_industry.<industry>.<suffix>`  Supports `gt`, `gte`, `lt` and `lte` suffixes in the same way other range parameters are supported.  Please note that use of a suffix is required.  Note: When using this filter events that do not have a `predicted_event_spend` will not be returned.
  --privateinclude: string@privateinclude-completer # Whether or not to include private events. Private events are excluded by default.  Private events are those that have the `private` field set to `true`. These events are typically not publicly advertised and may have limited information available. They may be included in the API for specific use cases, but are generally not included in search results by default.  Default: `false`
  --privateuser-id: list # A comma-separated list of user identifiers. This filters the events returned to private events that are associated with the specified users.  The `private.user_id` filter must be used in conjunction with `private.include=true` or `private.include=only`.  Example: `12345,67890`
  --privateorg-review: list # A comma-separated list of review statuses for private events. This filters the events returned to private events that have been reviewed by the specified organizations. The `private.org_review` filter must be used in conjunction with `private.include=true` or `private.include=only`.  Example: `approved,pending`
  --q: string # A full-text search query.  Example: `katy perry`
  --rankgte: int # Filters events with a PHQ Rank greater than or equal to the specified value.  Example: `80`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --rankgt: int # Filters events with a PHQ Rank greater than the specified value.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --ranklte: int # Filters events with a PHQ Rank less than or equal to the specified value.  Example: `90`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --ranklt: int # Filters events with a PHQ Rank less than the specified value.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --rank-level: list # A comma-separated list of numbers between 1 and 5, corresponding to the PHQ Rank levels.  Possible values:  - 1 - Minor (rank between 0 and 20). - 2 - Moderate (rank between 21 and 40). - 3 - Important (rank between 41 and 60). - 4 - Significant (rank between 61 and 80). - 5 - Major (rank between 81 and 100).  Example: `4,5`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --saved-locationlocation-id: list # A comma-separated list of saved location identifiers. Up to a maximum of 20 identifiers. This filters the events returned to events within the locations specified. Refer to the Saved Locations API for more details on managing locations.  Example: `sFlb8HlsLa1j-S4UDEMEkQ`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --qp-sort: list # Comma-separated fields to sort results by. Default: `-start` (most recent first). Prefix a field name with `-` to reverse the direction.  - `id`: sort alphabetically A–Z - `-id`: sort alphabetically Z–A - `title`: sort alphabetically A–Z - `-title`: sort alphabetically Z–A - `start`: earliest first (ascending) - `-start`: most recent first (descending) - `end`: earliest first (ascending) - `-end`: most recent first (descending) - `first_seen`: oldest first (ascending) - `-first_seen`: newest first (descending) - `predicted_end`: earliest first (ascending) - `-predicted_end`: most recent first (descending) - `updated`: oldest first (ascending) - `-updated`: newest first (descending) - `rank`: highest rank first (descending) - `-rank`: lowest rank first (ascending) - `local_rank`: highest rank first (descending) - `-local_rank`: lowest rank first (ascending) - `phq_attendance`: highest attendance first (descending) - `-phq_attendance`: lowest attendance first (ascending) - `category`: sort alphabetically A–Z - `-category`: sort alphabetically Z–A - `duration`: shortest first (ascending) - `-duration`: longest first (descending) - `country`: sort alphabetically A–Z - `-country`: sort alphabetically Z–A - `labels`: sort alphabetically A–Z - `-labels`: sort alphabetically Z–A - `predicted_event_spend`: highest spend first (descending) - `-predicted_event_spend`: lowest spend first (ascending) - `predicted_event_spend_industry.*`: highest spend first (descending) - `-predicted_event_spend_industry.*`: lowest spend first (ascending)  Note when sorting on `predicted_end` or `local_rank`, events without a value for that field will be placed last.  Example: `country,-start`
  --startgte: string # Filters events that start on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --startgt: string # Filters events that start after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --startlte: string # Filters events that start on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --startlt: string # Filters events that start before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --starttz: string # Specifies the timezone for the `start.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --start-date-confidence-scoregte: int # A unique attribute to Predicted Events that were generated from analyzing sets of recurring events. The score ranges from 1 to 5, representing the event’s consistency in being held around the same date with each recurrence. Higher scores indicate the event is held at mostly the same date each year, while lower scores indicate a greater variation in start date, meaning that details are more likely to change as new details become available.
  --start-date-confidence-scoregt: int # Filters events with a start date confidence score greater than the specified score (exclusive).
  --start-date-confidence-scorelte: int # Filters events with a start date confidence score less than or equal to the specified score.
  --start-date-confidence-scorelt: int # Filters events with a start date confidence score less than the specified score (exclusive).
  --state: list # A comma-separated list of states for the events.  This parameter is useful in conjunction with `updated` when you cache events and are interested in retrieving a list of all events that have changed since a specific date and time.  Example: `active,deleted`  Default: `active`
  --updatedgte: string # Filters events that were last modified on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --updatedgt: string # Filters events that were last modified after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --updatedlte: string # Filters events that were last modified on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --updatedlt: string # Filters events that were last modified before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --updatedtz: string # Specifies the timezone for the `updated.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --within: string # A geo center and radius in the form `{radius}{unit}@{latitude},{longitude}`, where the radius unit can be one of: `m`, `km`, `ft`, `mi`.  When using the units of `km` and `mi` you can enter whole numbers or floats e.g. `5mi`, `1.5km` or `1.2mi`. When using the units `ft` or `m` you must enter whole numbers (you cannot enter a fraction of a meter or foot).  Note that results may contain events that apply to a parent scope of the specified area.  Note we always recommend using our Suggested Radius API to determine the relevant impact zone around your location.  Example: `2.5mi@-36.844480,174.768368`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --limit: int # Limit the number of results. (default: 10)
  --offset: int # Offset the results. (default: 0)
]: nothing -> record<count: int, overflow: bool, previous: string, next: string, results: table<brand_safe: bool, cancelled: string, category: string, country: string, deleted_reason: string, description: string, duplicate_of_id: string, duration: int, end: string, end_local: string, entities: list, first_seen: string, id: string, impact_patterns: list, labels: list, local_rank: int, location: list, location_confidence_score: int, geo: any, parent_event: record, phq_attendance: int, phq_labels: list, place_hierarchies: list, postponed: string, predicted_end: string, predicted_end_local: string, predicted_event_spend: int, predicted_event_spend_industries: record, rank: int, scope: string, start: string, start_local: string, start_date_confidence_score: int, state: string, timezone: string, title: string, updated: string, private: bool>> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
