# Get Event Counts
#
# GET /v1/events/count/
# operationId: count_events
@deprecated --flag label
export def "events-count events" [
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --dry-run(-n) # Return the request that would be sent without executing it
  --activegte: string # Filters events that are active on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --activegt: string # Filters events that are active after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --activelte: string # Filters events that are active on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --activelt: string # Filters events that are active before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --activetz: string # Specifies the timezone for the `active.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --beamanalysis-id: string # An optional Beam Analysis filter which if provided will calculate the location, rank and categories from the Beam Analysis and optionally the Beam Analysis group (see `beam.group_id`).  This is the best way to filter for events relevant to your business based on your Beam Analysis.  The following parameters are mutually exclusive with `beam.analysis_id` and cannot be used in the same request:  - `within` - `category` - `country` - `local_rank.gt` - `local_rank.gte` - `local_rank.lt` - `local_rank.lte` - `local_rank_level` - `place.scope` - `place.exact` - `placekey` - `rank.gt` - `rank.gte` - `rank.lt` - `rank.lte` - `rank_level` - `saved_location.location_id`
  --beamgroup-id: string # If `beam.group_id` is provided the categories will be calculated from the feature importance results of the Analysis Group otherwise the categories will be calculated from the feature importance results of the individual Analysis.  If using `beam.group_id` the `beam.analysis_id` is required.
  --brand-unsafeexclude: string@brand-unsafeexclude-completer # Whether or not to exclude potentially brand-unsafe events. Potentially brand-unsafe events are included by default.  Examples of brand-unsafe events include content that promotes hate, violence or discrimination, coarse language, content that is sexually suggestive or explicit, etc.  Default: `false`
  --cancelledgte: string # Filters events that were cancelled on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01`  (format: date-time)
  --cancelledgt: string # Filters events that were cancelled after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  (format: date-time)
  --cancelledlte: string # Filters events that were cancelled on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01`  (format: date-time)
  --cancelledlt: string # Filters events that were cancelled before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  (format: date-time)
  --cancelledtz: string # Specifies the timezone for the `cancelled.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --category: list # A comma-separated list of categories.  Take a look at the [Event Categories](https://docs.predicthq.com/getting-started/predicthq-data/event-categories) page for an overview of the different categories.  Example: `concerts,sports`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --country: list # A comma-separated list of 2-letter country codes.  Example: `US`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --deleted-reason: list # A comma-separated list of deleted reasons for the events.  Example: `cancelled,duplicate`
  --endgte: string # Filters events that end on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --endgt: string # Filters events that end after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --endlte: string # Filters events that end on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --endlt: string # Filters events that end before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --endtz: string # Specifies the timezone for the `end.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --entityid: list # A comma-separated list of Entity identifiers.  Example: `XABWvihQAj8TnjvF6WNzLW`
  --first-seengte: string # Filters events that were first seen in our system on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --first-seengt: string # Filters events that were first seen in our system after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --first-seenlte: string # Filters events that were first seen in our system on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --first-seenlt: string # Filters events that were first seen in our system before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --first-seentz: string # Specifies the timezone for the `first_seen.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --id: list # A comma-separated list of Event identifiers.  Example: `z13B3870YOgv`
  --impactgte: string # Filters events that are predicted to have an impact on or after the specified date.  The Predicted Impact Pattern of events can be larger than the actual event date range.  These parameters work similarly to the `active.*` parameter, but it uses an industry-specific Predicted Impact Pattern date range of an event where applicable.  You must also specify the industry (see `impact.industry`).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --impactgt: string # Filters events that are predicted to have an impact after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --impactlte: string # Filters events that are predicted to have an impact on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --impactlt: string # Filters events that are predicted to have an impact before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --impacttz: string # Specifies the timezone for the `impact.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --impactindustry: string@impactindustry-completer # Selected industry for the Predicted Impact Patterns.  If no industry is selected, `impact.*` will function effectively the same as `active.*`.  Example: `accommodation`
  --label: list # A comma-separated list of labels.  Please note that all event labels are lowercase and that the search is case sensitive.  The `label` param has been deprecated. Please update your integrations to use `phq_label` instead.  Example: `holiday,observance` (DEPRECATED)
  --local-rankgte: int # Filters events with a Local Rank greater than or equal to the specified value.  Events without a Local Rank will not be returned.  Example: `80`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --local-rankgt: int # Filters events with a Local Rank greater than the specified value.  Events without a Local Rank will not be returned.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --local-ranklte: int # Filters events with a Local Rank less than or equal to the specified value.  Events without a Local Rank will not be returned.  Example: `90`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --local-ranklt: int # Filters events with a Local Rank less than the specified value.  Events without a Local Rank will not be returned.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --local-rank-level: list # A comma-separated list of numbers between 1 and 5, corresponding to the Local Rank levels.  Possible values:  - 1 - Minor (rank between 0 and 20). - 2 - Moderate (rank between 21 and 40). - 3 - Important (rank between 41 and 60). - 4 - Significant (rank between 61 and 80). - 5 - Major (rank between 81 and 100).  Example: `4,5`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --location-confidence-scoregte: int # A unique attribute to Predicted Events that were generated from analyzing sets of recurring events. The score ranges from 1 to 5, representing the event’s propensity to change location with each recurrence. Higher scores indicate a higher consistency in location, while lower scores indicate the event’s location is more likely to shift once additional details become available.
  --location-confidence-scoregt: int # Filters events with a location confidence score greater than the specified score (exclusive).
  --location-confidence-scorelte: int # Filters events with a location confidence score less than or equal to the specified score.
  --location-confidence-scorelt: int # Filters events with a location confidence score less than the specified score (exclusive).
  --parentinclude: string@parentinclude-completer # Whether or not to include parent events / exclude child events.  Note that child events are those events that have a link to a parent event. Parent events are all the other events, whether they have children or not.  See the documentation on [umbrella events](https://docs.predicthq.com/getting-started/guides/date-and-time-guides/working-with-multi-day-and-umbrella-events#umbrella-events-beta) for more information on parent and child events.  Default: `true`
  --phq-attendancegte: int # Filters events with a Predicted Attendance greater than or equal to the specified value.  Example: `2000`
  --phq-attendancegt: int # Filters events with a Predicted Attendance greater than the specified value.
  --phq-attendancelte: int # Filters events with a Predicted Attendance less than or equal to the specified value.  Example: `10000`
  --phq-attendancelt: int # Filters events with a Predicted Attendance less than the specified value.
  --phq-label: list # A comma-separated list of PHQ labels.  PHQ Labels leverage AI and classifier models for more accurate labelling.  Please note that all event labels are lowercase and that the search is case sensitive.  Take a look at [PHQ Label Values](https://docs.predicthq.com/getting-started/predicthq-data/labels#phq-label-values) to get a list of possible values.  Example: `agriculture-forestry-and-fisheries,food-and-beverage`
  --phq-labelop: string@phq-labelop-completer # Whether to find events with `any` or `all` the specified labels.  Default: `any`
  --phq-labelexclude: list # A comma-separated list of PHQ labels to exclude. This will filter for events that do not have the specified labels.  Please note that all event labels are lowercase and that the search is case sensitive.  Example: `lifestyle`
  --phq-labelexcludeop: string@phq-labelexcludeop-completer # Whether to exclude events with `any` or `all` the specified labels.  Default: `any`
  --placescope: list # A comma-separated list of Place IDs and/or IATA (3 character), ICAO (4 character), and UN/LOCODE (5 character) airport codes where the events occur.  A CSV file of all supported airport codes and their respective Place IDs is available to download.  Results will contain events that apply to the parent and children places of the specified place. E.g. National, regional and local school holidays that apply to a region.  Example: `5128638,SFO`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --placeexact: list # A comma-separated list of Place IDs and/or IATA (3 character), ICAO (4 character), and UN/LOCODE (5 character) airport codes where the events occur.  Results will contain events that apply to the specified place only. E.g. Regional school holidays only.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --placekey: list # A comma-separated list of Placekeys (See [placekey.io](https://www.placekey.io/)). Returns events that have a Placekey value matching this filter.  There are 2 parts to a Placekey: `what@where`  - `what` Contains 2 part in the form `{address}-{poi}`.   - The first part represents an address.   - The second part represents a Point Of Interest (E.g. named venue). This will be missing on locations that only have addresses - `where` An H3 hexagon index (resolution 10) of the event.  This filter supports entering a full Placekey to match events having that specific Placekey or a partial Placekey (such as just the `@where` part) to perform a partial match on Placekey. You can use the following Placekey format in this filter:  - `{address}-{poi}@{where}` - only returns events with a full matching placekey (an exact match) - `{address}@{where}` - matches events where the the address and where part match (even if poi is different) - `@{where}` - matches events for which the `@where` part matches, ignores the `{address}-{poi}` parts. You can perform a partial match on the `@where` part to find nearby events. The minimum amount of characters that can be matched on is 5. See [using Placekey](https://docs.predicthq.com/getting-started/guides/geolocation-guides/searching-by-location/find-events-by-placekey) for more details.   Note that Placekey applies to our attended event categories. Some events do not contain a Placekey.  Example: `225@63j-rqb-j7q,@627-s8j-z2k`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --postponedgte: string # Filters events that were marked as postponed on or after the specified date.  Note when filtering on postponed, events that are not postponed will not be returned.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --postponedgt: string # Filters events that were marked as postponed after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --postponedlte: string # Filters events that were marked as postponed on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --postponedlt: string # Filters events that were marked as postponed before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --postponedtz: string # Specifies the timezone for the `postponed.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --predicted-endgte: string # Filters events that are predicted to end on or after the specified date.  Note when filtering on postponed, events that are not postponed will not be returned.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --predicted-endgt: string # Filters events that are predicted to end after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --predicted-endlte: string # Filters events that are predicted to end on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --predicted-endlt: string # Filters events that are predicted to end before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --predicted-endtz: string # Specifies the timezone for the `predicted_end.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --predicted-event-spendgte: int # Filters events with a Predicted Event Spend (USD) greater or equal to the specified value.  Note: When using this filter events that do not have a  predicted_event_spend  will not be returned.  Example: `80000`
  --predicted-event-spendgt: int # Filters events with a Predicted Event Spend greater than the specified value (exclusive).
  --predicted-event-spendlte: int # Filters events with a Predicted Event Spend less than or equal to the specified value.  Example: `200000`
  --predicted-event-spendlt: int # Filters events with a Predicted Event Spend less than the specified value (exclusive).
  --predicted-event-spend-industry<industry><suffix>: int # The Predicted Event Spend for a given industry in USD.  Supported industries: - accommodation - hospitality - transportation  The format of this parameter name is: `predicted_event_spend_industry.<industry>.<suffix>`  Supports `gt`, `gte`, `lt` and `lte` suffixes in the same way other range parameters are supported.  Please note that use of a suffix is required.  Note: When using this filter events that do not have a `predicted_event_spend` will not be returned.
  --privateinclude: string@privateinclude-completer # Whether or not to include private events. Private events are excluded by default.  Private events are those that have the `private` field set to `true`. These events are typically not publicly advertised and may have limited information available. They may be included in the API for specific use cases, but are generally not included in search results by default.  Default: `false`
  --privateuser-id: list # A comma-separated list of user identifiers. This filters the events returned to private events that are associated with the specified users.  The `private.user_id` filter must be used in conjunction with `private.include=true` or `private.include=only`.  Example: `12345,67890`
  --privateorg-review: list # A comma-separated list of review statuses for private events. This filters the events returned to private events that have been reviewed by the specified organizations. The `private.org_review` filter must be used in conjunction with `private.include=true` or `private.include=only`.  Example: `approved,pending`
  --q: string # A full-text search query.  Example: `katy perry`
  --rankgte: int # Filters events with a PHQ Rank greater than or equal to the specified value.  Example: `80`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --rankgt: int # Filters events with a PHQ Rank greater than the specified value.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --ranklte: int # Filters events with a PHQ Rank less than or equal to the specified value.  Example: `90`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --ranklt: int # Filters events with a PHQ Rank less than the specified value.  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --rank-level: list # A comma-separated list of numbers between 1 and 5, corresponding to the PHQ Rank levels.  Possible values:  - 1 - Minor (rank between 0 and 20). - 2 - Moderate (rank between 21 and 40). - 3 - Important (rank between 41 and 60). - 4 - Significant (rank between 61 and 80). - 5 - Major (rank between 81 and 100).  Example: `4,5`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --saved-locationlocation-id: list # A comma-separated list of saved location identifiers. Up to a maximum of 20 identifiers. This filters the events returned to events within the locations specified. Refer to the Saved Locations API for more details on managing locations.  Example: `sFlb8HlsLa1j-S4UDEMEkQ`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
  --qp-sort: list # Comma-separated fields to sort results by. Default: `-start` (most recent first). Prefix a field name with `-` to reverse the direction.  - `id`: sort alphabetically A–Z - `-id`: sort alphabetically Z–A - `title`: sort alphabetically A–Z - `-title`: sort alphabetically Z–A - `start`: earliest first (ascending) - `-start`: most recent first (descending) - `end`: earliest first (ascending) - `-end`: most recent first (descending) - `first_seen`: oldest first (ascending) - `-first_seen`: newest first (descending) - `predicted_end`: earliest first (ascending) - `-predicted_end`: most recent first (descending) - `updated`: oldest first (ascending) - `-updated`: newest first (descending) - `rank`: highest rank first (descending) - `-rank`: lowest rank first (ascending) - `local_rank`: highest rank first (descending) - `-local_rank`: lowest rank first (ascending) - `phq_attendance`: highest attendance first (descending) - `-phq_attendance`: lowest attendance first (ascending) - `category`: sort alphabetically A–Z - `-category`: sort alphabetically Z–A - `duration`: shortest first (ascending) - `-duration`: longest first (descending) - `country`: sort alphabetically A–Z - `-country`: sort alphabetically Z–A - `labels`: sort alphabetically A–Z - `-labels`: sort alphabetically Z–A - `predicted_event_spend`: highest spend first (descending) - `-predicted_event_spend`: lowest spend first (ascending) - `predicted_event_spend_industry.*`: highest spend first (descending) - `-predicted_event_spend_industry.*`: lowest spend first (ascending)  Note when sorting on `predicted_end` or `local_rank`, events without a value for that field will be placed last.  Example: `country,-start`
  --startgte: string # Filters events that start on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --startgt: string # Filters events that start after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --startlte: string # Filters events that start on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --startlt: string # Filters events that start before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --starttz: string # Specifies the timezone for the `start.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --start-date-confidence-scoregte: int # A unique attribute to Predicted Events that were generated from analyzing sets of recurring events. The score ranges from 1 to 5, representing the event’s consistency in being held around the same date with each recurrence. Higher scores indicate the event is held at mostly the same date each year, while lower scores indicate a greater variation in start date, meaning that details are more likely to change as new details become available.
  --start-date-confidence-scoregt: int # Filters events with a start date confidence score greater than the specified score (exclusive).
  --start-date-confidence-scorelte: int # Filters events with a start date confidence score less than or equal to the specified score.
  --start-date-confidence-scorelt: int # Filters events with a start date confidence score less than the specified score (exclusive).
  --state: list # A comma-separated list of states for the events.  This parameter is useful in conjunction with `updated` when you cache events and are interested in retrieving a list of all events that have changed since a specific date and time.  Example: `active,deleted`  Default: `active`
  --updatedgte: string # Filters events that were last modified on or after the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-01-01` (format: date-time)
  --updatedgt: string # Filters events that were last modified after the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --updatedlte: string # Filters events that were last modified on or before the specified date.  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`.  Example: `2025-02-01` (format: date-time)
  --updatedlt: string # Filters events that were last modified before the specified date (exclusive).  Expected format: `YYYY-MM-DD` or `YYYY-MM-DDThh:mm:ss`. (format: date-time)
  --updatedtz: string # Specifies the timezone for the `updated.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --within: string # A geo center and radius in the form `{radius}{unit}@{latitude},{longitude}`, where the radius unit can be one of: `m`, `km`, `ft`, `mi`.  When using the units of `km` and `mi` you can enter whole numbers or floats e.g. `5mi`, `1.5km` or `1.2mi`. When using the units `ft` or `m` you must enter whole numbers (you cannot enter a fraction of a meter or foot).  Note that results may contain events that apply to a parent scope of the specified area.  Note we always recommend using our Suggested Radius API to determine the relevant impact zone around your location.  Example: `2.5mi@-36.844480,174.768368`  Must not be used in conjunction with `beam.analysis_id`. These two parameters are mutually exclusive — only one may be provided per request.
]: nothing -> record<count: int, top_rank: int, top_local_rank: int, top_aviation_rank: int, rank_levels: record<1: int, 2: int, 3: int, 4: int, 5: int>, local_rank_levels: record<1: int, 2: int, 3: int, 4: int, 5: int>, aviation_rank_levels: record<1: int, 2: int, 3: int, 4: int, 5: int>, categories: record, labels: record, phq_labels: record> {
  let auth = (build-auth $token ($auth_scheme | default "bearer"))
  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "active.gte" $activegte "scalar") (serialize-qp "active.gt" $activegt "scalar") (serialize-qp "active.lte" $activelte "scalar") (serialize-qp "active.lt" $activelt "scalar") (serialize-qp "active.tz" $activetz "scalar") (serialize-qp "beam.analysis_id" $beamanalysis_id "scalar") (serialize-qp "beam.group_id" $beamgroup_id "scalar") (serialize-qp "brand_unsafe.exclude" $brand_unsafeexclude "scalar") (serialize-qp "cancelled.gte" $cancelledgte "scalar") (serialize-qp "cancelled.gt" $cancelledgt "scalar") (serialize-qp "cancelled.lte" $cancelledlte "scalar") (serialize-qp "cancelled.lt" $cancelledlt "scalar") (serialize-qp "cancelled.tz" $cancelledtz "scalar") (serialize-qp "category" $category "csv") (serialize-qp "country" $country "csv") (serialize-qp "deleted_reason" $deleted_reason "csv") (serialize-qp "end.gte" $endgte "scalar") (serialize-qp "end.gt" $endgt "scalar") (serialize-qp "end.lte" $endlte "scalar") (serialize-qp "end.lt" $endlt "scalar") (serialize-qp "end.tz" $endtz "scalar") (serialize-qp "entity.id" $entityid "csv") (serialize-qp "first_seen.gte" $first_seengte "scalar") (serialize-qp "first_seen.gt" $first_seengt "scalar") (serialize-qp "first_seen.lte" $first_seenlte "scalar") (serialize-qp "first_seen.lt" $first_seenlt "scalar") (serialize-qp "first_seen.tz" $first_seentz "scalar") (serialize-qp "id" $id "csv") (serialize-qp "impact.gte" $impactgte "scalar") (serialize-qp "impact.gt" $impactgt "scalar") (serialize-qp "impact.lte" $impactlte "scalar") (serialize-qp "impact.lt" $impactlt "scalar") (serialize-qp "impact.tz" $impacttz "scalar") (serialize-qp "impact.industry" $impactindustry "scalar") (serialize-qp "label" $label "csv") (serialize-qp "local_rank.gte" $local_rankgte "scalar") (serialize-qp "local_rank.gt" $local_rankgt "scalar") (serialize-qp "local_rank.lte" $local_ranklte "scalar") (serialize-qp "local_rank.lt" $local_ranklt "scalar") (serialize-qp "local_rank_level" $local_rank_level "csv") (serialize-qp "location_confidence_score.gte" $location_confidence_scoregte "scalar") (serialize-qp "location_confidence_score.gt" $location_confidence_scoregt "scalar") (serialize-qp "location_confidence_score.lte" $location_confidence_scorelte "scalar") (serialize-qp "location_confidence_score.lt" $location_confidence_scorelt "scalar") (serialize-qp "parent.include" $parentinclude "scalar") (serialize-qp "phq_attendance.gte" $phq_attendancegte "scalar") (serialize-qp "phq_attendance.gt" $phq_attendancegt "scalar") (serialize-qp "phq_attendance.lte" $phq_attendancelte "scalar") (serialize-qp "phq_attendance.lt" $phq_attendancelt "scalar") (serialize-qp "phq_label" $phq_label "csv") (serialize-qp "phq_label.op" $phq_labelop "scalar") (serialize-qp "phq_label.exclude" $phq_labelexclude "csv") (serialize-qp "phq_label.exclude.op" $phq_labelexcludeop "scalar") (serialize-qp "place.scope" $placescope "csv") (serialize-qp "place.exact" $placeexact "csv") (serialize-qp "placekey" $placekey "csv") (serialize-qp "postponed.gte" $postponedgte "scalar") (serialize-qp "postponed.gt" $postponedgt "scalar") (serialize-qp "postponed.lte" $postponedlte "scalar") (serialize-qp "postponed.lt" $postponedlt "scalar") (serialize-qp "postponed.tz" $postponedtz "scalar") (serialize-qp "predicted_end.gte" $predicted_endgte "scalar") (serialize-qp "predicted_end.gt" $predicted_endgt "scalar") (serialize-qp "predicted_end.lte" $predicted_endlte "scalar") (serialize-qp "predicted_end.lt" $predicted_endlt "scalar") (serialize-qp "predicted_end.tz" $predicted_endtz "scalar") (serialize-qp "predicted_event_spend.gte" $predicted_event_spendgte "scalar") (serialize-qp "predicted_event_spend.gt" $predicted_event_spendgt "scalar") (serialize-qp "predicted_event_spend.lte" $predicted_event_spendlte "scalar") (serialize-qp "predicted_event_spend.lt" $predicted_event_spendlt "scalar") (serialize-qp "predicted_event_spend_industry.<industry>.<suffix>" $predicted_event_spend_industry<industry><suffix> "scalar") (serialize-qp "private.include" $privateinclude "scalar") (serialize-qp "private.user_id" $privateuser_id "csv") (serialize-qp "private.org_review" $privateorg_review "csv") (serialize-qp "q" $q "scalar") (serialize-qp "rank.gte" $rankgte "scalar") (serialize-qp "rank.gt" $rankgt "scalar") (serialize-qp "rank.lte" $ranklte "scalar") (serialize-qp "rank.lt" $ranklt "scalar") (serialize-qp "rank_level" $rank_level "csv") (serialize-qp "saved_location.location_id" $saved_locationlocation_id "csv") (serialize-qp "sort" $qp_sort "csv") (serialize-qp "start.gte" $startgte "scalar") (serialize-qp "start.gt" $startgt "scalar") (serialize-qp "start.lte" $startlte "scalar") (serialize-qp "start.lt" $startlt "scalar") (serialize-qp "start.tz" $starttz "scalar") (serialize-qp "start_date_confidence_score.gte" $start_date_confidence_scoregte "scalar") (serialize-qp "start_date_confidence_score.gt" $start_date_confidence_scoregt "scalar") (serialize-qp "start_date_confidence_score.lte" $start_date_confidence_scorelte "scalar") (serialize-qp "start_date_confidence_score.lt" $start_date_confidence_scorelt "scalar") (serialize-qp "state" $state "csv") (serialize-qp "updated.gte" $updatedgte "scalar") (serialize-qp "updated.gt" $updatedgt "scalar") (serialize-qp "updated.lte" $updatedlte "scalar") (serialize-qp "updated.lt" $updatedlt "scalar") (serialize-qp "updated.tz" $updatedtz "scalar") (serialize-qp "within" $within "scalar")] | flatten | str join "&"
