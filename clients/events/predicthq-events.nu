  --first-seentz: string # Specifies the timezone for the `first_seen.*` date parameters.  Timezone must be in the [TZ Database](https://en.wikipedia.org/wiki/List_of_tz_database_time_zones) format (e.g. `America/Los_Angeles`).  Default: `UTC`
  --id: list # A comma-separated list of Event identifiers.  Example: `z13B3870YOgv`
