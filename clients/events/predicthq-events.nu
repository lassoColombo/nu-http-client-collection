  --beamanalysis-id: string # An optional Beam Analysis filter which if provided will calculate the location, rank and categories from the Beam Analysis and optionally the Beam Analysis group (see `beam.group_id`).  This is the best way to filter for events relevant to your business based on your Beam Analysis.  The following parameters are mutually exclusive with `beam.analysis_id` and cannot be used in the same request:  - `within` - `category` - `country` - `local_rank.gt` - `local_rank.gte` - `local_rank.lt` - `local_rank.lte` - `local_rank_level` - `place.scope` - `place.exact` - `placekey` - `rank.gt` - `rank.gte` - `rank.lt` - `rank.lte` - `rank_level` - `saved_location.location_id`
  --beamgroup-id: string # If `beam.group_id` is provided the categories will be calculated from the feature importance results of the Analysis Group otherwise the categories will be calculated from the feature importance results of the individual Analysis.  If using `beam.group_id` the `beam.analysis_id` is required.
