  --advertiserIds: list # Select only placement groups that belong to these advertisers.
  --archived: oneof<nothing, bool> # Select only archived placements. Don't set this field to select both archived and non-archived placements.
  --campaignIds: list # Select only placement groups that belong to these campaigns.
  --contentCategoryIds: list # Select only placement groups that are associated with these content categories.
  --directorySiteIds: list # Select only placement groups that are associated with these directory sites.
  --ids: list # Select only placement groups with these IDs.
