  --required-flash-plugin-version: string # The minimum required Flash plugin version for this creative. For example, 11.2.202.235. This is a read-only field. Applicable to the following creative types: all RICH_MEDIA, and all VPAID.
  --required-flash-version: int # The internal Flash version for this creative as calculated by Studio. This is a read-only field. Applicable to the following creative types: FLASH_INPAGE all RICH_MEDIA, and all VPAID. Applicable to DISPLAY when the primary asset type is not HTML_IMAGE. (format: int32)
  --size: record # Represents the dimensions of ads, placements, creatives, or creative assets. — shape: {height?: int, iab?: bool, id?: string, kind?: string, width?: int}
