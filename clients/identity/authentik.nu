  name: string
  --not-configured-action: string@not-configured-action-completer
  --device-classes: list # Device classes which can be used to authenticate
  --configuration-stages: list # Stages used to configure Authenticator when user doesn't have any compatible devices. After this configuration Stage passes, the user is not prompted again.
  --last-auth-threshold: string # If any of the user's device has been used within this threshold, this stage will be skipped
  --webauthn-user-verification: any # Enforce user verification for WebAuthn devices.
