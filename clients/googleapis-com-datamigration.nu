# Completers for enum parameters
def xgafv-completer [] { ["1" "2"] }
def alt-completer [] { ["json" "media" "proto"] }
def state-completer [] { ["COMPLETED" "CREATING" "DELETED" "DELETING" "DRAFT" "FAILED" "MAINTENANCE" "NOT_STARTED" "RESTARTING" "RESUMING" "RUNNING" "STARTING" "STATE_UNSPECIFIED" "STOPPED" "STOPPING" "UPDATING"] }
