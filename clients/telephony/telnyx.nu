  --session-id: string # id of the room session associated with the room composition. (format: uuid, e.g. 0ccc7b54-4df3-4bca-a65a-3da1ecc777b0)
  --video-layout: record # Describes the video layout of the room composition in terms of regions.
  --webhook-event-url: string # The URL where webhooks related to this room composition will be sent. Must include a scheme, such as 'https'. (format: uri, e.g. https://example.com)
  --webhook-event-failover-url: string # The failover URL where webhooks related to this room composition will be sent if sending to the primary URL fails. Must include a scheme, such as 'https'. (format: uri, default: , e.g. https://failover.example.com)
  --webhook-timeout-secs: int # Specifies how many seconds to wait before timing out a webhook. (e.g. 25)
]: any -> record<data: record<id: string, room_id: string, session_id: string, user_id: string, status: string, size_mb: float, download_url: string, duration_secs: int, format: string, created_at: string, updated_at: string, ended_at: string, started_at: string, completed_at: string, video_layout: record, webhook_event_url: string, webhook_event_failover_url: string, webhook_timeout_secs: int, resolution: string, record_type: string>> {
