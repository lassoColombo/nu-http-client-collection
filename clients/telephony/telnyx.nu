# Update a SIM card
#
# PATCH /sim_cards/{id}
# operationId: UpdateSimCard
# --data_limit shape: {amount?: string, unit?: "MB"|"GB"}
# --current_billing_period_consumed_data shape: {amount?: string, unit?: string}
# --current_device_location shape: {latitude?: string, longitude?: string, accuracy?: int, accuracy_unit?: string}
export def "sim-cards UpdateSimCard" [
  id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
  --max-time(-m): duration # Timeout
  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --status: record
  --sim-card-group-id: string # The group SIMCardGroup identification. This attribute can be <code>null</code> when it's present in an associated resource. (format: uuid, e.g. 6a09cdc3-8948-47f0-aa62-74ac943d6c58)
  --tags: list # Searchable tags associated with the SIM card (e.g. [personal, customers, active-customers])
  --authorized-imeis: list # List of IMEIs authorized to use a given SIM card. (nullable, e.g. [106516771852751, 534051870479563, 508821468377961])
  --data-limit: record # The SIM card individual data limit configuration. — shape: {amount?: string, unit?: "MB"|"GB"}
