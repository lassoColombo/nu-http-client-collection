  --Trim: string@Trim-completer # Whether to trim any leading and trailing silence from the recording. Defaults to `trim-silence`. (e.g. trim-silence)
  --ConferenceRecord: string@ConferenceRecord-completer # Whether to record the conference the participant is joining. Defualts to `do-not-record`. The boolean values `true` and `false` are synonymous with `record-from-start` and `do-not-record` respectively. (e.g. record-from-start)
  --ConferenceRecordingStatusCallback: string # The URL the conference recording callbacks will be sent to. (e.g. https://example.com/conference_recording_status_callback)
  --ConferenceRecordingStatusCallbackMethod: string@ConferenceRecordingStatusCallbackMethod-completer # HTTP request type used for `ConferenceRecordingStatusCallback`. Defaults to `POST`. (e.g. GET)
  --ConferenceRecordingStatusCallbackEvent: string # The changes to the conference recording's state that should generate a call to `RecoridngStatusCallback`. Can be: `in-progress`, `completed` and `absent`. Separate multiple values with a space. Defaults to `completed`. `failed` and `absent` are synonymous. (e.g. in-progress completed failed absent)
  --ConferenceRecordingTimeout: int # The number of seconds that Telnyx will wait for the recording to be stopped if silence is detected. The timer only starts when the speech is detected. Please note that the transcription is used to detect silence and the related charge will be applied. The minimum value is 0. The default value is 0 (infinite) (default: 0, e.g. 5)
