  let base = ($base_url | default $BASE_URL)
  let qp = [(serialize-qp "page[number]" $pagenumber "scalar") (serialize-qp "page[size]" $pagesize "scalar") (serialize-qp "filter[phone_number][contains]" $filterphone_numbercontains "scalar") (serialize-qp "filter[phone_number][eq]" $filterphone_numbereq "scalar")] | flatten | str join "&"
  let full_url = (build-url $base $"/enterprises/($enterprise_id)/reputation/numbers" $qp)
  let accept_val = "application/json"
  let auth = ($auth | update headers ($auth.headers | merge {Accept: $accept_val}))
  do-request "get" $full_url $auth $insecure $raw $max_time $allow_errors "application/json"
}

