  --top-k: int # Top-k sampling parameter — limits the token vocabulary considered at each step. Default: 50.
  --top-p: float # Top-p (nucleus) sampling parameter — cumulative probability cutoff for token selection. Default: 1.0. (format: float)
  --repetition-penalty: float # Repetition penalty to reduce repeated patterns in generated audio. Default: 1.05. (format: float)
  --max-new-tokens: int # Maximum number of tokens to generate. Default: 2048.
  --provider: string@provider-completer-5 # Voice synthesis provider. `telnyx` uses the Qwen3TTS model; `minimax` uses the Minimax speech models. Case-insensitive. Defaults to `telnyx`. (default: telnyx)
