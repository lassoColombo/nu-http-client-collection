  --raw(-r) # Fetch as text
  --allow-errors(-e) # Return full response without error handling
  --Page: int # The number of the page to be displayed, zero-indexed, should be used in conjuction with PageToken. (e.g. 1)
  --PageSize: int # The number of records to be displayed on a page (e.g. 10)
  --PageToken: string # Used to request the next page of results.
  --To: string # Filters calls by the to number. (e.g. +1312345678)
  --From: string # Filters calls by the from number. (e.g. +1312345678)
  --Status: string@Status-completer # Filters calls by status. (e.g. no-answer)
  --StartTime: string # Filters calls by their start date. Expected format is YYYY-MM-DD. (e.g. 2023-05-22)
  --StartTime-gt: string # Filters calls by their start date (after). Expected format is YYYY-MM-DD (e.g. 2023-05-22)
  --StartTime-lt: string # Filters calls by their start date (before). Expected format is YYYY-MM-DD (e.g. 2023-05-22)
  --EndTime: string # Filters calls by their end date. Expected format is YYYY-MM-DD (e.g. 2023-05-22)
