# Gather DTMF using audio prompt in a conference
#
# POST /conferences/{id}/actions/gather_using_audio
# operationId: ConferenceGatherUsingAudio
export def "conferences-actions-gather-using-audio ConferenceGatherUsingAudio" [
  id: string
  --base-url(-b): string@base-url-completer # API base URL
  --token(-t): string # Auth token
  --auth-scheme(-a): string@auth-scheme-completer # Auth scheme
  --insecure(-k) # Skip TLS verification
