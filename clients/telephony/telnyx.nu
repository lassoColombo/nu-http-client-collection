rd_track, record_trim: $record_trim, record_custom_file_name: $record_custom_file_name, supervise_call_control_id: $supervise_call_control_id, supervisor_role: $supervisor_role, enable_dialogflow: $enable_dialogflow, dialogflow_config: $dialogflow_config, transcription: $transcription, transcription_config: $transcription_config, sip_region: $sip_region, stream_auth_token: $stream_auth_token} | compact
